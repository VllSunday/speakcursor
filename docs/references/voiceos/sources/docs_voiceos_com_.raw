r-width,19rem) flex gap-x-8 min-h-screen pt-[calc(10rem+var(--banner-height,2.5rem))] px-4 lg:pt-10 lg:pl-16 lg:pr-10" id="content-container"><div class="flex flex-col box-border w-full relative grow mx-auto [contain:inline-size] max-w-(--content-width,36rem) 2xl:max-w-(--content-width,42rem) xl:w-[calc(100%-28rem)] lg:mt-12" id="content-area"><header id="header" class="relative leading-none @container/page-header"><div class="mt-0.5 space-y-2.5"><div class="eyebrow h-5 text-primary dark:text-primary-light text-sm font-semibold">Get started</div><div class="flex flex-col sm:flex-row items-start sm:items-center relative gap-2 min-w-0"><h1 id="page-title" class="text-3xl sm:text-4xl text-gray-900 tracking-tight dark:text-gray-200 [overflow-wrap:anywhere] font-semibold">Build for VoiceOS</h1></div></div><div class="mt-2 text-lg prose prose-gray dark:prose-invert [&amp;&gt;*]:[overflow-wrap:anywhere]"><p>Add tools to the VoiceOS agent and answer with native cards in the Mac notch.</p></div></header><div class="mdx-content @container/columns-container relative mt-8 prose prose-gray dark:prose-invert [contain:inline-size] isolate empty:hidden mb-14" data-page-title="Build for VoiceOS" data-page-href="/integrations/index" id="content"><span data-as="p">VoiceOS is a voice assistant that lives in the Mac notch. Users talk, the agent
acts, and answers arrive as <strong>cards in the notch</strong>.</span>
<span data-as="p">A <strong>custom integration</strong> puts your thing on that surface. You declare tools; the
agent calls them when the user asks; your results render as native cards — or as
<a class="link" href="/integrations/widgets">fully custom UI</a> when you want every pixel. If it has an
API, you can build it: internal dashboards, home automation, your CRM, a coffee
tracker.</span>
<div><figure data-name="frame" class="frame p-2 not-prose relative bg-gray-50/50 rounded-2xl overflow-hidden dark:bg-gray-800/25 print:print-color-exact"><div style="background-position:10px 10px" class="absolute inset-0 bg-grid-neutral-200/20 [mask-image:linear-gradient(0deg,#fff,rgba(255,255,255,0.6))] dark:bg-grid-white/5 dark:[mask-image:linear-gradient(0deg,rgba(255,255,255,0.1),rgba(255,255,255,0.5))] print:print-color-exact"></div><div class="relative rounded-xl overflow-hidden flex justify-center [&amp;_:where(img:not([class*=rounded-]))]:rounded-xl"><span data-ramka-trigger="" class="zoom-image-trigger contents cursor-zoom-in"><span class="contents"><picture class="contents"><img data-path="images/integrations/gallery-official.png" src="https://mintcdn.com/voiceos/KVsJZgZq4ypscj2j/images/integrations/gallery-official.png?fit=max&amp;auto=format&amp;n=KVsJZgZq4ypscj2j&amp;q=85&amp;s=4d472003dfdf108cc1f40833ec780c93" alt="Two VoiceOS notch cards side by side: a Gmail inbox card listing three emails with a green New badge, and a Google Calendar card listing the day&#x27;s three events with times." class="object-contain" width="3808" height="1278" decoding="async" sizes="(max-width: 1024px) 100vw, 672px" srcSet="https://mintcdn.com/voiceos/KVsJZgZq4ypscj2j/images/integrations/gallery-official.png?w=280&amp;fit=max&amp;auto=format&amp;n=KVsJZgZq4ypscj2j&amp;q=85&amp;s=9ea6f07e7683ae143892092171abd303 280w, https://mintcdn.com/voiceos/KVsJZgZq4ypscj2j/images/integrations/gallery-official.png?w=560&amp;fit=max&amp;auto=format&amp;n=KVsJZgZq4ypscj2j&amp;q=85&amp;s=06c8847a9d1185a30462977746bb152c 560w, https://mintcdn.com/voiceos/KVsJZgZq4ypscj2j/images/integrations/gallery-official.png?w=840&amp;fit=max&amp;auto=format&amp;n=KVsJZgZq4ypscj2j&amp;q=85&amp;s=4b79758bfeeb0bf92e60aa8b47984fe9 840w, https://mintcdn.com/voiceos/KVsJZgZq4ypscj2j/images/integrations/gallery-official.png?w=1100&amp;fit=max&amp;auto=format&amp;n=KVsJZgZq4ypscj2j&amp;q=85&amp;s=6b9f43054ea1ebf2d190d89877be13ef 1100w, https://mintcdn.com/voiceos/KVsJZgZq4ypscj2j/images/integrations/gallery-official.png?w=1650&amp;fit=max&amp;auto=format&amp;n=KVsJZgZq4ypscj2j&amp;q=85&amp;s=7c17960c0709e18b36df7a0b5113ba3b 1650w, https://mintcdn.com/voiceos/KVsJZgZq4ypscj2j/images/integrations/gallery-official.png?w=2500&amp;fit=max&amp;auto=format&amp;n=KVsJZgZq4ypscj2j&amp;q=85&amp;s=9cc1df8f7d9c7dd92dc3d5651b856718 2500w" data-optimize="true" style="aspect-ratio:3808 / 1278"/></picture></span></span><button type="button" aria-haspopup="dialog" aria-expanded="false" data-ramka-trigger="" aria-label="Expand image" class="inline-flex shrink-0 cursor-pointer items-center justify-center rounded-full border border-black/20 bg-white/55 text-neutral-900 shadow-[0_0.5px_1px_rgb(0_0_0/0.12),0_1px_2px_rgb(0_0_0/0.08),inset_0_0.5px_0_rgb(255_255_255/0.65)] backdrop-blur-[40px] backdrop-saturate-150 transition-[background-color,box-shadow,scale,opacity,color] duration-150 ease-out hover:bg-white/65 active:scale-[0.96] active:bg-white/75 focus:outline-hidden focus-visible:shadow-[0_0_0_2px_rgb(0_0_0/0.25),0_0.5px_1px_rgb(0_0_0/0.12),0_1px_2px_rgb(0_0_0/0.08),inset_0_0.5px_0_rgb(255_255_255/0.65)] disabled:cursor-not-allowed disabled:opacity-30 disabled:active:scale-100 dark:border-white/25 dark:bg-neutral-900/45 dark:text-white dark:shadow-[0_0_0_0.5px_#000,0_0.5px_1px_rgb(0_0_0/0.45),0_1px_2px_rgb(0_0_0/0.35),inset_0_0.5px_0_rgb(255_255_255/0.14)] dark:hover:bg-neutral-900/55 dark:active:bg-neutral-900/65 dark:focus-visible:shadow-[0_0_0_2px_rgb(255_255_255/0.4),0_0_0_0.5px_#000,0_0.5px_1px_rgb(0_0_0/0.45),0_1px_2px_rgb(0_0_0/0.35),inset_0_0.5px_0_rgb(255_255_255/0.14)] absolute z-10 size-px overflow-hidden whitespace-nowrap [clip-path:inset(50%)] pointer-events-none focus-visible:size-9 focus-visible:overflow-visible focus-visible:[clip-path:none] focus-visible:pointer-events-auto in-[a]:hidden"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="size-4 shrink-0"><path d="M10.75 2.75H15.25V7.25" stroke="currentColor" width="1.5" linecap="round" linejoin="round"></path><path d="M15.25 2.75L10.75 7.25" stroke="currentColor" width="1.5" linecap="round" linejoin="round"></path><path d="M2.75 10.75V15.25H7.25" stroke="currentColor" width="1.5" linecap="round" linejoin="round"></path><path d="M2.75 15.25L7.25 10.75" stroke="currentColor" width="1.5" linecap="round" linejoin="round"></path></svg></button></div><div class="absolute inset-0 pointer-events-none border border-black/5 rounded-2xl dark:border-white/5"></div><figcaption class="relative rounded-2xl text-center mt-3 pt-0 px-8 pb-2 text-sm text-gray-700 dark:text-gray-400 [&amp;_p]:m-0 [&amp;_a]:font-semibold [&amp;_a]:no-underline [&amp;_a]:border-b [&amp;_a]:border-primary [&amp;_a:hover]:border-b-2 dark:[&amp;_a]:text-white dark:[&amp;_a]:border-primary-light" data-component-part="frame-caption"><p>First-party integrations answering in the notch. A custom integration renders on this exact surface.</p></figcaption></figure></div>
<span data-as="p">Think of it like the App Store: <strong>VoiceOS is iOS, your integration is an app.</strong>
One manifest declares what it does (tools), where it runs (runtime), what it
needs (auth and permissions), and how it confirms actions (declarative UI).
VoiceOS wires up the rest. You never touch VoiceOS internals — which is also why
your code can never reach VoiceOS’s backend or secrets.</span>
<h2 class="flex whitespace-pre-wrap group font-semibold" id="pick-a-path"><div class="absolute" tabindex="-1"><a href="#pick-a-path" class="-ml-10 flex items-center opacity-0 border-0 group-hover:opacity-100 focus:opacity-100 focus:outline-0 group/link" aria-label="Navigate to header">​<div class="size-6 rounded-md flex items-center justify-center shadow-xs text-gray-400 dark:text-white/50 dark:bg-background-dark dark:brightness-[1.35] dark:ring-1 dark:hover:brightness-150 bg-white ring-1 ring-gray-400/30 dark:ring-gray-700/25 hover:ring-gray-400/60 dark:hover:ring-white/20 group-focus/link:border-2 group-focus/link:border-primary dark:group-focus/link:border-primary-light"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="size-3 shrink-0"><path d="M8.50001 6.827C8.14801 6.995 7.81801 7.225 7.52701 7.517L7.51701 7.527C6.13601 8.908 6.13601 11.146 7.51701 12.527L9.69201 14.702C11.073 16.083 13.311 16.083 14.692 14.702L14.702 14.692C16.083 13.311 16.083 11.073 14.702 9.692L13.771 8.761" stroke="currentColor" width="1.5" linecap="round" linejoin="round"></path><path d="M9.50002 11.173C9.85202 11.005 10.182 10.775 10.473 10.483L10.483 10.473C11.864 9.092 11.864 6.854 10.483 5.473L8.30802 3.298C6.92702 1.917 4.68902 1.917 3.30802 3.298L3.29802 3.308C1.91702 4.689 1.91702 6.927 3.29802 8.308L4.22902 9.239" stroke="currentColor" width="1.5" linecap="round" linejoin="round"></path></svg></div></a></div><span class="cursor-pointer">Pick a path</span></h2>
<div class="columns prose dark:prose-invert grid max-w-none gap-4 sm:grid-cols-[repeat(var(--cols),minmax(0,1fr))] @2xl/columns-container:grid-cols-[repeat(var(--cols),minmax(0,1fr))] @[0px]/columns-container:grid-cols-1 card-group dark:prose-dark gap-y-0 sm:grid-cols-[repeat(var(--cols),minmax(0,1fr))]!" style="--cols:2"><div class="card block font-normal group relative my-2 ring-2 ring-transparent rounded-2xl bg-white dark:bg-background-dark border border-gray-950/10 dark:border-white/10 overflow-hidden w-full cursor-pointer hover:border-primary! dark:hover:border-primary-light!" aria-labelledby="_R_2b5bbdqnpfb39p7b9snpfiutb_" tabindex="0" role="link"><div class="px-6 py-5 relative" data-component-part="card-content-container"><div class="absolute text-gray-400 dark:text-gray-500 group-hover:text-primary dark:group-hover:text-primary-light top-5 right-5 hidden"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="m-0.5 size-3 shrink-0"><path d="M14.25 3.75L3.75525 14.2446" stroke="currentColor" width="1.5" linecap="round" linejoin="round"></path><path d="M4.71301 3.75H14.2499V13.2869" stroke="currentColor" width="1.5" linecap="round" linejoin="round"></path></svg></div><div aria-hidden="true" class="size-6 fill-gray-800 dark:fill-gray-100 text-gray-800 dark:text-gray-100 [&amp;&gt;svg]:size-6" data-component-part="card-icon"><svg class="forced-colors:forced-color-adjust-none forced-colors:bg-[color:CanvasText]! size-6 m-0! shrink-0 bg-primary dark:bg-primary-light" aria-hidden="true" focusable="false" style="-webkit-mask-image:url(&quot;https://d3gk2c5xim1je2.cloudfront.net/lucide/v1.16.0/sparkles.svg&quot;);-webkit-mask-repeat:no-repeat;-webkit-mask-position:center;mask-image:url(&quot;https://d3gk2c5xim1je2.cloudfront.net/lucide/v1.16.0/sparkles.svg&quot;);mask-repeat:no-repeat;mask-position:center;mask-size:100%"></svg></div><div class="w-full"><h2 id="_R_2b5bbdqnpfb39p7b9snpfiutb_" class="not-prose font-semibold text-base text-gray-800 dark:text-white mt-4" contentEditable="false" data-component-part="card-title">Build with AI — no code</h2><div id="_R_2b5bbdqnpfb39p7b9snpfiutbH1_" class="prose mt-1 font-normal text-base leading-6 text-gray-600 dark:text-gray-400" data-component-part="card-content"><span data-as="p">Describe your integration in a sentence. The Integration Studio plans it,
builds it, designs its cards, and lets you test-drive it live. ~3 minutes.</span></div></div></div></div><div class="card block font-normal group relative my-2 ring-2 ring-transparent rounded-2xl bg-white dark:bg-background-dark border border-gray-950/10 dark:border-white/10 overflow-hidden w-full cursor-pointer hover:border-primary! dark:hover:border-primary-light!" aria-labelledby="_R_4b5bbdqnpfb39p7b9snpfiutb_" tabindex="0" role="link"><div class="px-6 py-5 relative" data-component-part="card-content-container"><div class="absolute text-gray-400 dark:text-gray-500 group-hover:text-primary dark:group-hover:text-primary-light top-5 right-5 hidden"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="m-0.5 size-3 shrink-0"><path d="M14.25 3.75L3.75525 14.2446" stroke="currentColor" width="1.5" linecap="round" linejoin="round"></path><path d="M4.71301 3.75H14.2499V13.2869" stroke="currentColor" width="1.5" linecap="round" linejoin="round"></path></svg></div><div aria-hidden="true" class="size-6 fill-gray-800 dark:fill-gray-100 text-gray-800 dark:text-gray-100 [&amp;&gt;svg]:size-6" data-component-part="card-icon"><svg class="forced-colors:forced-color-adjust-none forced-colors:bg-[color:CanvasText]! size-6 m-0! shrink-0 bg-primary dark:bg-primary-light" aria-hidden="true" focusable="false" style="-webkit-mask-image:url(&quot;https://d3gk2c5xim1je2.cloudfront.net/lucide/v1.16.0/code.svg&quot;);-webkit-mask-repeat:no-repeat;-webkit-mask-position:center;mask-image:url(&quot;https://d3gk2c5xim1je2.cloudfront.net/lucide/v1.16.0/code.svg&quot;);mask-repeat:no-repeat;mask-position:center;mask-size:100%"></svg></div><div class="w-full"><h2 id="_R_4b5bbdqnpfb39p7b9snpfiutb_" class="not-prose font-semibold text-base text-gray-800 dark:text-white mt-4" contentEditable="false" data-component-part="card-title">Build with code</h2><div id="_R_4b5bbdqnpfb39p7b9snpfiutbH1_" class="prose mt-1 font-normal text-base leading-6 text-gray-600 dark:text-gray-400" data-component-part="card-content"><span data-as="p">A standalone folder with a manifest and a small MCP server. Full control
over logic, cards, and widgets. ~10 minutes.</span></div></div></div></div></div>
<span data-as="p">Both produce the same thing: an integration folder VoiceOS can install.
Studio-built integrations are real folders too — open one in your editor, or
hand it to a coding agent, and keep building.</span>
<h2 class="flex whitespace-pre-wrap group font-semibold" id="what-it-feels-like"><div class="absolute" tabindex="-1"><a href="#what-it-feels-like" class="-ml-10 flex items-center opacity-0 border-0 group-hover:opacity-100 focus:opacity-100 focus:outline-0 group/link" aria-label="Navigate to header">​<div class="size-6 rounded-md flex items-center justify-center shadow-xs text-gray-400 dark:text-white/50 dark:bg-background-dark dark:brightness-[1.35] dark:ring-1 dark:hover:brightness-150 bg-white ring-1 ring-gray-400/30 dark:ring-gray-700/25 hover:ring-gray-400/60 dark:hover:ring-white/20 group-focus/link:border-2 group-focus/link:border-primary dark:group-focus/link:border-primary-light"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="size-3 shrink-0"><path d="M8.50001 6.827C8.14801 6.995 7.81801 7.225 7.52701 7.517L7.51701 7.527C6.13601 8.908 6.13601 11.146 7.51701 12.527L9.69201 14.702C11.073 16.083 13.311 16.083 14.692 14.702L14.702 14.692C16.083 13.311 16.083 11.073 14.702 9.692L13.771 8.761" stroke="currentColor" width="1.5" linecap="round" linejoin="round"></path><path d="M9.50002 11.173C9.85202 11.005 10.182 10.775 10.473 10.483L10.483 10.473C11.864 9.092 11.864 6.854 10.483 5.473L8.30802 3.298C6.92702 1.917 4.68902 1.917 3.30802 3.298L3.29802 3.308C1.91702 4.689 1.91702 6.927 3.29802 8.308L4.22902 9.239" stroke="currentColor" width="1.5" linecap="round" linejoin="round"></path></svg></div></a></div><span class="cursor-pointer">What it feels like</span></h2>
<span data-as="p">Say you built an <strong>ElevenLabs</strong> integration.</span>
<div role="list" class="steps ml-3.5 mt-10 mb-6"><div role="listitem" class="step group/step step-container relative flex items-start pb-5"><div data-component-part="step-line" class="absolute w-px h-[calc(100%-2.75rem)] top-11 bg-gray-200/70 dark:bg-white/10" contentEditable="false"></div><div class="absolute ml-[-13px] py-2" data-component-part="step-number" contentEditable="false"><div data-component-part="step-indicator" class="group/step-indicator relative size-7 shrink-0 rounded-full bg-gray-50 dark:bg-white/10 text-xs text-gray-900 dark:text-gray-50 font-semibold flex items-center justify-center"><div class="[[data-component-part=step-indicator]:has(a:focus-visible)_&amp;]:opacity-0">1</div></div></div><div class="w-full overflow-hidden pl-8 pr-px"><p class="mt-2 font-semibold prose dark:prose-invert text-gray-900 dark:text-gray-200" contentEditable="false" data-component-part="step-title">The user speaks, and the agent confirms</p><div data-component-part="step-content" class="prose dark:prose-invert"><span data-as="p"><em>“Read this in Rachel’s voice”</em> — the agent picks your <code>generate_speech</code> tool.
Because it <strong>acts</strong> (it spends API credits and writes a file), VoiceOS first
renders the confirmation card you declared in the manifest, before any of your
code runs.</span><div><figure data-name="frame" class="frame p-2 not-prose relative bg-gray-50/50 rounded-2xl overflow-hidden dark:bg-gray-800/25 print:print-color-exact"><div style="background-position:10px 10px" class="absolute inset-0 bg-grid-neutral-200/20 [mask-image:linear-gradient(0deg,#fff,rgba(255,255,255,0.6))] dark:bg-grid-white/5 dark:[mask-image:linear-gradient(0deg,rgba(255,255,255,0.1),rgba(255,255,255,0.5))] print:print-color-exact"></div><div class="relative rounded-xl overflow-hidden flex justify-center [&amp;_:where(img:not([class*=rounded-]))]:rounded-xl"><span data-ramka-trigger="" class="zoom-image-trigger contents cursor-zoom-in"><span class="contents"><picture class="contents"><img data-path="images/integrations/elevenlabs-confirm.png" src="https://mintcdn.com/voiceos/KVsJZgZq4ypscj2j/images/integrations/elevenlabs-confirm.png?fit=max&amp;auto=format&amp;n=KVsJZgZq4ypscj2j&amp;q=85&amp;s=77db66a04aa42d377007f7a78b2b667e" alt="A &#x27;Generate speech&#x27; confirmation card in the notch with an editable Text field reading &#x27;VoiceOS turns your voice into action.&#x27;, a Voice picker set to Rachel, and Cancel / Generate buttons." class="object-contain" width="1952" height="1312" decoding="async" sizes="(max-width: 1024px) 100vw, 672px" srcSet="https://mintcdn.com/voiceos/KVsJZgZq4ypscj2j/images/integrations/elevenlabs-confirm.png?w=280&amp;fit=max&amp;auto=format&amp;n=KVsJZgZq4ypscj2j&amp;q=85&amp;s=171d7e44cf30841190e3f197e846c4f6 280w, https://mintcdn.com/voiceos/KVsJZgZq4ypscj2j/images/integrations/elevenlabs-confirm.png?w=560&amp;fit=max&amp;auto=format&amp;n=KVsJZgZq4ypscj2j&amp;q=85&amp;s=fccfe7609448cfcdadf6b409bf1c9824 560w, https://mintcdn.com/voiceos/KVsJZgZq4ypscj2j/images/integrations/elevenlabs-confirm.png?w=840&amp;fit=max&amp;auto=format&amp;n=KVsJZgZq4ypscj2j&amp;q=85&amp;s=924450033305f47d724d9cea89b5995f 840w, https://mintcdn.com/voiceos/KVsJZgZq4ypscj2j/images/integrations/elevenlabs-confirm.png?w=1100&amp;fit=max&amp;au