www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="size-4 shrink-0"><path d="M10.75 2.75H15.25V7.25" stroke="currentColor" width="1.5" linecap="round" linejoin="round"></path><path d="M15.25 2.75L10.75 7.25" stroke="currentColor" width="1.5" linecap="round" linejoin="round"></path><path d="M2.75 10.75V15.25H7.25" stroke="currentColor" width="1.5" linecap="round" linejoin="round"></path><path d="M2.75 15.25L7.25 10.75" stroke="currentColor" width="1.5" linecap="round" linejoin="round"></path></svg></button></div><div class="absolute inset-0 pointer-events-none border border-black/5 rounded-2xl dark:border-white/5"></div><figcaption class="relative rounded-2xl text-center mt-3 pt-0 px-8 pb-2 text-sm text-gray-700 dark:text-gray-400 [&amp;_p]:m-0 [&amp;_a]:font-semibold [&amp;_a]:no-underline [&amp;_a]:border-b [&amp;_a]:border-primary [&amp;_a:hover]:border-b-2 dark:[&amp;_a]:text-white dark:[&amp;_a]:border-primary-light" data-component-part="frame-caption"><p>The user edits the arguments; the edited values are what your handler receives.</p></figcaption></figure></div></div></div></div><div role="listitem" class="step group/step step-container relative flex items-start pb-5"><div data-component-part="step-line" class="absolute w-px h-[calc(100%-2.75rem)] top-11 bg-transparent bg-linear-to-b from-gray-200 dark:from-white/10 via-80% to-transparent [.step-container:has([data-component-part=step-content]:empty)_&amp;]:hidden" contentEditable="false"></div><div class="absolute ml-[-13px] py-2" data-component-part="step-number" contentEditable="false"><div data-component-part="step-indicator" class="group/step-indicator relative size-7 shrink-0 rounded-full bg-gray-50 dark:bg-white/10 text-xs text-gray-900 dark:text-gray-50 font-semibold flex items-center justify-center"><div class="[[data-component-part=step-indicator]:has(a:focus-visible)_&amp;]:opacity-0">2</div></div></div><div class="w-full overflow-hidden pl-8 pr-px"><p class="mt-2 font-semibold prose dark:prose-invert text-gray-900 dark:text-gray-200" contentEditable="false" data-component-part="step-title">Your server runs, your card appears</p><div data-component-part="step-content" class="prose dark:prose-invert"><span data-as="p">The handler calls the ElevenLabs API and returns JSON. The agent narrates the
data; the notch shows your card.</span><div><figure data-name="frame" class="frame p-2 not-prose relative bg-gray-50/50 rounded-2xl overflow-hidden dark:bg-gray-800/25 print:print-color-exact"><div style="background-position:10px 10px" class="absolute inset-0 bg-grid-neutral-200/20 [mask-image:linear-gradient(0deg,#fff,rgba(255,255,255,0.6))] dark:bg-grid-white/5 dark:[mask-image:linear-gradient(0deg,rgba(255,255,255,0.1),rgba(255,255,255,0.5))] print:print-color-exact"></div><div class="relative rounded-xl overflow-hidden flex justify-center [&amp;_:where(img:not([class*=rounded-]))]:rounded-xl"><span data-ramka-trigger="" class="zoom-image-trigger contents cursor-zoom-in"><span class="contents"><picture class="contents"><img data-path="images/integrations/elevenlabs-hero.png" src="https://mintcdn.com/voiceos/KVsJZgZq4ypscj2j/images/integrations/elevenlabs-hero.png?fit=max&amp;auto=format&amp;n=KVsJZgZq4ypscj2j&amp;q=85&amp;s=f003b7bec7ff21f0ca8f1d506e4659d5" alt="The VoiceOS notch showing the prompt &#x27;Read this in Rachel&#x27;s voice&#x27; and an ElevenLabs result card: Voice Rachel, Length 0:07, Saved to narration.mp3, with a green &#x27;Opened in Music&#x27; badge." class="object-contain" width="1952" height="1162" decoding="async" sizes="(max-width: 1024px) 100vw, 672px" srcSet="https://mintcdn.com/voiceos/KVsJZgZq4ypscj2j/images/integrations/elevenlabs-hero.png?w=280&amp;fit=max&amp;auto=format&amp;n=KVsJZgZq4ypscj2j&amp;q=85&amp;s=7c59cae9c5c3516ddd04f22815fe16dd 280w, https://mintcdn.com/voiceos/KVsJZgZq4ypscj2j/images/integrations/elevenlabs-hero.png?w=560&amp;fit=max&amp;auto=format&amp;n=KVsJZgZq4ypscj2j&amp;q=85&amp;s=06247417cf1e3ec668c931f29381603e 560w, https://mintcdn.com/voiceos/KVsJZgZq4ypscj2j/images/integrations/elevenlabs-hero.png?w=840&amp;fit=max&amp;auto=format&amp;n=KVsJZgZq4ypscj2j&amp;q=85&amp;s=c9b0e4f8a4dd0afc17a94d2d6c88dbd9 840w, https://mintcdn.com/voiceos/KVsJZgZq4ypscj2j/images/integrations/elevenlabs-hero.png?w=1100&amp;fit=max&amp;auto=format&amp;n=KVsJZgZq4ypscj2j&amp;q=85&amp;s=7dc1b8cb15e5335ef2359db5d04cc35b 1100w, https://mintcdn.com/voiceos/KVsJZgZq4ypscj2j/images/integrations/elevenlabs-hero.png?w=1650&amp;fit=max&amp;auto=format&amp;n=KVsJZgZq4ypscj2j&amp;q=85&amp;s=56e4326f6d9c85faf81f37482f73c5de 1650w, https://mintcdn.com/voiceos/KVsJZgZq4ypscj2j/images/integrations/elevenlabs-hero.png?w=2500&amp;fit=max&amp;auto=format&amp;n=KVsJZgZq4ypscj2j&amp;q=85&amp;s=c07ba04bab026ea4d7c1e9e8676c03ad 2500w" data-optimize="true" style="aspect-ratio:1952 / 1162"/></picture></span></span><button type="button" aria-haspopup="dialog" aria-expanded="false" data-ramka-trigger="" aria-label="Expand image" class="inline-flex shrink-0 cursor-pointer items-center justify-center rounded-full border border-black/20 bg-white/55 text-neutral-900 shadow-[0_0.5px_1px_rgb(0_0_0/0.12),0_1px_2px_rgb(0_0_0/0.08),inset_0_0.5px_0_rgb(255_255_255/0.65)] backdrop-blur-[40px] backdrop-saturate-150 transition-[background-color,box-shadow,scale,opacity,color] duration-150 ease-out hover:bg-white/65 active:scale-[0.96] active:bg-white/75 focus:outline-hidden focus-visible:shadow-[0_0_0_2px_rgb(0_0_0/0.25),0_0.5px_1px_rgb(0_0_0/0.12),0_1px_2px_rgb(0_0_0/0.08),inset_0_0.5px_0_rgb(255_255_255/0.65)] disabled:cursor-not-allowed disabled:opacity-30 disabled:active:scale-100 dark:border-white/25 dark:bg-neutral-900/45 dark:text-white dark:shadow-[0_0_0_0.5px_#000,0_0.5px_1px_rgb(0_0_0/0.45),0_1px_2px_rgb(0_0_0/0.35),inset_0_0.5px_0_rgb(255_255_255/0.14)] dark:hover:bg-neutral-900/55 dark:active:bg-neutral-900/65 dark:focus-visible:shadow-[0_0_0_2px_rgb(255_255_255/0.4),0_0_0_0.5px_#000,0_0.5px_1px_rgb(0_0_0/0.45),0_1px_2px_rgb(0_0_0/0.35),inset_0_0.5px_0_rgb(255_255_255/0.14)] absolute z-10 size-px overflow-hidden whitespace-nowrap [clip-path:inset(50%)] pointer-events-none focus-visible:size-9 focus-visible:overflow-visible focus-visible:[clip-path:none] focus-visible:pointer-events-auto in-[a]:hidden"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="size-4 shrink-0"><path d="M10.75 2.75H15.25V7.25" stroke="currentColor" width="1.5" linecap="round" linejoin="round"></path><path d="M15.25 2.75L10.75 7.25" stroke="currentColor" width="1.5" linecap="round" linejoin="round"></path><path d="M2.75 10.75V15.25H7.25" stroke="currentColor" width="1.5" linecap="round" linejoin="round"></path><path d="M2.75 15.25L7.25 10.75" stroke="currentColor" width="1.5" linecap="round" linejoin="round"></path></svg></button></div><div class="absolute inset-0 pointer-events-none border border-black/5 rounded-2xl dark:border-white/5"></div><figcaption class="relative rounded-2xl text-center mt-3 pt-0 px-8 pb-2 text-sm text-gray-700 dark:text-gray-400 [&amp;_p]:m-0 [&amp;_a]:font-semibold [&amp;_a]:no-underline [&amp;_a]:border-b [&amp;_a]:border-primary [&amp;_a:hover]:border-b-2 dark:[&amp;_a]:text-white dark:[&amp;_a]:border-primary-light" data-component-part="frame-caption"><p>A glance card — rendered by VoiceOS&#x27;s own components from three lines of JSON.</p></figcaption></figure></div></div></div></div></div>
<span data-as="p">Read-only tools skip the confirmation entirely — <em>“what voices do I have?”</em> just
answers, instantly, with a card.</span>
<h2 class="flex whitespace-pre-wrap group font-semibold" id="what-you-can-build"><div class="absolute" tabindex="-1"><a href="#what-you-can-build" class="-ml-10 flex items-center opacity-0 border-0 group-hover:opacity-100 focus:opacity-100 focus:outline-0 group/link" aria-label="Navigate to header">​<div class="size-6 rounded-md flex items-center justify-center shadow-xs text-gray-400 dark:text-white/50 dark:bg-background-dark dark:brightness-[1.35] dark:ring-1 dark:hover:brightness-150 bg-white ring-1 ring-gray-400/30 dark:ring-gray-700/25 hover:ring-gray-400/60 dark:hover:ring-white/20 group-focus/link:border-2 group-focus/link:border-primary dark:group-focus/link:border-primary-light"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="size-3 shrink-0"><path d="M8.50001 6.827C8.14801 6.995 7.81801 7.225 7.52701 7.517L7.51701 7.527C6.13601 8.908 6.13601 11.146 7.51701 12.527L9.69201 14.702C11.073 16.083 13.311 16.083 14.692 14.702L14.702 14.692C16.083 13.311 16.083 11.073 14.702 9.692L13.771 8.761" stroke="currentColor" width="1.5" linecap="round" linejoin="round"></path><path d="M9.50002 11.173C9.85202 11.005 10.182 10.775 10.473 10.483L10.483 10.473C11.864 9.092 11.864 6.854 10.483 5.473L8.30802 3.298C6.92702 1.917 4.68902 1.917 3.30802 3.298L3.29802 3.308C1.91702 4.689 1.91702 6.927 3.29802 8.308L4.22902 9.239" stroke="currentColor" width="1.5" linecap="round" linejoin="round"></path></svg></div></a></div><span class="cursor-pointer">What you can build</span></h2>
<!-- --><div role="presentation" style="position:relative;--scroll-area-corner-height:0px;--scroll-area-corner-width:0px" data-component-part="scroll-area" data-table-wrapper="true" class="min-w-0 [--page-padding:16px] flex w-[calc(100%+(var(--page-padding)*2))] my-[1em] py-[1em] -mx-(--page-padding) max-w-none [contain:inline-size]"><div data-id="base-ui-_R_p5bbdqnpfb39p7b9snpfiutb_-viewport" tabindex="-1" class="size-full rounded-[inherit] [--scroll-area-fade-size:32px] overflow-y-hidden! base-ui-disable-scrollbar" style="overflow:scroll" data-component-part="scroll-area-viewport" role="region" aria-label="Scrollable table"><div role="presentation" style="min-width:fit-content" data-component-part="scroll-area-content" class="flex"><div class="px-(--page-padding) grow max-w-none table"><table class="m-0 min-w-full w-full max-w-none table [&amp;_th]:text-left [&amp;_td[data-numeric]]:tabular-nums [&amp;_td]:min-w-[150px]"><thead><tr><th></th><th></th></tr></thead><tbody><tr><td><strong>Lookups</strong></td><td>Dashboards, prices, statuses, schedules — anything with an API.</td></tr><tr><td><strong>Actions</strong></td><td>Send, create, post, open — always behind a confirmation card.</td></tr><tr><td><strong>Trackers</strong></td><td>”Log my coffee”, with stats and charts in the notch.</td></tr><tr><td><strong>Long-running work</strong></td><td>Background tasks that chime and show a card when done.</td></tr><tr><td><strong>Fully custom UI</strong></td><td>Sandboxed HTML widgets when the built-in blocks aren’t enough.</td></tr></tbody></table></div></div></div></div>
<h2 class="flex whitespace-pre-wrap group font-semibold" id="the-path-through-these-docs"><div class="absolute" tabindex="-1"><a href="#the-path-through-these-docs" class="-ml-10 flex items-center opacity-0 border-0 group-hover:opacity-100 focus:opacity-100 focus:outline-0 group/link" aria-label="Navigate to header">​<div class="size-6 rounded-md flex items-center justify-center shadow-xs text-gray-400 dark:text-white/50 dark:bg-background-dark dark:brightness-[1.35] dark:ring-1 dark:hover:brightness-150 bg-white ring-1 ring-gray-400/30 dark:ring-gray-700/25 hover:ring-gray-400/60 dark:hover:ring-white/20 group-focus/link:border-2 group-focus/link:border-primary dark:group-focus/link:border-primary-light"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="size-3 shrink-0"><path d="M8.50001 6.827C8.14801 6.995 7.81801 7.225 7.52701 7.517L7.51701 7.527C6.13601 8.908 6.13601 11.146 7.51701 12.527L9.69201 14.702C11.073 16.083 13.311 16.083 14.692 14.702L14.702 14.692C16.083 13.311 16.083 11.073 14.702 9.692L13.771 8.761" stroke="currentColor" width="1.5" linecap="round" linejoin="round"></path><path d="M9.50002 11.173C9.85202 11.005 10.182 10.775 10.473 10.483L10.483 10.473C11.864 9.092 11.864 6.854 10.483 5.473L8.30802 3.298C6.92702 1.917 4.68902 1.917 3.30802 3.298L3.29802 3.308C1.91702 4.689 1.91702 6.927 3.29802 8.308L4.22902 9.239" stroke="currentColor" width="1.5" linecap="round" linejoin="round"></path></svg></div></a></div><span class="cursor-pointer">The path through these docs</span></h2>
<span data-as="p">Read top to bottom and you’ll go from nothing to a polished, branded
integration.</span>
<ol>
<li><strong><a class="link" href="/integrations/quickstart">Quickstart</a></strong> — build one with AI, in the app,
in three minutes.</li>
<li><strong><a class="link" href="/integrations/how-it-works">How it works</a></strong> — the architecture in one page.</li>
<li><strong><a class="link" href="/integrations/build-with-code">Build with code</a></strong> and
<strong><a class="link" href="/integrations/tools">defining tools</a></strong> — schemas, handlers, background
execution. Add <strong><a class="link" href="/integrations/intents">fast intents</a></strong> for quicker
selection of common commands.</li>
<li><strong><a class="link" href="/integrations/result-cards">Result cards</a></strong>,
<strong><a class="link" href="/integrations/confirmations">confirmations</a></strong>,
<strong><a class="link" href="/integrations/setup-fields">setup fields</a></strong> — native UI, the easy way.</li>
<li><strong><a class="link" href="/integrations/widgets">Custom widgets</a></strong> and the
<strong><a class="link" href="/integrations/widget-kit">Widget Kit</a></strong> — pixel-level control.</li>
<li><strong><a class="link" href="/integrations/branding">Branding</a></strong>, <strong><a class="link" href="/integrations/testing">testing</a></strong>,
<strong><a class="link" href="/integrations/distribution">sharing</a></strong> — ship it.</li>
<li><strong><a class="link" href="/integrations/reference/manifest">Reference</a></strong> — every field, block, cap,
and bridge message.</li>
</ol>
<div role="note" aria-label="Note" class="callout my-4 px-5 py-4 overflow-hidden rounded-2xl flex gap-3 border border-blue-200 bg-blue-50 dark:border-blue-900 dark:bg-blue-600/20" data-callout-type="note"><div class="mt-0.5 w-4" data-component-part="callout-icon"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="size-4 text-blue-800 dark:text-blue-300"><path d="M 9 1.6714 C 13.0371 1.6714 16.3286 4.9629 16.3286 9 C 16.3286 13.0371 13.0371 16.3286 9 16.3286 C 7.0574 16.3252 5.1953 15.552 3.8217 14.1783 C 2.448 12.8047 1.6748 10.9426 1.6714 9 C 1.6714 4.9629 4.9629 1.6714 9 1.6714 Z M 9 0 C 4.0371 0 0 4.0371 0 9 C 0 13.9629 4.0371 18 9 18 C 13.9629 18 18 13.9629 18 9 C 18 4.0371 13.9629 0 9 0 Z M 10.2857 3.8571 H 7.7143 V 10.2857 H 10.2857 V 3.8571 Z M 10.2857 11.5714 H 7.7143 V 14.1429 H 10.2857 V 11.5714 Z" fill="currentColor" stroke="none" fill-rule="evenodd" clip-rule="evenodd"></path></svg></div><div class="text-sm prose dark:prose-invert min-w-0 w-full [&amp;_kbd]:bg-background-light dark:[&amp;_kbd]:bg-background-dark [&amp;_code]:text-current! [&amp;_kbd]:text-current! [&amp;_a]:text-current! [&amp;_a]:border-current [&amp;_strong]:text-current! text-blue-800 dark:text-blue-300" data-component-part="callout-content"><span data-as="p">The Integration SDK is in developer preview. The folder contract — manifest,
