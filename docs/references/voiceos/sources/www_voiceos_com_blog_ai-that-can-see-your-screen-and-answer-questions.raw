ions\":{\"domain\":\".voiceos.com\"}}],[\"$\",\"$8\",null,{\"fallback\":null,\"children\":[[\"$\",\"$L15\",null,{}],[\"$\",\"$L16\",null,{}],[\"$\",\"$L17\",null,{}],[\"$\",\"$L18\",null,{}]]}],\"$L19\"]}]}]}]]}]\n1a:T5d1,{\"@context\":\"https://schema.org\",\"@type\":\"BlogPosting\",\"headline\":\"AI That Can See Your Screen and Answer Questions (2026)\",\"description\":\"Looking for an AI that reads your screen and answers questions? VoiceOS can look at what is on your Mac or Windows screen when you ask, understand the page, message, form, or app in front of you, and answer by voice. You can even point or draw with your mouse cursor to show it exactly what you mean.\",\"image\":\"https://www.voiceos.com/blogs/ai-that-can-see-your-screen-2026.jpg\",\"datePublished\":\"2026-08-30T07:30:00.000Z\",\"dateModified\":\"2026-08-30T07:30:00.000Z\",\"inLanguage\":\"en\",\"author\":{\"@type\":\"Person\",\"name\":\"Jonah Daian\",\"@id\":\"https://www.voiceos.com/authors/jonah-daian#person\",\"url\":\"https://www.voiceos.com/authors/jonah-daian\"},\"publisher\":{\"@type\":\"Organization\",\"name\":\"WakoAI Inc.\",\"url\":\"https://www.voiceos.com\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://www.voiceos.com/voiceOsLogo.png\"}},\"mainEntityOfPage\":{\"@type\":\"WebPage\",\"@id\":\"https://www.voiceos.com/blog/ai-that-can-see-your-screen-and-answer-questions\"},\"breadcrumb\":{\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://www.voiceos.com/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Blog\",\"item\":\"https://www.voiceos.com/blog\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"AI That Can See Your Screen and Answer Questions (2026)\",\"item\":\"https://www.voiceos.com/blog/ai-that-can-see-your-screen-and-answer-questions\"}]}}1b:Tf7c,{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"What is an AI that reads your screen?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"An AI that reads your screen is a screen-aware, multimodal assistant that uses the visible screen as context. It can recognize text, app layouts, charts, buttons, images, and error messages, then answer questions about what it sees. VoiceOS brings that capability to Mac and Windows and lets you ask by voice instead of uploading screenshots to a separate chat.\"}},{\"@type\":\"Question\",\"name\":\"Is there an AI that can see my screen and answer questions?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes. VoiceOS can see your current screen and answer questions about it on Mac and Windows. Turn on “Point and ask about your screen,” hold the Agent Mode trigger, and ask about whatever is visible. It is an AI that sees your screen and answers questions based on the real page, app, chart, document, or error in front of you.\"}},{\"@type\":\"Question\",\"name\":\"How is this different from a chatbot like ChatGPT?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"A standard chatbot lives in its own window and only knows what you type into it, so to get help you have to describe your screen in words. A screen-aware voice assistant closes that gap. It can see your screen with your permission, so it already knows the context, and it works system-wide across your apps instead of inside a single tab. You talk, it looks, it helps, with no copy-pasting and no explaining.\"}},{\"@type\":\"Question\",\"name\":\"What can an AI that scans your screen do?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Common uses include learning unfamiliar software without watching a tutorial, getting un-stuck the instant you cannot find a setting, understanding dense dashboards or documents, decoding confusing error messages, and turning \\\"how do I do this?\\\" into an action the assistant performs for you. With VoiceOS you can also dictate and edit text by voice and run multi-step tasks across apps like Gmail, Slack, and Google Calendar.\"}},{\"@type\":\"Question\",\"name\":\"Is it always watching my screen? What about privacy?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"No. A well-designed screen-aware assistant should look only when you ask it to, not record continuously. VoiceOS looks at your screen on demand, when you invoke it, rather than constantly capturing in the background, and it asks for confirmation before taking important actions. You stay in control of when it sees your screen and what happens next.\"}},{\"@type\":\"Question\",\"name\":\"What is the best screen-aware voice assistant for Mac and Windows in 2026?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"VoiceOS is one of the best options in 2026 because it is built for regular people, not just developers. It works system-wide on both Mac and Windows, understands natural language, sees your screen when you ask, and needs no setup, API keys, or coding. Backed by Y Combinator, it combines screen-aware questions, dictation, voice editing, and agent actions in a single app you can start using in minutes.\"}},{\"@type\":\"Question\",\"name\":\"Do I need to be technical to use one?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"No. VoiceOS is designed for everyone, especially people who are new to AI. There is no code to write and no configuration to learn. You download it, grant permission, and start talking to your computer about whatever is on your screen.\"}},{\"@type\":\"Question\",\"name\":\"Can the assistant understand what I am pointing at with my cursor?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes. With “Point and ask about your screen” enabled, hold your Agent Mode trigger and move the mouse cursor while you speak. VoiceOS draws a blue trail, so you can point to one item or circle a region and ask about “this” or “that.” The marked screen and your words are read together, which is often much faster than describing the location.\"}}]}6:[\"$\",\"main\",null,{\"className\":\"min-h-screen\",\"style\":{\"backgroundColor\":\"#F9F9F9\"},\"children\":[[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"$1a\"}}],[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"$1b\"}}],\"$L1c\",\"$L1d\",\"$L1e\"]}]\n1f:I[13826,[\"/_next/static/chunks/2kb52na2e7ces.js\",\"/_next/static/chunks/1xfsu92iq1h9m.js\",\"/_next/static/chunks/3x6-_ejf1r1x0.js\",\"/_next/static/chunks/0z6qqa_pcb2c9.js\",\"/_next/static/chunks/35rx1_qn9m74v.js\",\"/_next/static/chunks/3sng1v3_18lsq.js\"],\"default\"]\n20:I[21834,[\"/_next/static/chunks/2kb52na2e7ces.js\",\"/_next/static/chunks/1xfsu92iq1h9m.js\",\"/_next/static/chunks/3x6-_ejf1r1x0.js\",\"/_next/static/chunks/0z6qqa_pcb2c9.js\",\"/_next/static/chunks/35rx1_qn9m74v.js\",\"/_next/static/chunks/3sng1v3_18lsq.js\"],\"default\"]\n22:I[5500,[\"/_next/static/chunks/2kb52na2e7ces.js\",\"/_next/static/chunks/1xfsu92iq1h9m.js\",\"/_next/static/chunks/3x6-_ejf1r1x0.js\",\"/_next/static/chunks/0z6qqa_pcb2c9.js\",\"/_next/static/chunks/35rx1_qn9m74v.js\",\"/_next/static/chunks/3sng1v3_18lsq.js\"],\"Image\"]\n32:I[40163,[\"/_next/static/chunks/2kb52na2e7ces.js\",\"/_next/static/chunks/1xfsu92iq1h9m.js\",\"/_next/static/chunks/3x6-_ejf1r1x0.js\",\"/_next/static/chunks/0z6qqa_pcb2c9.js\",\"/_next/static/chunks/35rx1_qn9m74v.js\",\"/_next/static/chunks/3sng1v3_18lsq.js\"],\"default\"]\n33:I[75696,[\"/_next/static/chunks/2kb52na2e7ces.js\",\"/_next/static/chunks/1xfsu92iq1h9m.js\",\"/_next/static/chunks/3x6-_ejf1r1x0.js\"],\"default\"]\n1c:[\"$\",\"$L1f\",null,{}]\n1d:[\"$\",\"div\",null,{\"className\":\"px-4 md:px-6 pt-32 md:pt-44 pb-16 md:pb-24\",\"children\":[\"$\",\"div\",null,{\"className\":\"max-w-7xl mx-auto\",\"children\":[[\"$\",\"div\",null,{\"className\":\"lg:grid lg:gap-10 lg:[grid-template-columns:220px_minmax(0,1fr)_60px]\",\"children\":[[\"$\",\"aside\",null,{\"className\":\"hidden lg:block\",\"children\":[\"$\",\"div\",null,{\"className\":\"sticky top-32\",\"children\":[\"$\",\"div\",null,{\"className\":\"rounded-xl p-5\",\"style\":{\"backgroundColor\":\"#fff\",\"border\":\"1px solid #eee\"},\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center gap-2 mb-4\",\"children\":[[\"$\",\"svg\",null,{\"className\":\"w-4 h-4\",\"style\":{\"color\":\"#666\"},\"fill\":\"none\",\"stroke\":\"currentColor\",\"viewBox\":\"0 0 24 24\",\"children\":[[\"$\",\"circle\",null,{\"cx\":\"12\",\"cy\":\"12\",\"r\":\"10\",\"strokeWidth\":\"1.5\"}],[\"$\",\"path\",null,{\"strokeLinecap\":\"round\",\"strokeWidth\":\"1.5\",\"d\":\"M12 6v6l4 2\"}]]}],[\"$\",\"span\",null,{\"className\":\"text-sm\",\"style\":{\"color\":\"#666\"},\"children\":\"10 min read\"}]]}],[\"$\",\"p\",null,{\"className\":\"text-sm font-semibold mb-3\",\"style\":{\"color\":\"#0a0a0a\"},\"children\":\"Table of contents\"}],[\"$\",\"$L20\",null,{\"sections\":[{\"id\":\"quick-answer\",\"label\":\"Is there an AI that can see my screen and answer questions?\"},{\"id\":\"key-takeaways\",\"label\":\"Key Takeaways\"},{\"id\":\"the-problem\",\"label\":\"\\\"How do I do this?\\\" is where work goes to die\"},{\"id\":\"what-it-is\",\"label\":\"How an AI reads your screen and answers questions\"},{\"id\":\"why-now\",\"label\":\"How AI can scan your screen and understand it\"},{\"id\":\"what-changes\",\"label\":\"What changes when your computer can see what you see\"},{\"id\":\"meet-voiceos\",\"label\":\"Meet your screen-aware voice assistant: VoiceOS\"},{\"id\":\"point-to-understand\",\"label\":\"Use your mouse cursor to point at what you mean\"},{\"id\":\"seeing-to-doing\",\"label\":\"When seeing your screen turns into doing the work\"},{\"id\":\"how-to-start\",\"label\":\"How to start\"},{\"id\":\"faq\",\"label\":\"Frequently Asked Questions (FAQ)\"}]}]]}]}]}],[\"$\",\"div\",null,{\"children\":[\"$L21\",[\"$\",\"div\",null,{\"className\":\"mb-6\",\"children\":[\"$\",\"span\",null,{\"style\":{\"color\":\"#0f172a\",\"fontSize\":\"12px\",\"fontWeight\":600,\"letterSpacing\":\"0.14em\",\"textTransform\":\"uppercase\",\"lineHeight\":1},\"children\":\"Analysis\"}]}],[\"$\",\"h1\",null,{\"style\":{\"fontSize\":\"clamp(2rem, 6vw, 3.25rem)\",\"fontWeight\":600,\"lineHeight\":\"1.15\",\"color\":\"#0a0a0a\",\"letterSpacing\":\"-0.03em\"},\"children\":\"AI That Can See Your Screen and Answer Questions (2026)\"}],[\"$\",\"p\",null,{\"className\":\"mt-5\",\"style\":{\"fontSize\":\"clamp(1.125rem, 2.5vw, 1.375rem)\",\"fontWeight\":300,\"lineHeight\":\"1.6\",\"color\":\"#555\"},\"children\":\"Looking for an AI that reads your screen and answers questions? VoiceOS can look at what is on your Mac or Windows screen when you ask, understand the page, message, form, or app in front of you, and answer by voice. You can even point or draw with your mouse cursor to show it exactly what you mean.\"}],[\"$\",\"div\",null,{\"className\":\"flex items-center gap-5 mt-8 pb-8\",\"style\":{\"borderBottom\":\"1px solid #eee\"},\"children\":[[\"$\",\"$L22\",null,{\"src\":\"/jonahBlogProfile.png\",\"alt\":\"Jonah Daian\",\"width\":40,\"height\":40,\"className\":\"rounded-full flex-shrink-0\",\"style\":{\"objectFit\":\"cover\"}}],[\"$\",\"div\",null,{\"className\":\"flex items-center gap-6\",\"children\":[[\"$\",\"div\",null,{\"children\":[[\"$\",\"p\",null,{\"className\":\"text-xs\",\"style\":{\"color\":\"#999\",\"marginBottom\":\"2px\"},\"children\":\"Written by\"}],[\"$\",\"p\",null,{\"className\":\"text-sm font-semibold\",\"style\":{\"color\":\"#0a0a0a\"},\"children\":\"Jonah Daian\"}]]}],[\"$\",\"div\",null,{\"style\":{\"borderLeft\":\"1px solid #e5e5e5\",\"paddingLeft\":\"24px\"},\"children\":[[\"$\",\"p\",null,{\"className\":\"text-xs\",\"style\":{\"color\":\"#999\",\"marginBottom\":\"2px\"},\"children\":\"Last updated\"}],[\"$\",\"p\",null,{\"className\":\"text-sm font-semibold\",\"style\":{\"color\":\"#0a0a0a\"},\"children\":\"August 30, 2026\"}]]}]]}]]}],[\"$\",\"$L22\",null,{\"src\":\"/blogs/ai-that-can-see-your-screen-2026.jpg\",\"alt\":\"AI That Can See Your Screen and Answer Questions (2026)\",\"width\":1200,\"height\":630,\"className\":\"w-full mt-8\",\"style\":{\"objectFit\":\"cover\",\"borderRadius\":\"16px\"},\"priority\":true}],[\"$\",\"article\",null,{\"className\":\"mt-12\",\"children\":[[\"$\",\"section\",null,{\"className\":\"mb-10\",\"id\":\"quick-answer\",\"children\":[\"$\",\"div\",null,{\"className\":\"comparison-answer-glass p-6 md:p-8\",\"style\":{\"borderRadius\":\"22px\"},\"children\":[[\"$\",\"h2\",null,{\"style\":{\"fontSize\":\"clamp(1.5rem, 4vw, 2rem)\",\"fontWeight\":500,\"lineHeight\":\"1.3\",\"color\":\"#0a0a0a\",\"letterSpacing\":\"-0.02em\",\"marginBottom\":\"0.75rem\"},\"children\":\"Is there an AI that can see my screen and answer questions?\"}],\"$L23\",\"$L24\"]}]}],\"$L25\",\"$L26\",\"$L27\",\"$L28\",\"$L29\",\"$L2a\",\"$L2b\",\"$L2c\",\"$L2d\",\"$L2e\",\"$L2f\"]}]]}],\"$L30\"]}],\"$L31\"]}]}]\n1e:[\"$\",\"$L32\",null,{}]\n3:[\"$\",\"$L33\",null,{\"formats\":\"$undefined\",\"locale\":\"en\",\"messages\":{\"CTA\":{\"ctaPrefix\":\"Press\",\"ctaSuffix\":\"and start speaking.\",\"subheading\":\"Let \u003cbold\u003eyour voice\u003c/bold\u003e do the \u003cbold\u003ework\u003c/bold\u003e.\",\"downloadForMac\":\"Download for Mac\",\"downloadForWindows\":\"Download for Windows\"},\"MobilePage\":{\"title\":\"Mobile is coming soon\",\"metaDescription\":\"VoiceOS is on Mac and Windows today. Join the waitlist to get notified when VoiceOS launches on mobile.\",\"description\":\"VoiceOS is currently available on \u003cstrong\u003eMac\u003c/strong\u003e and \u003cstrong\u003eWindows\u003c/strong\u003e.\",\"notify\":\"Get notified when we launch on mobile.\",\"placeholder\":\"Enter your email\",\"submitButton\":\"Join Waitlist\",\"processing\":\"Processing...\",\"joined\":\"Joined!\",\"successTitle\":\"You're on the list!\",\"successBody\":\"We sent Mac and Windows download links to your inbox. You're still on the mobile waitlist, too.\",\"invalidEmail\":\"Please enter a valid email.\",\"emailSendError\":\"You're on the mobile waitlist, but we couldn't send the desktop download links. Please try again.\",\"backToHome\":\"Back to home\"},\"DictationPage\":{\"metaTitle\":\"Voice Dictation for Mac and Windows - VoiceOS\",\"metaDescription\":\"Talk anywhere you would otherwise type. VoiceOS turns speech into clean, formatted writing in any app, in 100 languages, without the filler words or typos.\",\"title\":\"Talk instead of \u003caccent\u003etyping\u003c/accent\u003e\",\"subtitle\":\"VoiceOS turns what you say into finished writing, in whatever app your cursor is already in.\",\"chip\":\"Mac and Windows\",\"speedTitle\":\"\u003caccent\u003e4x faster\u003c/accent\u003e than typing\",\"speedSubtitle\":\"Most people type around 55 words a minute. Speaking runs closer to 220, and VoiceOS keeps up with every word.\",\"editsTitle\":\"Say it messy, \u003caccent\u003eit lands clean\u003c/accent\u003e\",\"editsSubtitle\":\"Speak the way you actually think. VoiceOS drops the filler, fixes the spelling, learns the names you use, and writes down what you meant.\",\"toneTitle\":\"It writes to fit \u003caccent\u003ewhere it lands\u003c/accent\u003e\",\"toneSubtitle\":\"Say it once. VoiceOS reads the app your cursor is in and writes to match, so the same thought arrives as a proper email, a quick text, or a clean list of notes.\",\"toneMailGreeting\":\"Hi John,\",\"toneMailBody\":\"I'll send the deck over tonight.\",\"toneMailClosing\":\"Best,\",\"toneMailName\":\"Steve\",\"toneMessagesText\":\"sending the deck tonight\",\"toneNotionTitle\":\"Today\",\"toneNotionItem1\":\"Send John the deck tonight\",\"toneNotionItem2\":\"Add the Q3 numbers to slide four\",\"toneNotionItem3\":\"Ask Priya for the revenue chart\",\"langTitle\":\"Speak the language you \u003caccent\u003ethink in\u003c/accent\u003e\",\"langSubtitle\":\"Over 100 languages. Nothing to switch, nothing to set.\",\"spellTitle\":\"It spells them \u003caccent\u003eyour way\u003c/accent\u003e\",\"spellSubtitle\":\"Names, products, acronyms. Say them however they come out and VoiceOS writes them the way you write them.\",\"spellSaid1\":\"“wako AI”\",\"spellWrote1\":\"WakoAI\",\"spellSaid2\":\"“super base”\",\"spellWrote2\":\"Supabase\",\"spellSaid3\":\"“kuber netties”\",\"spellWrote3\":\"Kubernetes\",\"spellSaid4\":\"“oh kay ars”\",\"spellWrote4\":\"OKRs\"},\"AgentMode\":{\"title\":\"Voice + Agent Mode\",\"subtitle\":\"Ask VoiceOS and let it do it for you\",\"whatYouSee\":\"WHAT YOU SEE\",\"whatAgentDoes\":\"WHAT AGENT DOES\",\"senderName\":\"John Doe\",\"senderSubject\":\"Project Sync Meeting\",\"emailBody\":\"Hey, just checking if you're still free to meet tomorrow at 2pm? We need to go over the Q3 roadmap.\",\"voiceInstruction\":\"\\\"Reply saying I can't go\\\"\",\"draftCreated\":\"Draft Created\",\"draftGreeting\":\"Hi John,\",\"draftBody\":\"I won't be able to make it tomorrow at 2pm. Can we reschedule?\",\"instant\":\"Instant\",\"accurate\":\"Accurate\",\"useAgentModeTo\":\"Use Agent Mode to...\",\"exampleReschedule\":\"\\\"Politely reschedule the meeting\\\"\",\"exampleProfessional\":\"\\\"Make this more professional\\\"\",\"exampleThankYou\":\"\\\"Write a thank you email\\\"\",\"exampleFixGrammar\":\"\\\"Fix grammar and shorten this\\\"\",\"andMore\":\"\u0026 much more\"},\"PricingPage\":{\"metaTitle\":\"Pricing - VoiceOS\",\"metaDescription\":\"VoiceOS pricing. Start with a 7-day free trial of Pro. Unlimited dictation and Agent Mode on Mac and Windows. Cancel anytime.\",\"compareTitle\":\"Compare plans\",\"compareSubtitle\":\"Compare the plans available to new customers.\",\"planPro\":\"Pro\",\"planEnterprise\":\"Enterprise\",\"featureColumn\":\"Feature\",\"included\":\"Included\",\"notIncluded\":\"Not included\",\"valueUnlimited\":\"Unlimited\",\"valueComingSoon\":\"Coming soon\",\"valueEnforced\":\"Enforced\",\"groupPlatforms\":\"Platforms\",\"rowMac\":\"macOS\",\"rowWindows\":\"Windows\",\"rowMobile\":\"iPhone and Android\",\"rowEveryApp\":\"Works in every app you already use\",\"groupAgent\":\"Agent Mode\",\"rowAgentUsage\":\"Agent Mode sessions\",\"rowIntegrations\":\"App integrations\",\"rowMcp\":\"Your own MCP servers\",\"rowWebSearch\":\"Web search with sources\",\"rowScreen\":\"Screen awareness\",\"rowScheduling\":\"Reminders and scheduling\",\"rowConfirm\":\"Action confirmation\",\"groupDictation\":\"Dictation Mode\",\"rowDictationUsage\":\"Dictation sessions\",\"rowLanguages\":\"Languages\",\"value100Languages\":\"100 languages\",\"rowStyles\":\"Polish styles\",\"rowVocabulary\":\"Custom vocabulary and replacements\",\"rowEditText\":\"Edit selected text by voice\",\"groupPrivacy\":\"Privacy and security\",\"rowPrivateMode\":\"Private Mode\",\"rowLocalTranscripts\":\"Transcripts stored on your device\",\"rowSso\":\"SSO / SAML\",\"faqTitle\":\"Frequently asked questions\",\"faqQ1\":\"Is there a free trial?\",\"faqA1\":\"Yes. Every new account starts with a \u003cb\u003e7-day free trial of Pro\u003c/b\u003e. A card is required at checkout, and you can cancel any time before the trial ends. One trial per email address.\",\"faqQ2\":\"What happens when the trial ends?\",\"faqA2\":\"Your plan starts automatically on the billing cycle you chose at checkout, monthly or annual, at the price shown there. When the trial begins we email you \u003cb\u003ethe date and the amount\u003c/b\u003e of that first charge, so nothing arrives as a surprise.\",\"faqQ3\":\"Can I cancel anytime?\",\"faqA3\":\"Yes. Cancel from \u003cb\u003eSettings, then Billing\u003c/b\u003e inside the app. You keep Pro until the end of the period you have already paid for.\",\"faqQ4\":\"What happens to my account if I cancel?\",\"faqA4\":\"After cancellation, when your paid Pro period ends, existing accounts have limited access: 100 dictation sessions and 25 Agent Mode sessions per week. This is not a plan available at sign-up.\",\"faqQ5\":\"Do you offer discounts?\",\"faqA5\":\"Students get \u003cb\u003e50% off Pro while enrolled\u003c/b\u003e, and we re-check enrollment once a year. Builders shipping their own VoiceOS integrations can apply for \u003cb\u003e50% off Pro\u003c/b\u003e. Both are short application forms that we read by hand.\",\"faqQ6\":\"What is the difference between monthly and annual?\",\"faqA6\":\"Annual is billed once a year and works out to \u003cb\u003e60% less per month\u003c/b\u003e than paying monthly. The prices on the cards above update to your region automatically.\",\"faqQ7\":\"Which platforms does VoiceOS run on?\",\"faqA7\":\"\u003cb\u003eMac and Windows\u003c/b\u003e today. Mobile is on the way and you can join the waitlist from the mobile page.\",\"faqQ8\":\"Do you have plans for teams?\",\"faqA8\":\"VoiceOS offers Enterprise for teams. Contact us to confirm available administration, retention, and identity-provider requirements in your agreement.\",\"freeNote\":\"After cancellation, when your paid Pro period ends, existing accounts have limited access: 100 dictation sessions and 25 Agent Mode sessions per week. This is not a plan available at sign-up.\",\"signupNote\":\"New customers start with a 7-day free trial of Pro or contact us about Enterprise. A card is required. One trial per email address.\",\"afterCancellationTitle\":\"After Pro ends\",\"valueContactSales\":\"Contact sales\",\"valuePerAction\":\"Varies by action\"},\"Dictation\":{\"dictationMode\":\"Dictation Mode\",\"dictationDescription\":\"Writes \u003cbold\u003ewhat you meant\u003c/bold\u003e, not what you said.\",\"youSay\":\"You say\",\"voiceosWrites\":\"VoiceOS writes\",\"dictationInput\":\"\\\"Can you send me that form by today... I mean tomorrow?\\\"\",\"dictationOutput\":\"Can you send me that form by tomorrow?\",\"askMode\":\"Agent Mode\",\"askYouSay\":\"You say\",\"askDescription\":\"Ask VoiceOS and let it \u003cbold\u003ewrite for you\u003c/bold\u003e.\",\"askInput\":\"\\\"Reply I can't but ask to reschedule\\\"\",\"askOutputGreeting\":\"Hi John,\",\"askOutputBody\":\"I won't be able to make it tomorrow at 2pm. Can we reschedule?\",\"askOutputClosing\":\"Best,\",\"askOutputName\":\"Steve\"},\"Style\":{\"soundsLikeYouTitle\":\"Sounds \u003cbold\u003eJust Like You\u003c/bold\u003e\",\"soundsLikeYouDescription\":\"VoiceOS \u003cbold\u003eadapts\u003c/bold\u003e to match how you \u003cbold\u003enaturally communicate\u003c/bold\u003e\",\"youSay\":\"You say\",\"voiceosWrites\":\"VoiceOS writes\",\"inputThanks\":\"\\\"thanks\\\"\",\"outputMail\":\"Thanks.\",\"outputSlack\":\"Thanks!\",\"outputMessages\":\"thanks\",\"smartFormatsTitle\":\"\u003cbold\u003eSmart\u003c/bold\u003e Formats\",\"smartFormatsDescription\":\"VoiceOS \u003cbold\u003eautomatically formats\u003c/bold\u003e based on \u003cbold\u003econtext\u003c/bold\u003e\",\"smartFormatsInput\":\"\\\"Reply with demo link\\\"\",\"dictationDemoAutoFormatsTitle\":\"Auto \u003cbold\u003eFormats\u003c/bold\u003e\",\"dictationDemoAutoFormatsSubtitle\":\"Your words, perfectly structured\",\"emailGreeting\":\"Hey John,\",\"emailSubGreeting\":\"\",\"emailBody\":\"Thanks for your interest! Here's the demo video: \",\"emailDemoLink\":\"demo video\",\"emailFollowUp\":\"Let me know if you have any questions.\",\"emailPreClosing\":\"\",\"emailClosing\":\"Best,\",\"emailName\":\"Steve\"},\"AgentPage\":{\"metaTitle\":\"AI Voice Agent for Mac and Windows - VoiceOS\",\"metaDescription\":\"Say what you want done and VoiceOS does it across your apps. Send messages, book time, search the web, and connect MCP servers—with confirmation before it acts.\",\"title\":\"Say it, and it \u003caccent\u003egets done\u003c/accent\u003e\",\"subtitle\":\"Agent Mode goes and does the thing. It works inside the apps you already use, and it shows you a confirmation before anything sends.\",\"chip\":\"Mac and Windows\",\"speedSubtitle\":\"The moment you think of it, just say it. VoiceOS takes care of it, without you opening another app.\",\"videoLabel\":\"The VoiceOS Agent Mode film\",\"videoPlay\":\"Play the film\",\"appsTitle\":\"It works \u003caccent\u003ewith your favorite apps\u003c/accent\u003e\",\"appsSubtitle\":\"Say it once and the reply is sent, the event is scheduled, without you opening a single app.\",\"appsPickLabel\":\"Pick an app\",\"sceneSlack\":\"Replies in the thread\",\"sceneGmail\":\"Writes the email and sends it\",\"sceneGcal\":\"Puts it on the calendar\",\"sceneNotion\":\"Adds it to the page\",\"sceneLinear\":\"Files the issue\",\"sceneWeather\":\"Looks it up on the web\",\"confirmTitle\":\"Nothing sends until \u003caccent\u003eyou say so\u003c/accent\u003e\",\"confirmSubtitle\":\"Anything that sends, books, or changes something stops and shows you what it will do. Fix it or let it go.\",\"reachTitle\":\"Plug in \u003caccent\u003eanything you use\u003c/accent\u003e\",\"reachSubtitle\":\"Turn on Slack, Gmail, Notion, Linear and the rest in Settings. After that, just ask out loud and VoiceOS uses them for you. Built your own tool? It can use that too.\",\"reachMcpTitle\":\"Your own MCP server\",\"reachMcpBody\":\"Every tool on it, by voice\",\"reachMcpCmd\":\"voiceos add mcp\",\"bgTitle\":\"Say it and \u003caccent\u003econsider it done\u003c/accent\u003e\",\"bgSubtitle\":\"Long tasks keep running at the side of your screen. The answer comes back on its own.\",\"bgSearch\":\"Search\",\"bgToday\":\"Today, 2:14 PM\",\"bgYesterday\":\"Yesterday, 5:40 PM\",\"bgTask1\":\"Compare flights to Osaka\",\"bgTask2\":\"Summarize the Q3 doc\",\"bgTask3\":\"Draft the recap email\",\"bgTask4\":\"Rename the files on my desktop\",\"bgTask5\":\"Add dinner Thursday to my calendar\",\"bgTask6\":\"Find the Figma invoice\",\"bgTask7\":\"Send Kai the launch notes\",\"bgTask8\":\"Pull the numbers from the Notion doc\",\"bgTask9\":\"Check what is on my calendar tomorrow\",\"bgTask10\":\"Remind me to renew the domain\",\"bgDocTitle\":\"Osaka offsite\",\"bgDocP1\":\"We land Thursday morning, so the team dinner has to be that evening. Kenji offered to book the izakaya near the station.\",\"bgDocP2\":\"Friday is the workshop. Two sessions before lunch, then the demo, then we let people go early.\",\"bgDocP3\":\"Saturday is open. A few people want to stay on, so I will keep the group booking flexible until Wednesday.\",\"bgDocP4\":\"I will lock the hotel in once the flights are\",\"bgWorking\":\"Working in the background\",\"bgNew\":\"New response\"},\"Quote\":{\"text\":\"“Speech is the ultimate natural user interface.”\",\"author\":\"Steve Jobs\"},\"PriceValue\":{\"title\":\"For just \u003cprice\u003e{amount}\u003c/price\u003e a day\",\"subtitle\":\"That is 10x your productivity, for less than a cup of coffee a week.\"},\"Footer\":{\"copyright\":\"Copyright © 2026 WakoAI, Inc. All Rights Reserved.\",\"termsOfService\":\"Terms of Use\",\"privacyPolicy\":\"Privacy Policy\",\"security\":\"Security\",\"affiliatePolicy\":\"Affiliate Policy\",\"contact\":\"Contact\",\"affiliates\":\"Affiliates\",\"product\":\"Product\",\"company\":\"Company\",\"compare\":\"Compare\",\"allComparisons\":\"All comparisons\",\"resources\":\"Resources\",\"legal\":\"Legal\",\"pricing\":\"Pricing\",\"blog\":\"Blog\",\"about\":\"About\",\"team\":\"Team\",\"manifesto\":\"Manifesto\",\"agentMode\":\"Agent Mode\",\"dictationMode\":\"Dictation Mode\",\"appStore\":\"App Store\",\"features\":\"All features\",\"glossary\":\"Voice glossary\",\"changelog\":\"Changelog\",\"documentation\":\"Documentation\"},\"Navbar\":{\"pricing\":\"Pricing\",\"product\":\"Product\",\"features\":\"Features\",\"agentMode\":\"Agent Mode\",\"dictationMode\":\"Dictation Mode\",\"productPricingDesc\":\"Plans, trial, and discounts\",\"productFeaturesDesc\":\"Everything VoiceOS can do\",\"productAgentDesc\":\"Say it, and it gets done\",\"productDictationDesc\":\"Talk instead of typing\",\"blog\":\"Blogs\",\"about\":\"About\",\"team\":\"Team\",\"manifesto\":\"Manifesto\",\"affiliates\":\"Affiliates\",\"download\":\"Download\",\"downloadForMac\":\"Download for Mac\",\"downloadForWindows\":\"Download for Windows\",\"appStore\":\"App Store\"},\"Students\":{\"metaTitle\":\"VoiceOS for Students | 50% off Pro\",\"metaDescription\":\"Verify you're enrolled and keep 50% off Pro for as long as you're a student.\",\"title\":\"VoiceOS for \u003caccent\u003estudents\u003c/accent\u003e\",\"subtitle\":\"Verify you're enrolled. Keep the discount until you graduate.\",\"offerChip\":\"50% off Pro while you're enrolled\",\"optionalLabel\":\"(optional)\",\"nameLabel\":\"Name\",\"namePlaceholder\":\"Ada Lovelace\",\"schoolEmailLabel\":\"School email\",\"schoolEmailHint\":\"(your .edu or university address)\",\"accountEmailLabel\":\"VoiceOS account email\",\"accountEmailHint\":\"(only if it's different from your school email)\",\"schoolLabel\":\"School\",\"schoolPlaceholder\":\"MIT, University of Tokyo, ...\",\"programLabel\":\"What are you studying?\",\"programPlaceholder\":\"Computer science, law, medicine, ...\",\"gradYearLabel\":\"Expected graduation\",\"gradYearPlaceholder\":\"2028\",\"proofLabel\":\"Proof of enrollment\",\"proofHint\":\"(a photo of your student ID or a screenshot of your enrollment page both work)\",\"filePrompt\":\"Upload a photo or PDF\",\"fileReplace\":\"Replace\",\"fileMissing\":\"Please add your proof of enrollment.\",\"fileTooLarge\":\"That file is over 8MB. Please pick a smaller photo or PDF.\",\"fileUnsupported\":\"That file type didn't work. A JPG, PNG, HEIC, or PDF is perfect.\",\"tooManyAttempts\":\"Too many applications from this connection. Please try again in an hour.\",\"usageLabel\":\"What will you use VoiceOS for?\",\"usagePlaceholder\":\"Lecture notes, essays, coding assignments, ...\",\"dictatedLabel\":\"Bonus points: I dictated this application.\",\"submit\":\"Apply\",\"submitting\":\"Sending...\",\"invalidEmail\":\"That email doesn't look right.\",\"errorGeneric\":\"Something went wrong. Please try again.\",\"successTitle\":\"Application received.\",\"successBody\":\"We check every one. If you're verified, the discount lands in your inbox within a few days.\",\"renewalNote\":\"We re-check enrollment once a year. The discount rides along until you graduate.\",\"backToHome\":\"Back to home\"},\"AskAI\":{\"heading\":\"Still not sure? Ask your AI.\",\"askProvider\":\"Ask {provider}\"},\"AppStore\":{\"metaTitle\":\"VoiceOS App Store — Official Integrations\",\"metaDescription\":\"Browse every official VoiceOS integration — Gmail, Slack, Notion, iMessage, and more — and see every action each one can take by voice.\",\"heroEyebrow\":\"App Store\",\"heroTitleLine1\":\"The app ecosystem\",\"heroTitleLine2\":\"powered by voice\",\"heroSubtitle\":\"Official integrations, built into VoiceOS and maintained by us. Connect the apps you live in, then just say what you want done.\",\"viewBuildGuide\":\"Read the build guide\",\"filter_all\":\"All\",\"submitEyebrow\":\"Publish on the App Store\",\"submitTitle\":\"Got an integration to share?\",\"submitSubtitle\":\"Publish your integration to the VoiceOS App Store.\",\"nameLabel\":\"Integration name\",\"namePlaceholder\":\"Integration name\",\"emailLabel\":\"Your email\",\"emailPlaceholder\":\"Your email\",\"repoLabel\":\"Link (optional)\",\"repoPlaceholder\":\"Link to the code or a demo (optional)\",\"descriptionLabel\":\"What does it do?\",\"descriptionPlaceholder\":\"What does it do? Which apps it controls, what you can say to it, and why VoiceOS users would want it.\",\"submitButton\":\"Apply to publish\",\"submitting\":\"Submitting...\",\"submitSuccessTitle\":\"Submission received\",\"submitSuccessBody\":\"Thanks for sharing your integration. We will review it and reach out if we need anything else.\",\"invalidEmail\":\"Enter a valid email address.\",\"invalidRepo\":\"That link doesn't look right — include https://\",\"requiredFields\":\"Add a name, your email, and what it does.\",\"submitError\":\"We could not submit this integration. Please try again.\",\"reviewNote\":\"Reviewed by hand before anything is listed.\",\"category_messages\":\"Messaging\",\"category_email\":\"Email\",\"category_calendar\":\"Calendar\",\"category_productivity\":\"Productivity\",\"category_noteTaking\":\"Note Taking\",\"category_media\":\"Media\",\"category_social\":\"Social\",\"badgeBeta\":\"Beta\",\"badgeMacOnly\":\"macOS only\",\"toolCountLabel\":\"{count, plural, one {# voice action} other {# voice actions}}\",\"platformMac\":\"macOS\",\"platformMacWindows\":\"macOS · Windows\",\"backToAppStore\":\"All integrations\",\"detailMetaTitle\":\"{name} voice control — {count, plural, one {# voice action} other {# voice actions}} | VoiceOS\",\"detailMetaDescription\":\"{name} by voice with VoiceOS: {summary}. Every voice action, which confirm first, and how to connect it.\",\"detailCtaButton\":\"Download VoiceOS\",\"faqEyebrow\":\"FAQ\",\"faqTitle\":\"Questions we get asked\",\"faq_apps_q\":\"Which apps can VoiceOS connect to?\",\"faq_apps_a\":\"{integrationCount} official integrations ship inside VoiceOS, covering messaging, email, calendars, productivity tools, note taking, media and social. Together they add up to {toolCount} separate voice actions. We build and maintain every one of them, so none of this rests on a third-party plugin that stops working next month.\",\"faq_slack_q\":\"How do I use Slack with my voice?\",\"faq_slack_a\":\"Connect Slack once in the VoiceOS app, then just say what you want. You can send a message, schedule one for later, search your history, find a channel or a person, open a DM, react, set a reminder, or upload a file. Say \\\"tell the design channel the build is ready\\\" and VoiceOS writes it, then shows you the message before it posts.\",\"faq_meeting_q\":\"Can I book a meeting with my voice?\",\"faq_meeting_a\":\"Yes, through Google Calendar or Apple Calendar. VoiceOS can create an event, block out a full day, move or cancel something, read your schedule back to you, and find open time before it books anything. \\\"Find thirty minutes on Thursday afternoon and put it on my calendar\\\" is one sentence instead of six clicks.\",\"faq_siri_q\":\"Is VoiceOS a good Siri alternative?\",\"faq_siri_a\":\"They are built for different jobs. Siri is strongest on phone-sized tasks and system settings. VoiceOS works inside the desktop apps you actually get work done in, with {toolCount} concrete actions across {integrationCount} of them, and it will dictate into any text field on your Mac. If you have ever asked Siri to send a Slack message or move a meeting and hit a wall, that is the gap this fills.\",\"faq_setup_q\":\"Do I have to set up each app before it works?\",\"faq_setup_a\":\"Cloud apps like Gmail, Slack, Notion and Linear ask you to sign in once and then remember it. The Apple apps go through macOS permissions instead, so you approve access the first time VoiceOS reaches for them and never again.\",\"faq_windows_q\":\"Do all of these work on Windows?\",\"faq_windows_a\":\"Not all of them. {macOnlyCount} are macOS only, because they drive native Apple apps such as iMessage, Apple Mail, Reminders, Notes and Finder. The cloud integrations run on both, including Gmail, Slack, Notion, Jira, Linear and Google Drive. Every listing on this page says which.\",\"faq_confirm_q\":\"Will it send things without asking me first?\",\"faq_confirm_a\":\"Most actions that write something stop and confirm. Posting to Slack or uploading a file shows you what is about to happen first. Reading and searching simply answer you. A few integrations where confirming every time would only get in the way, like Spotify and Google Maps, act straight away. Each integration page marks exactly which of its actions ask first.\",\"faq_missing_q\":\"What if the app I use is not listed?\",\"faq_missing_a\":\"You can still wire it up yourself. VoiceOS speaks MCP, so any MCP server you point it at becomes a set of voice actions, and the build guide walks through it. If you would rather we ship it as an official integration, there is a form at the bottom of this page.\",\"factsVersion\":\"Version\",\"factsVersionCaption\":\"Built in\",\"factsDeveloper\":\"Developer\",\"factsDeveloperCaption\":\"First-party\",\"factsTools\":\"Tools\",\"factsToolsCaption\":\"voice actions\",\"factsCategory\":\"Category\",\"factsPlatforms\":\"Platforms\",\"samplesTitle\":\"Try saying\",\"setupTitle\":\"Getting started\",\"step1Title\":\"Download VoiceOS\",\"step1Body\":\"Free to start, on Mac and Windows.\",\"step2Title\":\"Connect {name}\",\"step2Body\":\"One click in the dashboard's Integrations tab.\",\"step3Title\":\"Just say it\",\"step3Body\":\"Speak — VoiceOS does the rest.\",\"connectionCloudNote\":\"Connects to your {name} account — you sign in with {name} in your browser, and VoiceOS never sees your password.\",\"connectionNativeNote\":\"Runs locally on your Mac — nothing to sign into, and your data stays on your device.\",\"permissionFullDisk\":\"macOS will ask for Full Disk Access when you connect — it's how VoiceOS reads your messages on this Mac.\",\"permissionAutomation\":\"macOS will ask permission for VoiceOS to control Spotify the first time you use it.\",\"canvasSetupNote\":\"Canvas needs an access token from your school account — VoiceOS walks you through creating one when you connect.\",\"jiraWorkspaceNote\":\"Your connection is bound to one Atlassian workspace, shown on the integration card so you always know where actions run.\",\"confirmationBody\":\"VoiceOS asks you to confirm before it sends, changes, or deletes anything — every action marked “Asks first” below.\",\"noConfirmationBody\":\"These actions are safe and easy to undo, so VoiceOS runs them right away — no confirmation needed.\",\"toolsTitle\":\"What it can do\",\"toolsSubtitle\":\"What Agent Mode can do with this integration.\",\"asksFirst\":\"Asks first\",\"asksFirstHint\":\"VoiceOS confirms with you before this runs.\",\"relatedTitle\":\"More from the App Store\"},\"ProductHuntBanner\":{\"message\":\"We're live on Product Hunt!\",\"cta\":\"Support us\",\"dismiss\":\"Dismiss\"},\"AppActions\":{\"struckTitle\":\"Speech-to-text\",\"title\":\"Voice-to-action\",\"subtitle\":\"Send the email, file the ticket, schedule the meeting. Say it once and VoiceOS does it in the right app.\",\"email\":\"Send an email\",\"slack\":\"Reply to Maya\",\"calendar\":\"Schedule a meeting\",\"finder\":\"Find that PDF\",\"notion\":\"Take a note\",\"imessage\":\"Text Mom\",\"linear\":\"File a bug\",\"chrome\":\"Search the web\",\"drive\":\"Open the roadmap\",\"docs\":\"Draft a proposal\",\"obsidian\":\"Add a daily note\"},\"StopScreenshots\":{\"caption\":\"Can you find his LinkedIn\",\"title\":\"Point anywhere on your screen.\",\"subtitle\":\"Stop taking screenshots. VoiceOS sees what your cursor is on and answers instantly. No copy-paste.\"},\"StopLooking\":{\"caption\":\"Search for last year's tax returns\",\"title\":\"Stop looking for {item}\",\"itemFile\":\"that file\",\"itemEmail\":\"that email\",\"itemDoc\":\"that doc\",\"itemNote\":\"that note\",\"subtitle\":\"You know exactly what you're looking for. You just don't know where it is. Ask, and VoiceOS pulls it up in seconds.\"},\"ProductivityGraph\":{\"title\":\"Not just another dictation app\",\"subtitle\":\"Dictation only speeds up your typing. VoiceOS multiplies your productivity.\",\"axisLabel\":\"Productivity\",\"crestLabel\":\"your productivity\",\"seriesTyping\":\"Typing\",\"seriesDictation\":\"Dictation\",\"seriesVoiceos\":\"VoiceOS\",\"tableCaption\":\"Relative productivity of typing, dictation, and VoiceOS\"},\"Builders\":{\"metaTitle\":\"VoiceOS for Builders | 50% off Pro\",\"metaDescription\":\"Show us what you're building with VoiceOS and get 50% off Pro for your first 3 months.\",\"title\":\"VoiceOS for \u003caccent\u003ebuilders\u003c/accent\u003e\",\"subtitle\":\"Show us what you're building with VoiceOS.\",\"offerChip\":\"50% off Pro for your first 3 months\",\"optionalLabel\":\"(optional)\",\"nameLabel\":\"Name\",\"namePlaceholder\":\"Ada Lovelace\",\"emailLabel\":\"Email\",\"emailHint\":\"(the one on your VoiceOS account)\",\"workflowLabel\":\"What workflow are you building with VoiceOS?\",\"workflowPlaceholder\":\"Dictating specs into Linear, triaging email by voice, voice-driving your editor...\",\"integrationsLabel\":\"Integrations you've made\",\"integrationsPlaceholder\":\"Notion, Spotify, your own MCP server...\",\"integrationsNextLabel\":\"Integrations you want next\",\"integrationsNextPlaceholder\":\"The tools you wish VoiceOS could drive...\",\"linkLabel\":\"Show us. One link.\",\"linkHint\":\"(a 60 second screen recording of your workflow is the fastest way to a yes)\",\"linkPlaceholder\":\"https://\",\"dictatedLabel\":\"Bonus points: I dictated this application.\",\"submit\":\"Apply\",\"submitting\":\"Sending...\",\"invalidEmail\":\"That email doesn't look right.\",\"invalidLink\":\"That link doesn't look right.\",\"tooManyAttempts\":\"Too many applications from this connection. Please try again in an hour.\",\"errorGeneric\":\"Something went wrong. Please try again.\",\"successTitle\":\"Application received.\",\"successBody\":\"We read every single one. If you're in, the discount lands in your inbox within a few days.\",\"backToHome\":\"Back to home\"},\"TimeSavings\":{\"caption\":\"Email him for honest feedback about VoiceOS\",\"title\":\"Point anywhere on your screen.\",\"subtitle\":\"Your cursor is the context. No more explaining, just point and ask.\",\"stepUnit\":\"step\",\"spokenRequest\":\"Hey VoiceOS, do I have any meetings today?\"},\"FAQ\":{\"title\":\"Questions?\",\"q1\":\"How is VoiceOS different from traditional speech recognition?\",\"a1\":\"VoiceOS uses advanced AI to go beyond basic speech-to-text. While Mac Dictation transcribes exactly what you say (including 'um' and 'uh'), VoiceOS \u003cstrong\u003eautomatically removes filler words\u003c/strong\u003e, fixes grammar, and formats your text professionally. It's like having an \u003cstrong\u003eeditor built in\u003c/strong\u003e, perfect for emails, documents, and messaging.\",\"q2\":\"Is my data private and secure with VoiceOS?\",\"a2\":\"Absolutely. VoiceOS processes your audio in real time and \u003cstrong\u003enever stores it\u003c/strong\u003e unless you give permission to help improve the product. Your transcripts are \u003cstrong\u003esaved locally on your device\u003c/strong\u003e, giving you full control over them. None of your data is used for training or shared with anyone. Privacy and security are built into everything we do.\",\"q3\":\"What apps does VoiceOS work with?\",\"a3\":\"VoiceOS works seamlessly across \u003cstrong\u003eyour favorite apps\u003c/strong\u003e like Gmail, Slack, Notion, Google Docs, iMessage, WhatsApp, and more. Whether you're writing code in Cursor, chatting in Messenger, or drafting in Obsidian, VoiceOS is there to help you \u003cstrong\u003ecommunicate faster\u003c/strong\u003e.\"},\"AgentModeDemo\":{\"badge\":\"Coming 4/3\",\"title\":\"Agent Mode\",\"subtitle\":\"Voice to Actions across integrated apps. Zero context switching.\",\"scenarioSlack\":\"Slack: draft reply in-channel\",\"scenarioGmail\":\"Gmail: compose \u0026 send\",\"scenarioGcal\":\"Google Calendar: new event\",\"scenarioNotion\":\"Notion: create page\",\"scenarioLinear\":\"Linear: create issue\",\"scenarioWeather\":\"Web search: weather\"},\"Pricing\":{\"title\":\"Pricing\",\"subtitle\":\"Start with a \u003cbold\u003e7-day free trial\u003c/bold\u003e, cancel anytime\",\"monthly\":\"Monthly\",\"annual\":\"Annual\",\"saveBadge\":\"Save {percent}%\",\"free\":\"Free\",\"pro\":\"Pro\",\"enterprise\":\"Enterprise\",\"forever\":\"forever\",\"perMonth\":\"per month\",\"noCreditCard\":\"no credit card required\",\"billedAnnually\":\"billed annually\",\"billedMonthly\":\"billed monthly\",\"custom\":\"Custom\",\"freeDescription\":\"Perfect for trying out VoiceOS\",\"enterpriseDescription\":\"For teams and organizations\",\"freeLimit\":\"100 usage / week\",\"proLimit\":\"Unlimited usage\",\"getStarted\":\"Get Started\",\"goPro\":\"Go Pro\",\"contactSales\":\"Contact Sales\",\"featureDictation\":\"\u003cbold\u003eDictation \u003c/bold\u003eMode\",\"featureAsk\":\"\u003cbold\u003eAgent \u003c/bold\u003eMode\",\"featureVocabulary\":\"\u003cbold\u003eCustom\u003c/bold\u003e vocabulary\",\"featureApps\":\"\u003cbold\u003eWorks\u003c/bold\u003e in every app\",\"featureEverythingFree\":\"\u003cbold\u003eEverything\u003c/bold\u003e in Free\",\"featureUnlimited\":\"\u003cbold\u003eUnlimited\u003c/bold\u003e usage\",\"featurePriority\":\"\u003cbold\u003ePriority\u003c/bold\u003e support\",\"featureTeam\":\"\u003cbold\u003eTeam\u003c/bold\u003e features\",\"featureEverythingPro\":\"\u003cbold\u003eEverything\u003c/bold\u003e in Pro\",\"featureZeroRetention\":\"\u003cbold\u003eZero\u003c/bold\u003e data retention\",\"featureSoc2\":\"\u003cbold\u003eSecurity\u003c/bold\u003e review support\",\"featureSso\":\"\u003cbold\u003eSSO / SAML\u003c/bold\u003e — contact sales\",\"buildersOfferLead\":\"Builders\",\"buildersOfferCta\":\"apply for 50% off Pro\",\"studentOfferLead\":\"Students\",\"studentOfferCta\":\"get 50% off Pro\",\"pageTitle\":\"Start with 7 days free\",\"pageSubtitle\":\"Full Pro access for a week. A card is required, and you can cancel any time before the trial ends.\",\"freeTrialIncluded\":\"7-day free trial included\"},\"Waitlist\":{\"joinWaitlist\":\"Join our waitlist\",\"beFirst\":\"Be the first to experience VoiceOS\",\"onTheList\":\"You're on the list!\",\"notify\":\"We'll notify you when VoiceOS is ready for you.\",\"enterEmail\":\"Enter your email\",\"joinButton\":\"Join Waitlist\",\"processing\":\"Processing...\",\"failedToJoin\":\"Failed to join waitlist. Please try again.\",\"errorOccurred\":\"An error occurred. Please try again.\"},\"StayOnTask\":{\"caption\":\"Remind me to send Maya the deck\",\"title\":\"Agent keeps you on task.\",\"subtitle\":\"Say it once and let it go. VoiceOS keeps track of the task and brings it back at the right time, so nothing sits in your head.\",\"spokenRequest\":\"Hey VoiceOS, remind me in 2 hours to send Maya the deck\",\"screenAlt\":\"A VoiceOS reminder card on a Mac desktop, with the notch listening above it\",\"cardTask\":\"Send Maya the deck\",\"cardTime\":\"Today, 4:00 PM\"},\"Languages\":{\"titleLine1\":\"Works in over\",\"titleLine2\":\"\u003cbold\u003e100+ languages\u003c/bold\u003e\",\"subtitle\":\"\u003cbold\u003eAutomatically detects\u003c/bold\u003e language. No switching required.\",\"english\":\"English\",\"spanish\":\"Spanish\",\"french\":\"French\",\"german\":\"German\",\"italian\":\"Italian\",\"portuguese\":\"Portuguese\",\"japanese\":\"Japanese\",\"hindi\":\"Hindi\",\"dutch\":\"Dutch\",\"swedish\":\"Swedish\",\"norwegian\":\"Norwegian\",\"danish\":\"Danish\",\"finnish\":\"Finnish\",\"polish\":\"Polish\",\"greek\":\"Greek\",\"turkish\":\"Turkish\",\"thai\":\"Thai\",\"vietnamese\":\"Vietnamese\",\"indonesian\":\"Indonesian\"},\"Privacy\":{\"titleLine1\":\"What you say\",\"titleLine2\":\"stays yours\",\"description\":\"Your audio is never stored on our servers and never used to train models. You decide what leaves your Mac.\",\"learnMore\":\"Learn more\",\"toggleLabel\":\"Privacy mode\",\"switchLabel\":\"Privacy\",\"tabGeneral\":\"General\",\"tabPrivacy\":\"Privacy\",\"tabProfiles\":\"Profiles\",\"tabAdvanced\":\"Advanced\",\"onDevice\":\"On your device\",\"keepTranscriptsLocal\":\"Save transcripts on this device\",\"processAudioRealtime\":\"Don't save audio in the cloud\",\"noTrainingUse\":\"Never use my dictation to train AI models\",\"optionalSharing\":\"Optional sharing\",\"shareDiagnostics\":\"Send anonymous diagnostics and crash reports\",\"shareDiagnosticsNote\":\"Never includes raw audio or full transcripts tied to you.\"},\"WallOfLove\":{\"titleHead\":\"Wall of \",\"titleTail\":\"Love\",\"subtitle\":\"Founders, creators, and builders are replacing typing with VoiceOS.\",\"joinThem\":\"Join Them\",\"joinCount\":\"20,000+ voicepilled\",\"joinAria\":\"Join 20,000+ VoiceOS users\",\"carouselAria\":\"VoiceOS testimonials carousel\",\"viewPostAria\":\"View {name}'s original post\",\"avatarAlt\":\"{name} avatar\",\"gabePerezName\":\"Gabe Perez\",\"gabePerezRole\":\"Head of Product Curation, Product Hunt\",\"gabePerezQuote\":\"VoiceOS lets me get work done 10x faster. I do everything with voice nowadays. The experience will change your life.\",\"andreyName\":\"Andrey\",\"andreyRole\":\"AI enthusiast, NVIDIA GTC winner\",\"andreyQuote\":\"Tried out all the voice productivity tools. VoiceOS is the one I ended up sticking with. It's just the best.\",\"yoichiOchiaiName\":\"Yoichi Ochiai\",\"yoichiOchiaiRole\":\"Media Artist, 605k followers\",\"yoichiOchiaiQuote\":\"I started using VoiceOS.\",\"usutakuName\":\"Usutaku\",\"usutakuRole\":\"#1 Japanese AI Influencer\",\"usutakuQuote\":\"I tried VoiceOS right away, and it was faster and a better experience than any voice input tool I've used before!\",\"souLabName\":\"sou-lab\",\"souLabRole\":\"VoiceOS user\",\"souLabQuote\":\"I sent VoiceOS some feedback, and they added the feature the very next day. Unreal.\",\"albyChurvenName\":\"Alby Churven\",\"albyChurvenRole\":\"14 y/o CMO\",\"albyChurvenQuote\":\"I was using WisprFlow for 3 days and just switched to VoiceOS. VoiceOS is genuinely crazy.\",\"akiraName\":\"akira\",\"akiraRole\":\"Founder of Random Labs, agent harness researcher\",\"akiraQuote\":\"Using VoiceOS for this and it's so smooth lets fucking go. Coding agents + dictation is an insane combo.\",\"emanuelPerezName\":\"Emanuel Perez\",\"emanuelPerezRole\":\"Operations Manager\",\"emanuelPerezQuote\":\"Big fan of agent mode on VoiceOS. This wasn't doable on other apps and makes things like replying to emails much faster.\",\"reneGrywnowName\":\"René Grywnow\",\"reneGrywnowRole\":\"Founder and operations lead\",\"reneGrywnowQuote\":\"VoiceOS: Just speak.\\n\\nNo setup. No excuse.\\n\\nThe future does not type. She speaks.\"},\"FeaturesPage\":{\"metaTitle\":\"Features - VoiceOS\",\"metaDescription\":\"Everything VoiceOS does. Agent Mode turns your voice into actions across apps, while Dictation Mode turns speech into polished writing on Mac and Windows.\",\"title\":\"Do more with your \u003caccent\u003evoice\u003c/accent\u003e\",\"subtitle\":\"VoiceOS turns what you say into real actions across the apps you already use. Dictation is built in.\",\"chip\":\"Mac and Windows\",\"hubAgentEyebrow\":\"Agent Mode\",\"hubAgentTitle\":\"Say it, and it gets done\",\"hubAgentBody\":\"Ask out loud and VoiceOS does the work inside your apps. It sends the message, books the time, finds the file, checks the web. Anything that sends or changes something shows you a confirmation first.\",\"hubDictationEyebrow\":\"Dictation Mode\",\"hubDictationTitle\":\"Talk instead of typing\",\"hubDictationBody\":\"Speak anywhere you would otherwise type, in any app, in 100 languages. The filler comes out, the spelling gets fixed, and what lands on the page is what you meant.\",\"hubCta\":\"See what it does\",\"agentTitle\":\"Agent Mode\",\"agentSubtitle\":\"Say what you want done. VoiceOS goes and does it.\",\"agentF1Title\":\"Actions across your apps\",\"agentF1Body\":\"Send the message, create the issue, add the calendar event. You talk, VoiceOS does the clicking.\",\"agentF2Title\":\"Integrations you connect\",\"agentF2Body\":\"Notion, Slack, Gmail, Linear, Spotify and more. Connect them once in Settings and they answer to your voice.\",\"agentF3Title\":\"Your own MCP servers\",\"agentF3Body\":\"Point VoiceOS at any MCP server and every tool it exposes becomes something you can just ask for.\",\"agentF4Title\":\"Web search with sources\",\"agentF4Body\":\"Ask a question out loud, get a real answer back with the sources it came from.\",\"agentF5Title\":\"Screen awareness\",\"agentF5Body\":\"Ask about whatever is in front of you. Screen access stays behind a toggle that you own.\",\"agentF6Title\":\"Reminders and scheduling\",\"agentF6Body\":\"Ask for a nudge later and VoiceOS brings it back to you at the right moment.\",\"agentF7Title\":\"It asks before it acts\",\"agentF7Body\":\"Anything that sends, books, or changes something shows you a confirmation card first.\",\"agentAskLabel\":\"You say\",\"agentAskSentence\":\"Tell David I'll be ten minutes late, and move our 3pm to Thursday\",\"agentDone1\":\"Message sent\",\"agentDone2\":\"Moved to Thursday\",\"agentConfirmLabel\":\"Before it sends\",\"agentConfirmAction\":\"Send message\",\"agentConfirmToLabel\":\"To\",\"agentConfirmToValue\":\"David Chen\",\"agentConfirmMsgLabel\":\"Message\",\"agentConfirmMsgText\":\"I'll be ten minutes late. Can we move our 3pm to Thursday?\",\"agentConfirmCancel\":\"Cancel\",\"agentConfirmSend\":\"Send\",\"dictationTitle\":\"Dictation Mode\",\"dictSpeedSlowLabel\":\"Keyboard\",\"dictSpeedSlowValue\":\"55 wpm\",\"dictSpeedFastLabel\":\"VoiceOS\",\"dictSpeedFastValue\":\"220 wpm\",\"dictSpeedSentence\":\"I'm getting started with the project. There are three things I need: repo access, the design files, and a staging key.\",\"dictSpeedTyped\":\"I'm getting started with the |porject|(project). There are three things I need: repo access, the |desgin|(design) files, and a staging key.\",\"dictSpeedListLead\":\"I'm getting started with the project. There are three things I need:\",\"dictSpeedListItem1\":\"Repo access\",\"dictSpeedListItem2\":\"The design files\",\"dictSpeedListItem3\":\"A staging key\",\"dictEditsRawLabel\":\"What you said\",\"dictEditsRaw\":\"\u003cfillerMark\u003eso um\u003c/fillerMark\u003e can you take a look at the onboarding bug on the mobile app, there's like three separate things going wrong with it, \u003cname\u003ePreya\u003c/name\u003e's fix from last night did not take, the magic link still lands in spam, \u003cfiller\u003euh\u003c/filler\u003e and the \u003ctypo\u003ePostgress\u003c/typo\u003e logs are full of timeouts, so let's move standup to ten.\",\"dictEditsMarkFiller\":\"Removed filler\",\"dictEditsMarkDict\":\"Added to dictionary\",\"dictEditsMarkSpelling\":\"Fixed spelling\",\"dictEditsNameFixed\":\"Priya\",\"dictEditsTypoFixed\":\"Postgres\",\"dictEditsCleanLead\":\"Can you take a look at the onboarding bug on the mobile app? Three separate things are going wrong with it:\",\"dictEditsCleanItem1\":\"Priya's fix from last night did not take.\",\"dictEditsCleanItem2\":\"The magic link still lands in spam.\",\"dictEditsCleanItem3\":\"The Postgres logs are full of timeouts.\",\"dictEditsCleanTail\":\"Let's move standup to ten.\",\"privacyStatHeadline\":\"\u003cnumber\u003e1,169,420\u003c/number\u003e hours saved for our users\",\"ctaTitle\":\"See it on your own machine\",\"ctaBody\":\"Seven days of Pro, on Mac and Windows.\"},\"Hero\":{\"backedBy\":\"Backed by\",\"combinator\":\"Combinator\",\"headline\":\"Voice assistant\\nat your fingertips\",\"description\":\"Get answers anywhere. Instantly\",\"downloadForMac\":\"Download for Mac\",\"downloadForWindows\":\"Download for Windows\",\"downloadOnDesktop\":\"Download on Desktop\",\"trustedBy\":\"Trusted by 10,000+ users\",\"trialNote\":\"7-day free trial · Cancel anytime\"}},\"now\":\"$undefined\",\"timeZone\":\"UTC\",\"children\":\"$L34\"}]\n35:I[28554,[\"/_next/static/chunks/2kb52na2e7ces.js\",\"/_next/static/chunks/1xfsu92iq1h9m.js\",\"/_next/static/chunks/3x6-_ejf1r1x0.js\",\"/_next/static/chunks/0z6qqa_pcb2c9.js\",\"/_next/static/chunks/35rx1_qn9m74v.js\",\"/_next/static/chunks/3sng1v3_18lsq.js\"],\"default\"]\n3b:I[70208,[\"/_next/static/chunks/2kb52na2e7ces.js\",\"/_next/static/chunks/1xfsu92iq1h9m.js\",\"/_next/static/chunks/3x6-_ejf1r1x0.js\",\"/_next/static/chunks/0z6qqa_pcb2c9.js\",\"/_next/static/chunks/35rx1_qn9m74v.js\",\"/_next/static/chunks/3sng1v3_18lsq.js\"],\"default\"]\n44:I[85581,[\"/_next/static/chunks/2kb52na2e7ces.js\",\"/_next/static/chunks/1xfsu92iq1h9m.js\",\"/_next/static/chunks/3x6-_ejf1r1x0.js\",\"/_next/static/chunks/0z6qqa_pcb2c9.js\",\"/_next/static/chunks/35rx1_qn9m74v.js\",\"/_next/static/chunks/3sng1v3_18lsq.js\"],\"default\"]\n23:[\"$\",\"p\",null,{\"style\":{\"fontSize\":\"1.0625rem\",\"fontWeight\":400,\"lineHeight\":\"1.8\",\"color\":\"#1f2937\",\"margin\":0},\"children\":\"Yes. VoiceOS is an AI that can see your screen and answer questions on Mac and Windows. Turn on “Point and ask about your screen,” hold your Agent Mode trigger, and ask about whatever you are looking at. VoiceOS reads the current screen only when you invoke it, uses your mouse cursor or blue drawing trail to identify the exact area you mean, and answers in the notch.\"}]\n24:[\"$\",\"div\",null,{\"className\":\"glassmorphic-button-wrap comparison-glass-cta-wrap mt-6\",\"children\":[[\"$\",\"$L35\",null,{\"href\":\"/\",\"sourceType\":\"blog\",\"sourceSlug\":\"ai-that-can-see-your-screen-and-answer-questions\",\"className\":\"glassmorphic-button comparison-glass-cta\",\"children\":[\"$\",\"span\",null,{\"children\":\"Download VoiceOS\"}]}],[\"$\",\"div\",null,{\"className\":\"glassmorphic-button-shadow\"}]]}]\n25:[\"$\",\"section\",null,{\"className\":\"mb-16\",\"id\":\"key-takeaways\",\"children\":[\"$\",\"div\",null,{\"className\":\"rounded-2xl p-6 md:p-8\",\"style\":{\"backgroundColor\":\"#fff\",\"border\":\"1px solid #eee\"},\"children\":[[\"$\",\"h2\",null,{\"style\":{\"fontSize\":\"clamp(1.5rem, 4vw, 2rem)\",\"fontWeight\":500,\"lineHeight\":\"1.3\",\"color\":\"#0a0a0a\",\"letterSpacing\":\"-0.02em\",\"marginBottom\":\"1rem\"},\"children\":\"Key Takeaways\"}],[\"$\",\"ul\",null,{\"className\":\"space-y-3\",\"children\":[[\"$\",\"li\",\"0\",{\"className\":\"flex gap-3\",\"style\":{\"fontSize\":\"1.0625rem\",\"fontWeight\":400,\"lineHeight\":\"1.8\",\"color\":\"#444\"},\"children\":[[\"$\",\"span\",null,{\"className\":\"flex-shrink-0 w-2 h-2 rounded-full\",\"style\":{\"backgroundColor\":\"#0a0a0a\",\"marginTop\":\"0.65em\"}}],[\"$\",\"span\",null,{\"children\":\"An AI that reads your screen and answers questions is often called a screen-aware or multimodal AI assistant. It can understand visible text, charts, buttons, errors, and app layouts instead of making you describe them from memory.\"}]]}],[\"$\",\"li\",\"1\",{\"className\":\"flex gap-3\",\"style\":\"$25:props:children:props:children:1:props:children:0:props:style\",\"children\":[[\"$\",\"span\",null,{\"className\":\"flex-shrink-0 w-2 h-2 rounded-full\",\"style\":{\"backgroundColor\":\"#0a0a0a\",\"marginTop\":\"0.65em\"}}],[\"$\",\"span\",null,{\"children\":\"For decades, help lived somewhere else: a search box, a support article, a twelve-minute tutorial. Screen-aware AI brings the help to your screen, in the moment, without you leaving what you are doing.\"}]]}],[\"$\",\"li\",\"2\",{\"className\":\"flex gap-3\",\"style\":\"$25:props:children:props:children:1:props:children:0:props:style\",\"children\":[[\"$\",\"span\",null,{\"className\":\"flex-shrink-0 w-2 h-2 rounded-full\",\"style\":{\"backgroundColor\":\"#0a0a0a\",\"marginTop\":\"0.65em\"}}],[\"$\",\"span\",null,{\"children\":\"This became possible in 2026 because three things arrived at once: fast and accurate speech recognition, multimodal AI that can actually read a screen, and assistants that can reach across all of your apps.\"}]]}],[\"$\",\"li\",\"3\",{\"className\":\"flex gap-3\",\"style\":\"$25:props:children:props:children:1:props:children:0:props:style\",\"children\":[[\"$\",\"span\",null,{\"className\":\"flex-shrink-0 w-2 h-2 rounded-full\",\"style\":{\"backgroundColor\":\"#0a0a0a\",\"marginTop\":\"0.65em\"}}],[\"$\",\"span\",null,{\"children\":\"The everyday payoff is the end of \\\"how do I do this?\\\" You stop switching to a search engine and start asking the thing in front of you, and sometimes it simply does it for you.\"}]]}],[\"$\",\"li\",\"4\",{\"className\":\"flex gap-3\",\"style\":\"$25:props:children:props:children:1:props:children:0:props:style\",\"children\":[[\"$\",\"span\",null,{\"className\":\"flex-shrink-0 w-2 h-2 rounded-full\",\"style\":{\"backgroundColor\":\"#0a0a0a\",\"marginTop\":\"0.65em\"}}],[\"$\",\"span\",null,{\"children\":\"VoiceOS puts a screen-aware voice assistant on Mac and Windows with no complicated setup. Enable “Point and ask about your screen,” press your Agent Mode trigger, and ask about what is in front of you.\"}]]}],[\"$\",\"li\",\"5\",{\"className\":\"flex gap-3\",\"style\":\"$25:props:children:props:children:1:props:children:0:props:style\",\"children\":[[\"$\",\"span\",null,{\"className\":\"flex-shrink-0 w-2 h-2 rounded-full\",\"style\":{\"backgroundColor\":\"#0a0a0a\",\"marginTop\":\"0.65em\"}}],[\"$\",\"span\",null,{\"children\":\"You can point instead of over-explaining. Move your mouse cursor to the exact message, button, or item you mean, or draw a blue loop around a region while you talk. VoiceOS sees the mark together with your screen and question.\"}]]}]]}]]}]}]\n26:[\"$\",\"section\",null,{\"className\":\"mb-16\",\"id\":\"the-problem\",\"children\":[[\"$\",\"h2\",null,{\"style\":{\"fontSize\":\"clamp(1.5rem, 4vw, 2rem)\",\"fontWeight\":500,\"lineHeight\":\"1.3\",\"color\":\"#0a0a0a\",\"letterSpacing\":\"-0.02em\",\"marginBottom\":\"1.5rem\"},\"children\":\"\\\"How do I do this?\\\" is where work goes to die\"}],[\"$\",\"p\",null,{\"style\":{\"fontSize\":\"1.0625rem\",\"fontWeight\":400,\"lineHeight\":\"1.8\",\"color\":\"#444\",\"marginBottom\":\"1.5rem\"},\"children\":\"Everyone knows the feeling. You are in an app you do not use often: a video editor, a spreadsheet full of someone else's formulas, a tax portal, a tool your company adopted last week. You know exactly what you want to accomplish. You just cannot find the button, the setting, or the sequence of steps that gets you there.\"}],[\"$\",\"p\",null,{\"style\":{\"fontSize\":\"1.0625rem\",\"fontWeight\":400,\"lineHeight\":\"1.8\",\"color\":\"#444\",\"marginBottom\":\"1.5rem\"},\"children\":\"So you do what we have all been trained to do. You switch to a browser. You type a half-remembered version of your question. You skim a forum thread from 2021, open a support doc that describes a version of the app that no longer exists, or scrub through a fourteen-minute tutorial to find the ten seconds that actually apply to you. Then you switch back, try to remember what you read, and hope it still lines up with what is on your screen.\"}],[\"$\",\"p\",null,{\"style\":\"$25:props:children:props:children:1:props:children:0:props:style\",\"children\":\"That round trip is one of the quietest, most universal taxes in modern work. It is not one big interruption, it is a hundred small ones a week. Every time your question lives in one place and your work lives in another, you pay to carry the answer across the gap. The promise of a screen-aware assistant is simple: close that gap entirely, and let the help live where the problem is.\"}],[\"$\",\"blockquote\",null,{\"className\":\"rounded-2xl p-6 md:p-8 mt-8\",\"style\":{\"backgroundColor\":\"#fff\",\"border\":\"1px solid #eee\",\"borderLeft\":\"4px solid #0a0a0a\"},\"children\":[\"$\",\"p\",null,{\"style\":{\"fontSize\":\"clamp(1.25rem, 3.5vw, 1.625rem)\",\"fontWeight\":500,\"lineHeight\":\"1.4\",\"color\":\"#0a0a0a\",\"letterSpacing\":\"-0.01em\",\"fontStyle\":\"italic\"},\"children\":\"\\\"What if the help could simply look at your screen with you?\\\"\"}]}]]}]\n27:[\"$\",\"section\",null,{\"className\":\"mb-16\",\"id\":\"what-it-is\",\"children\":[[\"$\",\"h2\",null,{\"style\":\"$26:props:children:0:props:style\",\"children\":\"How an AI reads your screen and answers questions\"}],[\"$\",\"p\",null,{\"style\":{\"fontSize\":\"1.0625rem\",\"fontWeight\":400,\"lineHeight\":\"1.8\",\"color\":\"#444\",\"marginBottom\":\"1.5rem\"},\"children\":\"A screen-aware AI assistant is software that can do three things a search box never could: see, understand, and act. An AI that looks at your screen receives the visible screen as context alongside your spoken question, so the two are interpreted together.\"}],[\"$\",\"p\",null,{\"style\":{\"fontSize\":\"1.0625rem\",\"fontWeight\":400,\"lineHeight\":\"1.8\",\"color\":\"#444\",\"marginBottom\":\"1.5rem\"},\"children\":\"It can see, because with your permission it reads what is currently on your screen, the way a knowledgeable friend leaning over your shoulder would. It can understand, because modern multimodal AI does not just scan the text on the page. It recognizes the app, layout, error message, chart, and state you are in, then connects those details to what you are asking. And it can act, because instead of only describing the steps, it can walk you through them or carry them out for you.\"}],[\"$\",\"p\",null,{\"style\":\"$25:props:children:props:children:1:props:children:0:props:style\",\"children\":\"Contrast that with the help we have lived with for thirty years. A support article is static, generic, and written for the average user, not for you and the exact screen you are staring at. A search result does not know which app you are in. A chatbot in a separate window cannot see your work at all, so you have to describe your situation to it in words, which is often harder than the original problem. Screen-aware AI removes that translation step. You do not have to explain your screen, because it is already looking at it.\"}],[\"$\",\"div\",null,{\"className\":\"rounded-2xl p-5 mt-6\",\"style\":{\"backgroundColor\":\"#fff\",\"border\":\"1px solid #eee\"},\"children\":[\"$\",\"p\",null,{\"style\":{\"fontSize\":\"0.9375rem\",\"fontWeight\":400,\"lineHeight\":\"1.8\",\"color\":\"#444\",\"margin\":0},\"children\":[\"Related: \",\"$L36\",\" · \",\"$L37\"]}]}]]}]\n28:[\"$\",\"section\",null,{\"className\":\"mb-16\",\"id\":\"why-now\",\"children\":[[\"$\",\"h2\",null,{\"style\":\"$26:props:children:0:props:style\",\"children\":\"How AI can scan your screen and understand it\"}],[\"$\",\"p\",null,{\"style\":{\"fontSize\":\"1.0625rem\",\"fontWeight\":400,\"lineHeight\":\"1.8\",\"color\":\"#444\",\"marginBottom\":\"1.5rem\"},\"children\":\"The idea of an AI that can watch your screen and help is not new. It is decades old. What changed is that three separate technologies matured at the same time, and only together do they add up to something that actually works.\"}],[\"$\",\"p\",null,{\"style\":{\"fontSize\":\"1.0625rem\",\"fontWeight\":400,\"lineHeight\":\"1.8\",\"color\":\"#444\",\"marginBottom\":\"1.5rem\"},\"children\":\"The first is speech recognition that is fast and accurate enough to feel like conversation, not like fighting with a phone menu. The second is multimodal AI, models that can look at an image of your screen and genuinely comprehend it, reading not just the words but the meaning of a layout, a chart, a dialog box, or an error. The third is system-wide reach, an assistant that is not trapped inside a single app but can sit across your whole computer and touch the tools where your work actually happens.\"}],[\"$\",\"p\",null,{\"style\":\"$25:props:children:props:children:1:props:children:0:props:style\",\"children\":\"Any one of these on its own is a demo. Put all three together and you get something new: an assistant you can simply talk to, that already sees what you see, and that can do something about it. That is why 2026 is the year this stopped being a research project and started being software you can download.\"}],[\"$\",\"div\",null,{\"className\":\"rounded-2xl p-5 mt-6\",\"style\":{\"backgroundColor\":\"#fff\",\"border\":\"1px solid #eee\"},\"children\":[\"$\",\"p\",null,{\"style\":{\"fontSize\":\"0.9375rem\",\"fontWeight\":400,\"lineHeight\":\"1.8\",\"color\":\"#444\",\"margin\":0},\"children\":[\"Related: \",\"$L38\",\" · \",\"$L39\"]}]}]]}]\n29:[\"$\",\"section\",null,{\"className\":\"mb-16\",\"id\":\"what-changes\",\"children\":[[\"$\",\"h2\",null,{\"style\":\"$26:props:children:0:props:style\",\"children\":\"What changes when your computer can see what you see\"}],[\"$\",\"p\",null,{\"style\":{\"fontSize\":\"1.0625rem\",\"fontWeight\":400,\"lineHeight\":\"1.8\",\"color\":\"#444\",\"marginBottom\":\"1.5rem\"},\"children\":\"The first shift is emotional, before it is practical. You stop feeling stuck. When help is always one spoken sentence away, the anxiety of unfamiliar software mostly disappears. You do not have to know the app anymore. You just have to be able to describe what you want.\"}],[\"$\",\"p\",null,{\"style\":{\"fontSize\":\"1.0625rem\",\"fontWeight\":400,\"lineHeight\":\"1.8\",\"color\":\"#444\",\"marginBottom\":\"1.5rem\"},\"children\":\"Picture the ordinary moments where this matters. A designer opens a professional video tool for the first time and, instead of pausing to find a beginner course, asks out loud how to do the one thing they need right now. An analyst stares at a dense dashboard someone else built and asks what a particular chart is actually telling them. A new hire lands in a sprawling internal app on day one and gets a patient, private guide instead of a forty-page onboarding PDF. Someone filling out a confusing government or banking form asks what a field means before they submit it, not after.\"}],[\"$\",\"p\",null,{\"style\":\"$25:props:children:props:children:1:props:children:0:props:style\",\"children\":\"In every one of these cases, the interface stops being a wall you have to decode alone. The screen becomes the conversation. And because the assistant can see exactly what you see, its answer is specific to your situation, not a generic paragraph that assumes a different version, a different layout, or a different problem than the one in front of you.\"}]]}]\n2a:[\"$\",\"section\",null,{\"className\":\"mb-16\",\"id\":\"meet-voiceos\",\"children\":[[\"$\",\"h2\",null,{\"style\":\"$26:props:children:0:props:style\",\"children\":\"Meet your screen-aware voice assistant: VoiceOS\"}],[\"$\",\"p\",null,{\"style\":{\"fontSize\":\"1.0625rem\",\"fontWeight\":400,\"lineHeight\":\"1.8\",\"color\":\"#444\",\"marginBottom\":\"1.5rem\"},\"children\":\"VoiceOS is the practical, ready-today version of everything above. It runs system-wide on Mac and Windows, so it is not locked inside one app. It lives in the notch at the top of your Mac, and in the same always-available spot on Windows. It is not something you open and close. It sits there, one word or one tap away, ready the moment you need it.\"}],[\"$\",\"p\",null,{\"style\":{\"fontSize\":\"1.0625rem\",\"fontWeight\":400,\"lineHeight\":\"1.8\",\"color\":\"#444\",\"marginBottom\":\"1.5rem\"},\"children\":\"Press your trigger and simply talk to it about what is on your screen. What does this setting actually do? Summarize this dashboard for me. What is this error trying to tell me? Walk me through exporting this. Because VoiceOS can look at your screen when you ask it to, its answers are grounded in your real situation, not a generic guess. You are not describing your problem to a chatbot in another window. You are asking the thing in front of you.\"}],[\"$\",\"p\",null,{\"style\":\"$25:props:children:props:children:1:props:children:0:props:style\",\"children\":\"And it is built for regular people, not just developers. There is no code to write, no API keys to paste, and no command list to memorize. You download it, grant permission, and start talking. That is the whole setup.\"}],[\"$\",\"figure\",null,{\"className\":\"mt-8\",\"children\":[[\"$\",\"$L22\",null,{\"src\":\"/blogs/ai-that-can-see-your-screen-observing-laptop.jpg\",\"alt\":\"VoiceOS observing what is displayed on a laptop screen\",\"width\":1672,\"height\":941,\"className\":\"w-full\",\"style\":{\"borderRadius\":\"16px\",\"border\":\"1px solid #eee\"}}],[\"$\",\"figcaption\",null,{\"style\":{\"fontSize\":\"0.875rem\",\"fontWeight\":400,\"lineHeight\":\"1.8\",\"color\":\"#888\",\"marginTop\":\"0.75rem\",\"textAlign\":\"center\",\"marginBottom\":0},\"children\":\"VoiceOS reads what's on your screen, tells you what it sees, and suggests what to do next.\"}]]}],[\"$\",\"div\",null,{\"className\":\"rounded-2xl p-5 mt-6\",\"style\":{\"backgroundColor\":\"#fff\",\"border\":\"1px solid #eee\"},\"children\":[\"$\",\"p\",null,{\"style\":{\"fontSize\":\"0.9375rem\",\"fontWeight\":400,\"lineHeight\":\"1.8\",\"color\":\"#444\",\"margin\":0},\"children\":[\"Related: \",\"$L3a\"]}]}]]}]\n2b:[\"$\",\"section\",null,{\"className\":\"mb-16\",\"id\":\"point-to-understand\",\"children\":[[\"$\",\"h2\",null,{\"style\":\"$26:props:children:0:props:style\",\"children\":\"Use your mouse cursor to point at what you mean\"}],[\"$\",\"p\",null,{\"style\":{\"fontSize\":\"1.0625rem\",\"fontWeight\":400,\"lineHeight\":\"1.8\",\"color\":\"#444\",\"marginBottom\":\"1.5rem\"},\"children\":\"Talking is not always the fastest way to identify what you mean. On a busy screen full of messages, buttons, photos, and choices, describing the one thing you care about can take longer than the question itself. This is where a second, very human way of communicating comes in: pointing.\"}],[\"$\",\"p\",null,{\"style\":{\"fontSize\":\"1.0625rem\",\"fontWeight\":400,\"lineHeight\":\"1.8\",\"color\":\"#444\",\"marginBottom\":\"1.5rem\"},\"children\":\"VoiceOS turns the mouse cursor into a visual reference. With “Point and ask about your screen” enabled, hold your Agent Mode trigger and begin speaking. As you move the cursor, a blue trail appears. Point at one item or draw a loop around a region while asking something natural, such as “how should I reply to this?” or “which one should I choose?” When you release the trigger, VoiceOS receives your words together with the marked view of your screen.\"}],[\"$\",\"p\",null,{\"style\":\"$25:props:children:props:children:1:props:children:0:props:style\",\"children\":\"That combination makes words like “this,” “that,” and “here” useful. The AI does not have to guess which message, product, or button you meant because your cursor drawing is part of the context it reads. It feels like sitting beside a friend, circling something on the screen, and asking a short question instead of giving a long explanation.\"}],[[\"$\",\"$L3b\",null,{\"locale\":\"en\"}],[\"$\",\"div\",null,{\"className\":\"rounded-2xl p-5 md:p-6 mt-8\",\"style\":{\"backgroundColor\":\"#fff\",\"border\":\"1px solid #eee\"},\"children\":[[\"$\",\"h3\",null,{\"style\":{\"fontSize\":\"clamp(1.125rem, 3vw, 1.375rem)\",\"fontWeight\":500,\"lineHeight\":\"1.4\",\"color\":\"#0a0a0a\",\"marginBottom\":\"1rem\"},\"children\":\"How to point at your screen and ask VoiceOS\"}],[\"$\",\"ol\",null,{\"className\":\"space-y-3\",\"children\":[[\"$\",\"li\",\"In the VoiceOS dashboard, open Agent Mode Actions and turn on “Point and ask about your screen.” Grant screen access if your computer asks for permission.\",{\"className\":\"flex gap-3\",\"style\":\"$25:props:children:props:children:1:props:children:0:props:style\",\"children\":[[\"$\",\"span\",null,{\"className\":\"flex h-7 w-7 flex-shrink-0 items-center justify-center rounded-full\",\"style\":{\"backgroundColor\":\"#eef6ff\",\"color\":\"#126ff6\",\"fontSize\":\"0.8125rem\",\"fontWeight\":600,\"marginTop\":\"0.1rem\"},\"children\":1}],[\"$\",\"span\",null,{\"children\":\"In the VoiceOS dashboard, open Agent Mode Actions and turn on “Point and ask about your screen.” Grant screen access if your computer asks for permission.\"}]]}],[\"$\",\"li\",\"Open the message, page, form, document, or photo you want help with, then hold your Agent Mode trigger.\",{\"className\":\"flex gap-3\",\"style\":\"$25:props:children:props:children:1:props:children:0:props:style\",\"children\":[[\"$\",\"span\",null,{\"className\":\"flex h-7 w-7 flex-shrink-0 items-center justify-center rounded-full\",\"style\":{\"backgroundColor\":\"#eef6ff\",\"color\":\"#126ff6\",\"fontSize\":\"0.8125rem\",\"fontWeight\":600,\"marginTop\":\"0.1rem\"},\"children\":2}],[\"$\",\"span\",null,{\"children\":\"Open the message, page, form, document, or photo you want help with, then hold your Agent Mode trigger.\"}]]}],[\"$\",\"li\",\"Ask your question while moving the mouse cursor to the exact item. If the screen is crowded, draw around it so the blue trail makes your meaning clear.\",{\"className\":\"flex gap-3\",\"style\":\"$25:props:children:props:children:1:props:children:0:props:style\",\"children\":[[\"$\",\"span\",null,{\"className\":\"flex h-7 w-7 flex-shrink-0 items-center justify-center rounded-full\",\"style\":{\"backgroundColor\":\"#eef6ff\",\"color\":\"#126ff6\",\"fontSize\":\"0.8125rem\",\"fontWeight\":600,\"marginTop\":\"0.1rem\"},\"children\":3}],[\"$\",\"span\",null,{\"children\":\"Ask your question while moving the mouse cursor to the exact item. If the screen is crowded, draw around it so the blue trail makes your meaning clear.\"}]]}],[\"$\",\"li\",\"Release the trigger. VoiceOS reads the marked screen together with your spoken question and answers in context.\",{\"className\":\"flex gap-3\",\"style\":\"$25:props:children:props:children:1:props:children:0:props:style\",\"children\":[\"$L3c\",\"$L3d\"]}]]}]]}]],\"$L3e\"]}]\n2c:[\"$\",\"section\",null,{\"className\":\"mb-16\",\"id\":\"seeing-to-doing\",\"children\":[[\"$\",\"h2\",null,{\"style\":\"$26:props:children:0:props:style\",\"children\":\"When seeing your screen turns into doing the work\"}],[\"$\",\"p\",null,{\"style\":{\"fontSize\":\"1.0625rem\",\"fontWeight\":400,\"lineHeight\":\"1.8\",\"color\":\"#444\",\"marginBottom\":\"1.5rem\"},\"children\":\"Answering questions is where a screen-aware assistant earns your trust. Taking action is where it changes your day.\"}],[\"$\",\"p\",null,{\"style\":{\"fontSize\":\"1.0625rem\",\"fontWeight\":400,\"lineHeight\":\"1.8\",\"color\":\"#444\",\"marginBottom\":\"1.5rem\"},\"children\":\"VoiceOS does more than explain what is on your screen. In Dictate mode, it turns natural speech into polished text anywhere your cursor is, cleaning up filler, fixing grammar, and matching the tone of the app you are in. In Edit mode, you reshape text you have already written just by talking to it: make this shorter, turn this into bullet points, make it friendlier. And in Agent mode, seeing your screen becomes doing the work. You can ask VoiceOS to reply to the message you are looking at, summarize a thread and draft a response, or carry a task across connected apps like Gmail, Slack, and Google Calendar.\"}],[\"$\",\"p\",null,{\"style\":\"$25:props:children:props:children:1:props:children:0:props:style\",\"children\":\"That is the real leap. A tool that can see your screen and also act on it collapses the distance between \\\"how do I do this?\\\" and \\\"just do this for me.\\\" And because handing your computer more capability should never mean handing over control, VoiceOS prepares important actions and confirms with you before anything is sent. You direct the work. It handles the busywork in between.\"}],[\"$\",\"div\",null,{\"className\":\"rounded-2xl p-5 mt-6\",\"style\":{\"backgroundColor\":\"#fff\",\"border\":\"1px solid #eee\"},\"children\":[\"$\",\"p\",null,{\"style\":{\"fontSize\":\"0.9375rem\",\"fontWeight\":400,\"lineHeight\":\"1.8\",\"color\":\"#444\",\"margin\":0},\"children\":[\"Related: \",\"$L3f\",\" · \",\"$L40\"]}]}]]}]\n2d:[\"$\",\"section\",null,{\"className\":\"mb-16\",\"id\":\"how-to-start\",\"children\":[[\"$\",\"h2\",null,{\"style\":\"$26:props:children:0:props:style\",\"children\":\"How to start\"}],[\"$\",\"p\",null,{\"style\":{\"fontSize\":\"1.0625rem\",\"fontWeight\":400,\"lineHeight\":\"1.8\",\"color\":\"#444\",\"marginBottom\":\"1.5rem\"},\"children\":\"You do not have to change how you work overnight. The easiest place to begin is low-risk. The next time you are stuck in an app, instead of opening a new browser tab, just ask about your screen. Get an answer in context, in seconds, without losing your place.\"}],[\"$\",\"p\",null,{\"style\":{\"fontSize\":\"1.0625rem\",\"fontWeight\":400,\"lineHeight\":\"1.8\",\"color\":\"#444\",\"marginBottom\":\"1.5rem\"},\"children\":\"From there, let it do more. Use voice to reshape a rough draft instead of rewriting it by hand. Ask questions about a document, a dashboard, or an email thread instead of parsing it yourself. Then, when you are comfortable, use Agent Mode for real actions like drafting replies, creating events, and chaining steps across apps, with the confirmation loop keeping you in command.\"}],[\"$\",\"p\",null,{\"style\":\"$25:props:children:props:children:1:props:children:0:props:style\",\"children\":\"Keep your keyboard and mouse for the precise work they are still best at. Use a screen-aware voice assistant for intent, for the moments when you know what you want but not where the button is. The goal was never to make your computer more complicated. It was to make it finally understand what you are looking at, and help.\"}]]}]\n2e:[\"$\",\"section\",null,{\"className\":\"mb-16\",\"id\":\"faq\",\"children\":[[\"$\",\"h2\",null,{\"style\":\"$26:props:children:0:props:style\",\"children\":\"Frequently Asked Questions (FAQ)\"}],[\"$\",\"div\",null,{\"className\":\"space-y-6\",\"children\":[[\"$\",\"div\",\"0\",{\"className\":\"rounded-2xl p-5 md:p-6\",\"style\":{\"backgroundColor\":\"#fff\",\"border\":\"1px solid #eee\"},\"children\":[[\"$\",\"h3\",null,{\"style\":{\"fontSize\":\"clamp(1.125rem, 3vw, 1.375rem)\",\"fontWeight\":500,\"lineHeight\":\"1.4\",\"color\":\"#0a0a0a\",\"marginBottom\":\"0.5rem\"},\"children\":\"What is an AI that reads your screen?\"}],[\"$\",\"p\",null,{\"style\":{\"fontSize\":\"0.9375rem\",\"fontWeight\":400,\"lineHeight\":\"1.8\",\"color\":\"#444\"},\"children\":\"An AI that reads your screen is a screen-aware, multimodal assistant that uses the visible screen as context. It can recognize text, app layouts, charts, buttons, images, and error messages, then answer questions about what it sees. VoiceOS brings that capability to Mac and Windows and lets you ask by voice instead of uploading screenshots to a separate chat.\"}]]}],[\"$\",\"div\",\"1\",{\"className\":\"rounded-2xl p-5 md:p-6\",\"style\":{\"backgroundColor\":\"#fff\",\"border\":\"1px solid #eee\"},\"children\":[[\"$\",\"h3\",null,{\"style\":{\"fontSize\":\"clamp(1.125rem, 3vw, 1.375rem)\",\"fontWeight\":500,\"lineHeight\":\"1.4\",\"color\":\"#0a0a0a\",\"marginBottom\":\"0.5rem\"},\"children\":\"Is there an AI that can see my screen and answer questions?\"}],[\"$\",\"p\",null,{\"style\":{\"fontSize\":\"0.9375rem\",\"fontWeight\":400,\"lineHeight\":\"1.8\",\"color\":\"#444\"},\"children\":\"Yes. VoiceOS can see your current screen and answer questions about it on Mac and Windows. Turn on “Point and ask about your screen,” hold the Agent Mode trigger, and ask about whatever is visible. It is an AI that sees your screen and answers questions based on the real page, app, chart, document, or error in front of you.\"}]]}],[\"$\",\"div\",\"2\",{\"className\":\"rounded-2xl p-5 md:p-6\",\"style\":{\"backgroundColor\":\"#fff\",\"border\":\"1px solid #eee\"},\"children\":[[\"$\",\"h3\",null,{\"style\":{\"fontSize\":\"clamp(1.125rem, 3vw, 1.375rem)\",\"fontWeight\":500,\"lineHeight\":\"1.4\",\"color\":\"#0a0a0a\",\"marginBottom\":\"0.5rem\"},\"children\":\"How is this different from a chatbot like ChatGPT?\"}],[\"$\",\"p\",null,{\"style\":{\"fontSize\":\"0.9375rem\",\"fontWeight\":400,\"lineHeight\":\"1.8\",\"color\":\"#444\"},\"children\":\"A standard chatbot lives in its own window and only knows what you type into it, so to get help you have to describe your screen in words. A screen-aware voice assistant closes that gap. It can see your screen with your permission, so it already knows the context, and it works system-wide across your apps instead of inside a single tab. You talk, it looks, it helps, with no copy-pasting and no explaining.\"}]]}],[\"$\",\"div\",\"3\",{\"className\":\"rounded-2xl p-5 md:p-6\",\"style\":{\"backgroundColor\":\"#fff\",\"border\":\"1px solid #eee\"},\"children\":[[\"$\",\"h3\",null,{\"style\":{\"fontSize\":\"clamp(1.125rem, 3vw, 1.375rem)\",\"fontWeight\":500,\"lineHeight\":\"1.4\",\"color\":\"#0a0a0a\",\"marginBottom\":\"0.5rem\"},\"children\":\"What can an AI that scans your screen do?\"}],[\"$\",\"p\",null,{\"style\":{\"fontSize\":\"0.9375rem\",\"fontWeight\":400,\"lineHeight\":\"1.8\",\"color\":\"#444\"},\"children\":\"Common uses include learning unfamiliar software without watching a tutorial, getting un-stuck the instant you cannot find a setting, understanding dense dashboards or documents, decoding confusing error messages, and turning \\\"how do I do this?\\\" into an action the assistant performs for you. With VoiceOS you can also dictate and edit text by voice and run multi-step tasks across apps like Gmail, Slack, and Google Calendar.\"}]]}],[\"$\",\"div\",\"4\",{\"className\":\"rounded-2xl p-5 md:p-6\",\"style\":{\"backgroundColor\":\"#fff\",\"border\":\"1px solid #eee\"},\"children\":[[\"$\",\"h3\",null,{\"style\":{\"fontSize\":\"clamp(1.125rem, 3vw, 1.375rem)\",\"fontWeight\":500,\"lineHeight\":\"1.4\",\"color\":\"#0a0a0a\",\"marginBottom\":\"0.5rem\"},\"children\":\"Is it always watching my screen? What about privacy?\"}],[\"$\",\"p\",null,{\"style\":{\"fontSize\":\"0.9375rem\",\"fontWeight\":400,\"lineHeight\":\"1.8\",\"color\":\"#444\"},\"children\":\"No. A well-designed screen-aware assistant should look only when you ask it to, not record continuously. VoiceOS looks at your screen on demand, when you invoke it, rather than constantly capturing in the background, and it asks for confirmation before taking important actions. You stay in control of when it sees your screen and what happens next.\"}]]}],\"$L41\",\"$L42\",\"$L43\"]}]]}]\n2f:[\"$\",\"section\",null,{\"className\":\"mb-8\",\"children\":[\"$\",\"div\",null,{\"className\":\"relative overflow-hidden rounded-[20px] py-14 md:py-20 px-6\",\"style\":{\"backgroundColor\":\"#F5F9FF\",\"color\":\"#0a0a0a\",\"border\":\"1px solid #e5edf8\"},\"children\":[[\"$\",\"div\",null,{\"className\":\"absolute inset-0\",\"style\":{\"backgroundImage\":\"url(/oceanWarp.webp)\",\"backgroundSize\":\"cover\",\"backgroundPosition\":\"center\"}}],[\"$\",\"div\",null,{\"className\":\"absolute inset-0 pointer-events-none\",\"style\":{\"backgroundColor\":\"rgba(255, 255, 255, 0.7)\"}}],[\"$\",\"div\",null,{\"className\":\"absolute inset-0 pointer-events-none\",\"style\":{\"background\":\"radial-gradient(ellipse 120% 120% at 50% 50%, transparent 30%, rgba(255,255,255,0.5) 70%, rgba(255,255,255,0.85) 100%)\"}}],[\"$\",\"div\",null,{\"className\":\"relative text-center flex flex-col items-center gap-4\",\"children\":[[\"$\",\"h2\",null,{\"style\":{\"fontSize\":\"clamp(1.375rem, 4vw, 1.75rem)\",\"fontWeight\":600,\"lineHeight\":\"1.3\",\"letterSpacing\":\"-0.02em\",\"color\":\"#0a0a0a\"},\"children\":\"Ask an AI about anything on your screen\"}],[\"$\",\"p\",null,{\"style\":{\"fontSize\":\"0.9375rem\",\"color\":\"rgba(10,10,10,0.58)\"},\"children\":\"VoiceOS is an AI that reads your screen and answers questions on Mac and Windows. Point with your cursor, ask by voice, and get help without leaving the app you are in.\"}],[\"$\",\"$L35\",null,{\"href\":\"/\",\"sourceType\":\"blog\",\"sourceSlug\":\"ai-that-can-see-your-screen-and-answer-questions\",\"className\":\"mt-2 inline-flex items-center gap-2 px-6 py-2.5 rounded-full text-sm font-medium border border-black/[0.06] shadow-[0_1px_2px_rgba(0,0,0,0.04),0_4px_12px_rgba(0,0,0,0.06)] transition-all duration-200 hover:-translate-y-[1px] hover:shadow-[0_2px_4px_rgba(0,0,0,0.08),0_8px_20px_rgba(0,0,0,0.08)]\",\"style\":{\"backgroundColor\":\"#fff\",\"color\":\"#111\"},\"children\":[\"Download VoiceOS\",[\"$\",\"svg\",null,{\"className\":\"w-3.5 h-3.5\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"viewBox\":\"0 0 24 24\",\"children\":[\"$\",\"path\",null,{\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"strokeWidth\":2.5,\"d\":\"M9 5l7 7-7 7\"}]}]]}]]}]]}]}]\n30:[\"$\",\"aside\",null,{\"className\":\"hidden lg:block\",\"children\":[\"$\",\"div\",null,{\"className\":\"sticky top-32\",\"children\":[\"$\",\"$L44\",null,{\"title\":\"AI That Can See Your Screen and Answer Questions (2026)\",\"url\":\"https://voiceos.com/blog/ai-that-can-see-your-screen-and-answer-questions\"}]}]}]\n31:[\"$\",\"div\",null,{\"className\":\"lg:hidden mt-8 flex justify-center\",\"children\":[\"$\",\"$L44\",null,{\"title\":\"