ateX(-10px)" href="/features/agent"><div class="absolute inset-0 rounded-[22px] opacity-0 transition-opacity duration-200 group-hover:opacity-100 group-active:opacity-100" style="background:rgba(255,255,255,0.48)"></div><span class="relative z-10 block font-semibold text-gray-900">Agent Mode</span></a><a class="group relative block rounded-[22px] px-3.5 py-2.5 transition-colors duration-200" style="transition-delay:0ms;opacity:0;transform:translateX(-10px)" href="/features/dictation"><div class="absolute inset-0 rounded-[22px] opacity-0 transition-opacity duration-200 group-hover:opacity-100 group-active:opacity-100" style="background:rgba(255,255,255,0.48)"></div><span class="relative z-10 block font-semibold text-gray-900">Dictation Mode</span></a><a class="group relative block rounded-[22px] px-3.5 py-2.5 transition-colors duration-200" style="transition-delay:0ms;opacity:0;transform:translateX(-10px)" href="/pricing"><div class="absolute inset-0 rounded-[22px] opacity-0 transition-opacity duration-200 group-hover:opacity-100 group-active:opacity-100" style="background:rgba(255,255,255,0.48)"></div><span class="relative z-10 block font-semibold text-gray-900">Pricing</span></a><a class="group relative block rounded-[22px] px-3.5 py-2.5 transition-colors duration-200" style="transition-delay:0ms;opacity:0;transform:translateX(-10px)" href="/about"><div class="absolute inset-0 rounded-[22px] opacity-0 transition-opacity duration-200 group-hover:opacity-100 group-active:opacity-100" style="background:rgba(255,255,255,0.48)"></div><span class="relative z-10 block font-semibold text-gray-900">About</span></a><a class="group relative block rounded-[22px] px-3.5 py-2.5 transition-colors duration-200" style="transition-delay:0ms;opacity:0;transform:translateX(-10px)" href="/blog"><div class="absolute inset-0 rounded-[22px] opacity-0 transition-opacity duration-200 group-hover:opacity-100 group-active:opacity-100" style="background:rgba(255,255,255,0.48)"></div><span class="relative z-10 block font-semibold text-gray-900">Blogs</span></a><a class="group relative block rounded-[22px] px-3.5 py-2.5 transition-colors duration-200" style="transition-delay:0ms;opacity:0;transform:translateX(-10px)" href="/app-store"><div class="absolute inset-0 rounded-[22px] opacity-0 transition-opacity duration-200 group-hover:opacity-100 group-active:opacity-100" style="background:rgba(255,255,255,0.48)"></div><span class="relative z-10 block font-semibold text-gray-900">App Store</span></a><a href="https://partners.dub.co/voice-os" target="_blank" rel="noopener noreferrer" class="group relative block rounded-[22px] px-3.5 py-2.5 transition-colors duration-200" style="transition-delay:0ms;opacity:0;transform:translateX(-10px)"><div class="absolute inset-0 rounded-[22px] opacity-0 transition-opacity duration-200 group-hover:opacity-100 group-active:opacity-100" style="background:rgba(255,255,255,0.48)"></div><span class="relative z-10 block font-semibold text-gray-900">Affiliates</span></a></div><div class="absolute bottom-0 left-6 right-6 h-px pointer-events-none" style="background:linear-gradient(90deg, transparent, rgba(15,23,42,0.06), transparent)"></div></div></div></div></nav><div class="px-4 md:px-6 pt-32 md:pt-44 pb-16 md:pb-24"><div class="max-w-7xl mx-auto"><div class="lg:grid lg:gap-10 lg:[grid-template-columns:220px_minmax(0,1fr)_60px]"><aside class="hidden lg:block"><div class="sticky top-32"><div class="rounded-xl p-5" style="background-color:#fff;border:1px solid #eee"><div class="flex items-center gap-2 mb-4"><svg class="w-4 h-4" style="color:#666" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" stroke-width="1.5"></circle><path stroke-linecap="round" stroke-width="1.5" d="M12 6v6l4 2"></path></svg><span class="text-sm" style="color:#666">10 min read</span></div><p class="text-sm font-semibold mb-3" style="color:#0a0a0a">Table of contents</p><nav class="space-y-1"><a href="#quick-answer" class="block py-1.5 text-[13px] leading-snug transition-colors duration-200 border-l-2" style="padding-left:12px;border-color:transparent;color:#999;font-weight:400">Is there an AI that can see my screen and answer questions?</a><a href="#key-takeaways" class="block py-1.5 text-[13px] leading-snug transition-colors duration-200 border-l-2" style="padding-left:12px;border-color:transparent;color:#999;font-weight:400">Key Takeaways</a><a href="#the-problem" class="block py-1.5 text-[13px] leading-snug transition-colors duration-200 border-l-2" style="padding-left:12px;border-color:transparent;color:#999;font-weight:400">&quot;How do I do this?&quot; is where work goes to die</a><a href="#what-it-is" class="block py-1.5 text-[13px] leading-snug transition-colors duration-200 border-l-2" style="padding-left:12px;border-color:transparent;color:#999;font-weight:400">How an AI reads your screen and answers questions</a><a href="#why-now" class="block py-1.5 text-[13px] leading-snug transition-colors duration-200 border-l-2" style="padding-left:12px;border-color:transparent;color:#999;font-weight:400">How AI can scan your screen and understand it</a><a href="#what-changes" class="block py-1.5 text-[13px] leading-snug transition-colors duration-200 border-l-2" style="padding-left:12px;border-color:transparent;color:#999;font-weight:400">What changes when your computer can see what you see</a><a href="#meet-voiceos" class="block py-1.5 text-[13px] leading-snug transition-colors duration-200 border-l-2" style="padding-left:12px;border-color:transparent;color:#999;font-weight:400">Meet your screen-aware voice assistant: VoiceOS</a><a href="#point-to-understand" class="block py-1.5 text-[13px] leading-snug transition-colors duration-200 border-l-2" style="padding-left:12px;border-color:transparent;color:#999;font-weight:400">Use your mouse cursor to point at what you mean</a><a href="#seeing-to-doing" class="block py-1.5 text-[13px] leading-snug transition-colors duration-200 border-l-2" style="padding-left:12px;border-color:transparent;color:#999;font-weight:400">When seeing your screen turns into doing the work</a><a href="#how-to-start" class="block py-1.5 text-[13px] leading-snug transition-colors duration-200 border-l-2" style="padding-left:12px;border-color:transparent;color:#999;font-weight:400">How to start</a><a href="#faq" class="block py-1.5 text-[13px] leading-snug transition-colors duration-200 border-l-2" style="padding-left:12px;border-color:transparent;color:#999;font-weight:400">Frequently Asked Questions (FAQ)</a></nav></div></div></aside><div><a class="inline-flex items-center gap-2 text-sm text-gray-500 hover:text-gray-900 transition-colors duration-200 mb-10" href="/blog"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 19l-7-7 7-7"></path></svg>All posts</a><div class="mb-6"><span style="color:#0f172a;font-size:12px;font-weight:600;letter-spacing:0.14em;text-transform:uppercase;line-height:1">Analysis</span></div><h1 style="font-size:clamp(2rem, 6vw, 3.25rem);font-weight:600;line-height:1.15;color:#0a0a0a;letter-spacing:-0.03em">AI That Can See Your Screen and Answer Questions (2026)</h1><p class="mt-5" style="font-size:clamp(1.125rem, 2.5vw, 1.375rem);font-weight:300;line-height:1.6;color:#555">Looking for an AI that reads your screen and answers questions? VoiceOS can look at what is on your Mac or Windows screen when you ask, understand the page, message, form, or app in front of you, and answer by voice. You can even point or draw with your mouse cursor to show it exactly what you mean.</p><div class="flex items-center gap-5 mt-8 pb-8" style="border-bottom:1px solid #eee"><img alt="Jonah Daian" loading="lazy" width="40" height="40" decoding="async" data-nimg="1" class="rounded-full flex-shrink-0" style="color:transparent;object-fit:cover" srcSet="/_next/image?url=%2FjonahBlogProfile.png&amp;w=48&amp;q=75 1x, /_next/image?url=%2FjonahBlogProfile.png&amp;w=96&amp;q=75 2x" src="/_next/image?url=%2FjonahBlogProfile.png&amp;w=96&amp;q=75"/><div class="flex items-center gap-6"><div><p class="text-xs" style="color:#999;margin-bottom:2px">Written by</p><p class="text-sm font-semibold" style="color:#0a0a0a">Jonah Daian</p></div><div style="border-left:1px solid #e5e5e5;padding-left:24px"><p class="text-xs" style="color:#999;margin-bottom:2px">Last updated</p><p class="text-sm font-semibold" style="color:#0a0a0a">August 30, 2026</p></div></div></div><img alt="AI That Can See Your Screen and Answer Questions (2026)" width="1200" height="630" decoding="async" data-nimg="1" class="w-full mt-8" style="color:transparent;object-fit:cover;border-radius:16px" srcSet="/_next/image?url=%2Fblogs%2Fai-that-can-see-your-screen-2026.jpg&amp;w=1200&amp;q=75 1x, /_next/image?url=%2Fblogs%2Fai-that-can-see-your-screen-2026.jpg&amp;w=3840&amp;q=75 2x" src="/_next/image?url=%2Fblogs%2Fai-that-can-see-your-screen-2026.jpg&amp;w=3840&amp;q=75"/><article class="mt-12"><section class="mb-10" id="quick-answer"><div class="comparison-answer-glass p-6 md:p-8" style="border-radius:22px"><h2 style="font-size:clamp(1.5rem, 4vw, 2rem);font-weight:500;line-height:1.3;color:#0a0a0a;letter-spacing:-0.02em;margin-bottom:0.75rem">Is there an AI that can see my screen and answer questions?</h2><p style="font-size:1.0625rem;font-weight:400;line-height:1.8;color:#1f2937;margin:0">Yes. VoiceOS is an AI that can see your screen and answer questions on Mac and Windows. Turn on “Point and ask about your screen,” hold your Agent Mode trigger, and ask about whatever you are looking at. VoiceOS reads the current screen only when you invoke it, uses your mouse cursor or blue drawing trail to identify the exact area you mean, and answers in the notch.</p><div class="glassmorphic-button-wrap comparison-glass-cta-wrap mt-6"><a class="glassmorphic-button comparison-glass-cta" href="/"><span>Download VoiceOS</span></a><div class="glassmorphic-button-shadow"></div></div></div></section><section class="mb-16" id="key-takeaways"><div class="rounded-2xl p-6 md:p-8" style="background-color:#fff;border:1px solid #eee"><h2 style="font-size:clamp(1.5rem, 4vw, 2rem);font-weight:500;line-height:1.3;color:#0a0a0a;letter-spacing:-0.02em;margin-bottom:1rem">Key Takeaways</h2><ul class="space-y-3"><li class="flex gap-3" style="font-size:1.0625rem;font-weight:400;line-height:1.8;color:#444"><span class="flex-shrink-0 w-2 h-2 rounded-full" style="background-color:#0a0a0a;margin-top:0.65em"></span><span>An AI that reads your screen and answers questions is often called a screen-aware or multimodal AI assistant. It can understand visible text, charts, buttons, errors, and app layouts instead of making you describe them from memory.</span></li><li class="flex gap-3" style="font-size:1.0625rem;font-weight:400;line-height:1.8;color:#444"><span class="flex-shrink-0 w-2 h-2 rounded-full" style="background-color:#0a0a0a;margin-top:0.65em"></span><span>For decades, help lived somewhere else: a search box, a support article, a twelve-minute tutorial. Screen-aware AI brings the help to your screen, in the moment, without you leaving what you are doing.</span></li><li class="flex gap-3" style="font-size:1.0625rem;font-weight:400;line-height:1.8;color:#444"><span class="flex-shrink-0 w-2 h-2 rounded-full" style="background-color:#0a0a0a;margin-top:0.65em"></span><span>This became possible in 2026 because three things arrived at once: fast and accurate speech recognition, multimodal AI that can actually read a screen, and assistants that can reach across all of your apps.</span></li><li class="flex gap-3" style="font-size:1.0625rem;font-weight:400;line-height:1.8;color:#444"><span class="flex-shrink-0 w-2 h-2 rounded-full" style="background-color:#0a0a0a;margin-top:0.65em"></span><span>The everyday payoff is the end of &quot;how do I do this?&quot; You stop switching to a search engine and start asking the thing in front of you, and sometimes it simply does it for you.</span></li><li class="flex gap-3" style="font-size:1.0625rem;font-weight:400;line-height:1.8;color:#444"><span class="flex-shrink-0 w-2 h-2 rounded-full" style="background-color:#0a0a0a;margin-top:0.65em"></span><span>VoiceOS puts a screen-aware voice assistant on Mac and Windows with no complicated setup. Enable “Point and ask about your screen,” press your Agent Mode trigger, and ask about what is in front of you.</span></li><li class="flex gap-3" style="font-size:1.0625rem;font-weight:400;line-height:1.8;color:#444"><span class="flex-shrink-0 w-2 h-2 rounded-full" style="background-color:#0a0a0a;margin-top:0.65em"></span><span>You can point instead of over-explaining. Move your mouse cursor to the exact message, button, or item you mean, or draw a blue loop around a region while you talk. VoiceOS sees the mark together with your screen and question.</span></li></ul></div></section><section class="mb-16" id="the-problem"><h2 style="font-size:clamp(1.5rem, 4vw, 2rem);font-weight:500;line-height:1.3;color:#0a0a0a;letter-spacing:-0.02em;margin-bottom:1.5rem">&quot;How do I do this?&quot; is where work goes to die</h2><p style="font-size:1.0625rem;font-weight:400;line-height:1.8;color:#444;margin-bottom:1.5rem">Everyone knows the feeling. You are in an app you do not use often: a video editor, a spreadsheet full of someone else&#x27;s formulas, a tax portal, a tool your company adopted last week. You know exactly what you want to accomplish. You just cannot find the button, the setting, or the sequence of steps that gets you there.</p><p style="font-size:1.0625rem;font-weight:400;line-height:1.8;color:#444;margin-bottom:1.5rem">So you do what we have all been trained to do. You switch to a browser. You type a half-remembered version of your question. You skim a forum thread from 2021, open a support doc that describes a version of the app that no longer exists, or scrub through a fourteen-minute tutorial to find the ten seconds that actually apply to you. Then you switch back, try to remember what you read, and hope it still lines up with what is on your screen.</p><p style="font-size:1.0625rem;font-weight:400;line-height:1.8;color:#444">That round trip is one of the quietest, most universal taxes in modern work. It is not one big interruption, it is a hundred small ones a week. Every time your question lives in one place and your work lives in another, you pay to carry the answer across the gap. The promise of a screen-aware assistant is simple: close that gap entirely, and let the help live where the problem is.</p><blockquote class="rounded-2xl p-6 md:p-8 mt-8" style="background-color:#fff;border:1px solid #eee;border-left:4px solid #0a0a0a"><p style="font-size:clamp(1.25rem, 3.5vw, 1.625rem);font-weight:500;line-height:1.4;color:#0a0a0a;letter-spacing:-0.01em;font-style:italic">&quot;What if the help could simply look at your screen with you?&quot;</p></blockquote></section><section class="mb-16" id="what-it-is"><h2 style="font-size:clamp(1.5rem, 4vw, 2rem);font-weight:500;line-height:1.3;color:#0a0a0a;letter-spacing:-0.02em;margin-bottom:1.5rem">How an AI reads your screen and answers questions</h2><p style="font-size:1.0625rem;font-weight:400;line-height:1.8;color:#444;margin-bottom:1.5rem">A screen-aware AI assistant is software that can do three things a search box never could: see, understand, and act. An AI that looks at your screen receives the visible screen as context alongside your spoken question, so the two are interpreted together.</p><p style="font-size:1.0625rem;font-weight:400;line-height:1.8;color:#444;margin-bottom:1.5rem">It can see, because with your permission it reads what is currently on your screen, the way a knowledgeable friend leaning over your shoulder would. It can understand, because modern multimodal AI does not just scan the text on the page. It recognizes the app, layout, error message, chart, and state you are in, then connects those details to what you are asking. And it can act, because instead of only describing the steps, it can walk you through them or carry them out for you.</p><p style="font-size:1.0625rem;font-weight:400;line-height:1.8;color:#444">Contrast that with the help we have lived with for thirty years. A support article is static, generic, and written for the average user, not for you and the exact screen you are staring at. A search result does not know which app you are in. A chatbot in a separate window cannot see your work at all, so you have to describe your situation to it in words, which is often harder than the original problem. Screen-aware AI removes that translation step. You do not have to explain your screen, because it is already looking at it.</p><div class="rounded-2xl p-5 mt-6" style="background-color:#fff;border:1px solid #eee"><p style="font-size:0.9375rem;font-weight:400;line-height:1.8;color:#444;margin:0">Related: <a style="color:#0a0a0a;text-decoration:underline;text-decoration-color:#0a0a0a40;text-underline-offset:2px;font-weight:500" href="/blog/what-is-a-voice-operating-system">What Is a Voice Operating System?</a> · <a style="color:#0a0a0a;text-decoration:underline;text-decoration-color:#0a0a0a40;text-underline-offset:2px;font-weight:500" href="/blog/voice-is-the-new-interface">Voice Is the New Interface</a></p></div></section><section class="mb-16" id="why-now"><h2 style="font-size:clamp(1.5rem, 4vw, 2rem);font-weight:500;line-height:1.3;color:#0a0a0a;letter-spacing:-0.02em;margin-bottom:1.5rem">How AI can scan your screen and understand it</h2><p style="font-size:1.0625rem;font-weight:400;line-height:1.8;color:#444;margin-bottom:1.5rem">The idea of an AI that can watch your screen and help is not new. It is decades old. What changed is that three separate technologies matured at the same time, and only together do they add up to something that actually works.</p><p style="font-size:1.0625rem;font-weight:400;line-height:1.8;color:#444;margin-bottom:1.5rem">The first is speech recognition that is fast and accurate enough to feel like conversation, not like fighting with a phone menu. The second is multimodal AI, models that can look at an image of your screen and genuinely comprehend it, reading not just the words but the meaning of a layout, a chart, a dialog box, or an error. The third is system-wide reach, an assistant that is not trapped inside a single app but can sit across your whole computer and touch the tools where your work actually happens.</p><p style="font-size:1.0625rem;font-weight:400;line-height:1.8;color:#444">Any one of these on its own is a demo. Put all three together and you get something new: an assistant you can simply talk to, that already sees what you see, and that can do something about it. That is why 2026 is the year this stopped being a research project and started being software you can download.</p><div class="rounded-2xl p-5 mt-6" style="background-color:#fff;border:1px solid #eee"><p style="font-size:0.9375rem;font-weight:400;line-height:1.8;color:#444;margin:0">Related: <a style="color:#0a0a0a;text-decoration:underline;text-decoration-color:#0a0a0a40;text-underline-offset:2px;font-weight:500" href="/blog/gpt-live-full-duplex-voice">GPT-Live: ChatGPT&#x27;s full-duplex voice makes &#x27;Her&#x27; and JARVIS real</a> · <a style="color:#0a0a0a;text-decoration:underline;text-decoration-color:#0a0a0a40;text-underline-offset:2px;font-weight:500" href="/blog/from-personal-assistant-to-voice-agent">From Personal Assistant to Voice Agent</a></p></div></section><section class="mb-16" id="what-changes"><h2 style="font-size:clamp(1.5rem, 4vw, 2rem);font-weight:500;line-height:1.3;color:#0a0a0a;letter-spacing:-0.02em;margin-bottom:1.5rem">What changes when your computer can see what you see</h2><p style="font-size:1.0625rem;font-weight:400;line-height:1.8;color:#444;margin-bottom:1.5rem">The first shift is emotional, before it is practical. You stop feeling stuck. When help is always one spoken sentence away, the anxiety of unfamiliar software mostly disappears. You do not have to know the app anymore. You just have to be able to describe what you want.</p><p style="font-size:1.0625rem;font-weight:400;line-height:1.8;color:#444;margin-bottom:1.5rem">Picture the ordinary moments where this matters. A designer opens a professional video tool for the first time and, instead of pausing to find a beginner course, asks out loud how to do the one thing they need right now. An analyst stares at a dense dashboard someone else built and asks what a particular chart is actually telling them. A new hire lands in a sprawling internal app on day one and gets a patient, private guide instead of a forty-page onboarding PDF. Someone filling out a confusing government or banking form asks what a field means before they submit it, not after.</p><p style="font-size:1.0625rem;font-weight:400;line-height:1.8;color:#444">In every one of these cases, the interface stops being a wall you have to decode alone. The screen becomes the conversation. And because the assistant can see exactly what you see, its answer is specific to your situation, not a generic paragraph that assumes a different version, a different layout, or a different problem than the one in front of you.</p></section><section class="mb-16" id="meet-voiceos"><h2 style="font-size:clamp(1.5rem, 4vw, 2rem);font-weight:500;line-height:1.3;color:#0a0a0a;letter-spacing:-0.02em;margin-bottom:1.5rem">Meet your screen-aware voice assistant: VoiceOS</h2><p style="font-size:1.0625rem;font-weight:400;line-height:1.8;color:#444;margin-bottom:1.5rem">VoiceOS is the practical, ready-today version of everything above. It runs system-wide on Mac and Windows, so it is not locked inside one app. It lives in the notch at the top of your Mac, and in the same always-available spot on Windows. It is not something you open and close. It sits there, one word or one tap away, ready the moment you need it.</p><p style="font-size:1.0625rem;font-weight:400;line-height:1.8;color:#444;margin-bottom:1.5rem">Press your trigger and simply talk to it about what is on your screen. What does this setting actually do? Summarize this dashboard for me. What is this error trying to tell me? Walk me through exporting this. Because VoiceOS can look at your screen when you ask it to, its answers are grounded in your real situation, not a generic guess. You are not describing your problem to a chatbot in another window. You are asking the thing in front of you.</p><p style="font-size:1.0625rem;font-weight:400;line-height:1.8;color:#444">And it is built for regular people, not just developers. There is no code to write, no API keys to paste, and no command list to memorize. You download it, grant permission, and start talking. That is the whole setup.</p><figure class="mt-8"><img alt="VoiceOS observing what is displayed on a laptop screen" loading="lazy" width="1672" height="941" decoding="async" data-nimg="1" class="w-full" style="color:transparent;border-radius:16px;border:1px solid #eee" srcSet="/_next/image?url=%2Fblogs%2Fai-that-can-see-your-screen-observing-laptop.jpg&amp;w=1920&amp;q=75 1x, /_next/image?url=%2Fblogs%2Fai-that-can-see-your-screen-observing-laptop.jpg&amp;w=3840&amp;q=75 2x" src="/_next/image?url=%2Fblogs%2Fai-that-can-see-your-screen-observing-laptop.jpg&amp;w=3840&amp;q=75"/><figcaption style="font-size:0.875rem;font-weight:400;line-height:1.8;color:#888;margin-top:0.75rem;text-align:center;margin-bottom:0">VoiceOS reads what&#x27;s on your screen, tells you what it sees, and suggests what to do next.</figcaption></figure><div class="rounded-2xl p-5 mt-6" style="background-color:#fff;border:1px solid #eee"><p style="font-size:0.9375rem;font-weight:400;line-height:1.8;color:#444;margin:0">Related: <a style="color:#0a0a0a;text-decoration:underline;text-decoration-color:#0a0a0a40;text-underline-offset:2px;font-weight:500" href="/blog/hands-free-voice-control-mac-windows">Hands-Free Voice Control for Mac and Windows</a></p></div></section><section class="mb-16" id="point-to-understand"><h2 style="font-size:clamp(1.5rem, 4vw, 2rem);font-weight:500;line-height:1.3;color:#0a0a0a;letter-spacing:-0.02em;margin-bottom:1.5rem">Use your mouse cursor to point at what you mean</h2><p style="font-size:1.0625rem;font-weight:400;line-height:1.8;color:#444;margin-bottom:1.5rem">Talking is not always the fastest way to identify what you mean. On a busy screen full of messages, buttons, photos, and choices, describing the one thing you care about can take longer than the question itself. This is where a second, very human way of communicating comes in: pointing.</p><p style="font-size:1.0625rem;font-weight:400;line-height:1.8;color:#444;margin-bottom:1.5rem">VoiceOS turns the mouse cursor into a visual reference. With “Point and ask about your screen” enabled, hold your Agent Mode trigger and begin speaking. As you move the cursor, a blue trail appears. Point at one item or draw a loop around a region while asking something natural, such as “how should I reply to this?” or “which one should I choose?” When you release the trigger, VoiceOS receives your words together with the marked view of your screen.</p><p style="font-size:1.0625rem;font-weight:400;line-height:1.8;color:#444">That combination makes words like “this,” “that,” and “here” useful. The AI does not have to guess which message, product, or button you meant because your cursor drawing is part of the context it reads. It feels like sitting beside a friend, circling something on the screen, and asking a short question instead of giving a long explanation.</p><figure class="jsx-1197279904 spd-figure"><div role="img" aria-label="Animated VoiceOS demo. A cursor draws a thin blue circle around an email asking for a presentation while the user asks how to reply, then VoiceOS suggests a friendly response in the notch." class="jsx-1197279904 spd-frame"><div style="--spd-s:1;opacity:0" aria-hidden="true" class="jsx-1197279904 spd-canvas"><div class="jsx-1197279904 spd-menubar"></div><div class="jsx-1197279904 spd-window"><header class="jsx-1197279904 spd-titlebar"><span class="jsx-1197279904 spd-lights"><i class="jsx-1197279904"></i><i class="jsx-1197279904"></i><i class="jsx-1197279904"></i></span><img alt="Outlook app icon" loading="lazy" width="40" height="40" decoding="async" data-nimg="1" class="spd-ol-logo" style="color:transparent" srcSet="/_next/image?url=%2Ficons%2FoutlookApp.webp&amp;w=48&amp;q=75 1x, /_next/image?url=%2Ficons%2FoutlookApp.webp&amp;w=96&amp;q=75 2x" src="/_next/image?url=%2Ficons%2FoutlookApp.webp&amp;w=96&amp;q=75"/><strong class="jsx-1197279904">Outlook</strong><div class="jsx-1197279904 spd-search"><svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><circle cx="7" cy="7" r="4.4"></circle><path d="m10.3 10.3 3.2 3.2"></path></svg><span class="jsx-1197279904">Search</span></div><div class="jsx-1197279904 spd-tb-right"><svg viewBox="0 0 16 16" fill="none" class="jsx-1197279904"><path d="M8 2.2a3.9 3.9 0 0 1 3.9 3.9c0 3 1.3 4.2 1.3 4.2H2.8s1.3-1.2 1.3-4.2A3.9 3.9 0 0 1 8 2.2ZM6.7 12.6a1.4 1.4 0 0 0 2.6 0" class="jsx-1197279904"></path></svg><b class="jsx-1197279904">JD</b></div></header><div class="jsx-1197279904 spd-body"><section class="jsx-1197279904 spd-list"><div class="jsx-1197279904 spd-list-head"><strong class="jsx-1197279904">Inbox</strong><svg viewBox="0 0 12 12" fill="none" class="jsx-1197279904"><path d="m3 4.6 3 3 3-3" class="jsx-1197279904"></path></svg><svg viewBox="0 0 14 14" fill="none" class="jsx-1197279904 spd-filter"><path d="M2 3.5h10M4 7h6M5.6 10.5h2.8" class="jsx-1197279904"></path></svg></div><div class="jsx-1197279904 spd-tabs"><span class="jsx-1197279904 is-on">Focused</span><span class="jsx-1197279904">Other</span></div><article class="jsx-1197279904 is-selected"><span style="background:#3977c3" class="jsx-1197279904 spd-row-avatar">MC</span><span class="jsx-1197279904 spd-row-text"><strong class="jsx-1197279904">Maya Chen</strong><b class="jsx-1197279904">Friday presentation</b><p class="jsx-1197279904">Could you send me the updated presentation before Friday’s meeting?</p></span><time class="jsx-1197279904">9:32</time></article><article class="jsx-1197279904 "><span style="background:#8764b8" class="jsx-1197279904 spd-row-avatar">PS</span><span class="jsx-1197279904 spd-row-text"><strong class="jsx-1197279904">Priya Shah</strong><b class="jsx-1197279904">Quarterly planning</b><p class="jsx-1197279904">Here are the notes from our last conversation…</p></span><time class="jsx-1197279904">8:45</time></article><article class="jsx-1197279904 "><span style="background:#498205" class="jsx-1197279904 spd-row-avatar">LA</span><span class="jsx-1197279904 spd-row-text"><strong class="jsx-1197279904">Luis Alvarez</strong><b class="jsx-1197279904">Dinner next week?</b><p class="jsx-1197279904">Would Tuesday work for everyone?</p></span><time class="jsx-1197279904">Yesterday</time></article><article class="jsx-1197279904 "><span style="background:#ae4794" class="jsx-1197279904 spd-row-avatar">AM</span><span class="jsx-1197279904 spd-row-text"><strong class="jsx-1197279904">Ava Martin</strong><b class="jsx-1197279904">Design sync notes</b><p class="jsx-1197279904">Sharing the takeaways from today…</p></span><time class="jsx-1197279904">Tue</time></article><article class="jsx-1197279904 "><span style="background:#0b6a53" class="jsx-1197279904 spd-row-avatar">NK</span><span class="jsx-1197279904 spd-row-text"><strong class="jsx-1197279904">Noah Kim</strong><b class="jsx-1197279904">Invoice #2041</b><p class="jsx-1197279904">The updated invoice is attached…</p></span><time class="jsx-1197279904">Mon</time></article><article class="jsx-1197279904 "><span style="background:#b06a00" class="jsx-1197279904 spd-row-avatar">ER</span><span class="jsx-1197279904 spd-row-text"><strong class="jsx-1197279904">Emma Ruiz</strong><b class="jsx-1197279904">Team offsite</b><p class="jsx-1197279904">Quick poll for offsite dates…</p></span><time class="jsx-1197279904">Mon</time></article></section><section class="jsx-1197279904 spd-read"><h3 class="jsx-1197279904">Friday presentation</h3><div class="jsx-1197279904 spd-msg-head"><span class="jsx-1197279904 spd-msg-avatar">MC</span><span class="jsx-1197279904 spd-msg-who"><strong class="jsx-1197279904">Maya Chen</strong><em class="jsx-1197279904">maya@example.com</em><small class="jsx-1197279904">To: Jonah Daian</small></span><span class="jsx-1197279904 spd-msg-side"><time class="jsx-1197279904">9:32 AM</time><svg viewBox="0 0 16 16" fill="none" class="jsx-1197279904"><path d="M6.4 4 3 7.2l3.4 3.2M3.4 7.2h5.4a4 4 0 0 1 4 4v1" class="jsx-1197279904"></path></svg></span></div><div class="jsx-1197279904 spd-msg-body"><p class="jsx-1197279904">Hi Jonah,</p><p class="jsx-1197279904">Could you send me the updated presentation before Friday’s meeting?</p><p class="jsx-1197279904">Thank you!</p><p class="jsx-1197279904">Maya</p></div></section></div></div><div class="jsx-1197279904 spd-overlay"><svg viewBox="0 0 880 513" fill="none" class="jsx-1197279904 spd-ink"><path d="M 404 271 C 480 260, 585 257, 660 264 C 745 272, 795 287, 798 307 C 800 331, 730 345, 640 348 C 540 351, 424 346, 380 330 C 348 317, 354 287, 404 275 C 442 266, 492 261, 540 259" pathLength="100" class="jsx-1197279904 spd-ink-glow"></path><path d="M 404 271 C 480 260, 585 257, 660 264 C 745 272, 795 287, 798 307 C 800 331, 730 345, 640 348 C 540 351, 424 346, 380 330 C 348 317, 354 287, 404 275 C 442 266, 492 261, 540 259" pathLength="100" class="jsx-1197279904 spd-ink-core"></path></svg><div class="jsx-1197279904 spd-hint"><svg viewBox="0 0 24 24" aria-hidden="true" class="jsx-1197279904"><path d="M4.037 4.688a.495.495 0 0 1 .651-.651l16 6.5a.5.5 0 0 1-.063.947l-6.124 1.58a2 2 0 0 0-1.438 1.435l-1.579 6.126a.5.5 0 0 1-.947.063z" class="jsx-1197279904"></path></svg>Point to show VoiceOS</div><div style="offset-path:path(&quot;M 838 456 C 772 420, 566 326, 404 271 C 480 260, 585 257, 660 264 C 7