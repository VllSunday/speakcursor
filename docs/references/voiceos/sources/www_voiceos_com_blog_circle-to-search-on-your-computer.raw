+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"{\\\"@context\\\":\\\"https://schema.org\\\",\\\"@type\\\":\\\"WebSite\\\",\\\"@id\\\":\\\"https://www.voiceos.com/#website\\\",\\\"url\\\":\\\"https://www.voiceos.com\\\",\\\"name\\\":\\\"VoiceOS\\\",\\\"description\\\":\\\"VoiceOS is a voice operating system that turns voice to action. The AI voice assistant for Mac and Windows: dictate, send messages, search the web, and automate apps by voice. Try it free.\\\",\\\"inLanguage\\\":[\\\"en\\\",\\\"ja\\\"],\\\"publisher\\\":{\\\"@id\\\":\\\"https://www.voiceos.com/#organization\\\"}}\"}}],[\"$\",\"link\",null,{\"rel\":\"alternate\",\"type\":\"text/plain\",\"href\":\"/llms.txt\",\"title\":\"LLM-readable site description\"}],[\"$\",\"link\",null,{\"rel\":\"describedby\",\"type\":\"text/plain\",\"href\":\"/llms-full.txt\",\"title\":\"Full LLM-readable VoiceOS documentation\"}],[\"$\",\"link\",null,{\"rel\":\"alternate\",\"type\":\"text/markdown\",\"href\":\"/agents.md\",\"title\":\"VoiceOS agent instructions\"}],[\"$\",\"link\",null,{\"rel\":\"alternate\",\"type\":\"text/markdown\",\"href\":\"/pricing.md\",\"title\":\"VoiceOS machine-readable pricing\"}],[\"$\",\"link\",null,{\"rel\":\"alternate\",\"type\":\"text/markdown\",\"href\":\"/index.md\",\"title\":\"VoiceOS markdown homepage\"}],[\"$\",\"link\",null,{\"rel\":\"alternate\",\"type\":\"application/json\",\"href\":\"/.well-known/agent-card.json\",\"title\":\"VoiceOS agent card\"}],[\"$\",\"link\",null,{\"rel\":\"alternate\",\"type\":\"application/rss+xml\",\"href\":\"/rss.xml\",\"title\":\"VoiceOS Blog RSS Feed\"}],[\"$\",\"link\",null,{\"rel\":\"preload\",\"as\":\"image\",\"href\":\"/skyCloudsHero-mobile.webp\",\"media\":\"(max-width: 767px)\",\"fetchPriority\":\"high\"}],[\"$\",\"link\",null,{\"rel\":\"preload\",\"as\":\"image\",\"href\":\"/skyCloudsHero.webp\",\"media\":\"(min-width: 768px)\",\"fetchPriority\":\"high\"}]]}],[\"$\",\"body\",null,{\"children\":[\"$\",\"$L11\",null,{\"children\":[\"$\",\"$L12\",null,{\"children\":[[\"$\",\"$L13\",null,{}],[\"$\",\"$L14\",null,{\"domainsConfig\":{\"refer\":\"refer.voiceos.com\"},\"cookieOptions\":{\"domain\":\".voiceos.com\"}}],[\"$\",\"$8\",null,{\"fallback\":null,\"children\":[[\"$\",\"$L15\",null,{}],[\"$\",\"$L16\",null,{}],[\"$\",\"$L17\",null,{}],[\"$\",\"$L18\",null,{}]]}],\"$L19\"]}]}]}]]}]\n1a:T545,{\"@context\":\"https://schema.org\",\"@type\":\"BlogPosting\",\"headline\":\"Circle to Search, But for Your Whole Computer\",\"description\":\"On a phone you draw a circle around something on screen and ask about it. Laptops never got that trick. Here is the same gesture on your Mac, and because you can talk while you do it, it goes further.\",\"image\":\"https://www.voiceos.com/blogs/circle-to-search-on-your-computer-v2.png\",\"datePublished\":\"2026-07-29T08:00:00.000Z\",\"dateModified\":\"2026-07-29T08:00:00.000Z\",\"inLanguage\":\"en\",\"author\":{\"@type\":\"Person\",\"name\":\"Kai Brokering\",\"@id\":\"https://www.voiceos.com/authors/kai-brokering#person\",\"url\":\"https://www.voiceos.com/authors/kai-brokering\"},\"publisher\":{\"@type\":\"Organization\",\"name\":\"WakoAI Inc.\",\"url\":\"https://www.voiceos.com\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://www.voiceos.com/voiceOsLogo.png\"}},\"mainEntityOfPage\":{\"@type\":\"WebPage\",\"@id\":\"https://www.voiceos.com/blog/circle-to-search-on-your-computer\"},\"breadcrumb\":{\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://www.voiceos.com/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Blog\",\"item\":\"https://www.voiceos.com/blog\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Circle to Search, But for Your Whole Computer\",\"item\":\"https://www.voiceos.com/blog/circle-to-search-on-your-computer\"}]}}1b:T8b8,{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Is there a Circle to Search for Mac?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Not as a built in Mac feature from Apple or Google. VoiceOS brings the same idea to macOS: hold Control and Option, sweep your cursor over anything on screen, and ask about it out loud. It works on top of any app rather than inside one browser.\"}},{\"@type\":\"Question\",\"name\":\"Do I need an Android emulator to get Circle to Search on my computer?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"No. That advice exists only because there was no desktop version for years. Running a phone app inside an emulator cannot see your actual Mac apps anyway, which is the whole point. A desktop tool that reads your real screen is a better fit.\"}},{\"@type\":\"Question\",\"name\":\"How is this different from Circle to Search on a phone?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"The phone version hands you search results. Here you ask a question in your own words and get an answer about your specific situation, then keep going. You can follow up, or ask it to write a reply based on what you circled.\"}},{\"@type\":\"Question\",\"name\":\"Do I have to draw an actual circle?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"No. Any movement over the thing is enough. A loop, a line under a sentence, or one dot on a button all work the same way. There is no drawing skill involved.\"}},{\"@type\":\"Question\",\"name\":\"Does it work in every app?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes. It is not built into one app, it draws over whatever is on your screen. Browsers, email, PDFs, spreadsheets, chat apps, and full screen apps all behave the same, with no per app setup.\"}},{\"@type\":\"Question\",\"name\":\"Does this work on Windows?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"VoiceOS runs on both Mac and Windows. The point and ask gesture is built and tested on Mac today. On Windows, start with voice typing and Agent Mode, which work there now.\"}},{\"@type\":\"Question\",\"name\":\"How much does it cost?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Pro starts at $11.99 per month when billed annually. Pointing at your screen and asking is part of Agent Mode and is included in Pro.\"}}]}6:[\"$\",\"main\",null,{\"className\":\"min-h-screen\",\"style\":{\"backgroundColor\":\"#F9F9F9\"},\"children\":[[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"$1a\"}}],[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"$1b\"}}],\"$L1c\",\"$L1d\",\"$L1e\"]}]\n1f:I[13826,[\"/_next/static/chunks/2kb52na2e7ces.js\",\"/_next/static/chunks/1xfsu92iq1h9m.js\",\"/_next/static/chunks/3x6-_ejf1r1x0.js\",\"/_next/static/chunks/3051mfl68oz5m.js\",\"/_next/static/chunks/35rx1_qn9m74v.js\",\"/_next/static/chunks/0z6qqa_pcb2c9.js\"],\"default\"]\n20:I[21834,[\"/_next/static/chunks/2kb52na2e7ces.js\",\"/_next/static/chunks/1xfsu92iq1h9m.js\",\"/_next/static/chunks/3x6-_ejf1r1x0.js\",\"/_next/static/chunks/3051mfl68oz5m.js\",\"/_next/static/chunks/35rx1_qn9m74v.js\",\"/_next/static/chunks/0z6qqa_pcb2c9.js\"],\"default\"]\n22:I[5500,[\"/_next/static/chunks/2kb52na2e7ces.js\",\"/_next/static/chunks/1xfsu92iq1h9m.js\",\"/_next/static/chunks/3x6-_ejf1r1x0.js\",\"/_next/static/chunks/3051mfl68oz5m.js\",\"/_next/static/chunks/35rx1_qn9m74v.js\",\"/_next/static/chunks/0z6qqa_pcb2c9.js\"],\"Image\"]\n32:I[40163,[\"/_next/static/chunks/2kb52na2e7ces.js\",\"/_next/static/chunks/1xfsu92iq1h9m.js\",\"/_next/static/chunks/3x6-_ejf1r1x0.js\",\"/_next/static/chunks/3051mfl68oz5m.js\",\"/_next/static/chunks/35rx1_qn9m74v.js\",\"/_next/static/chunks/0z6qqa_pcb2c9.js\"],\"default\"]\n33:I[75696,[\"/_next/static/chunks/2kb52na2e7ces.js\",\"/_next/static/chunks/1xfsu92iq1h9m.js\",\"/_next/static/chunks/3x6-_ejf1r1x0.js\"],\"default\"]\n1c:[\"$\",\"$L1f\",null,{}]\n1d:[\"$\",\"div\",null,{\"className\":\"px-4 md:px-6 pt-32 md:pt-44 pb-16 md:pb-24\",\"children\":[\"$\",\"div\",null,{\"className\":\"ma