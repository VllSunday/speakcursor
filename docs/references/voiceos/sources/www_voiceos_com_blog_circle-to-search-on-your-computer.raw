ateX(-10px)" href="/features/agent"><div class="absolute inset-0 rounded-[22px] opacity-0 transition-opacity duration-200 group-hover:opacity-100 group-active:opacity-100" style="background:rgba(255,255,255,0.48)"></div><span class="relative z-10 block font-semibold text-gray-900">Agent Mode</span></a><a class="group relative block rounded-[22px] px-3.5 py-2.5 transition-colors duration-200" style="transition-delay:0ms;opacity:0;transform:translateX(-10px)" href="/features/dictation"><div class="absolute inset-0 rounded-[22px] opacity-0 transition-opacity duration-200 group-hover:opacity-100 group-active:opacity-100" style="background:rgba(255,255,255,0.48)"></div><span class="relative z-10 block font-semibold text-gray-900">Dictation Mode</span></a><a class="group relative block rounded-[22px] px-3.5 py-2.5 transition-colors duration-200" style="transition-delay:0ms;opacity:0;transform:translateX(-10px)" href="/pricing"><div class="absolute inset-0 rounded-[22px] opacity-0 transition-opacity duration-200 group-hover:opacity-100 group-active:opacity-100" style="background:rgba(255,255,255,0.48)"></div><span class="relative z-10 block font-semibold text-gray-900">Pricing</span></a><a class="group relative block rounded-[22px] px-3.5 py-2.5 transition-colors duration-200" style="transition-delay:0ms;opacity:0;transform:translateX(-10px)" href="/about"><div class="absolute inset-0 rounded-[22px] opacity-0 transition-opacity duration-200 group-hover:opacity-100 group-active:opacity-100" style="background:rgba(255,255,255,0.48)"></div><span class="relative z-10 block font-semibold text-gray-900">About</span></a><a class="group relative block rounded-[22px] px-3.5 py-2.5 transition-colors duration-200" style="transition-delay:0ms;opacity:0;transform:translateX(-10px)" href="/blog"><div class="absolute inset-0 rounded-[22px] opacity-0 transition-opacity duration-200 group-hover:opacity-100 group-active:opacity-100" style="background:rgba(255,255,255,0.48)"></div><span class="relative z-10 block font-semibold text-gray-900">Blogs</span></a><a class="group relative block rounded-[22px] px-3.5 py-2.5 transition-colors duration-200" style="transition-delay:0ms;opacity:0;transform:translateX(-10px)" href="/app-store"><div class="absolute inset-0 rounded-[22px] opacity-0 transition-opacity duration-200 group-hover:opacity-100 group-active:opacity-100" style="background:rgba(255,255,255,0.48)"></div><span class="relative z-10 block font-semibold text-gray-900">App Store</span></a><a href="https://partners.dub.co/voice-os" target="_blank" rel="noopener noreferrer" class="group relative block rounded-[22px] px-3.5 py-2.5 transition-colors duration-200" style="transition-delay:0ms;opacity:0;transform:translateX(-10px)"><div class="absolute inset-0 rounded-[22px] opacity-0 transition-opacity duration-200 group-hover:opacity-100 group-active:opacity-100" style="background:rgba(255,255,255,0.48)"></div><span class="relative z-10 block font-semibold text-gray-900">Affiliates</span></a></div><div class="absolute bottom-0 left-6 right-6 h-px pointer-events-none" style="background:linear-gradient(90deg, transparent, rgba(15,23,42,0.06), transparent)"></div></div></div></div></nav><div class="px-4 md:px-6 pt-32 md:pt-44 pb-16 md:pb-24"><div class="max-w-7xl mx-auto"><div class="lg:grid lg:gap-10 lg:[grid-template-columns:220px_minmax(0,1fr)_60px]"><aside class="hidden lg:block"><div class="sticky top-32"><div class="rounded-xl p-5" style="background-color:#fff;border:1px solid #eee"><div class="flex items-center gap-2 mb-4"><svg class="w-4 h-4" style="color:#666" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" stroke-width="1.5"></circle><path stroke-linecap="round" stroke-width="1.5" d="M12 6v6l4 2"></path></svg><span class="text-sm" style="color:#666">6 min read</span></div><p class="text-sm font-semibold mb-3" style="color:#0a0a0a">Table of contents</p><nav class="space-y-1"><a href="#key-takeaways" class="block py-1.5 text-[13px] leading-snug transition-colors duration-200 border-l-2" style="padding-left:12px;border-color:transparent;color:#999;font-weight:400">Key Takeaways</a><a href="#what-it-is" class="block py-1.5 text-[13px] leading-snug transition-colors duration-200 border-l-2" style="padding-left:12px;border-color:transparent;color:#999;font-weight:400">What Circle to Search actually does</a><a href="#why-laptop" class="block py-1.5 text-[13px] leading-snug transition-colors duration-200 border-l-2" style="padding-left:12px;border-color:transparent;color:#999;font-weight:400">Your laptop never got the trick</a><a href="#same-gesture" class="block py-1.5 text-[13px] leading-snug transition-colors duration-200 border-l-2" style="padding-left:12px;border-color:transparent;color:#999;font-weight:400">The same gesture, on your Mac, with your voice attached</a><a href="#how-to" class="block py-1.5 text-[13px] leading-snug transition-colors duration-200 border-l-2" style="padding-left:12px;border-color:transparent;color:#999;font-weight:400">How to do it, step by step</a><a href="#say-it" class="block py-1.5 text-[13px] leading-snug transition-colors duration-200 border-l-2" style="padding-left:12px;border-color:transparent;color:#999;font-weight:400">Things worth saying out loud</a><a href="#laptop-wins" class="block py-1.5 text-[13px] leading-snug transition-colors duration-200 border-l-2" style="padding-left:12px;border-color:transparent;color:#999;font-weight:400">Three things the laptop version does that a phone cannot</a><a href="#privacy" class="block py-1.5 text-[13px] leading-snug transition-colors duration-200 border-l-2" style="padding-left:12px;border-color:transparent;color:#999;font-weight:400">What it is not doing</a><a href="#faq" class="block py-1.5 text-[13px] leading-snug transition-colors duration-200 border-l-2" style="padding-left:12px;border-color:transparent;color:#999;font-weight:400">Frequently Asked Questions (FAQ)</a></nav></div></div></aside><div><a class="inline-flex items-center gap-2 text-sm text-gray-500 hover:text-gray-900 transition-colors duration-200 mb-10" href="/blog"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 19l-7-7 7-7"></path></svg>All posts</a><div class="mb-6"><span style="color:#0369a1;font-size:12px;font-weight:600;letter-spacing:0.14em;text-transform:uppercase;line-height:1">Guide</span></div><h1 style="font-size:clamp(2rem, 6vw, 3.25rem);font-weight:600;line-height:1.15;color:#0a0a0a;letter-spacing:-0.03em">Circle to Search, But for Your Whole Computer</h1><p class="mt-5" style="font-size:clamp(1.125rem, 2.5vw, 1.375rem);font-weight:300;line-height:1.6;color:#555">On a phone you draw a circle around something on screen and ask about it. Laptops never got that trick. Here is the same gesture on your Mac, and because you can talk while you do it, it goes further.</p><div class="flex items-center gap-5 mt-8 pb-8" style="border-bottom:1px solid #eee"><img alt="Kai Brokering" loading="lazy" width="40" height="40" decoding="async" data-nimg="1" class="rounded-full flex-shrink-0" style="color:transparent;object-fit:cover" srcSet="/_next/image?url=%2FkaiBlogProfile.png&amp;w=48&amp;q=75 1x, /_next/image?url=%2FkaiBlogProfile.png&amp;w=96&amp;q=75 2x" src="/_next/image?url=%2FkaiBlogProfile.png&amp;w=96&amp;q=75"/><div class="flex items-center gap-6"><div><p class="text-xs" style="color:#999;margin-bottom:2px">Written by</p><p class="text-sm font-semibold" style="color:#0a0a0a">Kai Brokering</p></div><div style="border-left:1px solid #e5e5e5;padding-left:24px"><p class="text-xs" style="color:#999;margin-bottom:2px">Last updated</p><p class="text-sm font-semibold" style="color:#0a0a0a">July 29, 2026</p></div></div></div><img alt="Circle to Search, But for Your Whole Computer" width="1200" height="630" decoding="async" data-nimg="1" class="w-full mt-8" style="color:transparent;object-fit:cover;border-radius:16px" srcSet="/_next/image?url=%2Fblogs%2Fcircle-to-search-on-your-computer-v2.png&amp;w=1200&amp;q=75 1x, /_next/image?url=%2Fblogs%2Fcircle-to-search-on-your-computer-v2.png&amp;w=3840&amp;q=75 2x" src="/_next/image?url=%2Fblogs%2Fcircle-to-search-on-your-computer-v2.png&amp;w=3840&amp;q=75"/><article class="mt-12"><section class="mb-16" id="key-takeaways"><div class="rounded-2xl p-6 md:p-8" style="background-color:#fff;border:1px solid #eee"><h2 style="font-size:clamp(1.5rem, 4vw, 2rem);font-weight:500;line-height:1.3;color:#0a0a0a;letter-spacing:-0.02em;margin-bottom:1rem">Key Takeaways</h2><ul class="space-y-3"><li class="flex gap-3" style="font-size:1.0625rem;font-weight:400;line-height:1.8;color:#444"><span class="flex-shrink-0 w-2 h-2 rounded-full" style="background-color:#0a0a0a;margin-top:0.65em"></span><span>Circle to Search is the phone trick where you draw a circle around something on screen and get an answer without leaving the app.</span></li><li class="flex gap-3" style="font-size:1.0625rem;font-weight:400;line-height:1.8;color:#444"><span class="flex-shrink-0 w-2 h-2 rounded-full" style="background-color:#0a0a0a;margin-top:0.65em"></span><span>Laptops never got it. Search for a Mac version and you will find people suggesting an Android emulator.</span></li><li class="flex gap-3" style="font-size:1.0625rem;font-weight:400;line-height:1.8;color:#444"><span class="flex-shrink-0 w-2 h-2 rounded-full" style="background-color:#0a0a0a;margin-top:0.65em"></span><span>VoiceOS gives you the same gesture. Hold Control and Option, sweep your mouse over the thing, and it becomes the subject of your question.</span></li><li class="flex gap-3" style="font-size:1.0625rem;font-weight:400;line-height:1.8;color:#444"><span class="flex-shrink-0 w-2 h-2 rounded-full" style="background-color:#0a0a0a;margin-top:0.65em"></span><span>The difference is your voice. Instead of getting search results back, you ask a real question in your own words.</span></li><li class="flex gap-3" style="font-size:1.0625rem;font-weight:400;line-height:1.8;color:#444"><span class="flex-shrink-0 w-2 h-2 rounded-full" style="background-color:#0a0a0a;margin-top:0.65em"></span><span>It works on top of any app, including full screen windows, and across two or three monitors at once.</span></li></ul></div></section><section class="mb-16" id="what-it-is"><h2 style="font-size:clamp(1.5rem, 4vw, 2rem);font-weight:500;line-height:1.3;color:#0a0a0a;letter-spacing:-0.02em;margin-bottom:1.5rem">What Circle to Search actually does</h2><p style="font-size:1.0625rem;font-weight:400;line-height:1.8;color:#444;margin-bottom:1.5rem">If you have an Android phone you may already know this one. You hold the home button, draw a circle around something on the screen, and results appear for whatever you circled. A jacket in a photo. A word in a language you do not read. A plant. A pair of shoes.</p><p style="font-size:1.0625rem;font-weight:400;line-height:1.8;color:#444;margin-bottom:1.5rem">What people love is not the search. It is that you never left what you were doing. No copying text out, no switching apps, no trying to describe a jacket in words.</p><p style="font-size:1.0625rem;font-weight:400;line-height:1.8;color:#444">The gesture solved one very specific problem, and it is a problem every computer has: it is hard to tell a machine which part of the screen you mean.</p></section><section class="mb-16" id="why-laptop"><h2 style="font-size:clamp(1.5rem, 4vw, 2rem);font-weight:500;line-height:1.3;color:#0a0a0a;letter-spacing:-0.02em;margin-bottom:1.5rem">Your laptop never got the trick</h2><p style="font-size:1.0625rem;font-weight:400;line-height:1.8;color:#444;margin-bottom:1.5rem">Search for a way to do this on a Mac and you will find people recommending that you install an Android emulator. That is how wide the gap is.</p><p style="font-size:1.0625rem;font-weight:400;line-height:1.8;color:#444;margin-bottom:1.5rem">So on laptops we all improvised. Screenshot, crop, open a chat app, drag the image in, then type a sentence explaining what you just sent. It works. It is also five more steps than circling something with your finger.</p><p style="font-size:1.0625rem;font-weight:400;line-height:1.8;color:#444">The strange part is that a laptop should be better at this than a phone. You already have a pointer, a keyboard, and a microphone sitting right there. Nobody had wired them together.</p><div class="rounded-2xl p-5 mt-6" style="background-color:#fff;border:1px solid #eee"><p style="font-size:0.9375rem;font-weight:400;line-height:1.8;color:#444;margin:0">Related: <a style="color:#0a0a0a;text-decoration:underline;text-decoration-color:#0a0a0a40;text-underline-offset:2px;font-weight:500" href="/blog/stop-sending-screenshots-to-chatgpt">Stop Sending Screenshots to ChatGPT Just to Ask a Question</a></p></div></section><section class="mb-16" id="same-gesture"><h2 style="font-size:clamp(1.5rem, 4vw, 2rem);font-weight:500;line-height:1.3;color:#0a0a0a;letter-spacing:-0.02em;margin-bottom:1.5rem">The same gesture, on your Mac, with your voice attached</h2><p style="font-size:1.0625rem;font-weight:400;line-height:1.8;color:#444;margin-bottom:1.5rem">Here is what it looks like in VoiceOS. You hold two keys, Control and Option. Your cursor turns into a crosshair and a small label appears beside it that reads “Point to show VoiceOS”.</p><p style="font-size:1.0625rem;font-weight:400;line-height:1.8;color:#444;margin-bottom:1.5rem">Now move your mouse over whatever you care about. A blue trail follows your cursor like a highlighter. Loop it around a chart, run a line under a sentence, or drop a single dot on a button.</p><p style="font-size:1.0625rem;font-weight:400;line-height:1.8;color:#444;margin-bottom:1.5rem">While you do that, you talk. This is the part the phone gesture does not have. You are not stuck with “what is this”. You can ask whether the price is any good, what the error means, how to reply to the message, or which of two options is better.</p><p style="font-size:1.0625rem;font-weight:400;line-height:1.8;color:#444">Let go of the keys and your question arrives together with a picture of your screen and your mark on it. That is the whole reason the word “this” starts working.</p><figure class="mt-8"><div class="w-full aspect-video rounded-2xl overflow-hidden shadow-lg bg-gray-100"><div class="jsx-603730fb00e01a9f relative w-full h-full"><video src="/stopScreenshotsDemo.mp4" poster="/stopScreenshotsDemo-poster.webp" aria-label="Circling something on screen and asking VoiceOS about it" muted="" loop="" playsInline="" preload="none" class="jsx-603730fb00e01a9f w-full h-full object-cover cursor-pointer "></video><button type="button" aria-label="Unmute videos" aria-pressed="false" class="jsx-603730fb00e01a9f absolute bottom-3 right-3 z-10 grid h-8 w-8 place-items-center rounded-full bg-black/25 text-white/80 opacity-40 backdrop-blur-sm transition-opacity duration-200 hover:opacity-100 focus:outline-none focus-visible:opacity-100 focus-visible:ring-2 focus-visible:ring-white/80"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 5L6 9H2v6h4l5 4V5z"></path><path d="M23 9l-6 6"></path><path d="M17 9l6 6"></path></svg></button><div class="jsx-603730fb00e01a9f dv-caption-slot pointer-events-none absolute inset-x-0 bottom-0 flex justify-center pb-3 pl-3 pr-14"><p class="jsx-603730fb00e01a9f dv-caption"><span aria-hidden="true" class="jsx-603730fb00e01a9f dv-quote">“</span><span style="--delay:0ms" class="jsx-603730fb00e01a9f dv-word">Can</span> <span style="--delay:90ms" class="jsx-603730fb00e01a9f dv-word">you</span> <span style="--delay:180ms" class="jsx-603730fb00e01a9f dv-word">find</span> <span style="--delay:270ms" class="jsx-603730fb00e01a9f dv-word">his</span> <span style="--delay:360ms" class="jsx-603730fb00e01a9f dv-word">LinkedIn</span><span aria-hidden="true" class="jsx-603730fb00e01a9f dv-quote">”</span></p></div></div></div><figcaption style="font-size:0.875rem;color:#888;text-align:center;margin-top:0.75rem;line-height:1.6">The same gesture as a phone, on a Mac: sweep the cursor over the thing, then say what you want to know.</figcaption></figure><div class="rounded-2xl p-5 mt-6" style="background-color:#fff;border:1px solid #eee"><p style="font-size:0.9375rem;font-weight:400;line-height:1.8;color:#444;margin:0">Related: <a style="color:#0a0a0a;text-decoration:underline;text-decoration-color:#0a0a0a40;text-underline-offset:2px;font-weight:500" href="/blog/google-ai-pointer-voice-operating-system">Google’s AI Pointer and the reinvented cursor</a> · <a style="color:#0a0a0a;text-decoration:underline;text-decoration-color:#0a0a0a40;text-underline-offset:2px;font-weight:500" href="/blog/ai-that-can-see-your-screen">The AI That Helps You With Whatever’s on Your Screen</a></p></div></section><section class="mb-16" id="how-to"><h2 style="font-size:clamp(1.5rem, 4vw, 2rem);font-weight:500;line-height:1.3;color:#0a0a0a;letter-spacing:-0.02em;margin-bottom:1.5rem">How to do it, step by step</h2><p style="font-size:1.0625rem;font-weight:400;line-height:1.8;color:#444;margin-bottom:1.5rem">First, switch it on once. In VoiceOS settings, turn on “Ask about your screen”. Your Mac asks for screen permission at that moment. That is the only setup.</p><p style="font-size:1.0625rem;font-weight:400;line-height:1.8;color:#444;margin-bottom:1.5rem">After that, any time you want it: hold Control and Option, wait for the crosshair, then move your mouse over the thing you mean while you say your question out loud.</p><p style="font-size:1.0625rem;font-weight:400;line-height:1.8;color:#444">Let go of the keys when you stop talking. You never click and you never drag. Moving the mouse is the entire gesture.</p></section><section class="mb-16" id="say-it"><h2 style="font-size:clamp(1.5rem, 4vw, 2rem);font-weight:500;line-height:1.3;color:#0a0a0a;letter-spacing:-0.02em;margin-bottom:1.5rem">Things worth saying out loud</h2><p style="font-size:1.0625rem;font-weight:400;line-height:1.8;color:#444;margin-bottom:1.5rem">Each of these assumes you are sweeping over something while you speak.</p><div class="space-y-4"><div class="rounded-2xl p-5 md:p-6" style="background-color:#fff;border:1px solid #eee"><div class="flex items-center gap-2 mb-3"><svg class="w-3.5 h-3.5 flex-shrink-0" style="color:#126ff6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><rect x="9" y="3" width="6" height="11" rx="3" stroke-width="1.5"></rect><path stroke-linecap="round" stroke-width="1.5" d="M5 11a7 7 0 0 0 14 0M12 18v3"></path></svg><span style="font-size:0.6875rem;font-weight:600;letter-spacing:0.08em;text-transform:uppercase;color:#126ff6">Say</span></div><p style="font-size:1.0625rem;font-weight:500;line-height:1.6;color:#0a0a0a;margin-bottom:0.625rem">“<!-- -->What is this, and is that a good price?<!-- -->”</p><p style="font-size:0.875rem;line-height:1.6;color:#777;margin:0">Loop around a product on any shopping page.</p></div><div class="rounded-2xl p-5 md:p-6" style="background-color:#fff;border:1px solid #eee"><div class="flex items-center gap-2 mb-3"><svg class="w-3.5 h-3.5 flex-shrink-0" style="color:#126ff6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><rect x="9" y="3" width="6" height="11" rx="3" stroke-width="1.5"></rect><path stroke-linecap="round" stroke-width="1.5" d="M5 11a7 7 0 0 0 14 0M12 18v3"></path></svg><span style="font-size:0.6875rem;font-weight:600;letter-spacing:0.08em;text-transform:uppercase;color:#126ff6">Say</span></div><p style="font-size:1.0625rem;font-weight:500;line-height:1.6;color:#0a0a0a;margin-bottom:0.625rem">“<!-- -->Translate this for me.<!-- -->”</p><p style="font-size:0.875rem;line-height:1.6;color:#777;margin:0">Menus, forms, and screenshots people send you.</p></div><div class="rounded-2xl p-5 md:p-6" style="background-color:#fff;border:1px solid #eee"><div class="flex items-center gap-2 mb-3"><svg class="w-3.5 h-3.5 flex-shrink-0" style="color:#126ff6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><rect x="9" y="3" width="6" height="11" rx="3" stroke-width="1.5"></rect><path stroke-linecap="round" stroke-width="1.5" d="M5 11a7 7 0 0 0 14 0M12 18v3"></path></svg><span style="font-size:0.6875rem;font-weight:600;letter-spacing:0.08em;text-transform:uppercase;color:#126ff6">Say</span></div><p style="font-size:1.0625rem;font-weight:500;line-height:1.6;color:#0a0a0a;margin-bottom:0.625rem">“<!-- -->Which of these two is the better deal?<!-- -->”</p><p style="font-size:0.875rem;line-height:1.6;color:#777;margin:0">Sweep across both options in one go.</p></div><div class="rounded-2xl p-5 md:p-6" style="background-color:#fff;border:1px solid #eee"><div class="flex items-center gap-2 mb-3"><svg class="w-3.5 h-3.5 flex-shrink-0" style="color:#126ff6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><rect x="9" y="3" width="6" height="11" rx="3" stroke-width="1.5"></rect><path stroke-linecap="round" stroke-width="1.5" d="M5 11a7 7 0 0 0 14 0M12 18v3"></path></svg><span style="font-size:0.6875rem;font-weight:600;letter-spacing:0.08em;text-transform:uppercase;color:#126ff6">Say</span></div><p style="font-size:1.0625rem;font-weight:500;line-height:1.6;color:#0a0a0a;margin-bottom:0.625rem">“<!-- -->Explain this chart like I have never seen one before.<!-- -->”</p><p style="font-size:0.875rem;line-height:1.6;color:#777;margin:0">Point at the confusing axis, not the whole page.</p></div></div></section><section class="mb-16" id="laptop-wins"><h2 style="font-size:clamp(1.5rem, 4vw, 2rem);font-weight:500;line-height:1.3;color:#0a0a0a;letter-spacing:-0.02em;margin-bottom:1.5rem">Three things the laptop version does that a phone cannot</h2><p style="font-size:1.0625rem;font-weight:400;line-height:1.8;color:#444;margin-bottom:1.5rem">It reaches apps a phone does not have. Spreadsheets, design tools, code editors, PDF readers, video calls, full screen video. It sits on top of whatever is already open, so there is no list of supported apps to check first.</p><p style="font-size:1.0625rem;font-weight:400;line-height:1.8;color:#444;margin-bottom:1.5rem">It spans more than one screen. With two monitors you can mark a chart on one and a table on the other inside the same question, and ask about both together.</p><p style="font-size:1.0625rem;font-weight:400;line-height:1.8;color:#444">It can act instead of only answering. You are talking to an assistant, not a search box, so the next thing you say can be “draft a reply to this” rather than another search.</p><div class="rounded-2xl p-5 mt-6" style="background-color:#fff;border:1px solid #eee"><p style="font-size:0.9375rem;font-weight:400;line-height:1.8;color:#444;margin:0">Related: <a style="color:#0a0a0a;text-decoration:underline;text-decoration-color:#0a0a0a40;text-underline-offset:2px;font-weight:500" href="/blog/talk-to-your-computer-to-get-work-done">How to Talk to Your Computer to Get Work Done</a></p></div></section><section class="mb-16" id="privacy"><h2 style="font-size:clamp(1.5rem, 4vw, 2rem);font-weight:500;line-height:1.3;color:#0a0a0a;letter-spacing:-0.02em;margin-bottom:1.5rem">What it is not doing</h2><p style="font-size:1.0625rem;font-weight:400;line-height:1.8;color:#444;margin-bottom:1.5rem">It is not watching your screen. The screen is captured while you hold the keys and ask, and that is the end of it. Nothing records in the background, and no history of your day is being built.</p><p style="font-size:1.0625rem;font-weight:400;line-height:1.8;color:#444;margin-bottom:1.5rem">It also arrives switched off. Until you turn on “Ask about your screen” yourself and grant permission, the feature does nothing at all.</p><p style="font-size:1.0625rem;font-weight:400;line-height:1.8;color:#444">The blue trail is only for you. It does not show up in screen recordings or screen shares, so you can use it in the middle of a meeting and nobody sees it.</p></section><section class="mb-16" id="faq"><h2 style="font-size:clamp(1.5rem, 4vw, 2rem);font-weight:500;line-height:1.3;color:#0a0a0a;letter-spacing:-0.02em;margin-bottom:1.5rem">Frequently Asked Questions (FAQ)</h2><div class="space-y-6"><div class="rounded-2xl p-5 md:p-6" style="background-color:#fff;border:1px solid #eee"><h3 style="font-size:clamp(1.125rem, 3vw, 1.375rem);font-weight:500;line-height:1.4;color:#0a0a0a;margin-bottom:0.5rem">Is there a Circle to Search for Mac?</h3><p style="font-size:0.9375rem;font-weight:400;line-height:1.8;color:#444">Not as a built in Mac feature from Apple or Google. VoiceOS brings the same idea to macOS: hold Control and Option, sweep your cursor over anything on screen, and ask about it out loud. It works on top of any app rather than inside one browser.</p></div><div class="rounded-2xl p-5 md:p-6" style="background-color:#fff;border:1px solid #eee"><h3 style="font-size:clamp(1.125rem, 3vw, 1.375rem);font-weight:500;line-height:1.4;color:#0a0a0a;margin-bottom:0.5rem">Do I need an Android emulator to get Circle to Search on my computer?</h3><p style="font-size:0.9375rem;font-weight:400;line-height:1.8;color:#444">No. That advice exists only because there was no desktop version for years. Running a phone app inside an emulator cannot see your actual Mac apps anyway, which is the whole point. A desktop tool that reads your real screen is a better fit.</p></div><div class="rounded-2xl p-5 md:p-6" style="background-color:#fff;border:1px solid #eee"><h3 style="font-size:clamp(1.125rem, 3vw, 1.375rem);font-weight:500;line-height:1.4;color:#0a0a0a;margin-bottom:0.5rem">How is this different from Circle to Search on a phone?</h3><p style="font-size:0.9375rem;font-weight:400;line-height:1.8;color:#444">The phone version hands you search results. Here you ask a question in your own words and get an answer about your specific situation, then keep going. You can follow up, or ask it to write a reply based on what you circled.</p></div><div class="rounded-2xl p-5 md:p-6" style="background-color:#fff;border:1px solid #eee"><h3 style="font-size:clamp(1.125rem, 3vw, 1.375rem);font-weight:500;line-height:1.4;color:#0a0a0a;margin-bottom:0.5rem">Do I have to draw an actual circle?</h3><p style="font-size:0.9375rem;font-weight:400;line-height:1.8;color:#444">No. Any movement over the thing is enough. A loop, a line under a sentence, or one dot on a button all work the same way. There is no drawing skill involved.</p></div><div class="rounded-2xl p-5 md:p-6" style="background-color:#fff;border:1px solid #eee"><h3 style="font-size:clamp(1.125rem, 3vw, 1.375rem);font-weight:500;line-height:1.4;color:#0a0a0a;margin-bottom:0.5rem">Does it work in every app?</h3><p style="font-size:0.9375rem;font-weight:400;line-height:1.8;color:#444">Yes. It is not built into one app, it draws over whatever is on your screen. Browsers, email, PDFs, spreadsheets, chat apps, and full screen apps all behave the same, with no per app setup.</p></div><div class="rounded-2xl p-5 md:p-6" style="background-color:#fff;border:1px solid #eee"><h3 style="font-size:clamp(1.125rem, 3vw, 1.375rem);font-weight:500;line-height:1.4;color:#0a0a0a;margin-bottom:0.5rem">Does this work on Windows?</h3><p style="font-size:0.9375rem;font-weight:400;line-height:1.8;color:#444">VoiceOS runs on both Mac and Windows. The point and ask gesture is built and tested on Mac today. On Windows, start with voice typing and Agent Mode, which work there now.</p></div><div class="rounded-2xl p-5 md:p-6" style="background-color:#fff;border:1px solid #eee"><h3 style="font-size:clamp(1.125rem, 3vw, 1.375rem);font-weight:500;line-height:1.4;color:#0a0a0a;margin-bottom:0.5rem">How much does it cost?</h3><p style="font-size:0.9375rem;font-weight:400;line-height:1.8;color:#444">Pro starts at $11.99 per month when billed annually. Pointing at your screen and asking is part of Agent Mode and is included in Pro.</p></div></div></section><section class="mb-8"><div class="relative overflow-hidden rounded-[20px] py-14 md:py-20 px-6" style="background-color:#F5F9FF;color:#0a0a0a;border:1px solid #e5edf8"><div class="absolute inset-0" style="background-image:url(/oceanWarp.webp);background-size:cover;background-position:center"></div><div class="absolute inset-0 pointer-events-none" style="background-color:rgba(255, 255, 255, 0.7)"></div><div class="absolute inset-0 pointer-events-none" style="background:radial-gradient(ellipse 120% 120% at 50% 50%, transparent 30%, rgba(255,255,255,0.5) 70%, rgba(255,255,255,0.85) 100%)"></div><div class="relative text-center flex flex-col items-center gap-4"><h2 style="font-size:clamp(1.375rem, 4vw, 1.75rem);font-weight:600;line-height:1.3;letter-spacing:-0.02em;color:#0a0a0a">Circle something on your screen and just ask about it</h2><p style="font-size:0.9375rem;color:rgba(10,10,10,0.58)">VoiceOS runs on Mac and Windows. Download VoiceOS and use it in every app.</p><a class="mt-2 inline-flex items-center gap-2 px-6 py-2.5 rounded-full text-sm font-medium border border-black/[0.06] shadow-[0_1px_2px_rgba(0,0,0,0.04),0_4px_12px_rgba(0,0,0,0.06)] transition-all duration-200 hover:-translate-y-[1px] hover:shadow-[0_2px_4px_rgba(0,0,0,0.06),0_8px_20px_rgba(0,0,0,0.08)]" style="background-color:#fff;color:#111" href="/">Download VoiceOS<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"></path></svg></a></div></div></section></article></div><aside class="hidden lg:block"><div class="sticky top-32"><div class="flex flex-row lg:flex-col gap-2"><button style="width:36px;height:36px;border-radius:8px;border:1px solid #e5e5e5;background-color:#fff;display:flex;align-items:center;justify-content:center;cursor:pointer;transition:border-color 0.2s, background-color 0.2s" title="Share on X" aria-label="Share on X"><svg width="14" height="14" viewBox="0 0 24 24" fill="#0a0a0a"><path d=