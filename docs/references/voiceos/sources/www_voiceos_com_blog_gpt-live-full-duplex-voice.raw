s.com\",\"availableLanguage\":[\"English\",\"Japanese\"]}]}2:[\"$\",\"html\",null,{\"lang\":\"en\",\"className\":\"dm_mono_a086b4ea-module__pIDXBa__variable\",\"children\":[[\"$\",\"head\",null,{\"children\":[[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"$10\"}}],[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"{\\\"@context\\\":\\\"https://schema.org\\\",\\\"@type\\\":\\\"WebSite\\\",\\\"@id\\\":\\\"https://www.voiceos.com/#website\\\",\\\"url\\\":\\\"https://www.voiceos.com\\\",\\\"name\\\":\\\"VoiceOS\\\",\\\"description\\\":\\\"VoiceOS is a voice operating system that turns voice to action. The AI voice assistant for Mac and Windows: dictate, send messages, search the web, and automate apps by voice. Try it free.\\\",\\\"inLanguage\\\":[\\\"en\\\",\\\"ja\\\"],\\\"publisher\\\":{\\\"@id\\\":\\\"https://www.voiceos.com/#organization\\\"}}\"}}],[\"$\",\"link\",null,{\"rel\":\"alternate\",\"type\":\"text/plain\",\"href\":\"/llms.txt\",\"title\":\"LLM-readable site description\"}],[\"$\",\"link\",null,{\"rel\":\"describedby\",\"type\":\"text/plain\",\"href\":\"/llms-full.txt\",\"title\":\"Full LLM-readable VoiceOS documentation\"}],[\"$\",\"link\",null,{\"rel\":\"alternate\",\"type\":\"text/markdown\",\"href\":\"/agents.md\",\"title\":\"VoiceOS agent instructions\"}],[\"$\",\"link\",null,{\"rel\":\"alternate\",\"type\":\"text/markdown\",\"href\":\"/pricing.md\",\"title\":\"VoiceOS machine-readable pricing\"}],[\"$\",\"link\",null,{\"rel\":\"alternate\",\"type\":\"text/markdown\",\"href\":\"/index.md\",\"title\":\"VoiceOS markdown homepage\"}],[\"$\",\"link\",null,{\"rel\":\"alternate\",\"type\":\"application/json\",\"href\":\"/.well-known/agent-card.json\",\"title\":\"VoiceOS agent card\"}],[\"$\",\"link\",null,{\"rel\":\"alternate\",\"type\":\"application/rss+xml\",\"href\":\"/rss.xml\",\"title\":\"VoiceOS Blog RSS Feed\"}],[\"$\",\"link\",null,{\"rel\":\"preload\",\"as\":\"image\",\"href\":\"/skyCloudsHero-mobile.webp\",\"media\":\"(max-width: 767px)\",\"fetchPriority\":\"high\"}],[\"$\",\"link\",null,{\"rel\":\"preload\",\"as\":\"image\",\"href\":\"/skyCloudsHero.webp\",\"media\":\"(min-width: 768px)\",\"fetchPriority\":\"high\"}]]}],[\"$\",\"body\",null,{\"children\":[\"$\",\"$L11\",null,{\"children\":[\"$\",\"$L12\",null,{\"children\":[[\"$\",\"$L13\",null,{}],[\"$\",\"$L14\",null,{\"domainsConfig\":{\"refer\":\"refer.voiceos.com\"},\"cookieOptions\":{\"domain\":\".voiceos.com\"}}],[\"$\",\"$8\",null,{\"fallback\":null,\"children\":[[\"$\",\"$L15\",null,{}],[\"$\",\"$L16\",null,{}],[\"$\",\"$L17\",null,{}],[\"$\",\"$L18\",null,{}]]}],\"$L19\"]}]}]}]]}]\n1a:T5d6,{\"@context\":\"https://schema.org\",\"@type\":\"BlogPosting\",\"headline\":\"GPT-Live Is Here: ChatGPT's Voice Now Listens and Talks at Once, Just Like 'Her' and JARVIS\",\"description\":\"On July 8, 2026, OpenAI replaced Advanced Voice Mode with GPT-Live, a full-duplex voice that listens and speaks at the same time. Here is what changed, how full-duplex differs from the old turn-based voice, and why it means voice is becoming the operating system for real work.\",\"image\":\"https://www.voiceos.com/blogs/gpt-live-full-duplex-voice.png\",\"datePublished\":\"2026-07-09T08:00:00.000Z\",\"dateModified\":\"2026-07-09T08:00:00.000Z\",\"inLanguage\":\"en\",\"author\":{\"@type\":\"Person\",\"name\":\"Kai Brokering\",\"@id\":\"https://www.voiceos.com/authors/kai-brokering#person\",\"url\":\"https://www.voiceos.com/authors/kai-brokering\"},\"publisher\":{\"@type\":\"Organization\",\"name\":\"WakoAI Inc.\",\"url\":\"https://www.voiceos.com\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://www.voiceos.com/voiceOsLogo.png\"}},\"mainEntityOfPage\":{\"@type\":\"WebPage\",\"@id\":\"https://www.voiceos.com/blog/gpt-live-full-duplex-voice\"},\"breadcrumb\":{\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://www.voiceos.com/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Blog\",\"item\":\"https://www.voiceos.com/blog\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"GPT-Live Is Here: ChatGPT's Voice Now Listens and Talks at Once, Just Like 'Her' and JARVIS\",\"item\":\"https://www.voiceos.com/blog/gpt-live-full-duplex-voice\"}]}}1b:Tcff,{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"What is GPT-Live?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"GPT-Live is OpenAI's new generation of ChatGPT Voice, launched on July 8, 2026. It is a full-duplex voice model, meaning it can listen and speak at the same time, which makes talking to ChatGPT feel much more like a real conversation. It comes in two versions, GPT-Live-1 and GPT-Live-1 mini, and replaces the older Advanced Voice Mode.\"}},{\"@type\":\"Question\",\"name\":\"When was GPT-Live released and where can I use it?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"OpenAI released GPT-Live on July 8, 2026. It is rolling out globally inside the ChatGPT app on iOS and Android and on ChatGPT.com on the web, where it becomes the default voice experience. OpenAI said support in the API is coming soon.\"}},{\"@type\":\"Question\",\"name\":\"How is GPT-Live different from Advanced Voice Mode?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Advanced Voice Mode was half-duplex: it chained a speech-to-text model, a language model, and a text-to-speech model, which forced strict turn-taking. GPT-Live is full-duplex, a single model that listens and speaks simultaneously, adds natural cues like \\\"mhmm\\\" and \\\"yeah,\\\" handles interruptions gracefully, and hands hard questions to a stronger model (GPT-5.5 at launch) in the background. In OpenAI's testing, people preferred GPT-Live 75.7% of the time.\"}},{\"@type\":\"Question\",\"name\":\"Which ChatGPT plans get GPT-Live-1 versus GPT-Live-1 mini?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"GPT-Live-1 is the default voice model for paid subscribers on the Go, Plus, and Pro plans. GPT-Live-1 mini is the default for free users. Both replace Advanced Voice Mode as the standard ChatGPT Voice experience.\"}},{\"@type\":\"Question\",\"name\":\"Is ChatGPT's new voice like the movie Her?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"That is the comparison many people reach for. Like the AI in the 2013 film Her, GPT-Live holds a flowing, natural conversation, listens while it talks, and responds without the awkward pauses of older assistants. OpenAI has drawn Her comparisons before, including the Sky voice it pulled in 2024. GPT-Live is the closest a mainstream product has come to that experience.\"}},{\"@type\":\"Question\",\"name\":\"Does this mean I can have a real-life JARVIS?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"A natural voice like GPT-Live is one half of the JARVIS idea. The other half is a computer that can actually take action across your apps, not just talk. For that you need a system-wide voice layer. VoiceOS brings a JARVIS-style assistant to Mac and Windows: you talk, and it dictates, edits, answers questions about your screen, and takes actions across apps like Gmail, Slack, and Calendar.\"}},{\"@type\":\"Question\",\"name\":\"Is voice really becoming the new operating system?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"The direction is clear. OpenAI's own ChatGPT Voice lead described voice as becoming \\\"a kind of primary interface to computing.\\\" As AI learns to understand intent rather than fixed commands, talking becomes a primary way to operate a computer, alongside the keyboard and mouse. Tools like VoiceOS take that further by letting your voice act across every app on your desktop, not just inside one chatbot.\"}}]}6:[\"$\",\"main\",null,{\"className\":\"min-h-screen\",\"style\":{\"backgroundColor\":\"#F9F9F9\"},\"children\":[[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"$1a\"}}],[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"$1b\"}}],\"$L1c\",\"$L1d\",\"$L1e\"]}]\n1f:I[13826,[\"/_next/static/chunks/2kb52na2e7ces.js\",\"/_next/static/chunks/1xfsu92iq1h9m.js\",\"/_next/static/chunks/3x6-_ejf1r1x0.js\",\"/_next/static/chunks/1bslr0-ipnt__.js\",\"/_next/static/chunks/35rx1_qn9m74v.js\",\"/_next/static/chunks/0z6qqa_pcb2c9.js\"],\"default\"]\n20:I[21834,[\"/_next/static/chunks/2kb52na2e7ces.js\",\"/_next/static/chunks/1xfsu92iq1h9m.js\",\"/_next/static/chunks/3x6-_ejf1r1x0.js\",\"/_next/static/chunks/1bslr0-ipnt__.js\",\"/_next/static/chunks/35rx1_qn9m74v.js\",\"/_next/static/chunks/0z6qqa_pcb2c9.js\"],\"default\"]\n22:I[5500,[\"/_next/static/chunks/2kb52na2e7ces.js\",\"/_next/static/chunks/1xfsu92iq1h9m.js\",\"/_next/static/chunks/3x6-_ejf1r1x0.js\",\"/_next/static/chunks/1bslr0-ipnt__.js\",\"/_next/static/chunks/35rx1_qn9m74v.js\",\"/_next/static/chunks/0z6qqa_pcb2c9.js\"],\"Image\"]\n34:I[40163,[\"/_next/static/chunks/2kb52na2e7ces.js\",\"/_next/static/chunks/1xfsu92iq1h9m.js\",\"/_next/static/chunks/3x6-_ejf1r1x0.js\",\"/_next/static/chunks/1bslr0-ipnt__.js\",\"/_next/static/chunks/35rx1_qn9m74v.js\",\"/_next/static/chunks/0z6qqa_pcb2c9.js\"],\"default\"]\n35:I[75696,[\"/_next/static/chunks/2kb52na2e7ces.js\",\"/_next/static/chunks/1xfsu92iq1h9m.js\",\"/_next/static/chunks/3x6-_ejf1r1x0.js\"],\"default\"]\n1c:[\"$\",\"$L1f\",null,{}]\n1d:[\"$\",\"div\",null,{\"className\":\"px-4 md:px-6 pt-32 md:pt-44 pb-16 md:pb-24\",\"children\":[\"$\",\"div\",null,{\"className\":\"max-w-7xl mx-auto\",\"children\":[[\"$\",\"div\",null,{\"className\":\"lg:grid lg:gap-10 lg:[grid-template-columns:220px_minmax(0,1fr)_60px]\",\"children\":[[\"$\",\"aside\",null,{\"className\":\"hidden lg:block\",\"children\":[\"$\",\"div\",null,{\"className\":\"sticky top-32\",\"children\":[\"$\",\"div\",null,{\"className\":\"rounded-xl p-5\",\"style\":{\"backgroundColor\":\"#fff\",\"border\":\"1px solid #eee\"},\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center gap-2 mb-4\",\"children\":[[\"$\",\"svg\",null,{\"className\":\"w-4 h-4\",\"style\":{\"color\":\"#666\"},\"fill\":\"none\",\"stroke\":\"currentColor\",\"viewBox\":\"0 0 24 24\",\"children\":[[\"$\",\"circle\",null,{\"cx\":\"12\",\"cy\":\"12\",\"r\":\"10\",\"strokeWidth\":\"1.5\"}],[\"$\",\"path\",null,{\"strokeLinecap\":\"round\",\"strokeWidth\":\"1.5\",\"d\":\"M12 6v6l4 2\"}]]}],[\"$\",\"span\",null,{\"className\":\"text-sm\",\"style\":{\"color\":\"#666\"},\"children\":\"10 min read\"}]]}],[\"$\",\"p\",null,{\"className\":\"text-sm font-semibold mb-3\",\"style\":{\"color\":\"#0a0a0a\"},\"children\":\"Table of contents\"}],[\"$\",\"$L20\",null,{\"sections\":[{\"id\":\"key-takeaways\",\"label\":\"Key Takeaways\"},{\"id\":\"what-happened\",\"label\":\"What OpenAI actually released\"},{\"id\":\"full-duplex-vs-half-duplex\",\"label\":\"Full-duplex vs. half-duplex: what actually changed\"},{\"id\":\"why-it-feels-natural\",\"label\":\"Why it suddenly feels human\"},{\"id\":\"her-jarvis\",\"label\":\"From 'Her' and JARVIS to your desktop\"},{\"id\":\"voice-as-os\",\"label\":\"Voice is becoming the operating system\"},{\"id\":\"talking-vs-doing\",\"label\":\"Talking to a chatbot vs. doing your work by voice\"},{\"id\":\"voiceos\",\"label\":\"Where VoiceOS fits\"},{\"id\":\"faq\",\"label\":\"Frequently Asked Questions (FAQ)\"}]}]]}]}]}],[\"$\",\"div\",null,{\"children\":[\"$L21\",[\"$\",\"div\",null,{\"className\":\"mb-6\",\"children\":[\"$\",\"span\",null,{\"style\":{\"color\":\"#0d4fb8\",\"fontSize\":\"12px\",\"fontWeight\":600,\"letterSpacing\":\"0.14em\",\"textTransform\":\"uppercase\",\"lineHeight\":1},\"children\":\"News\"}]}],[\"$\",\"h1\",null,{\"style\":{\"fontSize\":\"clamp(2rem, 6vw, 3.25rem)\",\"fontWeight\":600,\"lineHeight\":\"1.15\",\"color\":\"#0a0a0a\",\"letterSpacing\":\"-0.03em\"},\"children\":\"GPT-Live Is Here: ChatGPT's Voice Now Listens and Talks at Once, Just Like 'Her' and JARVIS\"}],[\"$\",\"p\",null,{\"className\":\"mt-5\",\"style\":{\"fontSize\":\"clamp(1.125rem, 2.5vw, 1.375rem)\",\"fontWeight\":300,\"lineHeight\":\"1.6\",\"color\":\"#555\"},\"children\":\"On July 8, 2026, OpenAI replaced Advanced Voice Mode with GPT-Live, a full-duplex voice that listens and speaks at the same time. Here is what changed, how full-duplex differs from the old turn-based voice, and why it means voice is becoming the operating system for real work.\"}],[\"$\",\"div\",null,{\"className\":\"flex items-center gap-5 mt-8 pb-8\",\"style\":{\"borderBottom\":\"1px solid #eee\"},\"children\":[[\"$\",\"$L22\",null,{\"src\":\"/kaiBlogProfile.png\",\"alt\":\"Kai Brokering\",\"width\":40,\"height\":40,\"className\":\"rounded-full flex-shrink-0\",\"style\":{\"objectFit\":\"cover\"}}],[\"$\",\"div\",null,{\"className\":\"flex items-center gap-6\",\"children\":[[\"$\",\"div\",null,{\"children\":[[\"$\",\"p\",null,{\"className\":\"text-xs\",\"style\":{\"color\":\"#999\",\"marginBottom\":\"2px\"},\"children\":\"Written by\"}],[\"$\",\"p\",null,{\"className\":\"text-sm font-semibold\",\"style\":{\"color\":\"#0a0a0a\"},\"children\":\"Kai Brokering\"}]]}],[\"$\",\"div\",null,{\"style\":{\"borderLeft\":\"1px solid #e5e5e5\",\"paddingLeft\":\"24px\"},\"children\":[[\"$\",\"p\",null,{\"className\":\"text-xs\",\"style\":{\"color\":\"#999\",\"marginBottom\":\"2px\"},\"children\":\"Last updated\"}],[\"$\",\"p\",null,{\"className\":\"text-sm font-semibold\",\"style\":{\"color\":\"#0a0a0a\"},\"children\":\"July 9, 2026\"}]]}]]}]]}],[\"$\",\"$L22\",null,{\"src\":\"/blogs/gpt-live-full-duplex-voice.png\",\"alt\":\"GPT-Live Is Here: ChatGPT's Voice Now Listens and Talks at Once, Just Like 'Her' and JARVIS\",\"width\":1200,\"height\":630,\"className\":\"w-full mt-8\",\"style\":{\"objectFit\":\"cover\",\"borderRadius\":\"16px\"},\"priority\":true}],[\"$\",\"article\",null,{\"className\":\"mt-12\",\"children\":[[\"$\",\"section\",null,{\"className\":\"mb-16\",\"id\":\"key-takeaways\",\"children\":[\"$\",\"div\",null,{\"className\":\"rounded-2xl p-6 md:p-8\",\"style\":{\"backgroundColor\":\"#fff\",\"border\":\"1px solid #eee\"},\"children\":[[\"$\",\"h2\",null,{\"style\":{\"fontSize\":\"clamp(1.5rem, 4vw, 2rem)\",\"fontWeight\":500,\"lineHeight\":\"1.3\",\"color\":\"#0a0a0a\",\"letterSpacing\":\"-0.02em\",\"marginBottom\":\"1rem\"},\"children\":\"Key Takeaways\"}],[\"$\",\"ul\",null,{\"className\":\"space-y-3\",\"children\":[[\"$\",\"li\",\"0\",{\"className\":\"flex gap-3\",\"style\":{\"fontSize\":\"1.0625rem\",\"fontWeight\":400,\"lineHeight\":\"1.8\",\"color\":\"#444\"},\"children\":[\"$L23\",\"$L24\"]}],\"$L25\",\"$L26\",\"$L27\",\"$L28\"]}]]}]}],\"$L29\",\"$L2a\",\"$L2b\",\"$L2c\",\"$L2d\",\"$L2e\",\"$L2f\",\"$L30\",\"$L31\"]}]]}],\"$L32\"]}],\"$L33\"]}]}]\n1e:[\"$\",\"$L34\",null,{}]\n3:[\"$\",\"$L35\",null,{\"formats\":\"$undefined\",\"locale\":\"en\",\"messages\":{\"CTA\":{\"ctaPrefix\":\"Press\",\"ctaSuffix\":\"and start speaking.\",\"subheading\":\"Let \u003cbold\u003eyour voice\u003c/bold\u003e do the \u003cbold\u003ework\u003c/bold\u003e.\",\"downloadForMac\":\"Download for Mac\",\"downloadForWindows\":\"Download for Windows\"},\"MobilePage\":{\"title\":\"Mobile is coming soon\",\"metaDescription\":\"VoiceOS is on Mac and Windows today. Join the waitlist to get notified when VoiceOS launches on mobile.\",\"description\":\"VoiceOS is currently available on \u003cstrong\u003eMac\u003c/strong\u003e and \u003cstrong\u003eWindows\u003c/strong\u003e.\",\"notify\":\"Get notified when we launch on mobile.\",\"placeholder\":\"Enter your email\",\"submitButton\":\"Join Waitlist\",\"processing\":\"Processing...\",\"joined\":\"Joined!\",\"successTitle\":\"You're on the list!\",\"successBody\":\"We sent Mac and Windows download links to your inbox. You're still on the mobile waitlist, too.\",\"invalidEmail\":\"Please enter a valid email.\",\"emailSendError\":\"You're on the mobile waitlist, but we couldn't send the desktop download links. Please try again.\",\"backToHome\":\"Back to home\"},\"DictationPage\":{\"metaTitle\":\"Voice Dictation for Mac and Windows - VoiceOS\",\"metaDescription\":\"Talk anywhere you would otherwise type. VoiceOS turns speech into clean, formatted writing in any app, in 100 languages, without the filler words or typos.\",\"title\":\"Talk instead of \u003caccent\u003etyping\u003c/accent\u003e\",\"subtitle\":\"VoiceOS turns what you say into finished writing, in whatever app your cursor is already in.\",\"chip\":\"Mac and Windows\",\"speedTitle\":\"\u003caccent\u003e4x faster\u003c/accent\u003e than typing\",\"speedSubtitle\":\"Most people type around 55 words a minute. Speaking runs closer to 220, and VoiceOS keeps up with every word.\",\"editsTitle\":\"Say it messy, \u003caccent\u003eit lands clean\u003c/accent\u003e\",\"editsSubtitle\":\"Speak the way you actually think. VoiceOS drops the filler, fixes the spelling, learns the names you use, and writes down what you meant.\",\"toneTitle\":\"It writes to fit \u003caccent\u003ewhere it lands\u003c/accent\u003e\",\"toneSubtitle\":\"Say it once. VoiceOS reads the app your cursor is in and writes to match, so the same thought arrives as a proper email, a quick text, or a clean list of notes.\",\"toneMailGreeting\":\"Hi John,\",\"toneMailBody\":\"I'll send the deck over tonight.\",\"toneMailClosing\":\"Best,\",\"toneMailName\":\"Steve\",\"toneMessagesText\":\"sending the deck tonight\",\"toneNotionTitle\":\"Today\",\"toneNotionItem1\":\"Send John the deck tonight\",\"toneNotionItem2\":\"Add the Q3 numbers to slide four\",\"toneNotionItem3\":\"Ask Priya for the revenue chart\",\"langTitle\":\"Speak the language you \u003caccent\u003ethink in\u003c/accent\u003e\",\"langSubtitle\":\"Over 100 languages. Nothing to switch, nothing to set.\",\"spellTitle\":\"It spells them \u003caccent\u003eyour way\u003c/accent\u003e\",\"spellSubtitle\":\"Names, products, acronyms. Say them however they come out and VoiceOS writes them the way you write them.\",\"spellSaid1\":\"“wako AI”\",\"spellWrote1\":\"WakoAI\",\"spellSaid2\":\"“super base”\",\"spellWrote2\":\"Supabase\",\"spellSaid3\":\"“kuber netties”\",\"spellWrote3\":\"Kubernetes\",\"spellSaid4\":\"“oh kay ars”\",\"spellWrote4\":\"OKRs\"},\"AgentMode\":{\"title\":\"Voice + Agent Mode\",\"subtitle\":\"Ask VoiceOS and let it do it for you\",\"whatYouSee\":\"WHAT YOU SEE\",\"whatAgentDoes\":\"WHAT AGENT DOES\",\"senderName\":\"John Doe\",\"senderSubject\":\"Project Sync Meeting\",\"emailBody\":\"Hey, just checking if you're still free to meet tomorrow at 2pm? We need to go over the Q3 roadmap.\",\"voiceInstruction\":\"\\\"Reply saying I can't go\\\"\",\"draftCreated\":\"Draft Created\",\"draftGreeting\":\"Hi John,\",\"draftBody\":\"I won't be able to make it tomorrow at 2pm. Can we reschedule?\",\"instant\":\"Instant\",\"accurate\":\"Accurate\",\"useAgentModeTo\":\"Use Agent Mode to...\",\"exampleReschedule\":\"\\\"Politely reschedule the meeting\\\"\",\"exampleProfessional\":\"\\\"Make this more professional\\\"\",\"exampleThankYou\":\"\\\"Write a thank you email\\\"\",\"exampleFixGrammar\":\"\\\"Fix grammar and shorten this\\\"\",\"andMore\":\"\u0026 much more\"},\"PricingPage\":{\"metaTitle\":\"Pricing - VoiceOS\",\"metaDescription\":\"VoiceOS pricing. Start with a 7-day free trial of Pro. Unlimited dictation and Agent Mode on Mac and Windows. Cancel anytime.\",\"compareTitle\":\"Compare plans\",\"compareSubtitle\":\"Compare the plans available to new customers.\",\"planPro\":\"Pro\",\"planEnterprise\":\"Enterprise\",\"featureColumn\":\"Feature\",\"included\":\"Included\",\"notIncluded\":\"Not included\",\"valueUnlimited\":\"Unlimited\",\"valueComingSoon\":\"Coming soon\",\"valueEnforced\":\"Enforced\",\"groupPlatforms\":\"Platforms\",\"rowMac\":\"macOS\",\"rowWindows\":\"Windows\",\"rowMobile\":\"iPhone and Android\",\"rowEveryApp\":\"Works in every app you already use\",\"groupAgent\":\"Agent Mode\",\"rowAgentUsage\":\"Agent Mode sessions\",\"rowIntegrations\":\"App integrations\",\"rowMcp\":\"Your own MCP servers\",\"rowWebSearch\":\"Web search with sources\",\"rowScreen\":\"Screen awareness\",\"rowScheduling\":\"Reminders and scheduling\",\"rowConfirm\":\"Action confirmation\",\"groupDictation\":\"Dictation Mode\",\"rowDictationUsage\":\"Dictation sessions\",\"rowLanguages\":\"Languages\",\"value100Languages\":\"100 languages\",\"rowStyles\":\"Polish styles\",\"rowVocabulary\":\"Custom vocabulary and replacements\",\"rowEditText\":\"Edit selected text by voice\",\"groupPrivacy\":\"Privacy and security\",\"rowPrivateMode\":\"Private Mode\",\"rowLocalTranscripts\":\"Transcripts stored on your device\",\"rowSso\":\"SSO / SAML\",\"faqTitle\":\"Frequently asked questions\",\"faqQ1\":\"Is there a free trial?\",\"faqA1\":\"Yes. Every new account starts with a \u003cb\u003e7-day free trial of Pro\u003c/b\u003e. A card is required at checkout, and you can cancel any time before the trial ends. One trial per email address.\",\"faqQ2\":\"What happens when the trial ends?\",\"faqA2\":\"Your plan starts automatically on the billing cycle you chose at checkout, monthly or annual, at the price shown there. When the trial begins we email you \u003cb\u003ethe date and the amount\u003c/b\u003e of that first charge, so nothing arrives as a surprise.\",\"faqQ3\":\"Can I cancel anytime?\",\"faqA3\":\"Yes. Cancel from \u003cb\u003eSettings, then Billing\u003c/b\u003e inside the app. You keep Pro until the end of the period you have already paid for.\",\"faqQ4\":\"What happens to my account if I cancel?\",\"faqA4\":\"After cancellation, when your paid Pro period ends, existing accounts have limited access: 100 dictation sessions and 25 Agent Mode sessions per week. This is not a plan available at sign-up.\",\"faqQ5\":\"Do you offer discounts?\",\"faqA5\":\"Students get \u003cb\u003e50% off Pro while enrolled\u003c/b\u003e, and we re-check enrollment once a year. Builders shipping their own VoiceOS integrations can apply for \u003cb\u003e50% off Pro\u003c/b\u003e. Both are short application forms that we read by hand.\",\"faqQ6\":\"What is the difference between monthly and annual?\",\"faqA6\":\"Annual is billed once a year and works out to \u003cb\u003e60% less per month\u003c/b\u003e than paying monthly. The prices on the cards above update to your region automatically.\",\"faqQ7\":\"Which platforms does VoiceOS run on?\",\"faqA7\":\"\u003cb\u003eMac and Windows\u003c/b\u003e today. Mobile is on the way and you can join the waitlist from the mobile page.\",\"faqQ8\":\"Do you have plans for teams?\",\"faqA8\":\"VoiceOS offers Enterprise for teams. Contact us to confirm available administration, retention, and identity-provider requirements in your agreement.\",\"freeNote\":\"After cancellation, when your paid Pro period ends, existing accounts have limited access: 100 dictation sessions and 25 Agent Mode sessions per week. This is not a plan available at sign-up.\",\"signupNote\":\"New customers start with a 7-day free trial of Pro or contact us about Enterprise. A card is required. One trial per email address.\",\"afterCancellationTitle\":\"After Pro ends\",\"valueContactSales\":\"Contact sales\",\"valuePerAction\":\"Varies by action\"},\"Dictation\":{\"dictationMode\":\"Dictation Mode\",\"dictationDescription\":\"Writes \u003cbold\u003ewhat you meant\u003c/bold\u003e, not what you said.\",\"youSay\":\"You say\",\"voiceosWrites\":\"VoiceOS writes\",\"dictationInput\":\"\\\"Can you send me that form by today... I mean tomorrow?\\\"\",\"dictationOutput\":\"Can you send me that form by tomorrow?\",\"askMode\":\"Agent Mode\",\"askYouSay\":\"You say\",\"askDescription\":\"Ask VoiceOS and let it \u003cbold\u003ewrite for you\u003c/bold\u003e.\",\"askInput\":\"\\\"Reply I can't but ask to reschedule\\\"\",\"askOutputGreeting\":\"Hi John,\",\"askOutputBody\":\"I won't be able to make it tomorrow at 2pm. Can we reschedule?\",\"askOutputClosing\":\"Best,\",\"askOutputName\":\"Steve\"},\"Style\":{\"soundsLikeYouTitle\":\"Sounds \u003cbold\u003eJust Like You\u003c/bold\u003e\",\"soundsLikeYouDescription\":\"VoiceOS \u003cbold\u003eadapts\u003c/bold\u003e to match how you \u003cbold\u003enaturally communicate\u003c/bold\u003e\",\"youSay\":\"You say\",\"voiceosWrites\":\"VoiceOS writes\",\"inputThanks\":\"\\\"thanks\\\"\",\"outputMail\":\"Thanks.\",\"outputSlack\":\"Thanks!\",\"outputMessages\":\"thanks\",\"smartFormatsTitle\":\"\u003cbold\u003eSmart\u003c/bold\u003e Formats\",\"smartFormatsDescription\":\"VoiceOS \u003cbold\u003eautomatically formats\u003c/bold\u003e based on \u003cbold\u003econtext\u003c/bold\u003e\",\"smartFormatsInput\":\"\\\"Reply with demo link\\\"\",\"dictationDemoAutoFormatsTitle\":\"Auto \u003cbold\u003eFormats\u003c/bold\u003e\",\"dictationDemoAutoFormatsSubtitle\":\"Your words, perfectly structured\",\"emailGreeting\":\"Hey John,\",\"emailSubGreeting\":\"\",\"emailBody\":\"Thanks for your interest! Here's the demo video: \",\"emailDemoLink\":\"demo video\",\"emailFollowUp\":\"Let me know if you have any questions.\",\"emailPreClosing\":\"\",\"emailClosing\":\"Best,\",\"emailName\":\"Steve\"},\"AgentPage\":{\"metaTitle\":\"AI Voice Agent for Mac and Windows - VoiceOS\",\"metaDescription\":\"Say what you want done and VoiceOS does it across your apps. Send messages, book time, search the web, and connect MCP servers—with confirmation before it acts.\",\"title\":\"Say it, and it \u003caccent\u003egets done\u003c/accent\u003e\",\"subtitle\":\"Agent Mode goes and does the thing. It works inside the apps you already use, and it shows you a confirmation before anything sends.\",\"chip\":\"Mac and Windows\",\"speedSubtitle\":\"The moment you think of it, just say it. VoiceOS takes care of it, without you opening another app.\",\"videoLabel\":\"The VoiceOS Agent Mode film\",\"videoPlay\":\"Play the film\",\"appsTitle\":\"It works \u003caccent\u003ewith your favorite apps\u003c/accent\u003e\",\"appsSubtitle\":\"Say it once and the reply is sent, the event is scheduled, without you opening a single app.\",\"appsPickLabel\":\"Pick an app\",\"sceneSlack\":\"Replies in the thread\",\"sceneGmail\":\"Writes the email and sends it\",\"sceneGcal\":\"Puts it on the calendar\",\"sceneNotion\":\"Adds it to the page\",\"sceneLinear\":\"Files the issue\",\"sceneWeather\":\"Looks it up on the web\",\"confirmTitle\":\"Nothing sends until \u003caccent\u003eyou say so\u003c/accent\u003e\",\"confirmSubtitle\":\"Anything that sends, books, or changes something stops and shows you what it will do. Fix it or let it go.\",\"reachTitle\":\"Plug in \u003caccent\u003eanything you use\u003c/accent\u003e\",\"reachSubtitle\":\"Turn on Slack, Gmail, Notion, Linear and the rest in Settings. After that, just ask out loud and VoiceOS uses them for you. Built your own tool? It can use that too.\",\"reachMcpTitle\":\"Your own MCP server\",\"reachMcpBody\":\"Every tool on it, by voice\",\"reachMcpCmd\":\"voiceos add mcp\",\"bgTitle\":\"Say it and \u003caccent\u003econsider it done\u003c/accent\u003e\",\"bgSubtitle\":\"Long tasks keep running at the side of your screen. The answer comes back on its own.\",\"bgSearch\":\"Search\",\"bgToday\":\"Today, 2:14 PM\",\"bgYesterday\":\"Yesterday, 5:40 PM\",\"bgTask1\":\"Compare flights to Osaka\",\"bgTask2\":\"Summarize the Q3 doc\",\"bgTask3\":\"Draft the recap email\",\"bgTask4\":\"Rename the files on my desktop\",\"bgTask5\":\"Add dinner Thursday to my calendar\",\"bgTask6\":\"Find the Figma invoice\",\"bgTask7\":\"Send Kai the launch notes\",\"bgTask8\":\"Pull the numbers from the Notion doc\",\"bgTask9\":\"Check what is on my calendar tomorrow\",\"bgTask10\":\"Remind me to renew the domain\",\"bgDocTitle\":\"Osaka offsite\",\"bgDocP1\":\"We land Thursday morning, so the team dinner has to be that evening. Kenji offered to book the izakaya near the station.\",\"bgDocP2\":\"Friday is the workshop. Two sessions before lunch, then the demo, then we let people go early.\",\"bgDocP3\":\"Saturday is open. A few people want to stay on, so I will keep the group booking flexible until Wednesday.\",\"bgDocP4\":\"I will lock the hotel in once the flights are\",\"bgWorking\":\"Working in the background\",\"bgNew\":\"New response\"},\"Quote\":{\"text\":\"“Speech is the ultimate natural user interface.”\",\"author\":\"Steve Jobs\"},\"PriceValue\":{\"title\":\"For just \u003cprice\u003e{amount}\u003c/price\u003e a day\",\"subtitle\":\"That is 10x your productivity, for less than a cup of coffee a week.\"},\"Footer\":{\"copyright\":\"Copyright © 2026 WakoAI, Inc. All Rights Reserved.\",\"termsOfService\":\"Terms of Use\",\"privacyPolicy\":\"Privacy Policy\",\"security\":\"Security\",\"affiliatePolicy\":\"Affiliate Policy\",\"contact\":\"Contact\",\"affiliates\":\"Affiliates\",\"product\":\"Product\",\"company\":\"Company\",\"compare\":\"Compare\",\"allComparisons\":\"All comparisons\",\"resources\":\"Resources\",\"legal\":\"Legal\",\"pricing\":\"Pricing\",\"blog\":\"Blog\",\"about\":\"About\",\"team\":\"Team\",\"manifesto\":\"Manifesto\",\"agentMode\":\"Agent Mode\",\"dictationMode\":\"Dictation Mode\",\"appStore\":\"App Store\",\"features\":\"All features\",\"glossary\":\"Voice glossary\",\"changelog\":\"Changelog\",\"documentation\":\"Documentation\"},\"Navbar\":{\"pricing\":\"Pricing\",\"product\":\"Product\",\"features\":\"Features\",\"agentMode\":\"Agent Mode\",\"dictationMode\":\"Dictation Mode\",\"productPricingDesc\":\"Plans, trial, and discounts\",\"productFeaturesDesc\":\"Everything VoiceOS can do\",\"productAgentDesc\":\"Say it, and it gets done\",\"productDictationDesc\":\"Talk instead of typing\",\"blog\":\"Blogs\",\"about\":\"About\",\"team\":\"Team\",\"manifesto\":\"Manifesto\",\"affiliates\":\"Affiliates\",\"download\":\"Download\",\"downloadForMac\":\"Download for Mac\",\"downloadForWindows\":\"Download for Windows\",\"appStore\":\"App Store\"},\"Students\":{\"metaTitle\":\"VoiceOS for Students | 50% off Pro\",\"metaDescription\":\"Verify you're enrolled and keep 50% off Pro for as long as you're a student.\",\"title\":\"VoiceOS for \u003caccent\u003estudents\u003c/accent\u003e\",\"subtitle\":\"Verify you're enrolled. Keep the discount until you graduate.\",\"offerChip\":\"50% off Pro while you're enrolled\",\"optionalLabel\":\"(optional)\",\"nameLabel\":\"Name\",\"namePlaceholder\":\"Ada Lovelace\",\"schoolEmailLabel\":\"School email\",\"schoolEmailHint\":\"(your .edu or university address)\",\"accountEmailLabel\":\"VoiceOS account email\",\"accountEmailHint\":\"(only if it's different from your school email)\",\"schoolLabel\":\"School\",\"schoolPlaceholder\":\"MIT, University of Tokyo, ...\",\"programLabel\":\"What are you studying?\",\"programPlaceholder\":\"Computer science, law, medicine, ...\",\"gradYearLabel\":\"Expected graduation\",\"gradYearPlaceholder\":\"2028\",\"proofLabel\":\"Proof of enrollment\",\"proofHint\":\"(a photo of your student ID or a screenshot of your enrollment page both work)\",\"filePrompt\":\"Upload a photo or PDF\",\"fileReplace\":\"Replace\",\"fileMissing\":\"Please add your proof of enrollment.\",\"fileTooLarge\":\"That file is over 8MB. Please pick a smaller photo or PDF.\",\"fileUnsupported\":\"That file type didn't work. A JPG, PNG, HEIC, or PDF is perfect.\",\"tooManyAttempts\":\"Too many applications from this connection. Please try again in an hour.\",\"usageLabel\":\"What will you use VoiceOS for?\",\"usagePlaceholder\":\"Lecture notes, essays, coding assignments, ...\",\"dictatedLabel\":\"Bonus points: I dictated this application.\",\"submit\":\"Apply\",\"submitting\":\"Sending...\",\"invalidEmail\":\"That email doesn't look right.\",\"errorGeneric\":\"Something went wrong. Please try again.\",\"successTitle\":\"Application received.\",\"successBody\":\"We check every one. If you're verified, the discount lands in your inbox within a few days.\",\"renewalNote\":\"We re-check enrollment once a year. The discount rides along until you graduate.\",\"backToHome\":\"Back to home\"},\"AskAI\":{\"heading\":\"Still not sure? Ask your AI.\",\"askProvider\":\"Ask {provider}\"},\"AppStore\":{\"metaTitle\":\"VoiceOS App Store — Official Integrations\",\"metaDescription\":\"Browse every official VoiceOS integration — Gmail, Slack, Notion, iMessage, and more — and see every action each one can take by voice.\",\"heroEyebrow\":\"App Store\",\"heroTitleLine1\":\"The app ecosystem\",\"heroTitleLine2\":\"powered by voice\",\"heroSubtitle\":\"Official integrations, built into VoiceOS and maintained by us. Connect the apps you live in, then just say what you want done.\",\"viewBuildGuide\":\"Read the build guide\",\"filter_all\":\"All\",\"submitEyebrow\":\"Publish on the App Store\",\"submitTitle\":\"Got an integration to share?\",\"submitSubtitle\":\"Publish your integration to the VoiceOS App Store.\",\"nameLabel\":\"Integration name\",\"namePlaceholder\":\"Integration name\",\"emailLabel\":\"Your email\",\"emailPlaceholder\":\"Your email\",\"repoLabel\":\"Link (optional)\",\"repoPlaceholder\":\"Link to the code or a demo (optional)\",\"descriptionLabel\":\"What does it do?\",\"descriptionPlaceholder\":\"What does it do? Which apps it controls, what you can say to it, and why VoiceOS users would want it.\",\"submitButton\":\"Apply to publish\",\"submitting\":\"Submitting...\",\"submitSuccessTitle\":\"Submission received\",\"submitSuccessBody\":\"Thanks for sharing your integration. We will review it and reach out if we need anything else.\",\"invalidEmail\":\"Enter a valid email address.\",\"invalidRepo\":\"That link doesn't look right — include https://\",\"requiredFields\":\"Add a name, your email, and what it does.\",\"submitError\":\"We could not submit this integration. Please try again.\",\"reviewNote\":\"Reviewed by hand before anything is listed.\",\"category_messages\":\"Messaging\",\"category_email\":\"Email\",\"category_calendar\":\"Calendar\",\"category_productivity\":\"Productivity\",\"category_noteTaking\":\"Note Taking\",\"category_media\":\"Media\",\"category_social\":\"Social\",\"badgeBeta\":\"Beta\",\"badgeMacOnly\":\"macOS only\",\"toolCountLabel\":\"{count, plural, one {# voice action} other {# voice actions}}\",\"platformMac\":\"macOS\",\"platformMacWindows\":\"macOS · Windows\",\"backToAppStore\":\"All integrations\",\"detailMetaTitle\":\"{name} voice control — {count, plural, one {# voice action} other {# voice actions}} | VoiceOS\",\"detailMetaDescription\":\"{name} by voice with VoiceOS: {summary}. Every voice action, which confirm first, and how to connect it.\",\"detailCtaButton\":\"Download VoiceOS\",\"faqEyebrow\":\"FAQ\",\"faqTitle\":\"Questions we get asked\",\"faq_apps_q\":\"Which apps can VoiceOS connect to?\",\"faq_apps_a\":\"{integrationCount} official integrations ship inside VoiceOS, covering messaging, email, calendars, productivity tools, note taking, media and social. Together they add up to {toolCount} separate voice actions. We build and maintain every one of them, so none of this rests on a third-party plugin that stops working next month.\",\"faq_slack_q\":\"How do I use Slack with my voice?\",\"faq_slack_a\":\"Connect Slack once in the VoiceOS app, then just say what you want. You can send a message, schedule one for later, search your history, find a channel or a person, open a DM, react, set a reminder, or upload a file. Say \\\"tell the design channel the build is ready\\\" and VoiceOS writes it, then shows you the message before it posts.\",\"faq_meeting_q\":\"Can I book a meeting with my voice?\",\"faq_meeting_a\":\"Yes, through Google Calendar or Apple Calendar. VoiceOS can create an event, block out a full day, move or cancel something, read your schedule back to you, and find open time before it books anything. \\\"Find thirty minutes on Thursday afternoon and put it on my calendar\\\" is one sentence instead of six clicks.\",\"faq_siri_q\":\"Is VoiceOS a good Siri alternative?\",\"faq_siri_a\":\"They are built for different jobs. Siri is strongest on phone-sized tasks and system settings. VoiceOS works inside the desktop apps you actually get work done in, with {toolCount} concrete actions across {integrationCount} of them, and it will dictate into any text field on your Mac. If you have ever asked Siri to send a Slack message or move a meeting and hit a wall, that is the gap this fills.\",\"faq_setup_q\":\"Do I have to set up each app before it works?\",\"faq_setup_a\":\"Cloud apps like Gmail, Slack, Notion and Linear ask you to sign in once and then remember it. The Apple apps go through macOS permissions instead, so you approve access the first time VoiceOS reaches for them and never again.\",\"faq_windows_q\":\"Do all of these work on Windows?\",\"faq_windows_a\":\"Not all of them. {macOnlyCount} are macOS only, because they drive native Apple apps such as iMessage, Apple Mail, Reminders, Notes and Finder. The cloud integrations run on both, including Gmail, Slack, Notion, Jira, Linear and Google Drive. Every listing on this page says which.\",\"faq_confirm_q\":\"Will it send things without asking me first?\",\"faq_confirm_a\":\"Most actions that write something stop and confirm. Posting to Slack or uploading a file shows you what is about to happen first. Reading and searching simply answer you. A few integrations where confirming every time would only get in the way, like Spotify and Google Maps, act straight away. Each integration page marks exactly which of its actions ask first.\",\"faq_missing_q\":\"What if the app I use is not listed?\",\"faq_missing_a\":\"You can still wire it up yourself. VoiceOS speaks MCP, so any MCP server you point it at becomes a set of voice actions, and the build guide walks through it. If you would rather we ship it as an official integration, there is a form at the bottom of this page.\",\"factsVersion\":\"Version\",\"factsVersionCaption\":\"Built in\",\"factsDeveloper\":\"Developer\",\"factsDeveloperCaption\":\"First-party\",\"factsTools\":\"Tools\",\"factsToolsCaption\":\"voice actions\",\"factsCategory\":\"Category\",\"factsPlatforms\":\"Platforms\",\"samplesTitle\":\"Try saying\",\"setupTitle\":\"Getting started\",\"step1Title\":\"Download VoiceOS\",\"step1Body\":\"Free to start, on Mac and Windows.\",\"step2Title\":\"Connect {name}\",\"step2Body\":\"One click in the dashboard's Integrations tab.\",\"step3Title\":\"Just say it\",\"step3Body\":\"Speak — VoiceOS does the rest.\",\"connectionCloudNote\":\"Connects to your {name} account — you sign in with {name} in your browser, and VoiceOS never sees your password.\",\"connectionNativeNote\":\"Runs locally on your Mac — nothing to sign into, and your data stays on your device.\",\"permissionFullDisk\":\"macOS will ask for Full Disk Access when you connect — it's how VoiceOS reads your messages on this Mac.\",\"permissionAutomation\":\"macOS will ask permission for VoiceOS to control Spotify the first time you use it.\",\"canvasSetupNote\":\"Canvas needs an access token from your school account — VoiceOS walks you through creating one when you connect.\",\"jiraWorkspaceNote\":\"Your connection is bound to one Atlassian workspace, shown on the integration card so you always know where actions run.\",\"confirmationBody\":\"VoiceOS asks you to confirm before it sends, changes, or deletes anything — every action marked “Asks first” below.\",\"noConfirmationBody\":\"These actions are safe and easy to undo, so VoiceOS runs them right away — no confirmation needed.\",\"toolsTitle\":\"What it can do\",\"toolsSubtitle\":\"What Agent Mode can do with this integration.\",\"asksFirst\":\"Asks first\",\"asksFirstHint\":\"VoiceOS confirms with you before this runs.\",\"relatedTitle\":\"More from the App Store\"},\"ProductHuntBanner\":{\"message\":\"We're live on Product Hunt!\",\"cta\":\"Support us\",\"dismiss\":\"Dismiss\"},\"AppActions\":{\"struckTitle\":\"Speech-to-text\",\"title\":\"Voice-to-action\",\"subtitle\":\"Send the email, file the ticket, schedule the meeting. Say it once and VoiceOS does it in the right app.\",\"email\":\"Send an email\",\"slack\":\"Reply to Maya\",\"calendar\":\"Schedule a meeting\",\"finder\":\"Find that PDF\",\"notion\":\"Take a note\",\"imessage\":\"Text Mom\",\"linear\":\"File a bug\",\"chrome\":\"Search the web\",\"drive\":\"Open the roadmap\",\"docs\":\"Draft a proposal\",\"obsidian\":\"Add a daily note\"},\"StopScreenshots\":{\"caption\":\"Can you find his LinkedIn\",\"title\":\"Point anywhere on your screen.\",\"subtitle\":\"Stop taking screenshots. VoiceOS sees what your cursor is on and answers instantly. No copy-paste.\"},\"StopLooking\":{\"caption\":\"Search for last year's tax returns\",\"title\":\"Stop looking for {item}\",\"itemFile\":\"that file\",\"itemEmail\":\"that email\",\"itemDoc\":\"that doc\",\"itemNote\":\"that note\",\"subtitle\":\"You know exactly what you're looking for. You just don't know where it is. Ask, and VoiceOS pulls it up in seconds.\"},\"ProductivityGraph\":{\"title\":\"Not just another dictation app\",\"subtitle\":\"Dictation only speeds up your typing. VoiceOS multiplies your productivity.\",\"axisLabel\":\"Productivity\",\"crestLabel\":\"your productivity\",\"seriesTyping\":\"Typing\",\"seriesDictation\":\"Dictation\",\"seriesVoiceos\":\"VoiceOS\",\"tableCaption\":\"Relative productivity of typing, dictation, and VoiceOS\"},\"Builders\":{\"metaTitle\":\"VoiceOS for Builders | 50% off Pro\",\"metaDescription\":\"Show us what you're building with VoiceOS and get 50% off Pro for your first 3 months.\",\"title\":\"VoiceOS for \u003caccent\u003ebuilders\u003c/accent\u003e\",\"subtitle\":\"Show us what you're building with VoiceOS.\",\"offerChip\":\"50% off Pro for your first 3 months\",\"optionalLabel\":\"(optional)\",\"nameLabel\":\"Name\",\"namePlaceholder\":\"Ada Lovelace\",\"emailLabel\":\"Email\",\"emailHint\":\"(the one on your VoiceOS account)\",\"workflowLabel\":\"What workflow are you building with VoiceOS?\",\"workflowPlaceholder\":\"Dictating specs into Linear, triaging email by voice, voice-driving your editor...\",\"integrationsLabel\":\"Integrations you've made\",\"integrationsPlaceholder\":\"Notion, Spotify, your own MCP server...\",\"integrationsNextLabel\":\"Integrations you want next\",\"integrationsNextPlaceholder\":\"The tools you wish VoiceOS could drive...\",\"linkLabel\":\"Show us. One link.\",\"linkHint\":\"(a 60 second screen recording of your workflow is the fastest way to a yes)\",\"linkPlaceholder\":\"https://\",\"dictatedLabel\":\"Bonus points: I dictated this application.\",\"submit\":\"Apply\",\"submitting\":\"Sending...\",\"invalidEmail\":\"That email doesn't look right.\",\"invalidLink\":\"That link doesn't look right.\",\"tooManyAttempts\":\"Too many applications from this connection. Please try again in an hour.\",\"errorGeneric\":\"Something went wrong. Please try again.\",\"successTitle\":\"Application received.\",\"successBody\":\"We read every single one. If you're in, the discount lands in your inbox within a few days.\",\"backToHome\":\"Back to home\"},\"TimeSavings\":{\"caption\":\"Email him for honest feedback about VoiceOS\",\"title\":\"Point anywhere on your screen.\",\"subtitle\":\"Your cursor is the context. No more explaining, just point and ask.\",\"stepUnit\":\"step\",\"spokenRequest\":\"Hey VoiceOS, do I have any meetings today?\"},\"FAQ\":{\"title\":\"Questions?\",\"q1\":\"How is VoiceOS different from traditional speech recognition?\",\"a1\":\"VoiceOS uses advanced AI to go beyond basic speech-to-text. While Mac Dictation transcribes exactly what you say (including 'um' and 'uh'), VoiceOS \u003cstrong\u003eautomatically removes filler words\u003c/strong\u003e, fixes grammar, and formats your text professionally. It's like having an \u003cstrong\u003eeditor built in\u003c/strong\u003e, perfect for emails, documents, and messaging.\",\"q2\":\"Is my data private and secure with VoiceOS?\",\"a2\":\"Absolutely. VoiceOS processes your audio in real time and \u003cstrong\u003enever stores it\u003c/strong\u003e unless you give permission to help improve the product. Your transcripts are \u003cstrong\u003esaved locally on your device\u003c/strong\u003e, giving you full control over them. None of your data is used for training or shared with anyone. Privacy and security are built into everything we do.\",\"q3\":\"What apps does VoiceOS work with?\",\"a3\":\"VoiceOS works seamlessly across \u003cstrong\u003eyour favorite apps\u003c/strong\u003e like Gmail, Slack, Notion, Google Docs, iMessage, WhatsApp, and more. Whether you're writing code in Cursor, chatting in Messenger, or drafting in Obsidian, VoiceOS is there to help you \u003cstrong\u003ecommunicate faster\u003c/strong\u003e.\"},\"AgentModeDemo\":{\"badge\":\"Coming 4/3\",\"title\":\"Agent Mode\",\"subtitle\":\"Voice to Actions across integrated apps. Zero context switching.\",\"scenarioSlack\":\"Slack: draft reply in-channel\",\"scenarioGmail\":\"Gmail: compose \u0026 send\",\"scenarioGcal\":\"Google Calendar: new event\",\"scenarioNotion\":\"Notion: create page\",\"scenarioLinear\":\"Linear: create issue\",\"scenarioWeather\":\"Web search: weather\"},\"Pricing\":{\"title\":\"Pricing\",\"subtitle\":\"Start with a \u003cbold\u003e7-day free trial\u003c/bold\u003e, cancel anytime\",\"monthly\":\"Monthly\",\"annual\":\"Annual\",\"saveBadge\":\"Save {percent}%\",\"free\":\"Free\",\"pro\":\"Pro\",\"enterprise\":\"Enterprise\",\"forever\":\"forever\",\"perMonth\":\"per month\",\"noCreditCard\":\"no credit card required\",\"billedAnnually\":\"billed annually\",\"billedMonthly\":\"billed monthly\",\"custom\":\"Custom\",\"freeDescription\":\"Perfect for trying out VoiceOS\",\"enterpriseDescription\":\"For teams and organizations\",\"freeLimit\":\"100 usage / week\",\"proLimit\":\"Unlimited usage\",\"getStarted\":\"Get Started\",\"goPro\":\"Go Pro\",\"contactSales\":\"Contact Sales\",\"featureDictation\":\"\u003cbold\u003eDictation \u003c/bold\u003eMode\",\"featureAsk\":\"\u003cbold\u003eAgent \u003c/bold\u003eMode\",\"featureVocabulary\":\"\u003cbold\u003eCustom\u003c/bold\u003e vocabulary\",\"featureApps\":\"\u003cbold\u003eWorks\u003c/bold\u003e in every app\",\"featureEverythingFree\":\"\u003cbold\u003eEverything\u003c/bold\u003e in Free\",\"featureUnlimited\":\"\u003cbold\u003eUnlimited\u003c/bold\u003e usage\",\"featurePriority\":\"\u003cbold\u003ePriority\u003c/bold\u003e support\",\"featureTeam\":\"\u003cbold\u003eTeam\u003c/bold\u003e features\",\"featureEverythingPro\":\"\u003cbold\u003eEverything\u003c/bold\u003e in Pro\",\"featureZeroRetention\":\"\u003cbold\u003eZero\u003c/bold\u003e data retention\",\"featureSoc2\":\"\u003cbold\u003eSecurity\u003c/bold\u003e review support\",\"featureSso\":\"\u003cbold\u003eSSO / SAML\u003c/bold\u003e — contact sales\",\"buildersOfferLead\":\"Builders\",\"buildersOfferCta\":\"apply for 50% off Pro\",\"studentOfferLead\":\"Students\",\"studentOfferCta\":\"get 50% off Pro\",\"pageTitle\":\"Start with 7 days free\",\"pageSubtitle\":\"Full Pro access for a week. A card is required, and you can cancel any time before the trial ends.\",\"freeTrialIncluded\":\"7-day free trial included\"},\"Waitlist\":{\"joinWaitlist\":\"Join our waitlist\",\"beFirst\":\"Be the first to experience VoiceOS\",\"onTheList\":\"You're on the list!\",\"notify\":\"We'll notify you when VoiceOS is ready for you.\",\"enterEmail\":\"Enter your email\",\"joinButton\":\"Join Waitlist\",\"processing\":\"Processing...\",\"failedToJoin\":\"Failed to join waitlist. Please try again.\",\"errorOccurred\":\"An error occurred. Please try again.\"},\"StayOnTask\":{\"caption\":\"Remind me to send Maya the deck\",\"title\":\"Agent keeps you on task.\",\"subtitle\":\"Say it once and let it go. VoiceOS keeps track of the task and brings it back at the right time, so nothing sits in your head.\",\"spokenRequest\":\"Hey VoiceOS, remind me in 2 hours to send Maya the deck\",\"screenAlt\":\"A VoiceOS reminder card on a Mac desktop, with the notch listening above it\",\"cardTask\":\"Send Maya the deck\",\"cardTime\":\"Today, 4:00 PM\"},\"Languages\":{\"titleLine1\":\"Works in over\",\"titleLine2\":\"\u003cbold\u003e100+ languages\u003c/bold\u003e\",\"subtitle\":\"\u003cbold\u003eAutomatically detects\u003c/bold\u003e language. No switching required.\",\"english\":\"English\",\"spanish\":\"Spanish\",\"french\":\"French\",\"german\":\"German\",\"italian\":\"Italian\",\"portuguese\":\"Portuguese\",\"japanese\":\"Japanese\",\"hindi\":\"Hindi\",\"dutch\":\"Dutch\",\"swedish\":\"Swedish\",\"norwegian\":\"Norwegian\",\"danish\":\"Danish\",\"finnish\":\"Finnish\",\"polish\":\"Polish\",\"greek\":\"Greek\",\"turkish\":\"Turkish\",\"thai\":\"Thai\",\"vietnamese\":\"Vietnamese\",\"indonesian\":\"Indonesian\"},\"Privacy\":{\"titleLine1\":\"What you say\",\"titleLine2\":\"stays yours\",\"description\":\"Your audio is never stored on our servers and never used to train models. You decide what leaves your Mac.\",\"learnMore\":\"Learn more\",\"toggleLabel\":\"Privacy mode\",\"switchLabel\":\"Privacy\",\"tabGeneral\":\"General\",\"tabPrivacy\":\"Privacy\",\"tabProfiles\":\"Profiles\",\"tabAdvanced\":\"Advanced\",\"onDevice\":\"On your device\",\"keepTranscriptsLocal\":\"Save transcripts on this device\",\"processAudioRealtime\":\"Don't save audio in the cloud\",\"noTrainingUse\":\"Never use my dictation to train AI models\",\"optionalSharing\":\"Optional sharing\",\"shareDiagnostics\":\"Send anonymous diagnostics and crash reports\",\"shareDiagnosticsNote\":\"Never includes raw audio or full transcripts tied to you.\"},\"WallOfLove\":{\"titleHead\":\"Wall of \",\"titleTail\":\"Love\",\"subtitle\":\"Founders, creators, and builders are replacing typing with VoiceOS.\",\"joinThem\":\"Join Them\",\"joinCount\":\"20,000+ voicepilled\",\"joinAria\":\"Join 20,000+ VoiceOS users\",\"carouselAria\":\"VoiceOS testimonials carousel\",\"viewPostAria\":\"View {name}'s original post\",\"avatarAlt\":\"{name} avatar\",\"gabePerezName\":\"Gabe Perez\",\"gabePerezRole\":\"Head of Product Curation, Product Hunt\",\"gabePerezQuote\":\"VoiceOS lets me get work done 10x faster. I do everything with voice nowadays. The experience will change your life.\",\"andreyName\":\"Andrey\",\"andreyRole\":\"AI enthusiast, NVIDIA GTC winner\",\"andreyQuote\":\"Tried out all the voice productivity tools. VoiceOS is the one I ended up sticking with. It's just the best.\",\"yoichiOchiaiName\":\"Yoichi Ochiai\",\"yoichiOchiaiRole\":\"Media Artist, 605k followers\",\"yoichiOchiaiQuote\":\"I started using VoiceOS.\",\"usutakuName\":\"Usutaku\",\"usutakuRole\":\"#1 Japanese AI Influencer\",\"usutakuQuote\":\"I tried VoiceOS right away, and it was faster and a better experience than any voice input tool I've used before!\",\"souLabName\":\"sou-lab\",\"souLabRole\":\"VoiceOS user\",\"souLabQuote\":\"I sent VoiceOS some feedback, and they added the feature the very next day. Unreal.\",\"albyChurvenName\":\"Alby Churven\",\"albyChurvenRole\":\"14 y/o CMO\",\"albyChurvenQuote\":\"I was using WisprFlow for 3 days and just switched to VoiceOS. VoiceOS is genuinely crazy.\",\"akiraName\":\"akira\",\"akiraRole\":\"Founder of Random Labs, agent harness researcher\",\"akiraQuote\":\"Using VoiceOS for this and it's so smooth lets fucking go. Coding agents + dictation is an insane combo.\",\"emanuelPerezName\":\"Emanuel Perez\",\"emanuelPerezRole\":\"Operations Manager\",\"emanuelPerezQuote\":\"Big fan of agent mode on VoiceOS. This wasn't doable on other apps and makes things like replying to emails much faster.\",\"reneGrywnowName\":\"René Grywnow\",\"reneGrywnowRole\":\"Founder and operations lead\",\"reneGrywnowQuote\":\"VoiceOS: Just speak.\\n\\nNo setup. No excuse.\\n\\nThe future does not type. She speaks.\"},\"FeaturesPage\":{\"metaTitle\":\"Features - VoiceOS\",\"metaDescription\":\"Everything VoiceOS does. Agent Mode turns your voice into actions across apps, while Dictation Mode turns speech into polished writing on Mac and Windows.\",\"title\":\"Do more with your \u003caccent\u003evoice\u003c/accent\u003e\",\"subtitle\":\"VoiceOS turns what you say into real actions across the apps you already use. Dictation is built in.\",\"chip\":\"Mac and Windows\",\"hubAgentEyebrow\":\"Agent Mode\",\"hubAgentTitle\":\"Say it, and it gets done\",\"hubAgentBody\":\"Ask out loud and VoiceOS does the work inside your apps. It sends the message, books the time, finds the file, checks the web. Anything that sends or changes something shows you a confirmation first.\",\"hubDictationEyebrow\":\"Dictation Mode\",\"hubDictationTitle\":\"Talk instead of typing\",\"hubDictationBody\":\"Speak anywhere you would otherwise type, in any app, in 100 languages. The filler comes out, the spelling gets fixed, and what lands on the page is what you meant.\",\"hubCta\":\"See what it does\",\"agentTitle\":\"Agent Mode\",\"agentSubtitle\":\"Say what you want done. VoiceOS goes and does it.\",\"agentF1Title\":\"Actions across your apps\",\"agentF1Body\":\"Send the message, create the issue, add the calendar event. You talk, VoiceOS does the clicking.\",\"agentF2Title\":\"Integrations you connect\",\"agentF2Body\":\"Notion, Slack, Gmail, Linear, Spotify and more. Connect them once in Settings and they answer to your voice.\",\"agentF3Title\":\"Your own MCP servers\",\"agentF3Body\":\"Point VoiceOS at any MCP server and every tool it exposes becomes something you can just ask for.\",\"agentF4Title\":\"Web search with sources\",\"agentF4Body\":\"Ask a question out loud, get a real answer back with the sources it came from.\",\"agentF5Title\":\"Screen awareness\",\"agentF5Body\":\"Ask about whatever is in front of you. Screen access stays behind a toggle that you own.\",\"agentF6Title\":\"Reminders and scheduling\",\"agentF6Body\":\"Ask for a nudge later and VoiceOS brings it back to you at the right moment.\",\"agentF7Title\":\"It asks before it acts\",\"agentF7Body\":\"Anything that sends, books, or changes something shows you a confirmation card first.\",\"agentAskLabel\":\"You say\",\"agentAskSentence\":\"Tell David I'll be ten minutes late, and move our 3pm to Thursday\",\"agentDone1\":\"Message sent\",\"agentDone2\":\"Moved to Thursday\",\"agentConfirmLabel\":\"Before it sends\",\"agentConfirmAction\":\"Send message\",\"agentConfirmToLabel\":\"To\",\"agentConfirmToValue\":\"David Chen\",\"agentConfirmMsgLabel\":\"Message\",\"agentConfirmMsgText\":\"I'll be ten minutes late. Can we move our 3pm to Thursday?\",\"agentConfirmCancel\":\"Cancel\",\"agentConfirmSend\":\"Send\",\"dictationTitle\":\"Dictation Mode\",\"dictSpeedSlowLabel\":\"Keyboard\",\"dictSpeedSlowValue\":\"55 wpm\",\"dictSpeedFastLabel\":\"VoiceOS\",\"dictSpeedFastValue\":\"220 wpm\",\"dictSpeedSentence\":\"I'm getting started with the project. There are three things I need: repo access, the design files, and a staging key.\",\"dictSpeedTyped\":\"I'm getting started with the |porject|(project). There are three things I need: repo access, the |desgin|(design) files, and a staging key.\",\"dictSpeedListLead\":\"I'm getting started with the project. There are three things I need:\",\"dictSpeedListItem1\":\"Repo access\",\"dictSpeedListItem2\":\"The design files\",\"dictSpeedListItem3\":\"A staging key\",\"dictEditsRawLabel\":\"What you said\",\"dictEditsRaw\":\"\u003cfillerMark\u003eso um\u003c/fillerMark\u003e can you take a look at the onboarding bug on the mobile app, there's like three separate things going wrong with it, \u003cname\u003ePreya\u003c/name\u003e's fix from last night did not take, the magic link still lands in spam, \u003cfiller\u003euh\u003c/filler\u003e and the \u003ctypo\u003ePostgress\u003c/typo\u003e logs are full of timeouts, so let's move standup to ten.\",\"dictEditsMarkFiller\":\"Removed filler\",\"dictEditsMarkDict\":\"Added to dictionary\",\"dictEditsMarkSpelling\":\"Fixed spelling\",\"dictEditsNameFixed\":\"Priya\",\"dictEditsTypoFixed\":\"Postgres\",\"dictEditsCleanLead\":\"Can you take a look at the onboarding bug on the mobile app? Three separate things are going wrong with it:\",\"dictEditsCleanItem1\":\"Priya's fix from last night did not take.\",\"dictEditsCleanItem2\":\"The magic link still lands in spam.\",\"dictEditsCleanItem3\":\"The Postgres logs are full of timeouts.\",\"dictEditsCleanTail\":\"Let's move standup to ten.\",\"privacyStatHeadline\":\"\u003cnumber\u003e1,169,420\u003c/number\u003e hours saved for our users\",\"ctaTitle\":\"See it on your own machine\",\"ctaBody\":\"Seven days of Pro, on Mac and Windows.\"},\"Hero\":{\"backedBy\":\"Backed by\",\"combinator\":\"Combinator\",\"headline\":\"Voice assistant\\nat your fingertips\",\"description\":\"Get answers anywhere. Instantly\",\"downloadForMac\":\"Download for Mac\",\"downloadForWindows\":\"Download for Windows\",\"downloadOnDesktop\":\"Download on Desktop\",\"trustedBy\":\"Trusted by 10,000+ users\",\"trialNote\":\"7-day free trial · Cancel anytime\"}},\"now\":\"$undefined\",\"timeZone\":\"UTC\",\"children\":\"$L36\"}]\n4e:I[28554,[\"/_next/static/chunks/2kb52na2e7ces.js\",\"/_next/static/chunks/1xfsu92iq1h9m.js\",\"/_next/static/chunks/3x6-_ejf1r1x0.js\",\"/_next/static/chunks/1bslr0-ipnt__.js\",\"/_next/static/chunks/35rx1_qn9m74v.js\",\"/_next/static/chunks/0z6qqa_pcb2c9.js\"],\"default\"]\n4f:I[85581,[\"/_next/static/chunks/2kb52na2e7ces.js\",\"/_next/static/chunks/1xfsu92iq1h9m.js\",\"/_next/static/chunks/3x6-_ejf1r1x0.js\",\"/_next/static/chunks/1bslr0-ipnt__.js\",\"/_next/static/chunks/35rx1_qn9m74v.js\",\"/_next/static/chunks/0z6qqa_pcb2c9.js\"],\"default\"]\n23:[\"$\",\"span\",null,{\"className\":\"flex-shrink-0 w-2 h-2 rounded-full\",\"style\":{\"backgroundColor\":\"#0a0a0a\",\"marginTop\":\"0.65em\"}}]\n24:[\"$\",\"span\",null,{\"children\":\"On July 8, 2026, OpenAI launched GPT-Live, a new generation of ChatGPT Voice built on a full-duplex architecture that can listen and speak at the same time. It replaces Advanced Voice Mode for everyone.\"}]\n25:[\"$\",\"li\",\"1\",{\"className\":\"flex gap-3\",\"style\":\"$1d:props:children:props:children:0:props:children:1:props:children:6:props:children:0:props:children:props:children:1:props:children:0:props:style\",\"children\":[[\"$\",\"span\",null,{\"className\":\"flex-shrink-0 w-2 h-2 rounded-full\",\"style\":{\"backgroundColor\":\"#0a0a0a\",\"marginTop\":\"0.65em\"}}],[\"$\",\"span\",null,{\"children\":\"Two models rolled out globally on iOS, Android, and the web: GPT-Live-1 is the default for Go, Plus, and Pro subscribers, and GPT-Live-1 mini is the default for free users.\"}]]}]\n26:[\"$\",\"li\",\"2\",{\"className\":\"flex gap-3\",\"style\":\"$1d:props:children:props:children:0:props:children:1:props:children:6:props:children:0:props:children:props:children:1:props:children:0:props:style\",\"children\":[[\"$\",\"span\",null,{\"className\":\"flex-shrink-0 w-2 h-2 rounded-full\",\"style\":{\"backgroundColor\":\"#0a0a0a\",\"marginTop\":\"0.65em\"}}],[\"$\",\"span\",null,{\"children\":\"The old voice was half-duplex, a speech-to-text, language, and text-to-speech pipeline that forced strict turn-taking. GPT-Live listens while it talks, backchannels with cues like \\\"mhmm\\\" and \\\"yeah,\\\" and handles interruptions without losing the thread.\"}]]}]\n27:[\"$\",\"li\",\"3\",{\"className\":\"flex gap-3\",\"style\":\"$1d:props:children:props:children:0:props:children:1:props:children:6:props:children:0:props:children:props:children:1:props:children:0:props:style\",\"children\":[[\"$\",\"span\",null,{\"className\":\"flex-shrink-0 w-2 h-2 rounded-full\",\"style\":{\"backgroundColor\":\"#0a0a0a\",\"marginTop\":\"0.65em\"}}],[\"$\",\"span\",null,{\"children\":\"For hard questions, GPT-Live hands the work to a frontier model, GPT-5.5 at launch, in the background and keeps the conversation flowing. In OpenAI's testing, people preferred it to Advanced Voice Mode 75.7% of the time.\"}]]}]\n28:[\"$\",\"li\",\"4\",{\"className\":\"flex gap-3\",\"style\":\"$1d:props:children:props:children:0:props:children:1:props:children:6:props:children:0:props:children:props:children:1:props:children:0:props:style\",\"children\":[[\"$\",\"span\",null,{\"className\":\"flex-shrink-0 w-2 h-2 rounded-full\",\"style\":{\"backgroundColor\":\"#0a0a0a\",\"marginTop\":\"0.65em\"}}],[\"$\",\"span\",null,{\"children\":\"The bigger story is the interface. Talking is becoming a primary way to operate a computer, the science-fiction assistants from Her and Iron Man's JARVIS are turning into everyday software, and voice is becoming the new operating system for work.\"}]]}]\n29:[\"$\",\"section\",null,{\"className\":\"mb-16\",\"id\":\"what-happened\",\"children\":[[\"$\",\"h2\",null,{\"style\":{\"fontSize\":\"clamp(1.5rem, 4vw, 2rem)\",\"fontWeight\":500,\"lineHeight\":\"1.3\",\"color\":\"#0a0a0a\",\"letterSpacing\":\"-0.02em\",\"marginBottom\":\"1.5rem\"},\"children\":\"What OpenAI actually released\"}],[\"$\",\"p\",null,{\"style\":{\"fontSize\":\"1.0625rem\",\"fontWeight\":400,\"lineHeight\":\"1.8\",\"color\":\"#444\",\"marginBottom\":\"1.5rem\"},\"children\":\"On July 8, 2026, OpenAI introduced GPT-Live, a new generation of voice models that replaces the default ChatGPT Voice experience. It comes in two versions, GPT-Live-1 and GPT-Live-1 mini, and it is rolling out to ChatGPT users around the world across iOS, Android, and ChatGPT.com on the web.\"}],[\"$\",\"p\",null,{\"style\":{\"fontSize\":\"1.0625rem\",\"fontWeight\":400,\"lineHeight\":\"1.8\",\"color\":\"#444\",\"marginBottom\":\"1.5rem\"},\"children\":\"The split is simple. GPT-Live-1 becomes the default voice for paid users on the Go, Plus, and Pro plans, while GPT-Live-1 mini becomes the default for free users. Both retire the old Advanced Voice Mode, so this is not an optional beta buried in settings. It is the new default way ChatGPT talks.\"}],[\"$\",\"p\",null,{\"style\":{\"fontSize\":\"1.0625rem\",\"fontWeight\":400,\"lineHeight\":\"1.8\",\"color\":\"#444\",\"marginBottom\":\"1.5rem\"},\"children\":\"What makes it different is not that it sounds a little better. It is a different architecture. GPT-Live is built to listen and speak at the same time, and when a question needs a real answer, a web search, or multi-step work, it quietly hands that off to a stronger model in the background, GPT-5.5 at launch, and keeps the conversation going while the answer is prepared.\"}],[\"$\",\"p\",null,{\"style\":{\"fontSize\":\"1.0625rem\",\"fontWeight\":500,\"lineHeight\":\"1.8\",\"color\":\"#0a0a0a\",\"marginBottom\":\"1.25rem\"},\"children\":\"Here is the announcement, straight from OpenAI:\"}],[\"$\",\"div\",null,{\"className\":\"not-prose\",\"data-theme\":\"light\",\"children\":[\"$\",\"$8\",null,{\"fallback\":[\"$\",\"div\",null,{\"className\":\"react-tweet-theme tweet-container-module__CmFQMq__root tweet-skeleton-module__ZayCwq__root\",\"children\":[\"$\",\"article\",null,{\"className\":\"tweet-container-module__CmFQMq__article\",\"children\":[[\"$\",\"span\",null,{\"className\":\"skeleton-module__yM3A9W__skeleton\",\"style\":{\"height\":\"3rem\",\"marginBottom\":\"0.75rem\"}}],[\"$\",\"span\",null,{\"className\":\"skeleton-module__yM3A9W__skeleton\",\"style\":{\"height\":\"6rem\",\"margin\":\"0.5rem 0\"}}],[\"$\",\"div\",null,{\"style\":{\"borderTop\":\"var(--tweet-border)\",\"margin\":\"0.5rem 0\"}}],[\"$\",\"span\",null,{\"className\":\"skeleton-module__yM3A9W__skeleton\",\"style\":{\"height\":\"2rem\"}}],[\"$\",\"span\",null,{\"className\":\"skeleton-module__yM3A9W__skeleton\",\"style\":{\"height\":\"2rem\",\"borderRadius\":\"9999px\",\"marginTop\":\"0.5rem\"}}]]}]}],\"children\":\"$L37\"}]}],[\"$\",\"div\",null,{\"className\":\"rounded-2xl p-5 mt-6\",\"style\":{\"backgroundColor\":\"#fff\",\"border\":\"1px solid #eee\"},\"children\":[\"$\",\"p\",null,{\"style\":{\"fontSize\":\"0.9375rem\",\"fontWeight\":400,\"lineHeight\":\"1.8\",\"color\":\"#444\",\"margin\":0},\"children\":[\"Related: \",\"$L38\",\" · \",\"$L39\",\" · \",\"$L3a\",\" · \",\"$L3b\",\" · \",\"$L3c\"]}]}]]}]\n2a:[\"$\",\"section\",null,{\"className\":\"mb-16\",\"id\":\"full-duplex-vs-half-duplex\",\"children\":[[\"$\",\"h2\",null,{\"style\":\"$29:props:children:0:props:style\",\"children\":\"Full-duplex vs. half-duplex: what actually changed\"}],[\"$\",\"p\",null,{\"style\":{\"fontSize\":\"1.0625rem\",\"fontWeight\":400,\"lineHeight\":\"1.8\",\"color\":\"#444\",\"marginBottom\":\"1.5rem\"},\"children\":\"If you have used ChatGPT Voice before GPT-Live, you have used a half-duplex system, even if nobody called it that. Half-duplex means the line only runs one way at a time, like a walkie-talkie: one side talks, then the other side talks. Under the hood, the old Advanced Voice Mode chained three separate models together, one to turn your speech into text, one to generate a reply, and one to turn that reply back into speech.\"}],[\"$\",\"p\",null,{\"style\":{\"fontSize\":\"1.0625rem\",\"fontWeight\":400,\"lineHeight\":\"1.8\",\"color\":\"#444\",\"marginBottom\":\"1.5rem\"},\"children\":\"That pipeline is why the old experience felt like taking turns with a machine. You spoke, you waited, it answered, and if you tried to jump in, the whole turn often reset. It was impressive, but you never quite forgot you were talking to software that was patiently waiting for its cue.\"}],[\"$\",\"p\",null,{\"style\":{\"fontSize\":\"1.0625rem\",\"fontWeight\":400,\"lineHeight\":\"1.8\",\"color\":\"#444\",\"marginBottom\":\"2rem\"},\"children\":\"Full-duplex means both directions are open at once, like a real phone call where you can laugh, interrupt, and finish each other's sentences. GPT-Live is a single model that processes what you are saying while it is speaking, and it decides many times per second whether to keep talking, pause, listen, jump in, or call a tool. That one change, from a chain of turn-taking models to a single always-listening one, is what makes it feel less like a command line for your mouth and more like a conversation.\"}],[\"$\",\"div\",null,{\"className\":\"rounded-2xl overflow-hidden\",\"style\":{\"border\":\"1px solid #eee\",\"backgroundColor\":\"#fff\"},\"children\":[[\"$\",\"div\",null,{\"className\":\"grid grid-cols-2\",\"children\":[[\"$\",\"div\",null,{\"className\":\"px-4 py-3 md:px-6 md:py-4\",\"style\":{\"borderBottom\":\"1px solid #eee\",\"borderRight\":\"1px solid #eee\"},\"children\":[\"$\",\"p\",null,{\"style\":{\"fontSize\":\"0.9375rem\",\"fontWeight\":600,\"color\":\"#8a6a1f\",\"margin\":0},\"children\":\"Advanced Voice Mode — half-duplex\"}]}],[\"$\",\"div\",null,{\"className\":\"px-4 py-3 md:px-6 md:py-4\",\"style\":{\"borderBottom\":\"1px solid #eee\",\"backgroundColor\":\"#F5F9FF\"},\"children\":[\"$\",\"p\",null,{\"style\":{\"fontSize\":\"0.9375rem\",\"fontWeight\":600,\"color\":\"#0d4fb8\",\"margin\":0},\"children\":\"GPT-Live — full-duplex\"}]}]]}],[[\"$\",\"div\",\"0\",{\"children\":[[\"$\",\"div\",null,{\"className\":\"px-4 pt-4 md:px-6\",\"style\":{\"borderTop\":\"none\"},\"children\":[\"$\",\"p\",null,{\"style\":{\"fontSize\":\"11px\",\"fontWeight\":600,\"letterSpacing\":\"0.12em\",\"textTransform\":\"uppercase\",\"color\":\"#999\",\"margin\":0},\"children\":\"Architecture\"}]}],[\"$\",\"div\",null,{\"className\":\"grid grid-cols-2\",\"children\":[[\"$\",\"div\",null,{\"className\":\"px-4 py-3 md:px-6\",\"style\":{\"borderRight\":\"1px solid #eee\"},\"children\":[\"$\",\"p\",null,{\"style\":{\"fontSize\":\"0.9375rem\",\"fontWeight\":400,\"lineHeight\":1.6,\"color\":\"#444\",\"margin\":0},\"children\":\"Three models chained: speech-to-text, then a language model, then text-to-speech.\"}]}],[\"$\",\"div\",null,{\"className\":\"px-4 py-3 md:px-6\",\"style\":{\"backgroundColor\":\"#F5F9FF\"},\"children\":[\"$\",\"p\",null,{\"style\":{\"fontSize\":\"0.9375rem\",\"fontWeight\":400,\"lineHeight\":1.6,\"color\":\"#0a0a0a\",\"margin\":0},\"children\":\"One model that listens and speaks at the same time.\"}]}]]}]]}],[\"$\",\"div\",\"1\",{\"children\":[[\"$\",\"div\",null,{\"className\":\"px-4 pt-4 md:px-6\",\"style\":{\"borderTop\":\"1px solid #f0f0f0\"},\"children\":[\"$\",\"p\",null,{\"style\":{\"fontSize\":\"11px\",\"fontWeight\":600,\"letterSpacing\":\"0.12em\",\"textTransform\":\"uppercase\",\"color\":\"#999\",\"margin\":0},\"children\":\"Turn-taking\"}]}],[\"$\",\"div\",null,{\"className\":\"grid grid-cols-2\",\"children\":[[\"$\",\"div\",null,{\"className\":\"px-4 py-3 md:px-6\",\"style\":{\"borderRight\":\"1px solid #eee\"},\"children\":[\"$\",\"p\",null,{\"style\":{\"fontSize\":\"0.9375rem\",\"fontWeight\":400,\"lineHeight\":1.6,\"color\":\"#444\",\"margin\":0},\"children\":\"Strictly one at a time. You talk, it waits, then it replies.\"}]}],\"$L3d\"]}]]}],\"$L3e\",\"$L3f\",\"$L40\"]]}]]}]\n2b:[\"$\",\"section\",null,{\"className\":\"mb-16\",\"id\":\"why-it-feels-natural\",\"children\":[[\"$\",\"h2\",null,{\"style\":\"$29:props:children:0:props:style\",\"children\":\"Why it suddenly feels human\"}],[\"$\",\"p\",null,{\"style\":{\"fontSize\":\"1.0625rem\",\"fontWeight\":400,\"lineHeight\":\"1.8\",\"color\":\"#444\",\"marginBottom\":\"1.5rem\"},\"children\":\"The tell is in the small stuff. GPT-Live does the things people do without thinking. It drops in a quick \\\"mhmm\\\" or \\\"got it\\\" while you are still talking, so you know it is following. It waits through a natural pause instead of barreling in the moment you take a breath. And when you interrupt to correct yourself, it adjusts instead of starting over.\"}],[\"$\",\"p\",null,{\"style\":{\"fontSize\":\"1.0625rem\",\"fontWeight\":400,\"lineHeight\":\"1.8\",\"color\":\"#444\",\"marginBottom\":\"1.5rem\"},\"children\":\"Those micro-behaviors, called backchanneling, are most of what separates a real conversation from dictating into a form. They are also exactly what the old turn-based pipeline could not do, because it was structurally incapable of listening and speaking at the same time. In OpenAI's own human preference testing, people chose GPT-Live over Advanced Voice Mode in 75.7% of comparisons.\"}],[\"$\",\"p\",null,{\"style\":{\"fontSize\":\"1.0625rem\",\"fontWeight\":400,\"lineHeight\":\"1.8\",\"color\":\"#444\",\"marginBottom\":\"1.5rem\"},\"children\":\"Even Sam Altman, who has said he prefers typing to talking to an AI, framed the launch as a turning point:\"}],[\"$\",\"div\",null,{\"className\":\"not-prose\",\"data-theme\":\"light\",\"children\":[\"$\",\"$8\",null,{\"fallback\":[\"$\",\"div\",null,{\"className\":\"react-tweet-theme tweet-container-module__CmFQMq__root tweet-skeleton-module__ZayCwq__root\",\"children\":[\"$\",\"article\",null,{\"className\":\"tweet-container-module__CmFQMq__article\",\"children\":[[\"$\",\"span\",null,{\"className\":\"skeleton-module__yM3A9W__skeleton\",\"style\":{\"height\":\"3rem\",\"marginBottom\":\"0.75rem\"}}],[\"$\",\"span\",null,{\"className\":\"skeleton-module__yM3A9W__skeleton\",\"style\":{\"height\":\"6rem\",\"margin\":\"0.5rem 0\"}}],[\"$\",\"div\",null,{\"style\":{\"borderTop\":\"var(--tweet-border)\",\"margin\":\"0.5rem 0\"}}],[\"$\",\"span\",null,{\"className\":\"skeleton-module__yM3A9W__skeleton\",\"style\":{\"height\":\"2rem\"}}],[\"$\",\"span\",null,{\"className\":\"skeleton-module__yM3A9W__skeleton\",\"style\":{\"height\":\"2rem\",\"borderRadius\":\"9999px\",\"marginTop\":\"0.5rem\"}}]]}]}],\"children\":\"$L41\"}]}],[\"$\",\"p\",null,{\"style\":{\"fontSize\":\"1.0625rem\",\"fontWeight\":400,\"lineHeight\":\"1.8\",\"color\":\"#444\",\"marginTop\":\"1.75rem\",\"marginBottom\":\"1.25rem\"},\"children\":\"And it is not just English. Here is a demo of GPT-Live speaking Japanese that native speakers are calling almost indistinguishable from a person (video — turn the sound on):\"}],[\"$\",\"div\",null,{\"className\":\"not-prose\",\"data-theme\":\"light\",\"children\":[\"$\",\"$8\",null,{\"fallback\":[\"$\",\"div\",null,{\"className\":\"react-tweet-theme tweet-container-module__CmFQMq__root tweet-skeleton-module__ZayCwq__root\",\"children\":[\"$\",\"article\",null,{\"className\":\"tweet-container-module__CmFQMq__article\",\"children\":[[\"$\",\"span\",null,{\"className\":\"skeleton-module__yM3A9W__skeleton\",\"style\":{\"height\":\"3rem\",\"marginBottom\":\"0.75rem\"}}],[\"$\",\"span\",null,{\"className\":\"skeleton-module__yM3A9W__skeleton\",\"style\":{\"height\":\"6rem\",\"margin\":\"0.5rem 0\"}}],[\"$\",\"div\",null,{\"style\":{\"borderTop\":\"var(--tweet-border)\",\"margin\":\"0.5rem 0\"}}],[\"$\",\"span\",null,{\"className\":\"skeleton-module__yM3A9W__skeleton\",\"style\":{\"height\":\"2rem\"}}],[\"$\",\"span\",null,{\"className\":\"skeleton-module__yM3A9W__skeleton\",\"style\":{\"height\":\"2rem\",\"borderRadius\":\"9999px\",\"marginTop\":\"0.5rem\"}}]]}]}],\"children\":\"$L42\"}]}]]}]\n2c:[\"$\",\"section\",null,{\"className\":\"mb-16\",\"id\":\"her-jarvis\",\"children\":[[\"$\",\"h2\",null,{\"style\":\"$29:props:children:0:props:style\",\"children\":\"From 'Her' and JARVIS to your desktop\"}],[\"$\",\"blockquote\",null,{\"className\":\"rounded-2xl p-6 md:p-8 mb-8\",\"style\":{\"backgroundColor\":\"#fff\",\"border\":\"1px solid #eee\",\"borderLeft\":\"4px solid #0a0a0a\"},\"children\":[[\"$\",\"p\",null,{\"style\":{\"fontSize\":\"clamp(1.25rem, 3.5vw, 1.625rem)\",\"fontWeight\":500,\"lineHeight\":\"1.4\",\"color\":\"#0a0a0a\",\"letterSpacing\":\"-0.01em\",\"fontStyle\":\"italic\"},\"children\":\"\\\"Jarvis, wake up, Daddy's home.\\\"\"}],[\"$\",\"p\",null,{\"style\":{\"fontSize\":\"0.9375rem\",\"fontWeight\":400,\"lineHeight\":\"1.8\",\"color\":\"#888\",\"marginTop\":\"0.75rem\",\"marginBottom\":0},\"children\":\"Tony Stark, Iron Man\"}]]}],[\"$\",\"p\",null,{\"style\":{\"fontSize\":\"1.0625rem\",\"fontWeight\":400,\"lineHeight\":\"1.8\",\"color\":\"#444\",\"marginBottom\":\"1.5rem\"},\"children\":\"It is hard to hear GPT-Live and not think of the movies. In Spike Jonze's 2013 film Her, the main character falls into conversation with an operating system that talks like a person, listens without judgment, and is simply present. In Iron Man, Tony Stark walks into his workshop and says, \\\"Jarvis, wake up, Daddy's home,\\\" and a calm voice answers and gets to work. For years those were the reference points precisely because no real product came close.\"}],[\"$\",\"p\",null,{\"style\":{\"fontSize\":\"1.0625rem\",\"fontWeight\":400,\"lineHeight\":\"1.8\",\"color\":\"#444\",\"marginBottom\":\"1.5rem\"},\"children\":\"The comparison is not new to OpenAI. When it demoed a voice called Sky in 2024, listeners thought it sounded like Scarlett Johansson, who voiced the AI in Her, and the company pulled the voice after she objected. The fantasy has always been the same: a computer you talk to like a person. What changed in 2026 is that the conversation finally feels real enough that the comparison is about the experience, not just the voice.\"}],[\"$\",\"p\",null,{\"style\":\"$1d:props:children:props:children:0:props:children:1:props:children:6:props:children:0:props:children:props:children:1:props:children:0:props:style\",\"children\":\"We wrote a whole piece on the JARVIS idea and why it stopped being fiction. GPT-Live is the clearest sign yet that the talking-computer scene from those films has quietly become a shipping feature, available on the phone in your pocket.\"}],[\"$\",\"div\",null,{\"className\":\"rounded-2xl p-5 mt-6\",\"style\":{\"backgroundColor\":\"#fff\",\"border\":\"1px solid #eee\"},\"children\":[\"$\",\"p\",null,{\"style\":{\"fontSize\":\"0.9375rem\",\"fontWeight\":400,\"lineHeight\":\"1.8\",\"color\":\"#444\",\"margin\":0},\"children\":[\"Related: \",\"$L43\",\" · \",\"$L44\"]}]}]]}]\n2d:[\"$\",\"section\",null,{\"className\":\"mb-16\",\"id\":\"voice-as-os\",\"children\":[[\"$\",\"h2\",null,{\"style\":\"$29:props:children:0:props:style\",\"children\":\"Voice is becoming the operating system\"}],[\"$\",\"p\",null,{\"style\":{\"fontSize\":\"1.0625rem\",\"fontWeight\":400,\"lineHeight\":\"1.8\",\"color\":\"#444\",\"marginBottom\":\"1.5rem\"},\"children\":\"Every major shift in computing has moved the interface closer to human intent. The command line let us type exact instructions. The graphical interface let us point and click instead of memorizing commands. Touch let us use our fingers. Each step removed friction between what a person wanted and what the machine did. Voice is the natural next layer, because talking is the most human interface there is.\"}],[\"$\",\"p\",null,{\"style\":{\"fontSize\":\"1.0625rem\",\"fontWeight\":400,\"lineHeight\":\"1.8\",\"color\":\"#444\",\"marginBottom\":\"1.5rem\"},\"children\":\"OpenAI is saying this out loud. Atty Eleti, the product lead for ChatGPT Voice, put it plainly: \\\"Over time, we think this will also unlock the ability to use voice as a kind of primary interface to computing.\\\" That is a striking thing for the company to say about a voice feature. It is not describing a better dictation tool. It is describing voice as a primary way to operate a computer.\"}],[\"$\",\"p\",null,{\"style\":\"$1d:props:children:props:children:0:props:children:1:props:children:6:props:children:0:props:children:props:children:1:props:children:0:props:style\",\"children\":\"This is the thesis we have been writing about for a year: voice is not just a new input, it is a new operating layer. When the machine understands intent, you stop operating software one click at a time and start directing it. You say what you want, and the computer arranges itself around you.\"}],[\"$\",\"div\",null,{\"className\":\"rounded-2xl p-5 mt-6\",\"style\":{\"backgroundColor\":\"#fff\",\"border\":\"1px solid #eee\"},\"children\":[\"$\",\"p\",null,{\"style\":{\"fontSize\":\"0.9375rem\",\"fontWeight\":400,\"lineHeight\":\"1.8\",\"color\":\"#444\",\"margin\":0},\"children\":[\"Related: \",\"$L45\",\" · \",\"$L46\",\" · \",\"$L47\",\" · \",\"$L48\"]}]}]]}]\n2e:[\"$\",\"section\",null,{\"className\":\"mb-16\",\"id\":\"talking-vs-doing\",\"children\":[[\"$\",\"h2\",null,{\"style\":\"$29:props:children:0:props:style\",\"children\":\"Talking to a chatbot vs. doing your work by voice\"}],[\"$\",\"p\",null,{\"style\":{\"fontSize\":\"1.0625rem\",\"fontWeight\":400,\"lineHeight\":\"1.8\",\"color\":\"#444\",\"marginBottom\":\"1.5rem\"},\"children\":\"Here is the honest limit. GPT-Live is a spectacular conversation partner inside the ChatGPT app. It can chat, reason, translate, and answer. But most of your work does not happen inside ChatGPT. It happens in Gmail, Slack, Notion, your browser, your calendar, and your code editor, and it involves actually doing things, not just talking about them.\"}],[\"$\",\"p\",null,{\"style\":{\"fontSize\":\"1.0625rem\",\"fontWeight\":400,\"lineHeight\":\"1.8\",\"color\":\"#444\",\"marginBottom\":\"1.5rem\"},\"children\":\"A great voice inside one app is a great chatbot. A voice that works everywhere, that can type into any field, rewrite the text you already have, read what is on your screen, and take real actions across your apps, is an operating system. That is the difference between talking to a computer and getting your computer to do the work.\"}],[\"$\",\"p\",null,{\"style\":\"$1d:props:children:props:children:0:props:children:1:props:children:6:props:children:0:props:children:props:children:1:props:children:0:props:style\",\"children\":\"This is exactly the line between dictation, voice agents, and a true voice layer that we have broken down before. GPT-Live makes the conversation feel human. The next question is what that conversation can actually do across everything you already use.\"}],[\"$\",\"div\",null,{\"className\":\"rounded-2xl p-5 mt-6\",\"style\":{\"backgroundColor\":\"#fff\",\"border\":\"1px solid #eee\"},\"children\":[\"$\",\"p\",null,{\"style\":{\"fontSize\":\"0.9375rem\",\"fontWeight\":400,\"lineHeight\":\"1.8\",\"color\":\"#444\",\"margin\":0},\"children\":[\"Related: \",\"$L49\",\" · \",\"$L4a\",\" · \",\"$L4b\"]}]}]]}]\n2f:[\"$\",\"section\",null,{\"className\":\"mb-16\",\"id\":\"voiceos\",\"children\":[[\"$\",\"h2\",null,{\"style\":\"$29:props:children:0:props:style\",\"children\":\"Where VoiceOS fits\"}],[\"$\",\"p\",null,{\"style\":{\"fontSize\":\"1.0625rem\",\"fontWeight\":400,\"lineHeight\":\"1.8\",\"color\":\"#444\",\"marginBottom\":\"1.5rem\"},\"children\":\"VoiceOS is that system-wide voice layer for your Mac and Windows computer. It is not trapped inside one app. You press your trigger, speak naturally, and VoiceOS turns your words into the right output wherever your cursor is: a polished Slack message, a clean email, or a prompt to another AI tool, all in the tone of the app you are in.\"}],[\"$\",\"p\",null,{\"style\":{\"fontSize\":\"1.0625rem\",\"fontWeight\":400,\"lineHeight\":\"1.8\",\"color\":\"#444\",\"marginBottom\":\"1.5rem\"},\"children\":\"It also goes past talking into doing. With Agent Mode you can ask about what is on your screen, reshape text you already wrote, and take real actions across connected apps like Gmail, Slack, and Google Calendar, with a confirmation step before anything important is sent. GPT-Live shows how natural the conversation can feel. VoiceOS is about turning that conversation into work across every app you use.\"}],[\"$\",\"p\",null,{\"style\":\"$1d:props:children:props:children:0:props:children:1:props:children:6:props:children:0:props:children:props:children:1:props:children:0:props:style\",\"children\":\"The GPT-Live launch is the strongest signal yet that the whole industry is converging on the same idea we started with: you should be able to talk to your computer and have it understand and act. If that future excites you, the fastest way to feel it across your real work today is to start speaking to your own machine.\"}]]}]\n30:[\"$\",\"section\",null,{\"className\":\"mb-16\",\"id\":\"faq\",\"children\":[[\"$\",\"h2\",null,{\"style\":\"$29:props:children:0:props:style\",\"children\":\"Frequently Asked Questions (FAQ)\"}],[\"$\",\"div\",null,{\"className\":\"space-y-6\",\"children\":[[\"$\",\"div\",\"0\",{\"className\":\"rounded-2xl p-5 md:p-6\",\"style\":{\"backgroundColor\":\"#fff\",\"border\":\"1px solid #eee\"},\"children\":[[\"$\",\"h3\",null,{\"style\":{\"fontSize\":\"clamp(1.125rem, 3vw, 1.375rem)\",\"fontWeight\":500,\"lineHeight\":\"1.4\",\"color\":\"#0a0a0a\",\"marginBottom\":\"0.5rem\"},\"children\":\"What is GPT-Live?\"}],[\"$\",\"p\",null,{\"style\":{\"fontSize\":\"0.9375rem\",\"fontWeight\":400,\"lineHeight\":\"1.8\",\"color\":\"#444\"},\"children\":\"GPT-Live is OpenAI's new generation of ChatGPT Voice, launched on July 8, 2026. It is a full-duplex voice model, meaning it can listen and speak at the same time, which makes talking to ChatGPT feel much more like a real conversation. It comes in two versions, GPT-Live-1 and GPT-Live-1 mini, and replaces the older Advanced Voice Mode.\"}]]}],[\"$\",\"div\",\"1\",{\"className\":\"rounded-2xl p-5 md:p-6\",\"style\":{\"backgroundColor\":\"#fff\",\"border\":\"1px solid #eee\"},\"children\":[[\"$\",\"h3\",null,{\"style\":{\"fontSize\":\"clamp(1.125rem, 3vw, 1.375rem)\",\"fontWeight\":500,\"lineHeight\":\"1.4\",\"color\":\"#0a0a0a\",\"marginBottom\":\"0.5rem\"},\"children\":\"When was GPT-Live released and where can I use it?\"}],[\"$\",\"p\",null,{\"style\":{\"fontSize\":\"0.9375rem\",\"fontWeight\":400,\"lineHeight\":\"1.8\",\"color\":\"#444\"},\"children\":\"OpenAI released GPT-Live on July 8, 2026. It is rolling out globally inside the ChatGPT app on iOS and Android and on ChatGPT.com on the web, where it becomes the default voice experience. OpenAI said support in the API is coming soon.\"}]]}],[\"$\",\"div\",\"2\",{\"className\":\"rounded-2xl p-5 md:p-6\",\"style\":{\"backgroundColor\":\"#fff\",\"border\":\"1px solid #eee\"},\"children\":[[\"$\",\"h3\",null,{\"style\":{\"fontSize\":\"clamp(1.125rem, 3vw, 1.375rem)\",\"fontWeight\":500,\"lineHeight\":\"1.4\",\"color\":\"#0a0a0a\",\"marginBottom\":\"0.5rem\"},\"children\":\"How is GPT-Live different from Advanced Voice Mode?\"}],[\"$\",\"p\",null,{\"style\":{\"fontSize\":\"0.9375rem\",\"fontWeight\":400,\"lineHeight\":\"1.8\",\"color\":\"#444\"},\"children\":\"Advanced Voice Mode was half-duplex: it chained a speech-to-text model, a language model, and a text-to-speech model, which forced strict turn-taking. GPT-Live is full-duplex, a single model that listens and speaks simultaneously, adds natural cues like \\\"mhmm\\\" and \\\"yeah,\\\" handles interruptions gracefully, and hands hard questions to a stronger model (GPT-5.5 at launch) in the background. In OpenAI's testing, people preferred GPT-Live 75.7% of the time.\"}]]}],[\"$\",\"div\",\"3\",{\"className\":\"rounded-2xl p-5 md:p-6\",\"style\":{\"backgroundColor\":\"#fff\",\"border\":\"1px solid #eee\"},\"children\":[[\"$\",\"h3\",null,{\"style\":{\"fontSize\":\"clamp(1.125rem, 3vw, 1.375rem)\",\"fontWeight\":500,\"lineHeight\":\"1.4\",\"color\":\"#0a0a0a\",\"marginBottom\":\"0.5rem\"},\"children\":\"Which ChatGPT plans get GPT-Live-1 versus GPT-Live-1 mini?\"}],[\"$\",\"p\",null,{\"style\":{\"fontSize\":\"0.9375rem\",\"fontWeight\":400,\"lineHeight\":\"1.8\",\"color\":\"#444\"},\"children\":\"GPT-Live-1 is the default voice model for paid subscribers on the Go, Plus, and Pro plans. GPT-Live-1 mini is the default for free users. Both replace Advanced Voice Mode as the standard ChatGPT Voice experience.\"}]]}],[\"$\",\"div\",\"4\",{\"className\":\"rounded-2xl p-5 md:p-6\",\"style\":{\"backgroundColor\":\"#fff\",\"border\":\"1px solid #eee\"},\"children\":[[\"$\",\"h3\",null,{\"style\":{\"fontSize\":\"clamp(1.125rem, 3vw, 1.375rem)\",\"fontWeight\":500,\"lineHeight\":\"1.4\",\"color\":\"#0a0a0a\",\"marginBottom\":\"0.5rem\"},\"children\":\"Is ChatGPT's new voice like the movie Her?\"}],[\"$\",\"p\",null,{\"style\":{\"fontSize\":\"0.9375rem\",\"fontWeight\":400,\"lineHeight\":\"1.8\",\"color\":\"#444\"},\"children\":\"That is the comparison many people reach for. Like the AI in the 2013 film Her, GPT-Live holds a flowing, natural conversation, listens while it talks, and responds without the awkward pauses of older assistants. OpenAI has drawn Her comparisons before, including the Sky voice it pulled in 2024. GPT-Live is the closest a mainstream product has come to that experience.\"}]]}],\"$L4c\",\"$L4d\"]}]]}]\n31:[\"$\",\"section\",null,{\"className\":\"mb-8\",\"children\":[\"$\",\"div\",null,{\"className\":\"relative overflow-hidden rounded-[20px] py-14 md:py-20 px-6\",\"style\":{\"backgroundColor\":\"#F5F9FF\",\"color\":\"#0a0a0a\",\"border\":\"1px solid #e5edf8\"},\"children\":[[\"$\",\"div\",null,{\"className\":\"absolute inset-0\",\"style\":{\"backgroundImage\":\"url(/oceanWarp.webp)\",\"backgroundSize\":\"cover\",\"backgroundPosition\":\"center\"}}],[\"$\",\"div\",null,{\"className\":\"absolute inset-0 pointer-events-none\",\"style\":{\"backgroundColor\":\"rgba(255, 255, 255, 0.7)\"}}],[\"$\",\"div\",null,{\"className\":\"absolute inset-0 pointer-events-none\",\"style\":{\"background\":\"radial-gradient(ellipse 120% 120% at 50% 50%, transparent 30%, rgba(255,255,255,0.5) 70%, rgba(255,255,255,0.85) 100%)\"}}],[\"$\",\"div\",null,{\"className\":\"relative text-center flex flex-col items-center gap-4\",\"children\":[[\"$\",\"h2\",null,{\"style\":{\"fontSize\":\"clamp(1.375rem, 4vw, 1.75rem)\",\"fontWeight\":600,\"lineHeight\":\"1.3\",\"letterSpacing\":\"-0.02em\",\"color\":\"#0a0a0a\"},\"children\":\"Turn the conversation into work\"}],[\"$\",\"p\",null,{\"style\":{\"fontSize\":\"0.9375rem\",\"color\":\"rgba(10,10,10,0.58)\"},\"children\":\"GPT-Live makes talking to AI feel natural. VoiceOS makes it useful everywhere, letting you dictate, edit, ask, and take action across your Mac or Windows apps just by speaking.\"}],[\"$\",\"$L4e\",null,{\"href\":\"/\",\"sourceType\":\"blog\",\"sourceSlug\":\"gpt-live-full-duplex-voice\",\"className\":\"mt-2 inline-flex items-center gap-2 px-6 py-2.5 rounded-full text-sm font-medium border border-black/[0.06] shadow-[0_1px_2px_rgba(0,0,0,0.04),0_4px_12px_rgba(0,0,0,0.06)] transition-all duration-200 hover:-translate-y-[1px] hover:shadow-[0_2px_4px_rgba(0,0,0,0.06),0_8px_20px_rgba(0,0,0,0.08)]\",\"style\":{\"backgroundColor\":\"#fff\",\"color\":\"#111\"},\"children\":[\"Try VoiceOS\",[\"$\",\"svg\",null,{\"className\":\"w-3.5 h-3.5\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"viewBox\":\"0 0 24 24\",\"children\":[\"$\",\"path\",null,{\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"strokeWidth\":2.5,\"d\":\"M9 5l7 7-7 7\"}]}]]}]]}]]}]}]\n32:[\"$\",\"aside\",null,{\"className\":\"hidden lg:block\",\"children\":[\"$\",\"div\",null,{\"className\":\"sticky top-32\",\"children\":[\"$\",\"$L4f\",null,{\"title\":\"GPT-Live Is Here: ChatGPT's Voice Now Listens and Talks at Once, Just Like 'Her' and JARVIS\",\"url\":\"https://voiceos.com/blog/gpt-live-full-duplex-voice\"}]}]}]\n33:[\"$\",\"div\",null,{\"className\":\"lg:hidden mt-8 flex justify-center\",\"children\":[\"$\",\"$L4f\",null,{\"title\":\"GPT-Live Is Here: ChatGPT's Voice Now Listens and Talks at Once, Just Like 'Her' and JARVIS\",\"url\":\"https://voiceos.com/blog/gpt-live-full-duplex-voice\"}]}]\n36:[\"$\",\"$L4\",null,{\"parallelRouterKey\":\"children\",\"error\":\"$undefined\",\"errorStyles\":\"$undefined\",\"errorScripts\":\"$undefined\",\"template\":[\"$\",\"$L5\",null,{}],\"templateStyles\":\"$undefined\",\"templateScripts\":\"$undefined\",\"notFound\":\"$undefined\",\"forbidden\":\"$undefined\",\"unauthorized\":\"$undefined\"}]\n50:I[22016,[\"/_next/static/chunks/2kb52na2e7ces.js\",\"/_next/static/chunks/1xfsu92iq1h9m.js\",\"/_next/static/chunks/3x6-_ejf1r1x0.js\",\"/_next/static/chunks/0axdrs6tow-4n.js\"],\"\"]\n51:I[62549,[\"/_next/static/chunks/2kb52na2e7ces.js\",\"/_next/static/chunks/1xfsu92iq1h9m.js\",\"/_next/static/chunks/3x6-_ejf1r1x0.js\"],\"default\"]\n52:I[77105,[\"/_next/static/chunks/2kb52na2e7ces.js\",\"/_next/static/chunks/1xfsu92iq1h9m.js\",\"/_next/static/chunks/3x6-_ejf1r1x0.js\",\"/_next/static/chunks/1bslr0-ipnt__.js\",\"/_next/static/chunks/35rx1_qn9m74v.js\",\"/_next/static/chunks/0z6qqa_pcb2c9.js\"],\"default\"]\n3d:[\"$\",\"div\",null,{\"className\":\"px-4 py-3 md:px-6\",\"style\":{\"backgroundColor\":\"#F5F9FF\"},\"children\":[\"$\",\"p\",null,{\"style\":{\"fontSize\":\"0.9375rem\",\"fontWeight\":400,\"lineHeight\":1.6,\"color\":\"#0a0a0a\",\"margin\":0},\"children\":\"Continuous. It decides whether to talk, listen, or pause many times a second.\"}]}]\n3e:[\"$\",\"div\",\"2\",{\"children\":[[\"$\",\"div\",null,{\"className\":\"px-4 pt-4 md:px-6\",\"style\":{\"borderTop\":\"1px solid #f0f0f0\"},\"children\":[\"$\",\"p\",null,{\"style\":{\"fontSize\":\"11px\",\"fontWeight\":600,\"letterSpacing\":\"0.12em\",\"textTransform\":\"uppercase\",\"color\":\"#999\",\"margin\":0},\"children\":\"Interruptions\"}]}],[\"$\",\"div\",null,{\"className\":\"grid grid-cols-2\",\"children\":[[\"$\",\"div\",null,{\"className\":\"px-4 py-3 md:px-6\",\"style\":{\"borderRight\":\"1px solid #eee\"},\"children\":[\"$\",\"p\",null,{\"style\":{\"fontSize\":\"0.9375rem\",\"fontWeight\":400,\"lineHeight\":1.6,\"color\":\"#444\",\"margin\":0},\"children\":\"Clumsy. Jumping in often resets the whole turn.\"}]}],[\"$\",\"div\",null,{\"className\":\"px-4 py-3 md:px-6\",\"style\":{\"backgroundColor\":\"#F5F9FF\"},\"children\":[\"$\",\"p\",null,{\"style\":{\"fontSize\":\"0.9375rem\",\"fontWeight\":400,\"lineHeight\":1.6,\"color\":\"#0a0a0a\",\"margin\":0},\"children\":\"Natural. Interrupt mid-sentence and it adapts without losing the thread.\"}]}]]}]]}]\n3f:[\"$\",\"div\",\"3\",{\"children\":[[\"$\",\"div\",null,{\"className\":\"px-4 pt-4 md:px-6\",\"style\":{\"borderTop\":\"1px solid #f0f0f0\"},\"children\":[\"$\",\"p\",null,{\"style\":{\"fontSize\":\"11px\",\"fontWeight\":600,\"letterSpacing\":\"0.12em\",\"textTransform\":\"uppercase\",\"color\":\"#999\",\"margin\":0},\"children\":\"Listening cues\"}]}],[\"$\",\"div\",null,{\"className\":\"grid grid-cols-2\",\"children\":[[\"$\",\"div\",null,{\"className\":\"px-4 py-3 md:px-6\",\"style\":{\"borderRight\":\"1px solid #eee\"},\"children\":[\"$\",\"p\",null,{\"style\":{\"fontSize\":\"0.9375rem\",\"fontWeight\":400,\"lineHeight\":1.6,\"color\":\"#444\",\"margin\":0},\"children\":\"Silent until it is your turn.\"}]}],[\"$\",\"div\",null,{\"className\":\"px-4 py-3 md:px-6\",\"style\":{\"backgroundColor\":\"#F5F9FF\"},\"children\":[\"$\",\"p\",null,{\"style\":{\"fontSize\":\"0.9375rem\",\"fontWeight\":400,\"lineHeight\":1.6,\"color\":\"#0a0a0a\",\"margin\":0},\"children\":\"Backchannels with \\\"mhmm,\\\" \\\"yeah,\\\" and \\\"got it\\\" while you speak.\"}]}]]}]]}]\n40:[\"$\",\"div\",\"4\",{\"children\":[[\"$\",\"div\",null,{\"className\":\"px-4 pt-4 md:px-6\",\"style\":{\"borderTop\":\"1px solid #f0f0f0\"},\"children\":[\"$\",\"p\",null,{\"style\":{\"fontSize\":\"11px\",\"fontWeight\":600,\"letterSpacing\":\"0.12em\",\"textTransform\":\"uppercase\",\"color\":\"#999\",\"margin\":0},\"children\":\"Hard questions\"}]}],[\"$\",\"div\",null,{\"className\":\"grid grid-cols-2\",\"children\":[[\"$\",\"div\",null,{\"className\":\"px-4 py-3 md:px-6\",\"style\":{\"borderRight\":\"1px solid #eee\"},\"children\":[\"$\",\"p\",null,{\"style\":{\"fontSize\":\"0.9375rem\",\"fontWeight\":400,\"lineHeight\":1.6,\"color\":\"#444\",\"margin\":0},\"children\":\"One model does everything, so depth and speed trade off.\"}]}],[\"$\",\"div\",null,{\"className\":\"px-4 py-3 md:px-6\",\"style\":{\"backgroundColor\":\"#F5F9FF\"},\"children\":[\"$\",\"p\",null,{\"style\":{\"fontSize\":\"0.9375rem\",\"fontWeight\":400,\"lineHeight\":1.6,\"color\":\"#0a0a0a\",\"margin\":0},\"children\":\"Delegates to GPT-5.5 in the background and keeps talking while it works.\"}]}]]}]]}]\n4c:[\"$\",\"div\",\"5\",{\"className\":\"rounded-2xl p-5 md:p-6\",\"style\":{\"backgroundColor\":\"#fff\",\"border\":\"1px solid #eee\"},\"children\":[[\"$\",\"h3\",null,{\"style\":{\"fontSize\":\"clamp(1.125rem, 3vw, 1.375rem)\",\"fontWeight\":500,\"lineHeight\":\"1.4\",\"color\":\"#0a0a0a\",\"marginBottom\":\"0.5rem\"},\"children\":\"Does this mean I can have a real-life JARVIS?\"}],[\"$\",\"p\",null,{\"style\":{\"fontSize\":\"0.9375rem\",\"fontWeight\":400,\"lineHeight\":\"1.8\",\"color\":\"#444\"},\"children\":\"A natural voice like GPT-Live is one half of the JARVIS idea. The other half is a computer that can actually take action across your apps, not just talk. For that you need a system-wide voice layer. VoiceOS brings a JARVIS-style assistant to Mac and Windows: you talk, and it dictates, edits, answers questions about your screen, and takes actions across apps like Gmail, Slack, and Calendar.\"}]]}]\n4d:[\"$\",\"div\",\"6\",{\"className\":\"rounded-2xl p-5 md:p-6\",\"style\":{\"backgroundColor\":\"#fff\",\"border\":\"1px solid #eee\"},\"children\":[[\"$\",\"h3\",null,{\"style\":{\"fontSize\":\"clamp(1.125rem, 3vw, 1.375rem)\",\"fontWeight\":500,\"lineHeight\":\"1.4\",\"color\":\"#0a0a0a\",\"marginBottom\":\"0.5rem\"},\"children\":\"Is voice really becoming the new operating system?\"}],[\"$\",\"p\",null,{\"style\":{\"fontSize\":\"0.9375rem\",\"fontWeight\":400,\"lineHeight\":\"1.8\",\"color\":\"#444\"},\"children\":\"The direction is clear. OpenAI's own ChatGPT Voice lead described voice as becoming \\\"a kind of primary interface to computing.\\\" As AI learns to understand intent rather than fixed commands, talking becomes a primary way to operate a computer, alongside the keyboard and mouse. Tools like VoiceOS take that further by letting your voice act across every app on your desktop, not just inside one chatbot.\"}]]}]\n19:[\"$\",\"$L35\",null,{\"formats\":\"$undefined\",\"locale\":\"en\",\"messages\":{\"Navbar\":\"$3:props:messages:Navbar\",\"Footer\":\"$3:props:messages:Footer\",\"MobilePage\":\"$3:props:messages:MobilePage\",\"CTA\":\"$3:props:messages:CTA\"},\"now\":\"$undefined\",\"timeZone\":\"UTC\",\"children\":[[\"$\",\"$L4\",null,{\"parallelRouterKey\":\"children\",\"error\":\"$undefined\",\"errorStyles\":\"$undefined\",\"errorScripts\":\"$undefined\",\"template\":[\"$\",\"$L5\",null,{}],\"templateStyles\":\"$undefined\",\"templateScripts\":\"$undefined\",\"notFound\":[[\"$\",\"main\",null,{\"classNa