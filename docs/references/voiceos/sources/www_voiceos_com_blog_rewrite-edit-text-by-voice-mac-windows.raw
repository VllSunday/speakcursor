\",\"label\":\"How to rewrite text by voice (general workflow)\"},{\"id\":\"copy-ready-prompts\",\"label\":\"Copy-ready edit prompts\"},{\"id\":\"common-problems\",\"label\":\"Common problems (and fixes)\"},{\"id\":\"voiceos-edit-mode\",\"label\":\"Where VoiceOS fits (Edit mode)\"},{\"id\":\"frequently-asked-questions\",\"label\":\"Frequently asked questions\"}]}]\n13:[\"$\",\"div\",null,{\"className\":\"min-w-0\",\"children\":[null,\"$L17\",[\"$\",\"div\",null,{\"className\":\"mb-6\",\"children\":[\"$\",\"span\",null,{\"style\":{\"color\":\"#0369a1\",\"fontSize\":\"12px\",\"fontWeight\":600,\"letterSpacing\":\"0.14em\",\"textTransform\":\"uppercase\",\"lineHeight\":1},\"children\":\"Voice editing\"}]}],[\"$\",\"h1\",null,{\"style\":{\"fontSize\":\"clamp(2rem, 6vw, 3.25rem)\",\"fontWeight\":600,\"lineHeight\":\"1.15\",\"color\":\"#0a0a0a\",\"letterSpacing\":\"-0.03em\"},\"children\":\"How to Rewrite and Edit Text by Voice on Mac and Windows\"}],[\"$\",\"p\",null,{\"className\":\"mt-5\",\"style\":{\"fontSize\":\"clamp(1.125rem, 2.5vw, 1.375rem)\",\"fontWeight\":300,\"lineHeight\":\"1.6\",\"color\":\"#555\"},\"children\":\"Select existing text, speak a change, and let the model replace the selection—without pasting into a chatbot or retyping from scratch.\"}],[\"$\",\"div\",null,{\"className\":\"mt-8 flex items-center gap-5 border-b border-[#eee] pb-8\",\"children\":[[\"$\",\"$L18\",null,{\"src\":\"/kaiBlogProfile.png\",\"alt\":\"Kai Brokering\",\"width\":40,\"height\":40,\"className\":\"flex-shrink-0 rounded-full object-cover\"}],[\"$\",\"div\",null,{\"className\":\"flex items-center gap-6\",\"children\":[[\"$\",\"div\",null,{\"children\":[[\"$\",\"span\",null,{\"className\":\"mb-0.5 block text-xs text-[#999]\",\"children\":\"Written by\"}],[\"$\",\"a\",null,{\"href\":\"https://www.voiceos.com/authors/kai-brokering\",\"className\":\"text-sm font-semibold text-[#0a0a0a] hover:underline\",\"children\":\"Kai Brokering\"}]]}],[\"$\",\"div\",null,{\"className\":\"border-l border-[#e5e5e5] pl-6\",\"children\":[[\"$\",\"span\",null,{\"className\":\"mb-0.5 block text-xs text-[#999]\",\"children\":\"Published\"}],[\"$\",\"time\",null,{\"dateTime\":\"2026-09-19T09:00:00.000Z\",\"className\":\"text-sm font-semibold text-[#0a0a0a]\",\"children\":\"September 19, 2026\"}]]}]]}]]}],[\"$\",\"$L18\",null,{\"src\":\"/blogs/rewrite-edit-text-by-voice-mac-windows/thumbnail.png\",\"alt\":\"Voice editing: select, speak, replace—on Mac and Windows\",\"width\":1536,\"height\":1024,\"sizes\":\"(max-width: 1024px) 100vw, 900px\",\"className\":\"mt-8 h-auto w-full rounded-2xl object-cover\",\"priority\":true}],null,[\"$\",\"article\",null,{\"className\":\"mt-12\",\"children\":[[[\"$\",\"section\",\"key-takeaways\",{\"id\":\"key-takeaways\",\"className\":\"mb-16 scroll-mt-28\",\"children\":[[\"$\",\"div\",null,{\"className\":\"rounded-2xl border border-[#eee] bg-white p-6 md:p-8\",\"children\":[[\"$\",\"h2\",null,{\"style\":{\"fontSize\":\"clamp(1.5rem, 4vw, 2rem)\",\"fontWeight\":500,\"lineHeight\":\"1.3\",\"color\":\"#0a0a0a\",\"letterSpacing\":\"-0.02em\",\"marginBottom\":\"1rem\"},\"children\":\"Key takeaways\"}],[\"$\",\"div\",null,{\"className\":\"space-y-6\",\"children\":[[\"$\",\"div\",\"0\",{\"children\":[[\"$\",\"ul\",null,{\"className\":\"space-y-3\",\"children\":[[\"$\",\"li\",\"0\",{\"className\":\"flex gap-3\",\"style\":{\"fontSize\":\"1.0625rem\",\"fontWeight\":400,\"lineHeight\":\"1.8\",\"color\":\"#444\"},\"children\":[[\"$\",\"span\",null,{\"className\":\"mt-[0.65em] h-2 w-2 flex-shrink-0 rounded-full bg-[#0a0a0a]\"}],[\"$\",\"span\",null,{\"children\":\"**Rewriting by voice** means you keep the draft you already have, select it, and speak an instruction (\\\"make this shorter,\\\" \\\"more formal,\\\" \\\"turn this into bullets\\\") so the computer replaces the selection—instead of dictating a brand-new paragraph from scratch.\"}]]}],[\"$\",\"li\",\"1\",{\"className\":\"flex gap-3\",\"style\":\"$13:props:children:8:props:children:0:0:props:children:0:props:children:1:props:children:0:props:children:0:props:children:0:props:style\",\"children\":[[\"$\",\"span\",null,{\"className\":\"mt-[0.65em] h-2 w-2 flex-shrink-0 rounded-full bg-[#0a0a0a]\"}],[\"$\",\"span\",null,{\"children\":\"**Built-in tools** (macOS Dictation, Windows Voice Typing, Apple Intelligence Writing Tools where available) help you *enter* or lightly clean text. They are weaker when you want a full rewrite in place across every app.\"}]]}],[\"$\",\"li\",\"2\",{\"className\":\"flex gap-3\",\"style\":\"$13:props:children:8:props:children:0:0:props:children:0:props:children:1:props:children:0:props:children:0:props:children:0:props:style\",\"children\":[[\"$\",\"span\",null,{\"className\":\"mt-[0.65em] h-2 w-2 flex-shrink-0 rounded-full bg-[#0a0a0a]\"}],[\"$\",\"span\",null,{\"children\":\"**Chatbots** can rewrite well if you paste text in—and that paste step is the friction. A system-wide **Edit mode** removes the round trip: select → speak → replace.\"}]]}],[\"$\",\"li\",\"3\",{\"className\":\"flex gap-3\",\"style\":\"$13:props:children:8:props:children:0:0:props:children:0:props:children:1:props:children:0:props:children:0:props:children:0:props:style\",\"children\":[[\"$\",\"span\",null,{\"className\":\"mt-[0.65em] h-2 w-2 flex-shrink-0 rounded-full bg-[#0a0a0a]\"}],[\"$\",\"span\",null,{\"children\":\"**VoiceOS Edit mode** (Mac and Windows) is built for that select-and-rewrite loop, alongside Dictate (new text) and Agent (actions with confirmation). Try it after you understand the general workflow below.\"}]]}]]}],\"$L19\"]}]]}]]}],null]}],\"$L1a\",\"$L1b\",\"$L1c\",\"$L1d\",\"$L1e\",\"$L1f\"],\"$L20\",\"$L21\",\"$L22\",\"$L23\",\"$L24\"]}]]}]\n14:[\"$\",\"aside\",null,{\"className\":\"hidden lg:block\",\"children\":[\"$\",\"div\",null,{\"className\":\"sticky top-32\",\"children\":[\"$\",\"$L25\",null,{\"title\":\"How to Rewrite and Edit Text by Voice on Mac and Windows\",\"url\":\"https://www.voiceos.com/blog/rewrite-edit-text-by-voice-mac-windows\"}]}]}]\n15:[\"$\",\"$L26\",null,{}]\n37:I[28554,[\"/_next/static/chunks/2kb52na2e7ces.js\",\"/_next/static/chunks/1xfsu92iq1h9m.js\",\"/_next/static/chunks/3x6-_ejf1r1x0.js\",\"/_next/static/chunks/1bslr0-ipnt__.js\",\"/_next/static/chunks/35rx1_qn9m74v.js\",\"/_next/static/chunks/0z6qqa_pcb2c9.js\"],\"default\"]\n19:null\n1a:[\"$\",\"section\",\"what-edit-by-voice-means\",{\"id\":\"what-edit-by-voice-means\",\"className\":\"mb-16 scroll-mt-28\",\"children\":[[[\"$\",\"h2\",null,{\"style\":{\"fontSize\":\"clamp(1.5rem, 4vw, 2rem)\",\"fontWeight\":500,\"lineHeight\":\"1.3\",\"color\":\"#0a0a0a\",\"letterSpacing\":\"-0.02em\",\"marginBottom\":\"1.5rem\"},\"children\":\"What \\\"edit by voice\\\" actually means\"}],[\"$\",\"div\",null,{\"className\":\"space-y-6\",\"children\":[[\"$\",\"p\",\"0\",{\"style\":\"$13:props:children:8:props:children:0:0:props:children:0:props:children:1:props:children:0:props:children:0:props:children:0:props:style\",\"children\":[\"Most people who try voice on a computer start with **dictation**: talk, get words in a text field, fix a few mistakes. That is useful. It is not the same as **editing**.\",null]}],[\"$\",\"p\",\"1\",{\"style\":\"$13:props:children:8:props:children:0:0:props:children:0:props:children:1:props:children:0:props:children:0:props:children:0:props:style\",\"children\":[\"Editing is what you do when the words are already there:\",null]}],[\"$\",\"div\",\"2\",{\"children\":[[\"$\",\"ul\",null,{\"className\":\"space-y-3\",\"children\":[[\"$\",\"li\",\"0\",{\"className\":\"flex gap-3\",\"style\":\"$13:props:children:8:props:children:0:0:props:children:0:props:children:1:props:children:0:props:children:0:props:children:0:props:style\",\"children\":[[\"$\",\"span\",null,{\"className\":\"mt-[0.65em] h-2 w-2 flex-shrink-0 rounded-full bg-[#0a0a0a]\"}],[\"$\",\"span\",null,{\"children\":\"The email is too long.\"}]]}],[\"$\",\"li\",\"1\",{\"className\":\"flex gap-3\",\"style\":\"$13:props:children:8:props:children:0:0:props:children:0:props:children:1:props:children:0:props:children:0:props:children:0:props:style\",\"children\":[[\"$\",\"span\",null,{\"className\":\"mt-[0.65em] h-2 w-2 flex-shrink-0 rounded-full bg-[#0a0a0a]\"}],[\"$\",\"span\",null,{\"children\":\"The Slack reply sounds cold.\"}]]}],[\"$\",\"li\",\"2\",{\"className\":\"flex gap-3\",\"style\":\"$13:props:children:8:props:children:0:0:props:children:0:props:children:1:props:children:0:props:children:0:props:children:0:props:style\",\"children\":[[\"$\",\"span\",null,{\"className\":\"mt-[0.65em] h-2 w-2 flex-shrink-0 rounded-full bg-[#0a0a0a]\"}],[\"$\",\"span\",null,{\"children\":\"The paragraph should be bullets.\"}]]}],[\"$\",\"li\",\"3\",{\"className\":\"flex gap-3\",\"style\":\"$13:props:children:8:props:children:0:0:props:children:0:props:children:1:props:children:0:props:children:0:props:children:0:props:style\",\"children\":[[\"$\",\"span\",null,{\"className\":\"mt-[0.65em] h-2 w-2 flex-shrink-0 rounded-full bg-[#0a0a0a]\"}],[\"$\",\"span\",null,{\"children\":\"The tone should be friendlier for a customer, or sharper for a founder update.\"}]]}]]}],null]}],[\"$\",\"p\",\"3\",{\"style\":\"$13:props:children:8:props:children:0:0:props:children:0:props:children:1:props:children:0:props:children:0:props:children:0:props:style\",\"children\":[\"With a keyboard, you highlight, delete, retype, and second-guess. With voice editing, you highlight, speak the change you want, and let the model rewrite *that* selection. You stay in the same app. You do not re-explain the whole draft from memory.\",null]}],[\"$\",\"p\",\"4\",{\"style\":\"$13:props:children:8:props:children:0:0:props:children:0:props:children:1:props:children:0:props:children:0:props:children:0:props:style\",\"children\":[\"If your wrists, shoulders, or focus are already taxed from a long typing day, this is the part of voice that often matters more than raw speed. You are not generating more text. You are changing text you already decided to send.\",null]}]]}]],null]}]\n1b:[\"$\",\"section\",\"three-ways-to-rewrite\",{\"id\":\"three-ways-to-rewrite\",\"className\":\"mb-16 scroll-mt-28\",\"children\":[[[\"$\",\"h2\",null,{\"style\":{\"fontSize\":\"clamp(1.5rem, 4vw, 2rem)\",\"fontWeight\":500,\"lineHeight\":\"1.3\",\"color\":\"#0a0a0a\",\"letterSpacing\":\"-0.02em\",\"marginBottom\":\"1.5rem\"},\"children\":\"Three ways people rewrite text with AI today\"}],[\"$\",\"div\",null,{\"className\":\"space-y-6\",\"children\":[[\"$\",\"p\",\"0\",{\"style\":\"$13:props:children:8:props:children:0:0:props:children:0:props:children:1:props:children:0:props:children:0:props:children:0:props:style\",\"children\":[\"**1. Built-in OS tools**\",null]}],[\"$\",\"p\",\"1\",{\"style\":\"$13:props:children:8:props:children:0:0:props:children:0:props:children:1:props:children:0:props:children:0:props:children:0:props:style\",\"children\":[\"**On a Mac:** Turn on Dictation in System Settings → Keyboard → Dictation (or the equivalent path on your macOS version). Place the cursor, use the Dictation shortcut, and speak new text. Where Apple Intelligence Writing Tools are available on your Mac, you can often select text and ask for a rewrite, proofread, or summary from the system UI.\",[\"$\",\"sup\",null,{\"className\":\"ml-1\",\"children\":[[\"$\",\"a\",\"apple-dictation\",{\"href\":\"#source-apple-dictation\",\"className\":\"text-blue-600 hover:underline\",\"aria-label\":\"Source 3\",\"children\":[\"[\",3,\"]\",\"\"]}]]}]]}],[\"$\",\"p\",\"2\",{\"style\":\"$13:props:children:8:props:children:0:0:props:children:0:props:children:1:props:children:0:props:children:0:props:children:0:props:style\",\"children\":[\"**On Windows:** Press Win + H to open Voice Typing in supported fields. Speak to insert text. Use the on-screen options your Windows build exposes for punctuation and commands.\",[\"$\",\"sup\",null,{\"className\":\"ml-1\",\"children\":[[\"$\",\"a\",\"windows-voice-typing\",{\"href\":\"#source-windows-voice-typing\",\"className\":\"text-blue-600 hover:underline\",\"aria-label\":\"Source 4\",\"children\":[\"[\",4,\"]\",\"\"]}]]}]]}],[\"$\",\"p\",\"3\",{\"style\":\"$13:props:children:8:props:children:0:0:props:children:0:props:children:1:props:children:0:props:children:0:props:children:0:props:style\",\"children\":[\"**Honest limit:** These tools are strongest at *getting words in*. Full \\\"reshape this selection into a different tone\\\" across *every* app is inconsistent. Some apps honor system writing tools; many chat boxes and web editors do not.\",null]}],[\"$\",\"p\",\"4\",{\"style\":\"$13:props:children:8:props:children:0:0:props:children:0:props:children:1:props:children:0:props:children:0:props:children:0:props:style\",\"children\":[\"**2. Paste into a chatbot, then paste back**\",null]}],[\"$\",\"p\",\"5\",{\"style\":\"$13:props:children:8:props:children:0:0:props:children:0:props:children:1:props:children:0:props:children:0:props:children:0:props:style\",\"children\":[\"The common 2026 workaround: copy the draft, open ChatGPT, Claude, Gemini, or similar, paste and add instructions (\\\"shorter,\\\" \\\"less corporate,\\\" \\\"bullet points\\\"), copy the result, paste back into Slack, Mail, Docs, or your IDE comment box.\",null]}],[\"$\",\"p\",\"6\",{\"style\":\"$13:props:children:8:props:children:0:0:props:children:0:props:children:1:props:children:0:props:children:0:props:children:0:props:style\",\"children\":[\"The model quality is often excellent. The workflow is not. You context-switch, lose the thread you were answering, and sometimes paste into the wrong window. If you do this ten times a day, the tax adds up.\",null]}],[\"$\",\"p\",\"7\",{\"style\":\"$13:props:children:8:props:children:0:0:props:children:0:props:children:1:props:children:0:props:children:0:props:children:0:props:style\",\"children\":[\"**3. System-wide select → speak → replace**\",null]}],[\"$\",\"p\",\"8\",{\"style\":\"$13:props:children:8:props:children:0:0:props:children:0:props:children:1:props:children:0:props:children:0:props:children:0:props:style\",\"children\":[\"A voice layer that sits above your apps can treat the current selection as the thing to rewrite. You stay in Gmail, Notion, Linear, Docs, or a browser text field. You speak the edit. The selection updates.\",null]}],[\"$\",\"p\",\"9\",{\"style\":\"$13:props:children:8:props:children:0:0:props:children:0:props:children:1:props:children:0:props:children:0:props:children:0:props:style\",\"children\":[\"That is the shape of **VoiceOS Edit mode**, described after the general steps so you can judge the fit.\",[\"$\",\"sup\",null,{\"className\":\"ml-1\",\"children\":[[\"$\",\"a\",\"voiceos-edit\",{\"href\":\"#source-voiceos-edit\",\"className\":\"text-blue-600 hover:underline\",\"aria-label\":\"Source 1\",\"children\":[\"[\",1,\"]\",\"\"]}]]}]]}]]}]],[\"$\",\"div\",null,{\"className\":\"mt-6 rounded-2xl border border-[#eee] bg-white p-5\",\"children\":[\"$\",\"p\",null,{\"style\":{\"fontSize\":\"0.9375rem\",\"fontWeight\":400,\"lineHeight\":\"1.8\",\"color\":\"#444\",\"margin\":0},\"children\":[[\"$\",\"span\",null,{\"className\":\"font-semibold text-[#0a0a0a]\",\"children\":\"Sources \u0026 further reading:\"}],\" \",[[\"$\",\"span\",\"apple-dictation\",{\"children\":[[\"$\",\"a\",null,{\"href\":\"https://support.apple.com/en-gb/guide/mac-help/mh40584/mac\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"style\":{\"color\":\"#0a0a0a\",\"textDecoration\":\"underline\",\"textDecorationColor\":\"#0a0a0a40\",\"textUnderlineOffset\":\"2px\",\"fontWeight\":500},\"children\":\"Dictate messages and documents on Mac\"}],\" · \"]}],[\"$\",\"span\",\"windows-voice-typing\",{\"children\":[[\"$\",\"a\",null,{\"href\":\"https://support.microsoft.com/en-us/windows/use-voice-typing-to-talk-instead-of-type-on-your-pc\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"style\":\"$1b:props:children:1:props:children:props:children:2:0:props:children:0:props:style\",\"children\":\"Use voice typing to talk instead of type on your PC\"}],\" · \"]}],\"$L27\"]]}]}]]}]\n1c:[\"$\",\"section\",\"general-workflow\",{\"id\":\"general-workflow\",\"className\":\"mb-16 scroll-mt-28\",\"children\":[[[\"$\",\"h2\",null,{\"style\":{\"fontSize\":\"clamp(1.5rem, 4vw, 2rem)\",\"fontWeight\":500,\"lineHeight\":\"1.3\",\"color\":\"#0a0a0a\",\"letterSpacing\":\"-0.02em\",\"marginBottom\":\"1.5rem\"},\"children\":\"How to rewrite text by voice (general workflow)\"}],[\"$\",\"div\",null,{\"className\":\"space-y-6\",\"children\":[[\"$\",\"p\",\"0\",{\"style\":\"$13:props:children:8:props:children:0:0:props:children:0:props:children:1:props:children:0:props:children:0:props:children:0:props:style\",\"children\":[\"Use this pattern with whatever stack you have.\",null]}],[\"$\",\"aside\",\"1\",{\"className\":\"rounded-2xl border border-[#eee] bg-white p-5 md:p-6\",\"children\":[[\"$\",\"h3\",null,{\"style\":{\"fontSize\":\"clamp(1.125rem, 3vw, 1.375rem)\",\"fontWeight\":500,\"lineHeight\":\"1.4\",\"color\":\"#0a0a0a\",\"marginBottom\":\"0.5rem\"},\"children\":\"Step 1 — Finish a rough draft first\"}],[\"$\",\"p\",null,{\"style\":\"$13:props:children:8:props:children:0:0:props:children:0:props:children:1:props:children:0:props:children:0:props:children:0:props:style\",\"children\":[\"Dictate or type a messy first pass. Do not polish while you invent. Voice editing shines on text that already exists. Example rough Slack reply: \\\"hey yeah I can look at the PR tomorrow morning but I might be in standup until 10 so maybe closer to 11 also can you drop the link again\\\"\",null]}]]}],[\"$\",\"aside\",\"2\",{\"className\":\"rounded-2xl border border-[#eee] bg-white p-5 md:p-6\",\"children\":[[\"$\",\"h3\",null,{\"style\":\"$1c:props:children:0:1:props:children:1:props:children:0:props:style\",\"children\":\"Step 2 — Select only what should change\"}],[\"$\",\"p\",null,{\"style\":\"$13:props:children:8:props:children:0:0:props:children:0:props:children:1:props:children:0:props:children:0:props:children:0:props:style\",\"children\":[\"Highlight the sentences you want rewritten. Leave greetings, signatures, or code fences alone if they are already fine. Narrow selection = better edits.\",null]}]]}],[\"$\",\"aside\",\"3\",{\"className\":\"rounded-2xl border border-[#eee] bg-white p-5 md:p-6\",\"children\":[[\"$\",\"h3\",null,{\"style\":\"$1c:props:children:0:1:props:children:1:props:children:0:props:style\",\"children\":\"Step 3 — Speak a clear edit instruction\"}],[\"$\",\"p\",null,{\"style\":\"$13:props:children:8:props:children:0:0:props:children:0:props:children:1:props:children:0:props:children:0:props:children:0:props:style\",\"children\":[\"Say the outcome, not a novel: \\\"Make this shorter.\\\" \\\"Make this more polite.\\\" \\\"Make this more direct.\\\" \\\"Turn this into three bullet points.\\\" \\\"Fix the grammar but keep my voice.\\\" \\\"Rewrite this for a customer support tone.\\\" One instruction per pass beats stacking five requests in one breath.\",null]}]]}],[\"$\",\"aside\",\"4\",{\"className\":\"rounded-2xl border border-[#eee] bg-white p-5 md:p-6\",\"children\":[[\"$\",\"h3\",null,{\"style\":\"$1c:props:children:0:1:props:children:1:props:children:0:props:style\",\"children\":\"Step 4 — Read before you send\"}],[\"$\",\"p\",null,{\"style\":\"$13:props:children:8:props:children:0:0:props:children:0:props:children:1:props:children:0:props:children:0:props:children:0:props:style\",\"children\":[\"Voice edits can over-smooth personality or change a meaning you cared about. Skim the result. If it drifted, select again and say \\\"keep my casual tone\\\" or \\\"put back the part about standup.\\\"\",null]}]]}],[\"$\",\"aside\",\"5\",{\"className\":\"rounded-2xl border border-[#eee] bg-white p-5 md:p-6\",\"children\":[[\"$\",\"h3\",null,{\"style\":\"$1c:props:children:0:1:props:children:1:props:children:0:props:style\",\"children\":\"Step 5 — Repeat for structure, then tone\"}],[\"$\",\"p\",null,{\"style\":\"$13:props:children:8:props:children:0:0:props:children:0:props:children:1:props:children:0:props:children:0:props:children:0:props:style\",\"children\":[\"A practical order: 1. Structure (\\\"bullets,\\\" \\\"one short paragraph\\\"). 2. Length (\\\"cut this in half\\\"). 3. Tone (\\\"warmer,\\\" \\\"more formal\\\"). That order prevents a beautiful tone pass on text that is still rambling.\",null]}]]}]]}]],null]}]\n1d:[\"$\",\"section\",\"copy-ready-prompts\",{\"id\":\"copy-ready-prompts\",\"className\":\"mb-16 scroll-mt-28\",\"children\":[[[\"$\",\"h2\",null,{\"style\":{\"fontSize\":\"clamp(1.5rem, 4vw, 2rem)\",\"fontWeight\":500,\"lineHeight\":\"1.3\",\"color\":\"#0a0a0a\",\"letterSpacing\":\"-0.02em\",\"marginBottom\":\"1.5rem\"},\"children\":\"Copy-ready edit prompts\"}],[\"$\",\"div\",null,{\"className\":\"space-y-6\",\"children\":[[\"$\",\"p\",\"0\",{\"style\":\"$13:props:children:8:props:children:0:0:props:children:0:props:children:1:props:children:0:props:children:0:props:children:0:props:style\",\"children\":[\"Speak or paste these as-is:\",null]}],[\"$\",\"div\",\"1\",{\"className\":\"rounded-2xl border border-[#eee] bg-white\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"px-5 pt-5 md:px-6 md:pt-6\",\"style\":\"$1c:props:children:0:1:props:children:1:props:children:0:props:style\",\"children\":\"Edit prompts by goal\"}],[\"$\",\"p\",null,{\"className\":\"px-4 py-3 text-xs text-gray-500 md:hidden\",\"children\":\"Scroll horizontally to read all columns →\"}],[\"$\",\"div\",null,{\"className\":\"overflow-x-auto rounded-2xl focus-visible:outline focus-visible:outline-2 focus-visible:outline-blue-600\",\"role\":\"region\",\"aria-label\":\"Edit prompts by goal\",\"tabIndex\":0,\"children\":[\"$\",\"table\",null,{\"className\":\"w-full min-w-[600px] text-left text-sm md:min-w-0\",\"children\":[[\"$\",\"thead\",null,{\"className\":\"bg-[#f5f5f5]\",\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"Goal\",{\"className\":\"px-4 py-3 font-semibold text-[#0a0a0a]\",\"children\":\"Goal\"}],[\"$\",\"th\",\"Say\",{\"className\":\"px-4 py-3 font-semibold text-[#0a0a0a]\",\"children\":\"Say\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"className\":\"border-t border-[#eee]\",\"children\":[[\"$\",\"td\",\"0\",{\"className\":\"px-4 py-3 align-top leading-6 text-[#444]\",\"children\":\"Shorter\"}],[\"$\",\"td\",\"1\",{\"className\":\"px-4 py-3 align-top leading-6 text-[#444]\",\"children\":\"\\\"Make this half as long. Keep the ask clear.\\\"\"}]]}],[\"$\",\"tr\",\"1\",{\"className\":\"border-t border-[#eee]\",\"children\":[[\"$\",\"td\",\"0\",{\"className\":\"px-4 py-3 align-top leading-6 text-[#444]\",\"children\":\"Clearer\"}],[\"$\",\"td\",\"1\",{\"className\":\"px-4 py-3 align-top leading-6 text-[#444]\",\"children\":\"\\\"Rewrite this so a busy teammate gets the point in one glance.\\\"\"}]]}],[\"$\",\"tr\",\"2\",{\"className\":\"border-t border-[#eee]\",\"children\":[[\"$\",\"td\",\"0\",{\"className\":\"px-4 py-3 align-top leading-6 text-[#444]\",\"children\":\"Warmer\"}],[\"$\",\"td\",\"1\",{\"className\":\"px-4 py-3 align-top leading-6 text-[#444]\",\"children\":\"\\\"Make this friendlier without sounding fake.\\\"\"}]]}],[\"$\",\"tr\",\"3\",{\"className\":\"border-t border-[#eee]\",\"children\":[[\"$\",\"td\",\"0\",{\"className\":\"px-4 py-3 align-top leading-6 text-[#444]\",\"children\":\"Firmer\"}],[\"$\",\"td\",\"1\",{\"className\":\"px-4 py-3 align-top leading-6 text-[#444]\",\"children\":\"\\\"Make this more direct. Keep it professional.\\\"\"}]]}],[\"$\",\"tr\",\"4\",{\"className\":\"border-t border-[#eee]\",\"children\":[[\"$\",\"td\",\"0\",{\"className\":\"px-4 py-3 align-top leading-6 text-[#444]\",\"children\":\"Bullets\"}],[\"$\",\"td\",\"1\",{\"className\":\"px-4 py-3 align-top leading-6 text-[#444]\",\"children\":\"\\\"Turn this into short bullet points.\\\"\"}]]}],[\"$\",\"tr\",\"5\",{\"className\":\"border-t border-[#eee]\",\"children\":[[\"$\",\"td\",\"0\",{\"className\":\"px-4 py-3 align-top leading-6 text-[#444]\",\"children\":\"Support\"}],[\"$\",\"td\",\"1\",{\"className\":\"px-4 py-3 align-top leading-6 text-[#444]\",\"children\":\"\\\"Rewrite this as a calm customer support reply.\\\"\"}]]}],[\"$\",\"tr\",\"6\",{\"className\":\"border-t border-[#eee]\",\"children\":[[\"$\",\"td\",\"0\",{\"className\":\"px-4 py-3 align-top leading-6 text-[#444]\",\"children\":\"Grammar only\"}],[\"$\",\"td\",\"1\",{\"className\":\"px-4 py-3 align-top leading-6 text-[#444]\",\"children\":\"\\\"Fix grammar and punctuation. Do not change the meaning.\\\"\"}]]}],[\"$\",\"tr\",\"7\",{\"className\":\"border-t border-[#eee]\",\"children\":[[\"$\",\"td\",\"0\",{\"className\":\"px-4 py-3 align-top leading-6 text-[#444]\",\"children\":\"Remove filler\"}],[\"$\",\"td\",\"1\",{\"className\":\"px-4 py-3 align-top leading-6 text-[#444]\",\"children\":\"\\\"Remove filler and false starts. Keep my voice.\\\"\"}]]}]]}]]}]}],[\"$\",\"div\",null,{\"className\":\"px-4 pb-3\",\"children\":null}]]}]]}]],null]}]\n1e:[\"$\",\"section\",\"common-problems\",{\"id\":\"common-problems\",\"className\":\"mb-16 scroll-mt-28\",\"children\":[[[\"$\",\"h2\",null,{\"style\":{\"fontSize\":\"clamp(1.5rem, 4vw, 2rem)\",\"fontWeight\":500,\"lineHeight\":\"1.3\",\"color\":\"#0a0a0a\",\"letterSpacing\":\"-0.02em\",\"marginBottom\":\"1.5rem\"},\"children\":\"Common problems (and fixes)\"}],[\"$\",\"div\",null,{\"className\":\"space-y-6\",\"children\":[[\"$\",\"p\",\"0\",{\"style\":\"$13:props:children:8:props:children:0:0:props:children:0:props:children:1:props:children:0:props:children:0:props:children:0:props:style\",\"children\":[\"**The edit rewrites the whole email when you only hated one paragraph.** Select a smaller region. Voice editors usually operate on the selection, not the entire document—unless you selected everything.\",null]}],[\"$\",\"p\",\"1\",{\"style\":\"$13:props:children:8:props:children:0:0:props:children:0:props:children:1:props:children:0:props:children:0:props:children:0:props:style\",\"children\":[\"**The tone becomes generic \\\"AI bland.\\\"** Add a constraint: \\\"Keep it casual,\\\" \\\"sound like a Slack message,\\\" \\\"do not add corporate filler.\\\"\",null]}],[\"$\",\"p\",\"2\",{\"style\":\"$13:props:children:8:props:children:0:0:props:children:0:props:children:1:props:children:0:props:children:0:props:children:0:props:style\",\"children\":[\"**Names, product terms, or jargon get \\\"corrected.\\\"** Add those terms to a custom dictionary if your tool has one, or say \\\"keep the product name exactly as written.\\\"\",null]}],[\"$\",\"p\",\"3\",{\"style\":\"$13:props:children:8:props:children:0:0:props:children:0:props:children:1:props:children:0:props:children:0:props:children:0:props:style\",\"children\":[\"**It fails inside a web app.** Some browser fields block system accessibility hooks. Click into a standard text field, try a different browser, or paste into a temporary Docs/Notes window, edit by voice, then paste back—as a fallback, not the default.\",null]}],[\"$\",\"p\",\"4\",{\"style\":\"$13:props:children:8:props:children:0:0:props:children:0:props:children:1:props:children:0:props:children:0:props:children:0:props:style\",\"children\":[\"**You are still in pain after switching to voice.** Dictation and editing reduce keyboard load; they are not medical treatment. If you have wrist, hand, or shoulder pain, also look at ergonomics and clinical advice. VoiceOS's RSI-oriented guide covers the health-adjacent workflow angle separately.\",null]}]]}]],null]}]\n1f:[\"$\",\"section\",\"voiceos-edit-mode\",{\"id\":\"voiceos-edit-mode\",\"className\":\"mb-16 scroll-mt-28\",\"children\":[[[\"$\",\"h2\",null,{\"style\":{\"fontSize\":\"clamp(1.5rem, 4vw, 2rem)\",\"fontWeight\":500,\"lineHeight\":\"1.3\",\"color\":\"#0a0a0a\",\"letterSpacing\":\"-0.02em\",\"marginBottom\":\"1.5rem\"},\"children\":\"Where VoiceOS fits (Edit mode)\"}],[\"$\",\"div\",null,{\"className\":\"space-y-6\",\"children\":[[\"$\",\"p\",\"0\",{\"style\":\"$13:props:children:8:props:children:0:0:props:children:0:props:children:1:props:children:0:props:children:0:props:children:0:props:style\",\"children\":[\"Once the workflow above is clear, here is the VoiceOS-specific path—useful if you want the select-and-rewrite loop in almost any text field on Mac and Windows, without the chatbot paste round trip.\",[\"$\",\"sup\",null,{\"className\":\"ml-1\",\"children\":[[\"$\",\"a\",\"voiceos-edit\",{\"href\":\"#source-voiceos-edit\",\"className\":\"text-blue-600 hover:underline\",\"aria-label\":\"Source 1\",\"children\":[\"[\",1,\"]\",\"\"]}]]}]]}],[\"$\",\"p\",\"1\",{\"style\":\"$13:props:children:8:props:children:0:0:props:children:0:props:children:1:props:children:0:props:children:0:props:children:0:props:style\",\"children\":[\"VoiceOS splits voice into modes that match the job:\",null]}],[\"$\",\"div\",\"2\",{\"children\":[[\"$\",\"ul\",null,{\"className\":\"space-y-3\",\"children\":[[\"$\",\"li\",\"0\",{\"className\":\"flex gap-3\",\"style\":\"$13:props:children:8:props:children:0:0:props:children:0:props:children:1:props:children:0:props:children:0:props:children:0:props:style\",\"children\":[[\"$\",\"span\",null,{\"className\":\"mt-[0.65em] h-2 w-2 flex-shrink-0 rounded-full bg-[#0a0a0a]\"}],[\"$\",\"span\",null,{\"children\":\"**Dictate** — speak new text into the focused field; filler cleaned up; tone nudged toward the app you are in.\"}]]}],[\"$\",\"li\",\"1\",{\"className\":\"flex gap-3\",\"style\":\"$13:props:children:8:props:children:0:0:props:children:0:props:children:1:props:children:0:props:children:0:props:children:0:props:style\",\"children\":[[\"$\",\"span\",null,{\"className\":\"mt-[0.65em] h-2 w-2 flex-shrink-0 rounded-full bg-[#0a0a0a]\"}],[\"$\",\"span\",null,{\"children\":\"**Edit** — select existing text, speak a rewrite instruction, replace the selection.\"}]]}],[\"$\",\"li\",\"2\",{\"className\":\"flex gap-3\",\"style\":\"$13:props:children:8:props:children:0:0:props:children:0:props:children:1:props:children:0:props:children:0:props:children:0:props:style\",\"children\":[[\"$\",\"span\",null,{\"className\":\"mt-[0.65em] h-2 w-2 flex-shrink-0 rounded-full bg-[#0a0a0a]\"}],[\"$\",\"span\",null,{\"children\":\"**Agent** — ask about what is on screen or take actions in connected apps, with confirmation before consequential sends.\"}]]}]]}],[\"$\",\"sup\",null,{\"className\":\"ml-1\",\"children\":[[\"$\",\"a\",\"voiceos-edit\",{\"href\":\"#source-voiceos-edit\",\"className\":\"text-blue-600 hover:underline\",\"aria-label\":\"Source 1\",\"children\":[\"[\",1,\"]\",\" \"]}],[\"$\",\"a\",\"voiceos-dictation\",{\"href\":\"#source-voiceos-dictation\",\"className\":\"text-blue-600 hover:underline\",\"aria-label\":\"Source 2\",\"children\":[\"[\",2,\"]\",\"\"]}]]}]]}],[\"$\",\"aside\",\"3\",{\"className\":\"rounded-2xl border border-[#eee] bg-white p-5 md:p-6\",\"children\":[[\"$\",\"h3\",null,{\"style\":\"$1c:props:children:0:1:props:children:1:props:children:0:props:style\",\"children\":\"Try an edit in VoiceOS\"}],[\"$\",\"p\",null,{\"style\":\"$13:props:children:8:props:children:0:0:props:children:0:props:children:1:props:children:0:props:children:0:props:children:0:props:style\",\"children\":[\"1. Install VoiceOS on Mac or Windows and grant microphone (and any accessibility permissions your OS requests for typing into apps). 2. Open the draft in the app where it lives—Mail, Slack, Docs, Notion, a browser box, and so on. 3. Select the text you want changed. 4. Invoke Edit mode with your VoiceOS trigger (the shortcut you set in the app). 5. Speak one clear instruction from the table above—for example, \\\"Can you make this shorter?\\\" 6. Review the replacement. Undo or run a second pass if needed. 7. Send only when you are satisfied—especially for external email or customer replies.\",null]}]]}],[\"$\",\"p\",\"4\",{\"style\":\"$13:props:children:8:props:children:0:0:props:children:0:props:children:1:props:children:0:props:children:0:props:children:0:props:style\",\"children\":[\"Here is that loop in Google Docs: text selected, VoiceOS showing the selection chip, and the edit instruction spoken in.\",null]}],[\"$\",\"figure\",\"5\",{\"className\":\"mx-auto my-8 w-full\",\"style\":\"$undefined\",\"children\":[[\"$\",\"a\",null,{\"href\":\"/blogs/rewrite-edit-text-by-voice-mac-windows/docs-edit-shorter.png\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"aria-label\":\"View full-size image: VoiceOS Edit mode with selected Google Docs text and the instruction \\\"Can you make this shorter?\\\"\",\"className\":\"relative block overflow-hidden rounded-2xl focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-blue-600\",\"style\":\"$undefined\",\"children\":[\"$\",\"$L18\",null,{\"src\":\"/blogs/rewrite-edit-text-by-voice-mac-windows/docs-edit-shorter.png\",\"alt\":\"VoiceOS Edit mode with selected Google Docs text and the instruction \\\"Can you make this shorter?\\\"\",\"width\":3024,\"height\":1964,\"sizes\":\"(max-width: 1024px) 100vw, 920px\",\"className\":\"h-auto w-full rounded-2xl object-cover\",\"style\":\"$undefined\"}]}],\"$L28\",\"$L29\"]}],\"$L2a\",\"$L2b\",\"$L2c\",\"$L2d\",\"$L2e\",\"$L2f\",\"$L30\"]}]],\"$L31\"]}]\n20:[\"$\",\"section\",null,{\"id\":\"related-voiceos-reading\",\"className\":\"mb-16 space-y-4\",\"children\":[[\"$\",\"div\",null,{\"className\":\"rounded-2xl border border-[#eee] bg-white p-5\",\"children\":[\"$\",\"p\",null,{\"style\":{\"fontSize\":\"0.9375rem\",\"fontWeight\":400,\"lineHeight\":\"1.8\",\"color\":\"#444\",\"margin\":0},\"children\":[\"Related: \",[[\"$\",\"span\",\"/blog/top-10-dictation-tools-april-2026\",{\"children\":[\"$L32\",\" · \"]}],[\"$\",\"span\",\"/blog/hands-free-voice-control-mac-windows\",{\"children\":[\"$L33\",\" · \"]}],[\"$\",\"span\",\"/blog/what-is-a-voice-operating-system\",{\"children\":[\"$L34\",\" · \"]}],[\"$\",\"span\",\"/blog/voice-typing-for-rsi-and-carpal-tunnel\",{\"children\":[\"$L35\",\"\"]}]]]}]}],[\"$\",\"div\",null,{\"className\":\"rounded-2xl border border-[#eee] bg-white p-5\",\"children\":[\"$\",\"p\",null,{\"style\":{\"fontSize\":\"0.9375rem\",\"fontWeight\":400,\"lineHeight\":\"1.8\",\"color\":\"#444\",\"margin\":0},\"children\":[\"VoiceOS resources: \",[[\"$\",\"span\",\"/features/edit\",{\"children\":[\"$L36\",\"\"]}]]]}]}]]}]\n21:[\"$\",\"section\",null,{\"id\":\"sources\",\"className\":\"mb-16\",\"children\":[[\"$\",\"h2\",null,{\"style\":{\"fontSize\":\"clamp(1.5rem, 4vw, 2rem)\",\"fontWeight\":500,\"lineHeight\":\"1.3\",\"color\":\"#0a0a0a\",\"letterSpacing\":\"-0.02em\",\"marginBottom\":\"1.5rem\"},\"children\":\"Sources and methodology\"}],null,[\"$\",\"p\",null,{\"className\":\"mb-5\",\"style\":{\"fontSize\":\"0.9375rem\",\"fontWeight\":400,\"lineHeight\":\"1.8\",\"color\":\"#444\"},\"children\":[\"Reviewed VoiceOS product documentation for Edit, Dictate, and Agent modes. Reviewed macOS Dictation and Apple Intelligence Writing Tools documentation, and Windows Voice Typing documentation, to ground the built-in tool descriptions. No first-party accuracy benchmarks performed.\",\" \",\"Limitations: \",\"No first-party test measured transcription accuracy or edit quality; results vary by accent, noise, and microphone. This is not medical advice; readers with wrist or hand pain should consult a professional.\"]}],[\"$\",\"ol\",null,{\"className\":\"list-inside list-decimal space-y-3\",\"children\":[[\"$\",\"li\",\"voiceos-edit\",{\"id\":\"source-voiceos-edit\",\"style\":{\"fontSize\":\"0.9375rem\",\"fontWeight\":400,\"lineHeight\":\"1.8\",\"color\":\"#444\"},\"children\":[[\"$\",\"a\",null,{\"href\":\"https://www.voiceos.com/features/edit\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"style\":\"$1b:props:children:1:props:children:props:children:2:0:props:children:0:props:style\",\"children\":\"VoiceOS Edit Mode: select, speak, replace\"}],\" — \",\"VoiceOS\"]}],[\"$\",\"li\",\"voiceos-dictation\",{\"id\":\"source-voiceos-dictation\",\"style\":{\"fontSize\":\"0.9375rem\",\"fontWeight\":400,\"lineHeight\":\"1.8\",\"color\":\"#444\"},\"children\":[[\"$\",\"a\",null,{\"href\":\"https://www.voiceos.com/features/dictation\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"style\":\"$1b:props:children:1:props:children:props:children:2:0:props:children:0:props:style\",\"children\":\"VoiceOS Dictation Mode: voice writing and formatting\"}],\" — \",\"VoiceOS\"]}],[\"$\",\"li\",\"apple-dictation\",{\"id\":\"source-apple-dictation\",\"style\":{\"fontSize\":\"0.9375rem\",\"fontWeight\":400,\"lineHeight\":\"1.8\",\"color\":\"#444\"},\"children\":[[\"$\",\"a\",null,{\"href\":\"https://support.apple.com/en-gb/guide/mac-help/mh40584/mac\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"style\":\"$1b:props:children:1:props:children:props:children:2:0:props:children:0:props:style\",\"children\":\"Dictate messages and documents on Mac\"}],\" — \",\"Apple Support\"]}],[\"$\",\"li\",\"windows-voice-typing\",{\"id\":\"source-windows-voice-typing\",\"style\":{\"fontSize\":\"0.9375rem\",\"fontWeight\":400,\"lineHeight\":\"1.8\",\"color\":\"#444\"},\"children\":[[\"$\",\"a\",null,{\"href\":\"https://support.microsoft.com/en-us/windows/use-voice-typing-to-talk-instead-of-type-on-your-pc\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"style\":\"$1b:props:children:1:props:children:props:children:2:0:props:children:0:props:style\",\"children\":\"Use voice typing to talk instead of type on your PC\"}],\" — \",\"Microsoft Support\"]}]]}]]}]\n22:[\"$\",\"aside\",null,{\"className\":\"mb-16 rounded-2xl border border-[#eee] bg-white p-5 text-sm leading-6 text-[#666] md:p-6\",\"children\":[[\"$\",\"strong\",null,{\"className\":\"text-gray-900\",\"children\":\"How this was made:\"}],\" \",\"This article was prepared with AI assistance for the VoiceOS blog. VoiceOS makes one of the products discussed.\"]}]\n23:[\"$\",\"section\",null,{\"id\":\"frequently-asked-questions\",\"className\":\"mb-16 scroll-mt-28\",\"children\":[[\"$\",\"h2\",null,{\"style\":\"$21:props:children:0:props:style\",\"children\":\"Frequently asked questions\"}],[\"$\",\"div\",null,{\"className\":\"space-y-6\",\"children\":[[\"$\",\"div\",\"Is editing by voice the same as dictation?\",{\"className\":\"rounded-2xl border border-[#eee] bg-white p-5 md:p-6\",\"children\":[[\"$\",\"h3\",null,{\"style\":\"$1c:props:children:0:1:props:children:1:props:children:0:props:style\",\"children\":\"Is editing by voice the same as dictation?\"}],[\"$\",\"p\",null,{\"style\":{\"fontSize\":\"0.9375rem\",\"fontWeight\":400,\"lineHeight\":\"1.8\",\"color\":\"#444\"},\"children\":[\"No. Dictation inserts new words. Editing reshapes text that is already there. You select, instruct, and replace.\",null]}]]}],[\"$\",\"div\",\"Can I rewrite text by voice on both Mac and Windows?\",{\"className\":\"rounded-2xl border border-[#eee] bg-white p-5 md:p-6\",\"children\":[[\"$\",\"h3\",null,{\"style\":\"$1c:props:children:0:1:props:children:1:props:children:0:props:style\",\"children\":\"Can I rewrite text by voice on both Mac and Windows?\"}],[\"$\",\"p\",null,{\"style\":{\"fontSize\":\"0.9375rem\",\"fontWeight\":400,\"lineHeight\":\"1.8\",\"color\":\"#444\"},\"children\":[\"Yes, with a system-wide tool that can read the selection and type back into the field. Built-in OS features vary by version and app. VoiceOS Edit mode is available on Mac and Windows for this loop.\",[\"$\",\"sup\",null,{\"className\":\"ml-1\",\"children\":[[\"$\",\"a\",\"voiceos-edit\",{\"href\":\"#source-voiceos-edit\",\"className\":\"text-blue-600 hover:underline\",\"aria-label\":\"Source 1\",\"children\":[\"[\",1,\"]\",\"\"]}]]}]]}]]}],[\"$\",\"div\",\"Will voice editing send my email automatically?\",{\"className\":\"rounded-2xl border border-[#eee] bg-white p-5 md:p-6\",\"children\":[[\"$\",\"h3\",null,{\"style\":\"$1c:props:children:0:1:props:children:1:props:children:0:props:style\",\"children\":\"Will voice editing send my email automatically?\"}],[\"$\",\"p\",null,{\"style\":{\"fontSize\":\"0.9375rem\",\"fontWeight\":400,\"lineHeight\":\"1.8\",\"color\":\"#444\"},\"children\":[\"It should not. A rewrite only changes text in the field. Sending is a separate action. In VoiceOS, Agent actions that message or schedule use a confirmation step before anything consequential goes out; Edit mode is for the text itself.\",null]}]]}],[\"$\",\"div\",\"What if I only want grammar fixes, not a full rewrite?\",{\"className\":\"rounded-2xl border border-[#eee] bg-white p-5 md:p-6\",\"children\":[[\"$\",\"h3\",null,{\"style\":\"$1c:props:children:0:1:props:children:1:props:children:0:props:style\",\"children\":\"What if I only want grammar fixes, not a full rewrite?\"}],[\"$\",\"p\",null,{\"style\":{\"fontSize\":\"0.9375rem\",\"fontWeight\":400,\"lineHeight\":\"1.8\",\"color\":\"#444\"},\"children\":[\"Say so explicitly: \\\"Fix grammar and punctuation. Do not change the meaning or tone.\\\" Vague prompts invite bigger rewrites than you asked for.\",null]}]]}],[\"$\",\"div\",\"Does this help with RSI or carpal tunnel?\",{\"className\":\"rounded-2xl border border-[#eee] bg-white p-5 md:p-6\",\"children\":[[\"$\",\"h3\",null,{\"style\":\"$1c:props:children:0:1:props:children:1:props:children:0:props:style\",\"children\":\"Does this help with RSI or carpal tunnel?\"}],[\"$\",\"p\",null,{\"style\":{\"fontSize\":\"0.9375rem\",\"fontWeight\":400,\"lineHeight\":\"1.8\",\"color\":\"#444\"},\"children\":[\"Reducing retyping can lower keyboard load for many people. It is a workflow aid, not a diagnosis or cure. Combine it with breaks, setup changes, and professional care when needed.\",null]}]]}]]}]]}]\n24:[\"$\",\"section\",null,{\"className\":\"mb-8\",\"children\":[\"$\",\"div\",null,{\"className\":\"relative overflow-hidden rounded-[20px] border border-[#e5edf8] bg-[#F5F9FF] px-6 py-14 text-[#0a0a0a] md:py-20\",\"children\":[[\"$\",\"div\",null,{\"className\":\"absolute inset-0\",\"style\":{\"backgroundImage\":\"url(/oceanWarp.webp)\",\"backgroundPosition\":\"center\",\"backgroundSize\":\"cover\"}}],[\"$\",\"div\",null,{\"className\":\"pointer-events-none absolute inset-0 bg-white/70\"}],[\"$\",\"div\",null,{\"className\":\"pointer-events-none absolute inset-0\",\"style\":{\"background\":\"radial-gradient(ellipse 120% 120% at 50% 50%, transparent 30%, rgba(255,255,255,0.5) 70%, rgba(255,255,255,0.85) 100%)\"}}],[\"$\",\"div\",null,{\"className\":\"relative flex flex-col items-center gap-4 text-center\",\"children\":[[\"$\",\"h2\",null,{\"style\":{\"fontSize\":\"clamp(1.375rem, 4vw, 1.75rem)\",\"fontWeight\":600,\"lineHeight\":\"1.3\",\"letterSpacing\":\"-0.02em\"},\"children\":\"Try Edit mode on your next draft\"}],[\"$\",\"p\",null,{\"style\":{\"fontSize\":\"0.9375rem\",\"color\":\"rgba(10,10,10,0.58)\"},\"children\":\"Select text, speak a change, and see the result in place. Start with a real email or Slack reply you were about to rewrite by hand.\"}],[\"$\",\"$L37\",null,{\"href\":\"/download\",\"sourceType\":\"guide\",\"sourceSlug\":\"rewrite-edit-text-by-voice-mac-windows\",\"className\":\"mt-2 inline-flex items-center gap-2 rounded-full border border-black/[0.06] bg-white px-6 py-2.5 text-sm font-medium text-[#111] shadow-[0_1px_2px_rgba(0,0,0,0.04),0_4px_12px_rgba(0,0,0,0.06)] transition-all duration-200 hover:-translate-y-[1px] hover:shadow-[0_2px_4px_rgba(0,0,0,0.06),0_8px_20px_rgba(0,0,0,0.08)]\",\"children\":[\"Download VoiceOS\",[\"$\",\"svg\",null,{\"className\":\"h-3.5 w-3.5\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"viewBox\":\"0 0 24 24\",\"aria-hidden\":\"true\",\"children\":[\"$\",\"path\",null,{\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"strokeWidth\":2.5,\"d\":\"M9 5l7 7-7 7\"}]}]]}]]}]]}]}]\n27:[\"$\",\"span\",\"voiceos-edit\",{\"children\":[[\"$\",\"a\",null,{\"href\":\"https://www.voiceos.com/features/edit\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"style\":\"$1b:props:children:1:props:children:props:children:2:0:props:children:0:props:style\",\"children\":\"VoiceOS Edit Mode: select, speak, replace\"}],\"\"]}]\n28:[\"$\",\"figcaption\",null,{\"className\":\"mt-3 text-center text-sm leading-6 text-[#666]\",\"children\":\"Select text in Google Docs, invoke VoiceOS Edit mode, and speak the change you want.\"}]\n29:null\n2a:[\"$\",\"figure\",\"6\",{\"className\":\"mx-auto my-8 w-full\",\"style\":\"$undefined\",\"children\":[[\"$\",\"a\",null,{\"href\":\"/blogs/rewrite-edit-text-by-voice-mac-windows/docs-edit-shorter-2.png\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"aria-label\":\"View full-size image: VoiceOS Edit mode ready on the same Google Docs selection\",\"className\":\"relative block overflow-hidden rounded-2xl focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-blue-600\",\"style\":\"$undefined\",\"children\":[\"$\",\"$L18\",null,{\"src\":\"/blogs/rewrite-edit-text-by-voice-mac-windows/docs-edit-shorter-2.png\",\"alt\":\"VoiceOS Edit mode ready on the same Google Docs selection\",\"width\":3024,\"height\":1964,\"sizes\":\"(max-width: 1024px) 100vw, 920px\",\"className\":\"h-auto w-full rounded-2xl object-cover\",\"style\":\"$undefined\"}]}],[\"$\",\"figcaption\",null,{\"className\":\"mt-3 text-center text-sm leading-6 text-[#666]\",\"children\":\"The edited text replaces the selection in place.\"}],null]}]\n2b:[\"$\",\"p\",\"7\",{\"style\":\"$13:props:children:8:props:children:0:0:props:children:0:props:children:1:props:children:0:props:children:0:props:children:0:props:style\",\"children\":[\"The same loop works in email. Select the draft in Gmail, speak the tone change you want—for example, \\\"Can you make this more formal?\\\"—and replace the selection in place.\",null]}]\n2c:[\"$\",\"figure\",\"8\",{\"className\":\"mx-auto my-8 w-full\",\"style\":\"$undefined\",\"children\":[[\"$\",\"a\",null,{\"href\":\"/blogs/rewrite-edit-text-by-voice-mac-windows/gmail-edit-more-formal.png\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"aria-label\":\"View full-size image: VoiceOS Edit mode on a Gmail draft with \\\"Can you make this more formal?\\\"\",\"className\":\"relative block overflow-hidden rounded-2xl focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-blue-600\",\"style\":\"$undefined\",\"children\":[\"$\",\"$L18\",null,{\"src\":\"/blogs/rewrite-edit-text-by-voice-mac-windows/gmail-edit-more-formal.png\",\"alt\":\"VoiceOS Edit mode on a Gmail draft with \\\"Can you make this more formal?\\\"\",\"width\":3024,\"height\":1964,\"sizes\":\"(max-width: 1024px) 100vw, 920px\",\"className\":\"h-auto w-full rounded-2xl object-cover\",\"style\":\"$undefined\"}]}],[\"$\",\"figcaption\",null,{\"className\":\"mt-3 text-center text-sm leading-6 text-[#666]\",\"children\":\"Select the draft in Gmail, invoke Edit mode, and speak the change.\"}],null]}]\n2d:[\"$\",\"figure\",\"9\",{\"className\":\"mx-auto my-8 w-full\",\"style\":\"$undefined\",\"children\":[[\"$\",\"a\",null,{\"href\":\"/blogs/rewrite-edit-text-by-voice-mac-windows/gmail-edit-more-formal-2.png\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"aria-label\":\"View full-size image: VoiceOS Edit mode on the same Gmail draft after requesting a more formal rewrite\",\"className\":\"relative block overflow-hidden rounded-2xl focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-blue-600\",\"style\":\"$undefined\",\"children\":[\"$\",\"$L18\",null,{\"src\":\"/blogs/rewrite-edit-text-by-voice-mac-windows/gmail-edit-more-formal-2.png\",\"alt\":\"VoiceOS Edit mode on the same Gmail draft after requesting a more formal rewrite\",\"width\":3024,\"height\":1964,\"sizes\":\"(max-width: 1024px) 100vw, 920px\",\"className\":\"h-auto w-full rounded-2xl object-cover\",\"style\":\"$undefined\"}]}],[\"$\",\"figcaption\",null,{\"className\":\"mt-3 text-center text-sm leading-6 text-[#666]\",\"children\":\"The rewritten draft replaces the selection.\"}],null]}]\n2e:[\"$\",\"p\",\"10\",{\"style\":\"$13:props:children:8:props:children:0:0:props:children:0:props:children:1:props:children:0:props:children:0:props:children:0:props:style\",\"children\":[\"The product path is select → speak the change → replace in place. You stay in Docs, Gmail, Slack, Notion, or whichever field has the cursor. You do not paste into a separate chatbot window.\",null]}]\n2f:[\"$\",\"p\",\"11\",{\"style\":\"$13:props:children:8:props:children:0:0:props:children:0:props:children:1:props:children:0:props:children:0:props:children:0:props:style\",\"children\":[\"VoiceOS is not a replacement for ChatGPT or Claude when you want a long brainstorming conversation. It is the layer that applies a short spoken edit *where the cursor already is*. Many people use both: think in a chatbot when needed, edit and ship in the real app with voice.\",null]}]\n30:[\"$\",\"p\",\"12\",{\"style\":\"$13:props:children:8:props:children:0:0:props:children:0:props:children:1:props:children:0:props:children:0:props:children:0:props:style\",\"children\":[\"For the broader \\\"talk to run the computer\\\" picture, see [hands-free voice control on Mac and Windows](/blog/hands-free-voice-control-mac-windows) and [what a voice operating system is](/blog/what-is-a-voice-operating-system). For injury-aware typing reduction, see [voice typing for RSI and carpal tunnel](/blog/voice-typing-for-rsi-and-carpal-tunnel).\",null]}]\n31:[\"$\",\"div\",null,{\"className\":\"mt-6 rounded-2xl border border-[#eee] bg-white p-5\",\"children\":[\"$\",\"p\",null,{\"style\":{\"fontSize\":\"0.9375rem\",\"fontWeight\":400,\"lineHeight\":\"1.8\",\"color\":\"#444\",\"margin\":0},\"children\":[[\"$\",\"span\",null,{\"className\":\"font-semibold text-[#0a0a0a]\",\"children\":\"Sources \u0026 further reading:\"}],\" \",[[\"$\",\"span\",\"voiceos-edit\",{\"children\":[[\"$\",\"a\",null,{\"href\":\"https://www.voiceos.com/features/edit\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"style\":\"$1b:props:children:1:props:children:props:children:2:0:props:children:0:props:style\",\"children\":\"VoiceOS Edit Mode: select, speak, replace\"}],\" · \"]}],[\"$\",\"span\",\"voiceos-dictation\",{\"children\":[[\"$\",\"a\",null,{\"href\":\"https://www.voiceos.com/features/dictation\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"style\":\"$1b:props:children:1:props:children:props:children:2:0:props:children:0:props:style\",\"children\":\"VoiceOS Dictation Mode: voice writing and formatting\"}],\"\"]}]]]}]}]\n38:I[77105,[\"/_next/static/chunks/2kb52na2e7ces.js\",\"/_next/static/chunks/1xfsu92iq1h9m.js\",\"/_next/static/chunks/3x6-_ejf1r1x0.js\",\"/_next/static/chunks/1bslr0-ipnt__.js\",\"/_next/static/chunks/35rx1_qn9m74v.js\",\"/_next/static/chunks/0z6qqa_pcb2c9.js\"],\"default\"]\n3a:I[27745,[\"/_next/static/chunks/2kb52na2e7ces.js\",\"/_next/static/chunks/1xfsu92iq1h9m.js\",\"/_next/static/chunks/3x6-_ejf1r1x0.js\"],\"default\"]\n3b:I[67295,[\"/_next/static/chunks/2kb52na2e7ces.js\",\"/_next/static/chunks/1xfsu92iq1h9m.js\",\"/_next/static/chunks/3x6-_ejf1r1x0.js\"],\"PostHogProvider\"]\n3c:I[74074,[\"/_next/static/chunks/2kb52na2e7ces.js\",\"/_next/static/chunks/1xfsu92iq1h9m.js\",\"/_next/static/chunks/3x6-_ejf1r1x0.js\"],\"TrackingPixels\"]\n3d:I[25655,[\"/_next/static/chunks/2kb52na2e7ces.js\",\"/_next/static/chunks/1xfsu92iq1h9m.js\",\"/_next/static/chunks/3x6-_ejf1r1x0.js\"],\"Analytics\"]\n3e:I[77,[\"/_next/static/chunks/2kb52na2e7ces.js\",\"/_next/static/chunks/1xfsu92iq1h9m.js\",\"/_next/static/chunks/3x6-_ejf1r1x0.js\"],\"default\"]\n3f:I[83444,[\"/_next/static/chunks/2kb52na2e7ces.js\",\"/_next/static/chunks/1xfsu92iq1h9m.js\",\"/_next/static/chunks/3x6-_ejf1r1x0.js\"],\"default\"]\n40:I[32897,[\"/_next/static/chunks/2kb52na2e7ces.js\",\"/_next/static/chunks/1xfsu92iq1h9m.js\",\"/_next/static/chunks/3x6-_ejf1r1x0.js\"],\"default\"]\n41:I[12756,[\"/_next/static/chunks/2kb52na2e7ces.js\",\"/_next/static/chunks/1xfsu92iq1h9m.js\",\"/_next/static/chunks/3x6-_ejf1r1x0.js\"]