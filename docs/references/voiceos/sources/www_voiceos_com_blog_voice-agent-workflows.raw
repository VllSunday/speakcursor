anguage":["en","ja"],"publisher":{"@id":"https://www.voiceos.com/#organization"}}</script><script src="/_next/static/chunks/0cz1d0mv5g_q7.js" noModule=""></script></head><body><div hidden=""><!--$--><!--/$--></div><!--$--><!--/$--><!--$--><!--/$--><!--$--><!--/$--><main class="min-h-screen" style="background-color:#F9F9F9"><script type="application/ld+json">{"@context":"https://schema.org","@graph":[{"@type":"BlogPosting","headline":"40 VoiceOS actions and how to verify each one","description":"Forty documented VoiceOS actions across email, notes, calendars, files, and issue trackers, with platform limits, confirmation behavior, and verification steps.","image":"https://www.voiceos.com/blogs/guides/editorial/voice-agent-workflows-smoked-glass.webp","datePublished":"2026-09-30T07:00:00.000Z","dateModified":"2026-09-30T07:00:00.000Z","inLanguage":"en","author":{"@type":"Person","name":"Andrew Hoffmann"},"publisher":{"@type":"Organization","name":"WakoAI Inc.","url":"https://www.voiceos.com","logo":{"@type":"ImageObject","url":"https://www.voiceos.com/voiceOsLogo.png"}},"mainEntityOfPage":{"@type":"WebPage","@id":"https://www.voiceos.com/blog/voice-agent-workflows"}},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Were all forty actions tested live for this article?","acceptedAnswer":{"@type":"Answer","text":"No. Each action was checked against the shipped integration catalog. The verification steps are a test plan, not a record of completed end-to-end trials."}},{"@type":"Question","name":"Do all actions ask before running?","acceptedAnswer":{"@type":"Answer","text":"No. The table preserves the catalog’s per-tool confirmation behavior. Some local writes and read operations do not list a separate confirmation."}},{"@type":"Question","name":"Why do some sections say Mac only?","acceptedAnswer":{"@type":"Answer","text":"Native Apple integrations in the catalog have a Mac-specific platform requirement. A VoiceOS Windows installation does not add those Apple-o