\":\"VoiceOS\",\"url\":\"https://www.voiceos.com\"},\"founder\":[{\"@type\":\"Person\",\"@id\":\"https://www.voiceos.com/authors/jonah-daian#person\",\"name\":\"Jonah Daian\",\"url\":\"https://www.voiceos.com/authors/jonah-daian\"},{\"@type\":\"Person\",\"@id\":\"https://www.voiceos.com/authors/kai-brokering#person\",\"name\":\"Kai Brokering\",\"url\":\"https://www.voiceos.com/authors/kai-brokering\"}],\"sameAs\":[\"https://www.linkedin.com/company/voice-os/\",\"https://x.com/VoiceOSApp\",\"https://www.producthunt.com/products/voiceos\",\"https://www.ycombinator.com/launches/PP3-voiceos-the-siri-for-productivity\",\"https://docs.voiceos.com/\"],\"knowsAbout\":[\"AI dictation\",\"voice agents\",\"desktop productivity\",\"voice-to-action workflows\",\"hands-free computing\",\"workflow automation\"],\"contactPoint\":[{\"@type\":\"ContactPoint\",\"contactType\":\"customer support\",\"email\":\"support@voiceos.com\",\"availableLanguage\":[\"English\",\"Japanese\"]}]}2:[\"$\",\"html\",null,{\"lang\":\"en\",\"className\":\"dm_mono_a086b4ea-module__pIDXBa__variable\",\"children\":[[\"$\",\"head\",null,{\"children\":[[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"$33\"}}],[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"{\\\"@context\\\":\\\"https://schema.org\\\",\\\"@type\\\":\\\"WebSite\\\",\\\"@id\\\":\\\"https://www.voiceos.com/#website\\\",\\\"url\\\":\\\"https://www.voiceos.com\\\",\\\"name\\\":\\\"VoiceOS\\\",\\\"description\\\":\\\"VoiceOS is a voice operating system that turns voice to action. The AI voice assistant for Mac and Windows: dictate, send messages, search the web, and automate apps by voice. Try it free.\\\",\\\"inLanguage\\\":[\\\"en\\\",\\\"ja\\\"],\\\"publisher\\\":{\\\"@id\\\":\\\"https://www.voiceos.com/#organization\\\"}}\"}}],[\"$\",\"link\",null,{\"rel\":\"alternate\",\"type\":\"text/plain\",\"href\":\"/llms.txt\",\"title\":\"LLM-readable site d