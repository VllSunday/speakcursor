px] w-[3px] shrink-0 rounded-full\",\"style\":{\"backgroundColor\":\"rgba(15, 23, 42, 0.22)\"}}],[\"$\",\"span\",null,{\"className\":\"text-[15px] font-light leading-[1.6] text-gray-600\",\"children\":[\"Live support now handles attachments and update feedback more reliably\",\"$undefined\"]}]]}]\n7b:[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"mt-[10px] h-[3px] w-[3px] shrink-0 rounded-full\",\"style\":{\"backgroundColor\":\"rgba(15, 23, 42, 0.22)\"}}]\n7c:[\"$\",\"span\",null,{\"className\":\"text-[15px] font-light leading-[1.6] text-gray-600\",\"children\":[\"Studio now begins with a conversation: describe the integration, review the plan, and keep refining it in the same thread instead of restarting a form\",\"$undefined\"]}]\n7d:[\"$\",\"li\",\"A new Preview shows what the generated app will do before you install it, including the setup fields and actions it will expose\",{\"className\":\"flex gap-3\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"mt-[10px] h-[3px] w-[3px] shrink-0 rounded-full\",\"style\":{\"backgroundColor\":\"rgba(15, 23, 42, 0.22)\"}}],[\"$\",\"span\",null,{\"className\":\"text-[15px] font-light leading-[1.6] text-gray-600\",\"children\":[\"A new Preview shows what the generated app will do before you install it, including the setup fields and actions it will expose\",\"$undefined\"]}]]}]\n7e:[\"$\",\"li\",\"Build progress, terminal output, and readable debug logs are visible inside Studio, and common runtime crashes can be diagnosed and fixed automatically\",{\"className\":\"flex gap-3\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"mt-[10px] h-[3px] w-[3px] shrink-0 rounded-full\",\"style\":{\"backgroundColor\":\"rgba(15, 23, 42, 0.22)\"}}],[\"$\",\"span\",null,{\"className\":\"text-[15px] font-light leading-[1.6] text-gray-600\",\"children\":[\"Build progress, terminal output, and readable debug logs are visible inside Studio, and common runtime crashes can be diagnosed and fixed automatically\",\"$undefined\"]}]]}]\n7f:[\"$\",\"li\",\"Custom apps include their own runtime, so shared integrations can start on a new Mac or Windows PC without asking the recipient to install Node.js or Bun\",{\"className\":\"flex gap-3\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"mt-[10px] h-[3px] w-[3px] shrink-0 rounded-full\",\"style\":{\"backgroundColor\":\"rgba(15, 23, 42, 0.22)\"}}],[\"$\",\"span\",null,{\"className\":\"text-[15px] font-light leading-[1.6] text-gray-600\",\"children\":[\"Custom apps include their own runtime, so shared integrations can start on a new Mac or Windows PC without asking the recipient to install Node.js or Bun\",\"$undefined\"]}]]}]\n80:[\"$\",\"li\",\"First-run accessibility setup now includes a guided drag-to-grant flow, with clearer feedback when macOS still needs permission\",{\"className\":\"flex gap-3\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"mt-[10px] h-[3px] w-[3px] shrink-0 rounded-full\",\"style\":{\"backgroundColor\":\"rgba(15, 23, 42, 0.22)\"}}],[\"$\",\"span\",null,{\"className\":\"text-[15px] font-light leading-[1.6] text-gray-600\",\"children\":[\"First-run accessibility setup now includes a guided drag-to-grant flow, with clearer feedback when macOS still needs permission\",[\"$\",\"span\",null,{\"className\":\"ml-2 inline-block translate-y-[-1px] rounded-full px-2 py-[2px] align-middle text-[11px] font-medium tracking-wide\",\"style\":{\"backgroundColor\":\"rgba(15, 23, 42, 0.05)\",\"color\":\"#6b7280\"},\"children\":\"Mac\"}]]}]]}]\n81:[\"$\",\"li\",\"Japanese dictation now uses VoiceOS's hosted Whisper path, and Polished mode keeps spoken English product names in Latin characters instead of katakana\",{\"className\":\"flex gap-3\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"mt-[10px] h-[3px] w-[3px] shrink-0 rounded-full\",\"style\":{\"backgroundColor\":\"rgba(15, 23, 42, 0.22)\"}}],[\