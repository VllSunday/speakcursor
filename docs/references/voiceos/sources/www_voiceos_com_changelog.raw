y-600\",\"children\":[\"Custom integration icon previews persist across restarts, and their setup surfaces now keep the user's input in focus while showing clearer approval states\",\"$undefined\"]}]]}]\nf8:[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"mt-[10px] h-[3px] w-[3px] shrink-0 rounded-full\",\"style\":{\"backgroundColor\":\"rgba(15, 23, 42, 0.22)\"}}]\nf9:[\"$\",\"span\",null,{\"className\":\"text-[15px] font-light leading-[1.6] text-gray-600\",\"children\":[\"The first What's New system was added so returning users automatically see the release summary once after updating, with access to earlier entries\",\"$undefined\"]}]\nfa:[\"$\",\"li\",\"Custom integrations gained URL-based MCP transport, an improved explainer, actionable connection logs, and clearer error hints when a server cannot start\",{\"className\":\"flex gap-3\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"mt-[10px] h-[3px] w-[3px] shrink-0 rounded-full\",\"style\":{\"backgroundColor\":\"rgba(15, 23, 42, 0.22)\"}}],[\"$\",\"span\",null,{\"className\":\"text-[15px] font-light leading-[1.6] text-gray-600\",\"children\":[\"Custom integrations gained URL-based MCP transport, an improved explainer, actionable connection logs, and clearer error hints when a server cannot start\",\"$undefined\"]}]]}]\nfb:[\"$\",\"li\",\"Files can be dragged into Agent Mode, and conversation History now includes Agent sessions with smoother collapse and follow-up behavior\",{\"className\":\"flex gap-3\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"mt-[10px] h-[3px] w-[3px] shrink-0 rounded-full\",\"style\":{\"backgroundColor\":\"rgba(15, 23, 42, 0.22)\"}}],[\"$\",\"span\",null,{\"className\":\"text-[15px] font-light leading-[1.6] text-gray-600\",\"children\":[\"Files can be dragged into Agent Mode, and conversation History now includes Agent sessions with smoother collapse and follow-up behavior\",\"$undefined\"]}]]}]\nfc:[\"$\",\"li\",\