on-colors duration-200" href="/features/dictation"><div class="absolute inset-0 rounded-[18px] opacity-0 transition-opacity duration-200 group-hover:opacity-100 group-focus-visible:opacity-100" style="background:rgba(15,23,42,0.04)"></div><span class="relative z-10 block text-[15px] font-semibold leading-tight text-gray-900">Dictation Mode</span><span class="relative z-10 mt-1 block text-[13px] font-light leading-snug text-gray-500">Talk instead of typing</span></a><a class="group relative block rounded-[18px] px-3.5 py-3 transition-colors duration-200" href="/pricing"><div class="absolute inset-0 rounded-[18px] opacity-0 transition-opacity duration-200 group-hover:opacity-100 group-focus-visible:opacity-100" style="background:rgba(15,23,42,0.04)"></div><span class="relative z-10 block text-[15px] font-semibold leading-tight text-gray-900">Pricing</span><span class="relative z-10 mt-1 block text-[13px] font-light leading-snug text-gray-500">Plans, trial, and discounts</span></a></div></div></div><div class="md:hidden absolute left-4 right-4 top-full mt-2 transition-all duration-300 ease-out opacity-0 pointer-events-none" style="transform:translate3d(0, -8px, 0) scale(0.985);transform-origin:top center;visibility:hidden"><div class="relative overflow-hidden" style="border-radius:32px;background:linear-gradient(180deg, rgba(255,255,255,0.86) 0%, rgba(250,252,255,0.72) 100%);backdrop-filter:blur(10px) saturate(135%);-webkit-backdrop-filter:blur(10px) saturate(135%);box-shadow:0 10px 30px rgba(15, 23, 42, 0.08), 0 1px 4px rgba(15, 23, 42, 0.04), inset 0 1px 0 rgba(255,255,255,0.82);border:1px solid rgba(255,255,255,0.72);contain:paint"><div class="absolute inset-x-5 top-0 h-px pointer-events-none" style="background:linear-gradient(90deg, transparent, rgba(255,255,255,0.95), transparent)"></div><div class="relative z-10 p-2.5"><a class="group relative block rounded-[22px] px-3.5 py-2.5 transition-colors duration-200" style="transition-delay:0ms;opacity:0;transform:translateX(-10px)" href="/features/agent"><div class="absolute inset-0 rounded-[22px] opacity-0 transition-opacity duration-200 group-hover:opacity-100 group-active:opacity-100" style="background:rgba(255,255,255,0.48)"></div><span class="relative z-10 block font-semibold text-gray-900">Agent Mode</span></a><a class="group relative block rounded-[22px] px-3.5 py-2.5 transition-colors duration-200" style="transition-delay:0ms;opacity:0;transform:translateX(-10px)" href="/features/dictation"><div class="absolute inset-0 rounded-[22px] opacity-0 transition-opacity duration-200 group-hover:opacity-100 group-active:opacity-100" style="background:rgba(255,255,255,0.48)"></div><span class="relative z-10 block font-semibold text-gray-900">Dictation Mode</span></a><a class="group relative block rounded-[22px] px-3.5 py-2.5 transition-colors duration-200" style="transition-delay:0ms;opacity:0;transform:translateX(-10px)" href="/pricing"><div class="absolute inset-0 rounded-[22px] opacity-0 transition-opacity duration-200 group-hover:opacity-100 group-active:opacity-100" style="background:rgba(255,255,255,0.48)"></div><span class="relative z-10 block font-semibold text-gray-900">Pricing</span></a><a class="group relative block rounded-[22px] px-3.5 py-2.5 transition-colors duration-200" style="transition-delay:0ms;opacity:0;transform:translateX(-10px)" href="/about"><div class="absolute inset-0 rounded-[22px] opacity-0 transition-opacity duration-200 group-hover:opacity-100 group-active:opacity-100" style="background:rgba(255,255,255,0.48)"></div><span class="relative z-10 block font-semibold text-gray-900">About</span></a><a class="group relative block rounded-[22px] px-3.5 py-2.5 transition-colors duration-200" style="transition-delay:0ms;opacity:0;transform:translateX(-10px)" href="/blog"><div class="absolute inset-0 rounded-[22px] opacity-0 transition-opacity duration-200 group-hover:opacity-100 group-active:opacity-100" style="background:rgba(255,255,255,0.48)"></div><span class="relative z-10 block font-semibold text-gray-900">Blogs</span></a><a class="group relative block rounded-[22px] px-3.5 py-2.5 transition-colors duration-200" style="transition-delay:0ms;opacity:0;transform:translateX(-10px)" href="/app-store"><div class="absolute inset-0 rounded-[22px] opacity-0 transition-opacity duration-200 group-hover:opacity-100 group-active:opacity-100" style="background:rgba(255,255,255,0.48)"></div><span class="relative z-10 block font-semibold text-gray-900">App Store</span></a><a href="https://partners.dub.co/voice-os" target="_blank" rel="noopener noreferrer" class="group relative block rounded-[22px] px-3.5 py-2.5 transition-colors duration-200" style="transition-delay:0ms;opacity:0;transform:translateX(-10px)"><div class="absolute inset-0 rounded-[22px] opacity-0 transition-opacity duration-200 group-hover:opacity-100 group-active:opacity-100" style="background:rgba(255,255,255,0.48)"></div><span class="relative z-10 block font-semibold text-gray-900">Affiliates</span></a></div><div class="absolute bottom-0 left-6 right-6 h-px pointer-events-none" style="background:linear-gradient(90deg, transparent, rgba(15,23,42,0.06), transparent)"></div></div></div></div></nav><section class="px-4 pb-12 pt-32 md:px-6 md:pb-16 md:pt-44"><div class="mx-auto max-w-3xl text-center"><h1 class="section-title leading-tight" style="font-size:clamp(2.1rem, 10.2vw, 4.75rem);font-weight:600;color:#0a0a0a;letter-spacing:-0.03em">Do more with your <span style="font-weight:600;font-style:italic">voice</span></h1><p class="mx-auto mt-5 max-w-xl text-lg font-light leading-relaxed text-gray-500 md:text-xl">VoiceOS turns what you say into real actions across the apps you already use. Dictation is built in.</p><div class="mt-7 flex justify-center"><span class="lp-glass-chip"><span class="text-sm font-medium tracking-wide text-gray-800">Mac and Windows</span></span></div></div></section><section class="relative px-4 pb-24 md:px-6 md:pb-32"><div aria-hidden="true" class="pointer-events-none absolute left-1/2 top-24 h-[520px] w-[720px] -translate-x-[80%] rounded-full" style="background:radial-gradient(circle, rgba(18, 111, 246, 0.09) 0%, transparent 68%);filter:blur(20px)"></div><div aria-hidden="true" class="pointer-events-none absolute bottom-40 left-1/2 h-[460px] w-[640px] -translate-x-[15%] rounded-full" style="background:radial-gradient(circle, rgba(199, 205, 255, 0.35) 0%, transparent 68%);filter:blur(20px)"></div><div class="relative mx-auto max-w-4xl"><div class="grid grid-cols-1 gap-4 md:grid-cols-2"><a class="lp-glass-panel group flex h-full flex-col p-7 transition-transform duration-200 hover:-translate-y-0.5" href="/features/agent"><span class="mb-5 inline-flex h-11 w-11 items-center justify-center rounded-full bg-white/70 text-[#1f6fe0] shadow-[inset_0_1px_0_rgba(255,255,255,0.9),0_1px_2px_rgba(15,23,42,0.06)]"><svg class="h-[21px] w-[21px]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 15l-2 5L9 9l11 4-5 2zm0 0l5 5M7.188 2.239l.777 2.897M5.136 7.965l-2.898-.777M13.95 4.05l-2.122 2.122m-5.657 5.656l-2.12 2.122"></path></svg></span><span class="block text-[13px] font-medium tracking-wide text-[#1f6fe0]">Agent Mode</span><h2 class="section-title mt-1 text-2xl font-normal tracking-tight text-gray-900">Say it, and it gets done</h2><p class="mt-3 text-[15px] font-light leading-relaxed text-gray-600">Ask out loud and VoiceOS does the work inside your apps. It sends the message, books the time, finds the file, checks the web. Anything that sends or changes something shows you a confirmation first.</p><span class="mt-auto inline-flex items-center gap-1.5 pt-5 text-[15px] font-medium text-gray-900">See what it does<svg class="h-4 w-4 transition-transform duration-200 group-hover:translate-x-0.5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 6l6 6-6 6"></path></svg></span></a><a class="lp-glass-panel group flex h-full flex-col p-7 transition-transform duration-200 hover:-translate-y-0.5" href="/features/dictation"><span class="mb-5 inline-flex h-11 w-11 items-center justify-center rounded-full bg-white/70 text-[#1f6fe0] shadow-[inset_0_1px_0_rgba(255,255,255,0.9),0_1px_2px_rgba(15,23,42,0.06)]"><svg class="h-[21px] w-[21px]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-6.714 2.143L12 21l-2.286-6.857L3 12l6.714-2.143L12 3z"></path></svg></span><span class="block text-[13px] font-medium tracking-wide text-[#1f6fe0]">Dictation Mode</span><h2 class="section-title mt-1 text-2xl font-normal tracking-tight text-gray-900">Talk instead of typing</h2><p class="mt-3 text-[15px] font-light leading-relaxed text-gray-600">Speak anywhere you would otherwise type, in any app, in 100 languages. The filler comes out, the spelling gets fixed, and what lands on the page is what you meant.</p><span class="mt-auto inline-flex items-center gap-1.5 pt-5 text-[15px] font-medium text-gray-900">See what it does<svg class="h-4 w-4 transition-transform duration-200 group-hover:translate-x-0.5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 6l6 6-6 6"></path></svg></span></a></div><section class="mt-20 md:mt-28"><script type="application/ld+json">{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"What are the main VoiceOS features?","acceptedAnswer":{"@type":"Answer","text":"VoiceOS includes system-wide AI dictation, voice editing for selected text, screen-aware questions, web search, custom vocabulary and writing context, plus Agent Mode for supported connected actions. It runs on Mac and Windows and is designed to keep important actions reviewable before completion."}},{"@type":"Question","name":"Is VoiceOS only a dictation app?","acceptedAnswer":{"@type":"Answer","text":"No. Dictation Mode is one part of VoiceOS. Edit Mode changes existing text from a spoken instruction, and Agent Mode can use screen context, answer questions, search, and prepare actions through supported integrations. The product is designed around the full task rather than transcription alone."}},{"@type":"Question","name":"Can VoiceOS control every app on my computer?","acceptedAnswer":{"@type":"Answer","text":"VoiceOS can dictate into standard text fields across many desktop apps, while Agent Mode supports specific actions through screen context and connected services. It does not promise universal command-level control of every interface. Check the App Store and test the exact workflows you depend on."}},{"@type":"Question","name":"Does VoiceOS work on Windows as well as Mac?","acceptedAnswer":{"@type":"Answer","text":"Yes. VoiceOS provides desktop apps for macOS and Windows. The website selects an installer based on the visitor’s operating system, and the alternate desktop download remains available. App behavior can depend on operating-system permissions and the controls exposed by each destination app."}},{"@type":"Question","name":"Does VoiceOS send actions without asking?","acceptedAnswer":{"@type":"Answer","text":"VoiceOS is designed to present consequential actions for review before completion. You can inspect, edit, confirm, or cancel the proposed work. The exact confirmation flow depends on the action and connected service, but maintaining user control is a core part of Agent Mode."}},{"@type":"Question","name":"How do I get started with VoiceOS?","acceptedAnswer":{"@type":"Answer","text":"Download the Mac or Windows app and choose a plan. Begin with dictation in a familiar text field, then use Edit Mode, ask a question about your screen, and connect one supported integration. Using real tasks will show whether VoiceOS reduces corrections and context switching in your workflow."}}]}</script><div class="rounded-3xl border border-blue-100 bg-blue-50/70 p-6 md:p-8"><p class="text-sm font-semibold uppercase tracking-[0.1em] text-blue-700">The short answer</p><p class="mt-3 text-lg leading-relaxed text-gray-800">VoiceOS is an AI voice assistant for Mac and Windows with three connected capabilities: Dictation Mode turns speech into polished text, Edit Mode reshapes selected writing, and Agent Mode uses screen context to answer questions and prepare supported actions across your apps. Important actions remain reviewable before they are completed.</p></div><div class="mt-16 space-y-16"><section><h2 class="section-title text-3xl font-medium tracking-tight text-gray-950 md:text-4xl">What can VoiceOS do?</h2><div class="mt-5 space-y-5 text-[1.0625rem] leading-8 text-gray-700"><p>VoiceOS gives your desktop a voice layer that works where the task is already happening. Instead of opening a separate chatbot, copying context into it, and moving the answer back, you can speak from the app in front of you. The product decides whether the request is best handled as text, an edit, a question about the screen, or a supported action that needs your review.</p><p>The simplest workflow is dictation. Put the cursor in an email, document, message, prompt, issue, or code comment and speak naturally. VoiceOS removes verbal clutter, adds punctuation, and turns the thought into writing suited to the destination. From there, you can select text and ask for a revision, ask a question about the current screen, or use Agent Mode to prepare the next step.</p></div><ul class="mt-6 grid gap-3 rounded-2xl border border-gray-200 bg-white p-6 md:grid-cols-2"><li class="flex gap-3 text-[0.98rem] leading-relaxed text-gray-700"><span class="mt-[0.65em] h-1.5 w-1.5 flex-none rounded-full bg-blue-600"></span><span>Dictate polished text into standard fields across Mac and Windows apps.</span></li><li class="flex gap-3 text-[0.98rem] leading-relaxed text-gray-700"><span class="mt-[0.65em] h-1.5 w-1.5 flex-none rounded-full bg-blue-600"></span><span>Rewrite selected text by describing the result you want.</span></li><li class="flex gap-3 text-[0.98rem] leading-relaxed text-gray-700"><span class="mt-[0.65em] h-1.5 w-1.5 flex-none rounded-full bg-blue-600"></span><span>Ask questions that depend on the screen in front of you.</span></li><li class="flex gap-3 text-[0.98rem] leading-relaxed text-gray-700"><span class="mt-[0.65em] h-1.5 w-1.5 flex-none rounded-full bg-blue-600"></span><span>Search the web without breaking the current workflow.</span></li><li class="flex gap-3 text-[0.98rem] leading-relaxed text-gray-700"><span class="mt-[0.65em] h-1.5 w-1.5 flex-none rounded-full bg-blue-600"></span><span>Prepare supported messages, calendar items, documents, and other connected actions.</span></li></ul></section><section><h2 class="section-title text-3xl font-medium tracking-tight text-gray-950 md:text-4xl">How does VoiceOS Agent Mode work?</h2><div class="mt-5 space-y-5 text-[1.0625rem] leading-8 text-gray-700"><p>Agent Mode is the difference between voice as an input method and voice as a way to direct work. A traditional dictation tool returns text. An agent can interpret the outcome you described, use available context, choose an appropriate capability, and assemble a proposed result. You stay in the loop before consequential work is sent, created, or shared.</p><p>For example, while reading an email you might ask VoiceOS to summarize the request and draft a concise reply. While looking at a dashboard, you can ask what changed and turn the explanation into a message for your team. With a supported service connected, you can ask it to prepare a calendar event or a cross-app follow-up. The exact capabilities depend on your integrations and permissions, but the interaction remains consistent: describe the outcome, inspect the proposal, and confirm it when it is right.</p><p>This approach removes the manual glue between apps without pretending that judgment should be automated. VoiceOS is intended to handle context gathering, drafting, formatting, and orchestration while you decide what is accurate, appropriate, and ready to leave your computer.</p></div></section><section><h2 class="section-title text-3xl font-medium tracking-tight text-gray-950 md:text-4xl">How is VoiceOS different from a dictation app?</h2><div class="mt-5 space-y-5 text-[1.0625rem] leading-8 text-gray-700"><p>Dictation apps solve an important but narrow problem: they make words appear faster than you can type them. VoiceOS includes that capability, then keeps going. It can work with existing text through Edit Mode and with visible information through Agent Mode. That matters because most knowledge work does not end when a paragraph appears in a text field.</p><p>Consider a customer email. Dictation can help you write the response, but you may first need to understand a long thread, find a detail, match the tone, and verify a date. A voice assistant can help with those surrounding steps from the same interface. The gain is not only words per minute; it is fewer interruptions between understanding, deciding, writing, and acting.</p><p>VoiceOS also treats context as part of quality. The right output for Slack is usually shorter than the right output for a proposal. A message to a colleague can sound different from an executive update. By working where the writing will be used, VoiceOS can produce a more useful first draft and reduce the correction loop that often erases the time saved by raw transcription.</p></div></section><section><h2 class="section-title text-3xl font-medium tracking-tight text-gray-950 md:text-4xl">Which apps does VoiceOS work with?</h2><div class="mt-5 space-y-5 text-[1.0625rem] leading-8 text-gray-700"><p>Dictation and editing are designed to work in standard text fields across macOS and Windows, including browsers, email clients, chat tools, documents, note apps, project-management software, and code editors. If you can place a normal text cursor in an app, that is the first place to test VoiceOS. Protected fields and unusual custom controls can behave differently, so checking compatibility with your critical software is important.</p><p>Agent Mode adds another layer through screen context and connected services. The VoiceOS App Store lists current integrations and the actions each one supports. Capabilities can include preparing messages, working with calendars, retrieving information, or creating content in supported destinations. You choose which services to connect rather than granting blanket access to everything on your computer.</p></div><div class="mt-5 flex flex-wrap gap-3"><a class="rounded-full border border-gray-200 bg-white px-4 py-2 text-sm font-medium text-gray-800 hover:border-gray-300" href="/app-store">Browse the VoiceOS App Store</a><a class="rounded-full border border-gray-200 bg-white px-4 py-2 text-sm font-medium text-gray-800 hover:border-gray-300" href="/guide/build-mcp-integration">Build an MCP integration</a></div></section><section><h2 class="section-title text-3xl font-medium tracking-tight text-gray-950 md:text-4xl">How does VoiceOS keep voice actions under control?</h2><div class="mt-5 space-y-5 text-[1.0625rem] leading-8 text-gray-700"><p>Speed is useful only when the result remains trustworthy. VoiceOS separates preparation from confirmation for important actions. The assistant can draft the message, assemble the event, or plan the requested work, but you can inspect what will happen before it is completed. If something is wrong, edit the proposal or cancel it without sending the mistake downstream.</p><p>Permissions are also scoped by the operating system and the services you connect. Microphone access enables speech input. Accessibility permissions support interaction with desktop text fields. Screen context and integrations are used for the features that require them. Teams evaluating VoiceOS should review the current security page, retention choices, and administrative controls against their own policies before deployment.</p><p>The goal is a practical balance: less manual coordination, visible intent, and a human decision at the point where an action becomes consequential. That makes Agent Mode useful for daily work without asking users to trust an invisible automation chain.</p></div><div class="mt-5 flex flex-wrap gap-3"><a class="rounded-full border border-gray-200 bg-white px-4 py-2 text-sm font-medium text-gray-800 hover:border-gray-300" href="/security">Read VoiceOS security information</a></div></section><section><h2 class="section-title text-3xl font-medium tracking-tight text-gray-950 md:text-4xl">Who is VoiceOS for?</h2><div class="mt-5 space-y-5 text-[1.0625rem] leading-8 text-gray-700"><p>VoiceOS is useful for people whose work moves through language and software all day: founders, developers, operators, sales teams, support teams, students, writers, and anyone who repeatedly turns thoughts into messages, documents, prompts, plans, or app updates. It is especially valuable when the cost of the work comes from context switching rather than from one difficult task.</p><p>Developers can dictate prompts, issues, documentation, and code-review notes without leaving the editor. Customer-facing teams can draft replies from visible context and keep a consistent tone. Managers can turn a spoken update into a structured message or meeting follow-up. People who experience fatigue or discomfort from heavy typing may also benefit from moving more language work to voice, although specialized accessibility needs should always be tested directly.</p><p>You do not need to replace the keyboard and mouse. Voice works best as another input layer: use it for intent, drafting, revision, and multi-step direction; keep precise manual controls for the moments that demand them. The product is designed to shorten the distance between deciding what should happen and having a reviewable result ready.</p></div></section><section><h2 class="section-title text-3xl font-medium tracking-tight text-gray-950 md:text-4xl">How do you get started with VoiceOS?</h2><div class="mt-5 space-y-5 text-[1.0625rem] leading-8 text-gray-700"><p>Install the Mac or Windows desktop app, grant the permissions required for the modes you plan to use, and begin with a low-risk writing task. Dictate a note, an email draft, or a prompt in an app you know well. This establishes how the shortcut, microphone, and text insertion feel in your normal environment.</p><p>Next, select a piece of text and ask Edit Mode to shorten it, change the tone, or turn it into a list. Then try a screen-aware question on a document or webpage. Finally, connect one supported service and test a small Agent Mode workflow with confirmation enabled. Evaluating the product in layers makes it clear which part saves time and where your own permissions or app setup need adjustment.</p><p>To evaluate VoiceOS, use complete workflows rather than isolated demo sentences: start with the context you receive, produce the writing, prepare the follow-up, and count how many app switches and manual steps remain.</p></div></section><section id="features-faq"><h2 class="section-title text-3xl font-medium tracking-tight text-gray-950 md:text-4xl">VoiceOS feature FAQ</h2><div class="mt-6 space-y-3"><details class="rounded-2xl border border-gray-200 bg-white p-5"><summary class="cursor-pointer font-medium text-gray-950">What are the main VoiceOS features?</summary><p class="mt-3 text-[0.98rem] leading-relaxed text-gray-600">VoiceOS includes system-wide AI dictation, voice editing for selected text, screen-aware questions, web search, custom vocabulary and writing context, plus Agent Mode for supported connected actions. It runs on Mac and Windows and is designed to keep important actions reviewable before completion.</p></details><details class="rounded-2xl border border-gray-200 bg-white p-5"><summary class="cursor-pointer font-medium text-gray-950">Is VoiceOS only a dictation app?</summary><p class="mt-3 text-[0.98rem] leading-relaxed text-gray-600">No. Dictation Mode is one part of VoiceOS. Edit Mode changes existing text from a spoken instruction, and Agent Mode can use screen context, answer questions, search, and prepare actions through supported integrations. The product is designed around the full task rather than transcription alone.</p></details><details class="rounded-2xl border border-gray-200 bg-white p-5"><summary class="cursor-pointer font-medium text-gray-950">Can VoiceOS control every app on my computer?</summary><p class="mt-3 text-[0.98rem] leading-relaxed text-gray-600">VoiceOS can dictate into standard text fields across many desktop apps, while Agent Mode supports specific actions through screen context and connected services. It does not promise universal command-level control of every interface. Check the App Store and test the exact workflows you depend on.</p></details><details class="rounded-2xl border border-gray-200 bg-white p-5"><summary class="cursor-pointer font-medium text-gray-950">Does VoiceOS work on Windows as well as Mac?</summary><p class="mt-3 text-[0.98rem] leading-relaxed text-gray-600">Yes. VoiceOS provides desktop apps for macOS and Windows. The website selects an installer based on the visitor’s operating system, and the alternate desktop download remains available. App behavior can depend on operating-system permissions and the controls exposed by each destination app.</p></details><details class="rounded-2xl border border-gray-200 bg-white p-5"><summary class="cursor-pointer font-medium text-gray-950">Does VoiceOS send actions without asking?</summary><p class="mt-3 text-[0.98rem] leading-relaxed text-gray-600">VoiceOS is designed to present consequential actions for review before completion. You can inspect, edit, confirm, or cancel the proposed work. The exact confirmation flow depends on the action and connected service, but maintaining user control is a core part of Agent Mode.</p></details><details class="rounded-2xl border border-gray-200 bg-white p-5"><summary class="cursor-pointer font-medium text-gray-950">How do I get started with VoiceOS?</summary><p class="mt-3 text-[0.98rem] leading-relaxed text-gray-600">Download the Mac or Windows app and choose a plan. Begin with dictation in a familiar text field, then use Edit Mode, ask a question about your screen, and connect one supported integration. Using real tasks will show whether VoiceOS reduces corrections and context switching in your workflow.</p></details></div></section></div></section><div class="mt-20 md:mt-28"><div class="fp-privacy-card relative flex items-center justify-center overflow-hidden rounded-[56px] px-6 py-14 text-center md:rounded-[96px] md:py-0"><div class="relative z-10 mx-auto max-w-3xl"><h2 class="section-title text-[48px] font-normal leading-tight tracking-tight text-white"><span class="tabular-nums">0,000,000</span> hours saved for our users</h2></div></div></div></div></section><section class="relative px-4 py-24 md:px-8 md:py-32 bg-transparent"><div class="relative max-w-6xl mx-auto text-center"><h2 class="section-title text-[clamp(2.35rem,10.8vw,2.85rem)] md:text-6xl lg:text-7xl font-normal text-gray-900 mb-6 tracking-tight leading-[1.08] md:leading-none flex flex-wrap items-center justify-center gap-x-3 gap-y-2 md:gap-4"><span>Press</span><span class="glass-fn-key-wrap"><button class="glass-fn-key" type="button"><span>fn</span></button><div class="glass-fn-key-shadow"></div><div class="speech-bubbles-origin" aria-hidden="true"></div></span><span class="whitespace-nowrap">and start speaking.</span></h2><p class="section-title text-3xl md:text-4xl lg:text-5xl font-normal text-gray-500 mb-16 tracking-tight leading-relaxed">Let <strong class="font-semibold">your voice</strong> do the <strong class="font-semibold">work</strong>.</p><div class="flex flex-col items-center justify-center" style="opacity:0;transform:translateY(10px);transition:opacity 300ms ease-out, transform 300ms ease-out"><div class="glassmorphic-button-wrap"><button title="Download VoiceOS" type="button" class="glassmorphic-button"><span style="display:flex;align-items:center;justify-content:center;gap:0.5rem;position:relative;z-index:4"><svg class="w-6 h-6" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.54 4.09l.01-.01zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z"></path></svg>Download for Mac</span></button><div class="glassmorphic-button-shadow"></div></div></div></div></section><footer class="bg-transparent font-[family-name:var(--font-dm-mono)]"><div class="max-w-7xl mx-auto px-6 pt-12 md:pt-16"><div class="grid grid-cols-2 gap-8 sm:gap-12 lg:grid-cols-4"><div class="flex flex-col gap-3"><h3 class="text-lg font-medium text-muted-foreground">Product</h3><ul class="flex flex-col gap-2 text-sm"><li><a class="text-muted-foreground hover:text-primary transition-colors" href="/features/agent">Agent Mode</a></li><li><a class="text-muted-foreground hover:text-primary transition-colors" href="/features/dictation">Dictation Mode</a></li><li><a class="text-muted-foreground hover:text-primary transition-colors" href="/pricing">Pricing</a></li><li><a class="text-muted-foreground hover:text-primary transition-colors" href="/app-store">App Store</a></li><li><a class="text-muted-foreground hover:text-primary transition-colors" href="/blog">Blog</a></li></ul></div><div class="flex flex-col gap-3"><h3 class="text-lg font-medium text-muted-foreground">Company</h3><ul class="flex flex-col gap-2 text-sm"><li><a class="text-muted-foreground hover:text-primary tr