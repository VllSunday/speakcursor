ht:0;height:1px;background:rgba(232,234,237,0.08)"></div><div style="position:absolute;top:66.66666666666666%;left:0;right:0;height:1px;background:rgba(232,234,237,0.08)"></div><div style="position:absolute;top:83.33333333333334%;left:0;right:0;height:1px;background:rgba(232,234,237,0.08)"></div><div style="position:absolute;top:8.333333333333332%;left:0;right:0;height:1px;background:rgba(232,234,237,0.08);opacity:0.4"></div><div style="position:absolute;top:25%;left:0;right:0;height:1px;background:rgba(232,234,237,0.08);opacity:0.4"></div><div style="position:absolute;top:41.66666666666667%;left:0;right:0;height:1px;background:rgba(232,234,237,0.08);opacity:0.4"></div><div style="position:absolute;top:58.333333333333336%;left:0;right:0;height:1px;background:rgba(232,234,237,0.08);opacity:0.4"></div><div style="position:absolute;top:75%;left:0;right:0;height:1px;background:rgba(232,234,237,0.08);opacity:0.4"></div><div style="position:absolute;top:91.66666666666666%;left:0;right:0;height:1px;background:rgba(232,234,237,0.08);opacity:0.4"></div><div style="position:absolute;top:33.33333333333333%;height:16.66666666666667%;left:2px;right:2px;min-height:18px;border-radius:4px;background:#7986CB40;border-left:3px solid #7986CB;padding:3px 6px;overflow:hidden;display:flex;flex-direction:column;justify-content:flex-start"><span style="font-size:10px;font-weight:500;color:#E8EAED;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;line-height:1.3">Design review</span><span style="font-size:9px;color:#9AA0A6;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;line-height:1.3;margin-top:1px">11:00 – 12:00</span></div><div style="position:absolute;top:58.333333333333336%;height:16.666666666666664%;left:2px;right:2px;min-height:18px;border-radius:4px;background:#E67C7340;border-left:3px solid #E67C73;padding:3px 6px;overflow:hidden;display:flex;flex-direction:column;justify-content:flex-start"><span style="font-size:10px;font-weight:500;color:#E8EAED;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;line-height:1.3">Lunch w/ Sarah</span><span style="font-size:9px;color:#9AA0A6;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;line-height:1.3;margin-top:1px">12:30 – 1:30</span></div><div style="position:absolute;top:83.33333333333334%;height:8.333333333333314%;left:2px;right:2px;min-height:18px;border-radius:4px;background:#F6BF2640;border-left:3px solid #F6BF26;padding:3px 6px;overflow:hidden;display:flex;flex-direction:column;justify-content:flex-start"><span style="font-size:10px;font-weight:500;color:#E8EAED;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;line-height:1.3">1:1 with PM</span></div><div style="position:absolute;top:8.333333333333332%;height:16.666666666666668%;left:2px;right:2px;min-height:24px;border-radius:4px;background:#4285F4;border-left:3px solid #1A73E8;padding:3px 6px;overflow:hidden;box-shadow:0 1px 4px rgba(0,0,0,0.3);opacity:0;transform:scaleY(0);transform-origin:top;transition:opacity 0.3s ease-out, transform 0.3s ease-out"><span style="font-size:10px;font-weight:600;color:#fff;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;line-height:1.3">Cafe Meetup</span></div></div></div></div></div></div><div style="height:1px;background:rgba(255,255,255,0.03);opacity:0"></div><div style="padding:8px 16px 14px;display:flex;justify-content:flex-end;opacity:0;transition:opacity 0.3s ease-out 0.2s"><div style="height:32px;padding:0 20px;border-radius:16px;background:#8AB4F8;color:#202124;font-size:13px;font-weight:500;display:flex;align-items:center">Save</div></div></div></div></div></div></div></div></div></div><div aria-hidden="true" class="jsx-1531946181 ia-dock"><img src="/icons/finderApp.webp" alt="Finder app icon" loading="lazy" width="40" height="40" class="jsx-1531946181 ia-dock-icon"/><img src="/icons/googlecalendarApp.png" alt="Google Calendar app icon" loading="lazy" width="40" height="40" class="jsx-1531946181 ia-dock-icon is-lit"/><img src="/icons/slackApp.webp" alt="Slack app icon" loading="lazy" width="40" height="40" class="jsx-1531946181 ia-dock-icon"/><img src="/icons/notionApp.webp" alt="Notion app icon" loading="lazy" width="40" height="40" class="jsx-1531946181 ia-dock-icon"/><img src="/icons/gmailApp.webp" alt="Gmail app icon" loading="lazy" width="40" height="40" class="jsx-1531946181 ia-dock-icon"/><img src="/icons/linearApp.webp" alt="Linear app icon" loading="lazy" width="40" height="40" class="jsx-1531946181 ia-dock-icon"/><img src="/icons/googleApp.png" alt="Google app icon" loading="lazy" width="40" height="40" class="jsx-1531946181 ia-dock-icon"/><img src="/icons/applemapsApp.webp" alt="Apple Maps app icon" loading="lazy" width="40" height="40" class="jsx-1531946181 ia-dock-icon"/></div></div></div></div></section><section id="agent-confirm" class="jsx-d054b6759511f582 relative overflow-hidden px-4 py-16 md:px-8 md:py-24"><div class="jsx-d054b6759511f582 relative mx-auto grid max-w-6xl grid-cols-1 items-center gap-8 lg:grid-cols-2 lg:gap-14"><div class="jsx-d054b6759511f582 text-center lg:text-left"><h2 class="jsx-d054b6759511f582 cf-head section-title text-4xl font-normal tracking-tight text-gray-900 md:text-5xl lg:text-6xl">Nothing sends until <span style="font-weight:600">you say so</span></h2><p class="jsx-d054b6759511f582 mx-auto mt-6 max-w-xl text-lg font-light leading-relaxed text-gray-500 md:text-xl lg:mx-0">Anything that sends, books, or changes something stops and shows you what it will do. Fix it or let it go.</p></div><div class="jsx-d054b6759511f582 mx-auto w-full max-w-lg lg:max-w-none"><div class="jsx-d054b6759511f582 cf-panel"><span class="jsx-d054b6759511f582 cf-eyebrow">Before it sends</span><div class="jsx-d054b6759511f582 cf-card"><div class="jsx-d054b6759511f582 cf-card-head"><img src="/icons/slackApp.webp" alt="Slack app icon" aria-hidden="true" width="22" height="22" class="jsx-d054b6759511f582"/><span class="jsx-d054b6759511f582">Send message</span></div><dl class="jsx-d054b6759511f582 cf-card-rows"><dt class="jsx-d054b6759511f582">To</dt><dd class="jsx-d054b6759511f582">David Chen</dd><dt class="jsx-d054b6759511f582">Message</dt><dd class="jsx-d054b6759511f582">I&#x27;ll be ten minutes late. Can we move our 3pm to Thursday?</dd></dl><div class="jsx-d054b6759511f582 cf-card-foot"><span class="jsx-d054b6759511f582 cf-btn cf-btn-ghost">Cancel</span><span class="jsx-d054b6759511f582 cf-btn cf-btn-send">Send</span></div></div></div></div></div></section><section id="agent-reach" class="jsx-8dad8c20a2f0615f relative bg-transparent px-4 pb-14 pt-10 md:px-8 md:pb-20 md:pt-16"><div class="jsx-8dad8c20a2f0615f rc-card"><div class="jsx-8dad8c20a2f0615f rc-inner"><div class="jsx-8dad8c20a2f0615f rc-copy"><h2 class="jsx-8dad8c20a2f0615f rc-title section-title">Plug in <span style="font-weight:600">anything you use</span></h2><p class="jsx-8dad8c20a2f0615f rc-sub">Turn on Slack, Gmail, Notion, Linear and the rest in Settings. After that, just ask out loud and VoiceOS uses them for you. Built your own tool? It can use that too.</p></div><div class="jsx-8dad8c20a2f0615f rc-stack"><ul class="jsx-8dad8c20a2f0615f rc-shelf"><li style="--i:0" class="jsx-8dad8c20a2f0615f"><img src="/icons/slackApp.webp" alt="Slack" loading="lazy" width="48" height="48" class="jsx-8dad8c20a2f0615f"/></li><li style="--i:1" class="jsx-8dad8c20a2f0615f"><img src="/icons/gmailApp.webp" alt="Gmail" loading="lazy" width="48" height="48" class="jsx-8dad8c20a2f0615f"/></li><li style="--i:2" class="jsx-8dad8c20a2f0615f"><img src="/icons/notionApp.webp" alt="Notion" loading="lazy" width="48" height="48" class="jsx-8dad8c20a2f0615f"/></li><li style="--i:3" class="jsx-8dad8c20a2f0615f"><img src="/icons/linearApp.webp" alt="Linear" loading="lazy" width="48" height="48" class="jsx-8dad8c20a2f0615f"/></li><li style="--i:4" class="jsx-8dad8c20a2f0615f"><img src="/icons/googlecalendarApp.png" alt="Google Calendar" loading="lazy" width="48" height="48" class="jsx-8dad8c20a2f0615f"/></li><li style="--i:5" class="jsx-8dad8c20a2f0615f"><img src="/icons/googleDriveApp.webp" alt="Google Drive" loading="lazy" width="48" height="48" class="jsx-8dad8c20a2f0615f"/></li><li style="--i:6" class="jsx-8dad8c20a2f0615f"><img src="/icons/finderApp.webp" alt="Finder" loading="lazy" width="48" height="48" class="jsx-8dad8c20a2f0615f"/></li><li style="--i:7" class="jsx-8dad8c20a2f0615f"><img src="/icons/applemapsApp.webp" alt="Apple Maps" loading="lazy" width="48" height="48" class="jsx-8dad8c20a2f0615f"/></li><li style="--i:8" class="jsx-8dad8c20a2f0615f"><img src="/icons/googleDocsApp.webp" alt="Google Docs" loading="lazy" width="48" height="48" class="jsx-8dad8c20a2f0615f"/></li><li style="--i:9" class="jsx-8dad8c20a2f0615f"><img src="/icons/remindersApp.webp" alt="Reminders" loading="lazy" width="48" height="48" class="jsx-8dad8c20a2f0615f"/></li><li style="--i:10" class="jsx-8dad8c20a2f0615f"><img src="/icons/imessageApp.webp" alt="Messages" loading="lazy" width="48" height="48" class="jsx-8dad8c20a2f0615f"/></li><li style="--i:11" class="jsx-8dad8c20a2f0615f"><img src="/icons/obsedian.webp" alt="Obsidian" loading="lazy" width="48" height="48" class="jsx-8dad8c20a2f0615f"/></li></ul><div class="jsx-8dad8c20a2f0615f rc-mcp"><div class="jsx-8dad8c20a2f0615f rc-mcp-bar"><span class="jsx-8dad8c20a2f0615f rc-prompt">$</span><code class="jsx-8dad8c20a2f0615f">voiceos add mcp</code></div><div class="jsx-8dad8c20a2f0615f rc-mcp-body"><p class="jsx-8dad8c20a2f0615f rc-mcp-title">Your own MCP server</p><p class="jsx-8dad8c20a2f0615f rc-mcp-note">Every tool on it, by voice</p></div></div></div></div></div></section><section id="agent-background" class="jsx-2584854339 relative overflow-hidden px-4 py-12 md:px-8 md:py-16"><div class="jsx-2584854339 relative mx-auto max-w-5xl"><div class="jsx-2584854339 mb-7 text-center md:mb-8"><h2 class="jsx-2584854339 bg-head section-title text-4xl font-normal tracking-tight text-gray-900 md:text-5xl lg:text-6xl">Say it and <span style="font-weight:600">consider it done</span></h2><p class="jsx-2584854339 mx-auto mt-4 max-w-2xl text-lg font-light leading-relaxed text-gray-500 md:text-xl">Long tasks keep running at the side of your screen. The answer comes back on its own.</p></div><div class="jsx-2584854339 mx-auto w-full max-w-3xl"><div class="jsx-2584854339 bg-panel"><div aria-hidden="true" class="jsx-2584854339 bg-sheet"><p class="jsx-2584854339 bg-doc-title">Osaka offsite</p><p class="jsx-2584854339 bg-doc-p">We land Thursday morning, so the team dinner has to be that evening. Kenji offered to book the izakaya near the station.</p><p class="jsx-2584854339 bg-doc-p">Friday is the workshop. Two sessions before lunch, then the demo, then we let people go early.</p><p class="jsx-2584854339 bg-doc-p">Saturday is open. A few people want to stay on, so I will keep the group booking flexible until Wednesday.</p><p class="jsx-2584854339 bg-doc-p">I will lock the hotel in once the flights are<i class="jsx-2584854339 bg-caret"></i></p></div><div class="jsx-2584854339 hn-dock"><div aria-hidden="true" style="clip-path:polygon(0.000px 0.000px, 0.197px 2.503px, 0.783px 4.944px, 1.744px 7.264px, 3.056px 9.405px, 4.686px 11.314px, 6.595px 12.944px, 8.736px 14.256px, 11.056px 15.217px, 13.497px 15.803px, 16.000px 16.000px, 201.000px 16.000px, 205.849px 16.382px, 210.580px 17.517px, 215.074px 19.379px, 219.221px 21.920px, 222.920px 25.080px, 226.080px 28.779px, 228.621px 32.926px, 230.483px 37.420px, 231.618px 42.151px, 232.000px 47.000px, 232.000px calc(100% - 47.000px), 231.618px calc(100% - 42.151px), 230.483px calc(100% - 37.420px), 228.621px calc(100% - 32.926px), 226.080px calc(100% - 28.779px), 222.920px calc(100% - 25.080px), 219.221px calc(100% - 21.920px), 215.074px calc(100% - 19.379px), 210.580px calc(100% - 17.517px), 205.849px calc(100% - 16.382px), 201.000px calc(100% - 16.000px), 16.000px calc(100% - 16.000px), 13.497px calc(100% - 15.803px), 11.056px calc(100% - 15.217px), 8.736px calc(100% - 14.256px), 6.5