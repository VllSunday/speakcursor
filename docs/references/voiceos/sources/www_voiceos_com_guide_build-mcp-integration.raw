pan class=\"kw\"\u003ereturn\u003c/span\u003e \u003cspan class=\"var\"\u003eresult\u003c/span\u003e.\u003cspan class=\"var\"\u003estdout\u003c/span\u003e.\u003cspan class=\"fn\"\u003estrip\u003c/span\u003e() \u003cspan class=\"kw\"\u003eor\u003c/span\u003e \u003cspan class=\"str\"\u003e\"Done\"\u003c/span\u003e\n\n\u003cspan class=\"dec\"\u003e@mcp.tool()\u003c/span\u003e\n\u003cspan class=\"kw\"\u003edef\u003c/span\u003e \u003cspan class=\"fn\"\u003eplay\u003c/span\u003e() -\u0026gt; \u003cspan class=\"cls\"\u003estr\u003c/span\u003e:\n    \u003cspan class=\"str\"\u003e\"\"\"Resume Spotify playback.\"\"\"\u003c/span\u003e\n    \u003cspan class=\"kw\"\u003ereturn\u003c/span\u003e \u003cspan class=\"fn\"\u003eosascript\u003c/span\u003e(\u003cspan class=\"str\"\u003e\"play\"\u003c/span\u003e)\n\n\u003cspan class=\"dec\"\u003e@mcp.tool()\u003c/span\u003e\n\u003cspan class=\"kw\"\u003edef\u003c/span\u003e \u003cspan class=\"fn\"\u003epause\u003c/span\u003e() -\u0026gt; \u003cspan class=\"cls\"\u003estr\u003c/span\u003e:\n    \u003cspan class=\"str\"\u003e\"\"\"Pause Spotify playback.\"\"\"\u003c/span\u003e\n    \u003cspan class=\"kw\"\u003ereturn\u003c/span\u003e \u003cspan class=\"fn\"\u003eosascript\u003c/span\u003e(\u003cspan class=\"str\"\u003e\"pause\"\u003c/span\u003e)\n\n\u003cspan class=\"dec\"\u003e@mcp.tool()\u003c/span\u003e\n\u003cspan class=\"kw\"\u003edef\u003c/span\u003e \u003cspan class=\"fn\"\u003eskip_track\u003c/span\u003e() -\u0026gt; \u003cspan class=\"cls\"\u003estr\u003c/span\u003e:\n    \u003cspan class=\"str\"\u003e\"\"\"Skip to the next track.\"\"\"\u003c/span\u003e\n    \u003cspan class=\"kw\"\u003ereturn\u003c/span\u003e \u003cspan class=\"fn\"\u003eosascript\u003c/span\u003e(\u003cspan class=\"str\"\u003e\"next track\"\u003c/span\u003e)\n\n\u003cspan class=\"dec\"\u003e@mcp.tool()\u003c/span\u003e\n\u003cspan class=\"kw\"\u003edef\u003c/span\u003e \u003cspan class=\"fn\"\u003ecurrent_track\u003c/span\u003e() -\u0026gt; \u003cspan class=\"cls\"\u003estr\u003c/span\u003e:\n    \u003cspan class=\"str\"\u003e\"\"\"Get the currently playing track name and artist.\"\"\"\u003c/span\u003e\n    \u003cspan class=\"var\"\u003ename\u003c/span\u003e = \u003cspan class=\"fn\"\u003eosascript\u003c/span\u003e(\u003cspan class=\"str\"\u003e\"name of current track\"\u003c/span\u003e)\n    \u003cspan class=\"var\"\u003eartist\u003c/span\u003e = \u003cspan class=\"fn\"\u003eosascript\u003c/span\u003e(\u003cspan class=\"str\"\u003e\"artist of current track\"\u003c/span\u003e)\n    \u003cspan class=\"kw\"\u003ereturn\u003c/span\u003e \u003cspan class=\"str\"\u003ef\"\u003c/span\u003e\u003cspan class=\"var\"\u003e{name}\u003c/span\u003e\u003cspan class=\"str\"\u003e by \u003c/span\u003e\u003cspan class=\"var\"\u003e{artist}\u003c/span\u003e\u003cspan class=\"str\"\u003e\"\u003c/span\u003e\n\n\u003cspan class=\"kw\"\u003eif\u003c/span\u003e \u003cspan class=\"var\"\u003e__name__\u003c/span\u003e == \u003cspan class=\"str\"\u003e\"__main__\"\u003c/span\u003e:\n    \u003cspan class=\"var\"\u003emcp\u003c/span\u003e.\u003cspan class=\"fn\"\u003erun\u003c/span\u003e(\u003cspan class=\"var\"\u003etransport\u003c/span\u003e=\u003cspan class=\"str\"\u003e\"stdio\"\u003c/span\u003e)26:[\"$\",\"div\",\"spotify\",{\"children\":[[\"$\",\"div\",null,{\"className\":\"ge-spotify gl-py\",\"style\":{\"display\":\"none\"},\"children\":[\"$\",\"div\",null,{\"className\":\"rounded-2xl overflow-hidden border border-gray-200 bg-white \",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center justify-between px-4 py-2.5 border-b border-gray-100\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-xs font-mono text-gray-400\",\"children\":\"spotify_mcp.py\"}],[\"$\",\"button\",null,{\"data-copy\":\"import subprocess\\nfrom mcp.server.fastmcp import FastMCP\\n\\nmcp = FastMCP(\\\"spotify\\\")\\n\\ndef osascript(cmd: str) -\u003e str:\\n    result = subprocess.run(\\n        [\\\"osascript\\\", \\\"-e\\\", f'tell application \\\"Spotify\\\" to {cmd}'],\\n        capture_output=True, text=True,\\n    )\\n    return result.stdout.strip() or \\\"Done\\\"\\n\\n@mcp.tool()\\ndef play() -\u003e str:\\n    \\\"\\\"\\\"Resume Spotify playback.\\\"\\\"\\\"\\n    return osascript(\\\"play\\\")\\n\\n@mcp.tool()\\ndef pause() -\u003e str:\\n    \\\"\\\"\\\"Pause Spotify playback.\\\"\\\"\\\"\\n    return osascript(\\\"pause\\\")\\n\\n@mcp.tool()\\ndef skip_track() -\u003e str:\\n    \\\"\\\"\\\"Skip to the next track.\\\"\\\"\\\"\\n    return osascript(\\\"next track\\\")\\n\\n@mcp.tool()\\ndef current_track() -\u003e str:\\n    \\\"\\\"\\\"Get the currently playing track name and artist.\\\"\\\"\\\"\\n    name = osascript(\\\"name of current track\\\")\\n    artist = osascript(\\\"artist of current track\\\")\\n    return f\\\"{name} by {artist}\\\"\\n\\nif __name__ == \\\"__main__\\\":\\n    mcp.run(transport=\\\"stdio\\\")\",\"className\":\"copy-btn flex items-center gap-1.5 text-xs font-medium px-3 py-1.5 rounded-lg transition-all hover:bg-black/5 text-gray-400 hover:text-gray-600 shrink-0\",\"children\":[[\"$\",\"svg\",null,{\"width\":\"14\",\"height\":\"14\",\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":\"2\",\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"children\":[[\"$\",\"rect\",null,{\"x\":\"9\",\"y\":\"9\",\"width\":\"13\",\"height\":\"13\",\"rx\":\"2\",\"ry\":\"2\"}],[\"$\",\"path\",null,{\"d\":\"M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1\"}]]}],\"Copy\"]}]]}],[\"$\",\"pre\",null,{\"className\":\"guide-code px-4 py-4 overflow-x-auto text-[13px] leading-[1.8]\",\"dangerouslySetInnerHTML\":{\"__html\":\"$32\"}}]]}]}],\"$L33\"]}]\n34:T465,import subprocess\nfrom mcp.server.fastmcp import FastMCP\n\nmcp = FastMCP(\"system-control\")\n\ndef osascript(script: str) -\u003e str:\n    result = subprocess.run(\n        [\"osascript\", \"-e\", script],\n        capture_output=True, text=True,\n    )\n    return result.stdout.strip() or \"Done\"\n\n@mcp.tool()\ndef set_volume(level: int) -\u003e str:\n    \"\"\"Set the system volume (0-100).\"\"\"\n    return osascript(f\"set volume output volume {level}\")\n\n@mcp.tool()\ndef toggle_do_not_disturb() -\u003e str:\n    \"\"\"Toggle Do Not Disturb / Focus mode.\"\"\"\n    script = 'tell application \"System Events\" to keystroke \"D\" ' \\\n             'using {command down, shift down, option down}'\n    return osascript(script)\n\n@mcp.tool()\ndef open_app(app_name: str) -\u003e str:\n    \"\"\"Open an application by name.\"\"\"\n    subprocess.run([\"open\", \"-a\", app_name])\n    return f\"Opened {app_name}\"\n\n@mcp.tool()\ndef get_battery() -\u003e str:\n    \"\"\"Get the current battery level.\"\"\"\n    result = subprocess.run(\n        [\"pmset\", \"-g\", \"batt\"],\n        capture_output=True, text=True,\n    )\n    return result.stdout.strip()\n\nif __name__ == \"__main__\":\n    mcp.run(transport=\"stdio\")35:Td9b,\u003cspan class=\"kw\"\u003eimport\u003c/span\u003e \u003cspan class=\"mod\"\u003esubprocess\u003c/span\u003e\n\u003cspan class=\"kw\"\u003efrom\u003c/span\u003e \u003cspan class=\"mod\"\u003emcp.server.fastmcp\u003c/span\u003e \u003cspan class=\"kw\"\u003eimport\u003c/span\u003e \u003cspan class=\"cls\"\u003eFastMCP\u003c/span\u003e\n\n\u003cspan class=\"var\"\u003emcp\u003c/span\u003e = \u003cspan class=\"cls\"\u003eFastMCP\u003c/span\u003e(\u003cspan class=\"str\"\u003e\"system-control\"\u003c/span\u003e)\n\n\u003cspan class=\"kw\"\u003edef\u003c/span\u003e \u003cspan class=\"fn\"\u003eosascript\u003c/span\u003e(\u003cspan class=\"var\"\u003escript\u003c/span\u003e: \u003cspan class=\"cls\"\u003estr\u003c/span\u003e) -\u0026gt; \u003cspan class=\"cls\"\u003estr\u003c/span\u003e:\n    \u003cspan class=\"var\"\u003eresult\u003c/span\u003e = \u003cspan class=\"mod\"\u003esubprocess\u003c/span\u003e.\u003cspan class=\"fn\"\u003erun\u003c/span\u003e(\n        [\u003cspan class=\"str\"\u003e\"osascript\"\u003c/span\u003e, \u003cspan class=\"str\"\u003e\"-e\"\u003c/span\u003e, \u003cspan class=\"var\"\u003escript\u003c/span\u003e],\n        \u003cspan class=\"var\"\u003ecapture_output\u003c/span\u003e=\u003cspan class=\"kw\"\u003eTrue\u003c/span\u003e, \u003cspan class=\"var\"\u003etext\u003c/span\u003e=\u003cspan class=\"kw\"\u003eTrue\u003c/span\u003e,\n    )\n    \u003cspan class=\"kw\"\u003ereturn\u003c/span\u003e \u003cspan class=\"var\"\u003eresult\u003c/span\u003e.\u003cspan class=\"var\"\u003estdout\u003c/span\u003e.\u003cspan class=\"fn\"\u003estrip\u003c/span\u003e() \u003cspan class=\"kw\"\u003eor\u003c/span\u003e \u003cspan class=\"str\"\u003e\"Done\"\u003c/span\u003e\n\n\u003cspan class=\"dec\"\u003e@mcp.tool()\u003c/span\u003e\n\u003cspan class=\"kw\"\u003edef\u003c/span\u003e \u003cspan class=\"fn\"\u003eset_volume\u003c/span\u003e(\u003cspan class=\"var\"\u003elevel\u003c/span\u003e: \u003cspan class=\"cls\"\u003eint\u003c/span\u003e) -\u0026gt; \u003cspan class=\"cls\"\u003estr\u003c/span\u003e:\n    \u003cspan class=\"str\"\u003e\"\"\"Set the system volume (0-100).\"\"\"\u003c/span\u003e\n    \u003cspan class=\"kw\"\u003ereturn\u003c/span\u003e \u003cspan class=\"fn\"\u003eosascript\u003c/span\u003e(\u003cspan class=\"str\"\u003ef\"set volume output volume \u003c/span\u003e\u003cspan class=\"var\"\u003e{level}\u003c/span\u003e\u003cspan class=\"str\"\u003e\"\u003c/span\u003e)\n\n\u003cspan class=\"dec\"\u003e@mcp.tool()\u003c/span\u003e\n\u003cspan class=\"kw\"\u003edef\u003c/span\u003e \u003cspan class=\"fn\"\u003etoggle_do_not_disturb\u003c/span\u003e() -\u0026gt; \u003cspan class=\"cls\"\u003estr\u003c/span\u003e:\n    \u003cspan class=\"str\"\u003e\"\"\"Toggle Do Not Disturb / Focus mode.\"\"\"\u003c/span\u003e\n    \u003cspan class=\"var\"\u003escript\u003c/span\u003e = \u003cspan class=\"str\"\u003e'tell application \"System Events\" to keystroke \"D\" '\u003c/span\u003e \\\n             \u003cspan class=\"str\"\u003e'using {command down, shift down, option down}'\u003c/span\u003e\n    \u003cspan class=\"kw\"\u003ereturn\u003c/span\u003e \u003cspan class=\"fn\"\u003eosascript\u003c/span\u003e(\u003cspan class=\"var\"\u003escript\u003c/span\u003e)\n\n\u003cspan class=\"dec\"\u003e@mcp.tool()\u003c/span\u003e\n\u003cspan class=\"kw\"\u003edef\u003c/span\u003e \u003cspan class=\"fn\"\u003eopen_app\u003c/span\u003e(\u003cspan class=\"var\"\u003eapp_name\u003c/span\u003e: \u003cspan class=\"cls\"\u003estr\u003c/span\u003e) -\u0026gt; \u003cspan class=\"cls\"\u003estr\u003c/span\u003e:\n    \u003cspan class=\"str\"\u003e\"\"\"Open an application by name.\"\"\"\u003c/span\u003e\n    \u003cspan class=\"mod\"\u003esubprocess\u003c/span\u003e.\u003cspan class=\"fn\"\u003erun\u003c/span\u003e([\u003cspan class=\"str\"\u003e\"open\"\u003c/span\u003e, \u003cspan class=\"str\"\u003e\"-a\"\u003c/span\u003e, \u003cspan class=\"var\"\u003eapp_name\u003c/span\u003e])\n    \u003cspan class=\"kw\"\u003ereturn\u003c/span\u003e \u003cspan class=\"str\"\u003ef\"Opened \u003c/span\u003e\u003cspan class=\"var\"\u003e{app_name}\u003c/span\u003e\u003cspan class=\"str\"\u003e\"\u003c/span\u003e\n\n\u003cspan class=\"dec\"\u003e@mcp.tool()\u003c/span\u003e\n\u003cspan class=\"kw\"\u003edef\u003c/span\u003e \u003cspan class=\"fn\"\u003eget_battery\u003c/span\u003e() -\u0026gt; \u003cspan class=\"cls\"\u003estr\u003c/span\u003e:\n    \u003cspan class=\"str\"\u003e\"\"\"Get the current battery level.\"\"\"\u003c/span\u003e\n    \u003cspan class=\"var\"\u003eresult\u003c/span\u003e = \u003cspan class=\"mod\"\u003esubprocess\u003c/span\u003e.\u003cspan class=\"fn\"\u003erun\u003c/span\u003e(\n        [\u003cspan class=\"str\"\u003e\"pmset\"\u003c/span\u003e, \u003cspan class=\"str\"\u003e\"-g\"\u003c/span\u003e, \u003cspan class=\"str\"\u003e\"batt\"\u003c/span\u003e],\n        \u003cspan class=\"var\"\u003ecapture_output\u003c/span\u003e=\u003cspan class=\"kw\"\u003eTrue\u003c/span\u003e, \u003cspan class=\"var\"\u003etext\u003c/span\u003e=\u003cspan class=\"k