<span class="var">server</span>.<span class="fn">tool</span>(<span class="str">"pause"</span>, <span class="str">"Pause Spotify playback"</span>, {},
  <span class="kw">async</span> () =&gt; ({ <span class="var">content</span>: [{ <span class="var">type</span>: <span class="str">"text"</span>, <span class="var">text</span>: <span class="kw">await</span> <span class="fn">osascript</span>(<span class="str">"pause"</span>) }] }));

<span class="var">server</span>.<span class="fn">tool</span>(<span class="str">"skip_track"</span>, <span class="str">"Skip to the next track"</span>, {},
  <span class="kw">async</span> () =&gt; ({ <span class="var">content</span>: [{ <span class="var">type</span>: <span class="str">"text"</span>, <span class="var">text</span>: <span class="kw">await</span> <span class="fn">osascript</span>(<span class="str">"next track"</span>) }] }));

