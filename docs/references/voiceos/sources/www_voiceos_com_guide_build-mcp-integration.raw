        [<span class="str">"osascript"</span>, <span class="str">"-e"</span>, <span class="str">f'tell application "Spotify" to </span><span class="var">{cmd}</span><span class="str">'</span>],
        <span class="var">capture_output</span>=<span class="kw">True</span>, <span class="var">text</span>=<span class="kw">True</span>,
    )
    <span class="kw">return</span> <span class="var">result</span>.<span class="var">stdout</span>.<span class="fn">strip</span>() <span class="kw">or</span> <span class="str">"Done"</span>

