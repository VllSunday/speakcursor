, 0.05) 0px 1px 2px 0px inset, rgba(255, 255, 255, 0.6) 0px -1px 1px 0px inset, rgba(0, 0, 0, 0.06) 0px 2px 4px -1px"><button class="px-2.5 py-1 rounded-full text-xs font-semibold transition-all duration-200 bg-white/80 text-gray-900 shadow-sm" style="min-width:36px">EN</button><button class="px-2.5 py-1 rounded-full text-xs font-semibold transition-all duration-200 text-gray-500 hover:text-gray-700" style="min-width:36px">JA</button></div></div></div></div></footer></main><!--$--><!--/$--><!--$--><!--/$--><script src="/_next/static/chunks/2t99epdsa26s3.js" id="_R_" async=""></script><script>(self.__next_f=self.__next_f||[]).push([0])</script><script>self.__next_f.push([1,"1:\"$Sreact.fragment\"\n3:I[39756,[\"/_next/static/chunks/2kb52na2e7ces.js\",\"/_next/static/chunks/1xfsu92iq1h9m.js\",\"/_next/static/chunks/3x6-_ejf1r1x0.js\"],\"default\"]\n4:I[37457,[\"/_next/static/chunks/2kb52na2e7ces.js\",\"/_next/static/chunks/1xfsu92iq1h9m.js\",\"/_next/static/chunks/3x6-_ejf1r1x0.js\"],\"default\"]\n5:I[13826,[\"/_next/static/chunks/2kb52na2e7ces.js\",\"/_next/static/chunks/1xfsu92iq1h9m.js\",\"/_next/static/chunks/3x6-_ejf1r1x0.js\",\"/_next/static/chunks/0z6qqa_pcb2c9.js\",\"/_next/static/chunks/35rx1_qn9m74v.js\"],\"default\"]\n1a:I[68027,[\"/_next/static/chunks/2kb52na2e7ces.js\",\"/_next/static/chunks/1xfsu92iq1h9m.js\",\"/_next/static/chunks/3x6-_ejf1r1x0.js\"],\"default\",1]\n:HL[\"/_next/static/chunks/3n9hqloa8jzmk.css\",\"style\"]\n:HL[\"/_next/static/chunks/0ik2wv_u5zuv3.css\",\"style\"]\n:HL[\"/_next/static/media/36363bfb06833f56-s.p.38hmww4cj4vme.woff2\",\"font\",{\"crossOrigin\":\"\",\"type\":\"font/woff2\"}]\n:HL[\"/_next/static/media/7546fe8f902b88b8-s.p.1agee208_hwfr.woff2\",\"font\",{\"crossOrigin\":\"\",\"type\":\"font/woff2\"}]\n:HL[\"/_next/static/media/a73419dd2ba2d841-s.p.2yee423r7ahpo.woff2\",\"font\",{\"crossOrigin\":\"\",\"type\":\"font/woff2\"}]\n18:X\n0:{\"P\":null,\"c\":[\"\",\"privacy\"],\"q\":\"\",\"i\":false,\"f\":[[[\"\",{\"children\":[\"privacy\",{\"children\":[\"__PAGE__\",{},\"$undefined\",\"$undefined\",4096]},\"$undefined\",\"$undefined\",4096]},\"$undefined\",\"$undefined\",4112],[[\"$\",\"$1\",\"c\",{\"children\":[[[\"$\",\"link\",\"0\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/chunks/3n9hqloa8jzmk.css\",\"precedence\":\"next\",\"crossOrigin\":\"$undefined\",\"nonce\":\"$undefined\"}],[\"$\",\"link\",\"1\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/chunks/0ik2wv_u5zuv3.css\",\"precedence\":\"next\",\"crossOrigin\":\"$undefined\",\"nonce\":\"$undefined\"}],[\"$\",\"script\",\"script-0\",{\"src\":\"/_next/static/chunks/2kb52na2e7ces.js\",\"async\":true,\"nonce\":\"$undefined\"}],[\"$\",\"script\",\"script-1\",{\"src\":\"/_next/static/chunks/1xfsu92iq1h9m.js\",\"async\":true,\"nonce\":\"$undefined\"}],[\"$\",\"script\",\"script-2\",{\"src\":\"/_next/static/chunks/3x6-_ejf1r1x0.js\",\"async\":true,\"nonce\":\"$undefined\"}]],\"$L2\"]}],{\"children\":[[\"$\",\"$1\",\"c\",{\"children\":[null,[\"$\",\"$L3\",null,{\"parallelRouterKey\":\"children\",\"error\":\"$undefined\",\"errorStyles\":\"$undefined\",\"errorScripts\":\"$undefined\",\"template\":[\"$\",\"$L4\",null,{}],\"templateStyles\":\"$undefined\",\"templateScripts\":\"$undefined\",\"notFound\":\"$undefined\",\"forbidden\":\"$undefined\",\"unauthorized\":\"$undefined\"}]]}],{\"children\":[[\"$\",\"$1\",\"c\",{\"children\":[[\"$\",\"main\",null,{\"className\":\"min-h-screen\",\"style\":{\"backgroundColor\":\"#F9F9F9\"},\"children\":[[\"$\",\"$L5\",null,{}],[\"$\",\"div\",null,{\"className\":\"relative pt-32 pb-16\",\"children\":[\"$\",\"div\",null,{\"className\":\"max-w-4xl mx-auto px-6\",\"children\":[[\"$\",\"h1\",null,{\"className\":\"section-title text-5xl md:text-6xl font-bold text-gray-900 mb-4\",\"children\":\"Privacy Policy\"}],[\"$\",\"div\",null,{\"className\":\"text-lg md:text-xl text-gray-600 space-y-1\",\"children\":[[\"$\",\"p\",null,{\"children\":[\"Effective date: \",\"August 7, 2026\"]}],[\"$\",\"p\",null,{\"children\":[\"Last updated: \",\"August 7, 2026\"]}]]}]]}]}],[\"$\",\"div\",null,{\"className\":\"max-w-4xl mx-auto px-6 py-16\",\"children\":[null,[[\"$\",\"section\",null,{\"className\":\"mb-12\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"section-title text-3xl font-bold text-gray-900 mb-4\",\"children\":[\"1. \",\"Who We Are and What This Policy Covers\"]}],[\"$\",\"div\",null,{\"className\":\"prose prose-lg text-gray-700 space-y-4\",\"children\":[[\"$\",\"p\",null,{\"children\":[\"VoiceOS is operated by \",[\"$\",\"strong\",null,{\"children\":\"WakoAI Inc.\"}],\", located at 35 Buckelew Street, Sausalito, California 94965, United States.\"]}],[\"$\",\"p\",null,{\"children\":\"This Privacy Policy explains how WakoAI Inc. collects, uses, retains, protects, and shares personal information when you use the VoiceOS website, macOS application, Windows application, dashboard, Team plans, Enterprise plans, and affiliate or referral program. Together, these are the Service.\"}],[\"$\",\"p\",null,{\"children\":\"This Privacy Policy does not cover a separate VoiceOS mobile application. If WakoAI Inc. launches a mobile application, it will provide the notice applicable to that product before launch.\"}],[\"$\",\"p\",null,{\"children\":[\"If you have questions about this policy or want to exercise a privacy choice, contact us at \",[\"$\",\"a\",null,{\"href\":\"mailto:support@voiceos.com\",\"className\":\"text-voiceos-blue hover:underline font-medium\",\"children\":\"support@voiceos.com\"}],\".\"]}]]}]]}],[\"$\",\"section\",null,{\"className\":\"mb-12\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"section-title text-3xl font-bold text-gray-900 mb-4\",\"children\":[\"2. \",\"Plain Language Summary\"]}],[\"$\",\"div\",null,{\"className\":\"prose prose-lg text-gray-700 space-y-4\",\"children\":[[\"$\",\"p\",null,{\"children\":\"VoiceOS lets you dictate text and use Agent Mode to carry out user-directed tasks. To provide those features, VoiceOS processes the audio, text, and limited context you choose to provide.\"}],[\"$\",\"p\",null,{\"children\":\"By default, VoiceOS does not use your raw audio, transcripts, edited text, Agent prompts, Agent responses, data supplied to Agent Mode, or Agent outputs to evaluate, train, or improve VoiceOS models. Raw audio and transcripts are deleted immediately after processing needed to provide the requested feature and are not saved when Help Improve VoiceOS is off.\"}],[\"$\",\"p\",null,{\"children\":[\"If you affirmatively enable \",[\"$\",\"strong\",null,{\"children\":\"Help Improve VoiceOS\"}],\", VoiceOS may use the content categories described in Section 4 for evaluation. Raw audio and transcripts collected under that setting may be retained indefinitely for training. Turning the setting off later stops future collection under that setting but does not delete information already collected under it.\"]}],\"$L6\"]}]]}],\"$L7\",\"$L8\",\"$L9\",\"$La\",\"$Lb\",\"$Lc\",\"$Ld\",\"$Le\",\"$Lf\",\"$L10\",\"$L11\",\"$L12\",\"$L13\"]]}],\"$L14\"]}],[\"$L15\",\"$L16\"],\"$L17\"]}],{},null,false,null]},null,false,\"$18\"]},null,false,null],\"$L19\",false]],\"m\":\"$undefined\",\"G\":[\"$1a\",[\"$L1b\",\"$L1c\"]],\"S\":false,\"h\":null,\"r\":\"$undefined\",\"s\":\"$undefined\",\"a\":\"$undefined\",\"l\":\"$undefined\",\"p\":\"$undefined\",\"d\":\"$undefined\",\"b\":\"q9GMBTarcBnq9SQy8tdT7\"}\n25:I[40163,[\"/_next/static/chunks/2kb52na2e7ces.js\",\"/_next/static/chunks/1xfsu92iq1h9m.js\",\"/_next/static/chunks/3x6-_ejf1r1x0.js\",\"/_next/static/chunks/0z6qqa_pcb2c9.js\",\"/_next/static/chunks/35rx1_qn9m74v.js\"],\"default\"]\n26:I[97367,[\"/_next/static/chunks/2kb52na2e7ces.js\",\"/_next/static/chunks/1xfsu92iq1h9m.js\",\"/_next/static/chunks/3x6-_ejf1r1x0.js\"],\"OutletBoundary\"]\n27:\"$Sreact.suspense\"\n29:I[97367,[\"/_next/static/chunks/2kb52na2e7ces.js\",\"/_next/static/chunks/1xfsu92iq1h9m.js\",\"/_next/static/chunks/3x6-_ejf1r1x0.js\"],\"ViewportBoundary\"]\n2b:I[97367,[\"/_next/static/chunks/2kb52na2e7ces.js\",\"/_next/static/chunks/1xfsu92iq1h9m.js\",\"/_next/static/chunks/3x6-_ejf1r1x0.js\"],\"MetadataBoundary\"]\n6:[\"$\",\"p\",null,{\"children\":\"VoiceOS retains limited operational information needed to run, secure, support, measure, and administer the Service. This can include account identifiers, subscription status, usage counters, consent records, security logs, crash reports, diagnostics, user-submitted support communications, and limited referral information.\"}]\n7:[\"$\",\"section\",null,{\"className\":\"mb-12\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"section-title text-3xl font-bold text-gray-900 mb-4\",\"children\":[\"3. \",\"Information We Collect and Why\"]}],[\"$\",\"div\",null,{\"className\":\"prose prose-lg text-gray-700 space-y-4\",\"children\":[[\"$\",\"div\",null,{\"className\":\"hidden md:block overflow-x-auto rounded-2xl border border-gray-200 bg-white shadow-sm\",\"children\":[\"$\",\"table\",null,{\"className\":\"w-full text-left text-sm\",\"children\":[[\"$\",\"thead\",null,{\"className\":\"bg-gray-50\",\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"Category\",{\"className\":\"px-4 py-3 align-top font-semibold text-gray-900\",\"children\":\"Category\"}],[\"$\",\"th\",\"Examples\",{\"className\":\"px-4 py-3 align-top font-semibold text-gray-900\",\"children\":\"Examples\"}],[\"$\",\"th\",\"Why We Use It\",{\"className\":\"px-4 py-3 align-top font-semibold text-gray-900\",\"children\":\"Why We Use It\"}],[\"$\",\"th\",\"Retention Approach\",{\"className\":\"px-4 py-3 align-top font-semibold text-gray-900\",\"children\":\"Retention Approach\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"className\":\"border-t border-gray-200\",\"children\":[[\"$\",\"td\",\"0\",{\"className\":\"px-4 py-3 align-top text-gray-700\",\"children\":\"Account and profile information\"}],[\"$\",\"td\",\"1\",{\"className\":\"px-4 py-3 align-top text-gray-700\",\"children\":\"Name, email address, account ID, login information, settings\"}],[\"$\",\"td\",\"2\",{\"className\":\"px-4 py-3 align-top text-gray-700\",\"children\":\"Create and secure your account, provide the Service, communicate with you, prevent fraud, and provide support\"}],[\"$\",\"td\",\"3\",{\"className\":\"px-4 py-3 align-top text-gray-700\",\"children\":\"Retained while your account is active and deleted as described in Section 9 after account deletion, subject to lawful exceptions\"}]]}],[\"$\",\"tr\",\"1\",{\"className\":\"border-t border-gray-200\",\"children\":[[\"$\",\"td\",\"0\",{\"className\":\"px-4 py-3 align-top text-gray-700\",\"children\":\"Subscription information\"}],[\"$\",\"td\",\"1\",{\"className\":\"px-4 py-3 align-top text-gray-700\",\"children\":\"Plan selection, subscription status, renewal date, billing events, receipts, and transaction status\"}],[\"$\",\"td\",\"2\",{\"className\":\"px-4 py-3 align-top text-gray-700\",\"children\":\"Provide paid features, administer trials and subscriptions, respond to billing requests, and prevent fraud\"}],[\"$\",\"td\",\"3\",{\"className\":\"px-4 py-3 align-top text-gray-700\",\"children\":\"Account-linked records are deleted as described in Section 9, except for aggregate numerical records and any records we must retain by law\"}]]}],[\"$\",\"tr\",\"2\",{\"className\":\"border-t border-gray-200\",\"children\":[[\"$\",\"td\",\"0\",{\"className\":\"px-4 py-3 align-top text-gray-700\",\"children\":\"Payment information\"}],[\"$\",\"td\",\"1\",{\"className\":\"px-4 py-3 align-top text-gray-700\",\"children\":\"Payment information submitted at checkout\"}],[\"$\",\"td\",\"2\",{\"className\":\"px-4 py-3 align-top text-gray-700\",\"children\":\"Process payments and subscriptions through our payment processor\"}],[\"$\",\"td\",\"3\",{\"className\":\"px-4 py-3 align-top text-gray-700\",\"children\":\"Payment-card information is processed by the payment processor. VoiceOS does not store payment-card information\"}]]}],[\"$\",\"tr\",\"3\",{\"className\":\"border-t border-gray-200\",\"children\":[[\"$\",\"td\",\"0\",{\"className\":\"px-4 py-3 align-top text-gray-700\",\"children\":\"Voice and transcript content\"}],[\"$\",\"td\",\"1\",{\"className\":\"px-4 py-3 align-top text-gray-700\",\"children\":\"Raw audio, transcripts, edited text, and spoken Agent instructions\"}],[\"$\",\"td\",\"2\",{\"className\":\"px-4 py-3 align-top text-gray-700\",\"children\":\"Convert speech to text, provide Dictation Mode and Agent Mode, and return requested outputs\"}],[\"$\",\"td\",\"3\",{\"className\":\"px-4 py-3 align-top text-gray-700\",\"children\":\"See Sections 4 and 9\"}]]}],[\"$\",\"tr\",\"4\",{\"className\":\"border-t border-gray-200\",\"children\":[[\"$\",\"td\",\"0\",{\"className\":\"px-4 py-3 align-top text-gray-700\",\"children\":\"Agent Mode context\"}],[\"$\",\"td\",\"1\",{\"className\":\"px-4 py-3 align-top text-gray-700\",\"children\":\"Selected text, screenshots you allow, regions you draw, attachments, connected-service responses, tool inputs, and tool outputs\"}],\"$L1d\",\"$L1e\"]}],\"$L1f\",\"$L20\",\"$L21\",\"$L22\",\"$L23\"]}]]}]}],\"$L24\"]}]]}]\n8:[\"$\",\"section\",null,{\"className\":\"mb-12\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"section-title text-3xl font-bold text-gray-900 mb-4\",\"children\":[\"4. \",\"Help Improve VoiceOS\"]}],[\"$\",\"div\",null,{\"className\":\"prose prose-lg text-gray-700 space-y-4\",\"children\":[[\"$\",\"div\",null,{\"className\":\"space-y-4\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-2xl font-bold text-gray-900 pt-4\",\"children\":[\"4.1\",\" \",\"When Help Improve VoiceOS Is Off\"]}],[[\"$\",\"p\",null,{\"children\":\"When Help Improve VoiceOS is off, VoiceOS does not use your raw audio, transcripts, edited text, Agent prompts, Agent responses, data you provide to Agent Mode, or Agent outputs to evaluate, train, fine tune, benchmark, or otherwise improve VoiceOS models.\"}],[\"$\",\"p\",null,{\"children\":\"VoiceOS still processes information necessary to provide a feature you request. For example, it may transmit audio to a speech-processing provider or transmit a prompt and context to an AI-processing provider so that Dictation Mode or Agent Mode can work. This service-delivery processing is separate from using content for VoiceOS evaluation or training.\"}],[\"$\",\"p\",null,{\"children\":\"When Help Improve VoiceOS is off, raw audio and transcripts are deleted immediately after processing and are not saved by VoiceOS.\"}]]]}],[\"$\",\"div\",null,{\"className\":\"space-y-4\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-2xl font-bold text-gray-900 pt-4\",\"children\":[\"4.2\",\" \",\"When Help Improve VoiceOS Is On\"]}],[[\"$\",\"p\",null,{\"children\":\"Help Improve VoiceOS is an optional setting. If you turn it on, VoiceOS may use raw audio, transcripts, edited text, Agent prompts, Agent responses, data you provide to Agent Mode, and Agent outputs for evaluation of VoiceOS.\"}],[\"$\",\"p\",null,{\"children\":\"Raw audio and transcripts collected while Help Improve VoiceOS is on may be retained indefinitely for training. Before you enable the setting, VoiceOS will present the setting and its effect in the product.\"}]]]}],[\"$\",\"div\",null,{\"className\":\"space-y-4\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-2xl font-bold text-gray-900 pt-4\",\"children\":[\"4.3\",\" \",\"Turning the Setting Off\"]}],[\"$\",\"p\",null,{\"children\":\"If you turn Help Improve VoiceOS off after previously enabling it, VoiceOS stops future collection under that setting. Information collected while the setting was on remains retained under the applicable Help Improve VoiceOS retention rule. Turning the setting off does not retrospectively delete content already collected for training or evaluation.\"}]]}]]}]]}]\n9:[\"$\",\"section\",null,{\"className\":\"mb-12\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"section-title text-3xl font-bold text-gray-900 mb-4\",\"children\":[\"5. \",\"Agent Mode, Context, and Integrations\"]}],[\"$\",\"div\",null,{\"className\":\"prose prose-lg text-gray-700 space-y-4\",\"children\":[[\"$\",\"div\",null,{\"className\":\"space-y-4\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-2xl font-bold text-gray-900 pt-4\",\"children\":[\"5.1\",\" \",\"Agent Mode Context\"]}],[[\"$\",\"p\",null,{\"children\":\"Agent Mode may process selected text, screenshots you choose to allow, drawn screen regions, files you attach, connected-service content, web-search results, and tool inputs and outputs when needed to complete a task you request.\"}],[\"$\",\"p\",null,{\"children\":\"After processing, VoiceOS does not retain the details of those requests, screens, tool calls, MCP interactions, outputs, or other Agent Mode content. VoiceOS may retain limited non-content operational metadata, such as the number of requests, number of outputs, error indicators, and the request type, such as a search, screen-view, or specific MCP request.\"}]]]}],[\"$\",\"div\",null,{\"className\":\"space-y-4\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-2xl font-bold text-gray-900 pt-4\",\"children\":[\"5.2\",\" \",\"Connected Services\"]}],[[\"$\",\"p\",null,{\"children\":\"You may connect third-party services, such as email, chat, calendar, files, notes, and issue-tracking services. When you connect a service, VoiceOS uses the permissions and credentials you grant to carry out the actions you request.\"}],[\"$\",\"p\",null,{\"children\":\"You can disconnect a connected service through VoiceOS and may also revoke VoiceOS access through the third-party service. Third-party services you connect are governed by their own terms and privacy notices.\"}]]]}],[\"$\",\"div\",null,{\"className\":\"space-y-4\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-2xl font-bold text-gray-900 pt-4\",\"children\":[\"5.3\",\" \",\"Custom MCP Servers\"]}],[\"$\",\"p\",null,{\"children\":\"You may add your own Model Context Protocol, or MCP, servers as local commands or remote URLs. Custom MCP servers are third-party tools and services that you choose to enable. VoiceOS does not control, operate, or secure them. When Agent Mode uses a custom MCP server, your instruction and any context needed for that tool call may be transmitted to the endpoint you configured.\"}]]}]]}]]}]\na:[\"$\",\"section\",null,{\"className\":\"mb-12\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"section-title text-3xl font-bold text-gray-900 mb-4\",\"children\":[\"6. \",\"How We Share Information\"]}],[\"$\",\"div\",null,{\"className\":\"prose prose-lg text-gray-700 space-y-4\",\"children\":[[\"$\",\"p\",null,{\"children\":\"VoiceOS shares personal information only as needed to provide the Service, conduct a transaction you request, operate the business, or comply with law. We may share information with the following categories of recipients:\"}],[\"$\",\"ul\",null,{\"className\":\"list-disc space-y-3 ml-6 marker:text-gray-400\",\"children\":[[\"$\",\"li\",\"0\",{\"className\":\"text-gray-700\",\"children\":\"cloud infrastructure, database, and authentication providers;\"}],[\"$\",\"li\",\"1\",{\"className\":\"text-gray-700\",\"children\":\"speech-recognition, AI-processing, and text-to-speech providers;\"}],[\"$\",\"li\",\"2\",{\"className\":\"text-gray-700\",\"children\":\"payment and subscription processors;\"}],[\"$\",\"li\",\"3\",{\"className\":\"text-gray-700\",\"children\":\"integration and OAuth providers that help connect services you choose;\"}],[\"$\",\"li\",\"4\",{\"className\":\"text-gray-700\",\"children\":\"analytics, error-monitoring, referral, attribution, and advertising-measurement providers;\"}],[\"$\",\"li\",\"5\",{\"className\":\"text-gray-700\",\"children\":\"email, support, community, search, maps, and media providers when you use the relevant feature;\"}],[\"$\",\"li\",\"6\",{\"className\":\"text-gray-700\",\"children\":\"professional advisors, insurers, auditors, and service providers under appropriate confidentiality obligations;\"}],[\"$\",\"li\",\"7\",{\"className\":\"text-gray-700\",\"children\":\"authorities or other parties when required by law or necessary to protect rights, safety, security, or the Service; and\"}],[\"$\",\"li\",\"8\",{\"className\":\"text-gray-700\",\"children\":\"a successor or acquirer in connection with a merger, financing, acquisition, restructuring, or sale of assets, subject to appropriate protections.\"}]]}],[\"$\",\"p\",null,{\"children\":\"We use service providers that may include AWS, Supabase, Stripe, AI and voice-processing providers, Composio, PostHog, Sentry, Resend, Dub, Google Tag Manager, OpenAI Ads measurement tools, Exa, maps providers, Spotify, Discord, and software-signing or distribution providers. A provider receives information only when it is needed for the relevant feature, transaction, or operational function.\"}]]}]]}]\nb:[\"$\",\"section\",null,{\"className\":\"mb-12\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"section-title text-3xl font-bold text-gray-900 mb-4\",\"children\":[\"7. \",\"Website Analytics, Advertising, and Referrals\"]}],[\"$\",\"div\",null,{\"className\":\"prose prose-lg text-gray-700 space-y-4\",\"children\":[[\"$\",\"p\",null,{\"children\":\"VoiceOS uses PostHog, Sentry, Dub, Google Tag Manager, OpenAI Ads measurement tools, UTM parameters, and similar technologies to operate the website, understand product use, measure campaigns, attribute referrals, and diagnose errors.\"}],[\"$\",\"p\",null,{\"children\":\"VoiceOS does not use PostHog session replay and does not record screen sessions through PostHog. UTM parameters are used for campaign attribution and do not include your voice, transcript, Agent Mode content, or screen content.\"}],[\"$\",\"p\",null,{\"children\":\"VoiceOS responds to browser Do Not Track and Global Privacy Control signals. You can manage cookies through your browser settings.\"}]]}]]}]\nc:[\"$\",\"section\",null,{\"className\":\"mb-12\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"section-title text-3xl font-bold text-gray-900 mb-4\",\"children\":[\"8. \",\"Team and Enterprise Plans\"]}],[\"$\",\"div\",null,{\"className\":\"prose prose-lg text-gray-700 space-y-4\",\"children\":[[\"$\",\"p\",null,{\"children\":\"If you use VoiceOS through a Team or Enterprise plan, organization administrators may manage seats and billing. Administrators can access shared dictionaries, replacements, shared Memories, and integrations made available to the organization. Administrators do not receive access to your individual activity or aggregate usage through the ordinary Team or Enterprise administrative surfaces.\"}],[\"$\",\"p\",null,{\"children\":\"Enterprise customers may request a separate Enterprise Agreement or Data Processing Agreement. If WakoAI Inc. and an Enterprise customer sign one, its privacy and data-handling terms may supplement this policy and control to the extent of a conflict.\"}]]}]]}]\nd:[\"$\",\"section\",null,{\"className\":\"mb-12\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"section-title text-3xl font-bold text-gray-900 mb-4\",\"children\":[\"9. \",\"Retention and Account Deletion\"]}],[\"$\",\"div\",null,{\"className\":\"prose prose-lg text-gray-700 space-y-4\",\"children\":[[\"$\",\"p\",null,{\"children\":\"VoiceOS retains personal information for as long as necessary to provide the Service and fulfill the purposes described in this policy, unless a longer period is required or permitted by law.\"}],[\"$\",\"p\",null,{\"children\":\"When you delete your account, VoiceOS deletes account-linked stored data, including applicable Memories, knowledge entries, dictionary entries, replacements, writing styles, Team-shared data associated with your account, and account-linked logs, within 40 days. This does not require VoiceOS to delete deidentified or aggregated numerical statistics, such as total request counts or total subscription counts, that no longer identify you.\"}],[\"$\",\"p\",null,{\"children\":\"The Help Improve VoiceOS rules in Section 4 apply separately to raw audio and transcripts collected while that setting is on. In particular, turning off the setting does not delete information previously collected under the setting.\"}]]}]]}]\ne:[\"$\",\"section\",null,{\"className\":\"mb-12\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"section-title text-3xl font-bold text-gray-900 mb-4\",\"children\":[\"10. \",\"Data Deletion Procedure\"]}],[\"$\",\"div\",null,{\"className\":\"prose prose-lg text-gray-700 space-y-4\",\"children\":[[\"$\",\"p\",null,{\"children\":\"You may request deletion of your personal information at any time by:\"}],[\"$\",\"ul\",null,{\"className\":\"list-disc space-y-3 ml-6 marker:text-gray-400\",\"children\":[[\"$\",\"li\",\"0\",{\"className\":\"text-gray-700\",\"children\":[[\"$\",\"strong\",null,{\"children\":\"Deleting your account\"}],\" through Settings in VoiceOS, which triggers automatic deletion of account-linked data as described in Section 9; or\"]}],[\"$\",\"li\",\"1\",{\"className\":\"text-gray-700\",\"children\":[[\"$\",\"strong\",null,{\"children\":\"Submitting a deletion request\"}],\" by emailing \",[\"$\",\"a\",null,{\"href\":\"mailto:support@voiceos.com\",\"className\":\"text-voiceos-blue hover:underline font-medium\",\"children\":\"support@voiceos.com\"}],\" with the subject line \\\"Data Deletion Request\\\" and enough information for us to identify your account.\"]}]]}],[\"$\",\"p\",null,{\"children\":\"Upon receiving a verified deletion request, WakoAI Inc. will:\"}],[\"$\",\"ol\",null,{\"className\":\"list-decimal space-y-3 ml-6 marker:text-gray-400\",\"children\":[[\"$\",\"li\",\"0\",{\"className\":\"text-gray-700\",\"children\":[\"Delete your account-linked stored data, including Memories, knowledge entries, dictionary entries, replacements, writing styles, transcripts, and session data, within \",[\"$\",\"strong\",null,{\"children\":\"40 days\"}],\".\"]}],[\"$\",\"li\",\"1\",{\"className\":\"text-gray-700\",\"children\":[\"Delete associated audio recordings stored in our file storage systems within\",\" \",[\"$\",\"strong\",null,{\"children\":\"40 days\"}],\".\"]}],[\"$\",\"li\",\"2\",{\"className\":\"text-gray-700\",\"children\":\"Cancel any active subscription and remove payment method references from our systems (payment history retained by our payment processor as required by financial regulations).\"}],[\"$\",\"li\",\"3\",{\"className\":\"text-gray-700\",\"children\":\"Remove your data from active analytics systems. Deidentified or aggregated statistics that no longer identify you may be retained.\"}],[\"$\",\"li\",\"4\",{\"className\":\"text-gray-700\",\"children\":\"Retain a minimal record (email address and deletion timestamp) solely for fraud prevention and trial-abuse detection, as disclosed in Section 9.\"}]]}],[\"$\",\"p\",null,{\"children\":\"We will confirm completion of the deletion by email. If we cannot fulfill a request due to a legal obligation or legitimate exception, we will inform you of the reason and the specific data retained.\"}],[\"$\",\"p\",null,{\"children\":\"The Help Improve VoiceOS rules in Section 4 apply separately. Content collected while that setting was on is not deleted by account deletion or a deletion request, as described in Section 4.3.\"}]]}]]}]\nf:[\"$\",\"section\",null,{\"className\":\"mb-12\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"section-title text-3xl font-bold text-gray-900 mb-4\",\"children\":[\"11. \",\"Security\"]}],[\"$\",\"div\",null,{\"className\":\"prose prose-lg text-gray-700 space-y-4\",\"children\":[\"$\",\"p\",null,{\"children\":\"VoiceOS uses reasonable administrative, technical, and organizational safeguards designed to protect personal information. No system is perfectly secure, and we cannot guarantee absolute security.\"}]}]]}]\n10:[\"$\",\"section\",null,{\"className\":\"mb-12\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"section-title text-3xl font-bold text-gray-900 mb-4\",\"children\":[\"12. \",\"Your Choices and Privacy Requests\"]}],[\"$\",\"div\",null,{\"className\":\"prose prose-lg text-gray-700 space-y-4\",\"children\":[[\"$\",\"p\",null,{\"children\":\"You may:\"}],[\"$\",\"ul\",null,{\"className\":\"list-disc space-y-3 ml-6 marker:text-gray-400\",\"children\":[[\"$\",\"li\",\"0\",{\"className\":\"text-gray-700\",\"children\":\"turn Help Improve VoiceOS on or off;\"}],[\"$\",\"li\",\"1\",{\"className\":\"text-gray-700\",\"children\":\"delete account-linked data by closing your account;\"}],[\"$\",\"li\",\"2\",{\"className\":\"text-gray-700\",\"children\":\"manage or disconnect connected services;\"}],[\"$\",\"li\",\"3\",{\"className\":\"text-gray-700\",\"children\":\"remove custom MCP servers;\"}],[\"$\",\"li\",\"4\",{\"className\":\"text-gray-700\",\"children\":\"manage Memories, knowledge entries, dictionaries, replacements, writing styles, and shared resources available to you;\"}],[\"$\",\"li\",\"5\",{\"className\":\"text-gray-700\",\"children\":\"use browser controls to manage cookies and similar technologies; and\"}],[\"$\",\"li\",\"6\",{\"className\":\"text-gray-700\",\"children\":\"contact support to request access to, correction of, or deletion of personal information, subject to applicable law and verification.\"}]]}],[\"$\",\"p\",null,{\"children\":[\"To make a privacy request, contact \",[\"$\",\"a\",null,{\"href\":\"mailto:support@voiceos.com\",\"className\":\"text-voiceos-blue hover:underline font-medium\",\"children\":\"support@voiceos.com\"}],\" and include enough information for us to identify your account and process the request.\"]}]]}]]}]\n11:[\"$\",\"section\",null,{\"className\":\"mb-12\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"section-title text-3xl font-bold text-gray-900 mb-4\",\"children\":[\"13. \",\"Children and Eligibility\"]}],[\"$\",\"div\",null,{\"className\":\"prose prose-lg text-gray-700 space-y-4\",\"children\":[\"$\",\"p\",null,{\"children\":[\"VoiceOS is not directed to children under 13. You must be at least 13 years old to use the Service, or older if the law where you live requires a higher minimum age, such as 16 in certain regions. If you believe a child has provided personal information to VoiceOS in violation of this policy, contact us at \",[\"$\",\"a\",null,{\"href\":\"mailto:support@voiceos.com\",\"className\":\"text-voiceos-blue hover:underline font-medium\",\"children\":\"support@voiceos.com\"}],\".\"]}]}]]}]\n12:[\"$\",\"section\",null,{\"className\":\"mb-12\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"section-title text-3xl font-bold text-gray-900 mb-4\",\"children\":[\"14. \",\"Changes to This Policy\"]}],[\"$\",\"div\",null,{\"className\":\"prose prose-lg text-gray-700 space-y-4\",\"children\":[\"$\",\"p\",null,{\"children\":\"We may update this Privacy Policy from time to time. When we make a material change, we will update the Last updated date and may provide additional notice through the Service or by email when appropriate.\"}]}]]}]\n13:[\"$\",\"section\",null,{\"className\":\"mb-12\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"section-title text-3xl font-bold text-gray-900 mb-4\",\"children\":[\"15. \",\"Contact Us\"]}],[\"$\",\"div\",null,{\"className\":\"prose prose-lg text-gray-700 space-y-4\",\"children\":[[\"$\",\"p\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"WakoAI Inc.\"}],[\"$\",\"br\",null,{}],\"35 Buckelew Street\",[\"$\",\"br\",null,{}],\"Sausalito, California 94965\",[\"$\",\"br\",null,{}],\"United States\"]}],[\"$\",\"p\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Support and privacy requests:\"}],\" \",[\"$\",\"a\",null,{\"href\":\"mailto:support@voiceos.com\",\"className\":\"text-voiceos-blue hover:underline font-medium\",\"children\":\"support@voiceos.com\"}]]}]]}]]}]\n14:[\"$\",\"$L25\",null,{}]\n15:[\"$\",\"script\",\"script-0\",{\"src\":\"/_next/static/chunks/0z6qqa_pcb2c9.js\",\"async\":true,\"nonce\":\"$undefined\"}]\n16:[\"$\",\"script\",\"script-1\",{\"src\":\"/_next/static/chunks/35rx1_qn9m74v.js\",\"async\":true,\"nonce\":\"$undefined\"}]\n17:[\"$\",\"$L26\",null,{\"children\":[\"$\",\"$27\",null,{\"name\":\"Next.MetadataOutlet\",\"children\":\"$@28\"}]}]\n19:[\"$\",\"$1\",\"h\",{\"children\":[null,[\"$\",\"$L29\",null,{\"children\":\"$L2a\"}],[\"$\",\"div\",null,{\"hidden\":true,\"children\":[\"$\",\"$L2b\",null,{\"children\":[\"$\",\"$27\",null,{\"name\":\"Next.Metadata\",\"children\":\"$L2c\"}]}]}],[\"$\",\"meta\",null,{\"name\":\"next-size-adjust\",\"content\":\"\"}]]}]\n1b:[\"$\",\"link\",\"0\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/chunks/3n9hqloa8jzmk.css\",\"precedence\":\"next\",\"crossOrigin\":\"$undefined\",\"nonce\":\"$undefined\"}]\n1c:[\"$\",\"link\",\"1\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/chunks/0ik2wv_u5zuv3.css\",\"precedence\":\"next\",\"crossOrigin\":\"$undefined\",\"nonce\":\"$undefined\"}]\n18:C\n1d:[\"$\",\"td\",\"2\",{\"className\":\"px-4 py-3 align-top text-gray-700\",\"children\":\"Perform the task you direct Agent Mode to perform\"}]\n1e:[\"$\",\"td\",\"3\",{\"className\":\"px-4 py-3 align-top text-gray-700\",\"children\":\"VoiceOS retains only limited non-content operational metadata after processing, as described below\"}]\n1f:[\"$\",\"tr\",\"5\",{\"className\":\"border-t border-gray-200\",\"children\":[[\"$\",\"td\",\"0\",{\"className\":\"px-4 py-3 align-top text-gray-700\",\"children\":\"Personalization and configuration data\"}],[\"$\",\"td\",\"1\",{\"className\":\"px-4 py-3 align-top text-gray-700\",\"children\":\"Memories, knowledge entries, dictionary entries, replacements, writing styles, and Team-shared resources\"}],[\"$\",\"td\",\"2\",{\"className\":\"px-4 py-3 align-top text-gray-700\",\"children\":\"Personalize outputs and provide user and Team features\"}],[\"$\",\"td\",\"3\",{\"className\":\"px-4 py-3 align-top text-gray-700\",\"children\":\"Stored on your device and, for some features, on VoiceOS servers. Deleted within 40 days after account deletion, subject to lawful exceptions\"}]]}]\n20:[\"$\",\"tr\",\"6\",{\"className\":\"border-t border-gray-200\",\"children\":[[\"$\",\"td\",\"0\",{\"className\":\"px-4 py-3 align-top text-gray-700\",\"children\":\"Integration information\"}],[\"$\",\"td\",\"1\",{\"className\":\"px-4 py-3 align-top text-gray-700\",\"children\":\"Integration permissions, encrypted connection tokens, and user-authorized requests\"}],[\"$\",\"td\",\"2\",{\"className\":\"px-4 py-3 align-top text-gray-700\",\"children\":\"Connect services you choose and perform actions you request\"}],[\"$\",\"td\",\"3\",{\"className\":\"px-4 py-3 align-top text-gray-700\",\"children\":\"Retained only as needed to maintain the active connection and provide the requested feature, then handled under Section 9\"}]]}]\n21:[\"$\",\"tr\",\"7\",{\"className\":\"border-t border-gray-200\",\"children\":[[\"$\",\"td\",\"0\",{\"className\":\"px-4 py-3 align-top text-gray-700\",\"children\":\"Operational and security data\"}],[\"$\",\"td\",\"1\",{\"className\":\"px-4 py-3 align-top text-gray-700\",\"children\":\"Request counts, output counts, request type, error indicators, security logs, crash reports, diagnostics, device or app version, and consent records\"}],[\"$\",\"td\",\"2\",{\"className\":\"px-4 py-3 align-top text-gray-700\",\"children\":\"Operate, measure, secure, troubleshoot, and improve Service reliability\"}],[\"$\",\"td\",\"3\",{\"className\":\"px-4 py-3 align-top text-gray-700\",\"children\":\"Account-linked logs and similar records are deleted within 40 days after account deletion. Deidentified or aggregated numerical statistics may be retained indefinitely\"}]]}]\n22:[\"$\",\"tr\",\"8\",{\"className\":\"border-t border-gray-200\",\"children\":[[\"$\",\"td\",\"0\",{\"className\":\"px-4 py-3 align-top text-gray-700\",\"children\":\"Support and referral data\"}],[\"$\",\"td\",\"1\",{\"className\":\"px-4 py-3 align-top text-gray-700\",\"children\":\"Support messages or attachments you submit, referral code, referral count, reward-calculation information, and referral attribution information\"}],[\"$\",\"td\",\"2\",{\"className\":\"px-4 py-3 align-top text-gray-700\",\"children\":\"Respond to support requests and administer referral or affiliate programs\"}],[\"$\",\"td\",\"3\",{\"className\":\"px-4 py-3 align-top text-gray-700\",\"children\":\"Retained as needed for the support or referral purpose, then deleted with account-linked data as described in Section 9 unless a lawful exception applies\"}]]}]\n23:[\"$\",\"tr\",\"9\",{\"className\":\"border-t border-gray-200\",\"children\":[[\"$\",\"td\",\"0\",{\"className\":\"px-4 py-3 align-top text-gray-700\",\"children\":\"Website and campaign information\"}],[\"$\",\"td\",\"1\",{\"className\":\"px-4 py-3 align-top text-gray-700\",\"children\":\"Cookie or device identifiers, browser information, campaign and referral parameters, UTM parameters, and conversion events\"}],[\"$\",\"td\",\"2\",{\"className\":\"px-4 py-3 align-top text-gray-700\",\"children\":\"Operate the website, measure campaigns, attribute referrals, and understand product usage\"}],[\"$\",\"td\",\"3\",{\"className\":\"px-4 py-3 align-top text-gray-700\",\"children\":\"Retained under the applicable provider settings and our operational retention practices\"}]]}]\n24:[\"$\",\"div\",null,{\"className\":\"md:hidden space-y-4\",\"children\":[[\"$\",\"div\",\"0\",{\"className\":\"rounded-2xl border border-gray-200 bg-white p-5 shadow-sm\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-bold text-gray-900 mb-3\",\"children\":\"Account and profile information\"}],[\"$\",\"dl\",null,{\"className\":\"space-y-3 text-sm\",\"children\":[[\"$\",\"div\",\"0\",{\"children\":[[\"$\",\"dt\",null,{\"className\":\"font-medium text-gray-500\",\"children\":\"Examples\"}],[\"$\",\"dd\",null,{\"className\":\"text-gray-700\",\"children\":\"Name, email address, account ID, login information, settings\"}]]}],[\"$\",\"div\",\"1\",{\"children\":[[\"$\",\"dt\",null,{\"className\":\"font-medium text-gray-500\",\"children\":\"Why We Use It\"}],[\"$\",\"dd\",null,{\"className\":\"text-gray-700\",\"children\":\"Create and secure your account, provide the Service, communicate with you, prevent fraud, and provide support\"}]]}],[\"$\",\"div\",\"2\",{\"children\":[[\"$\",\"dt\",null,{\"className\":\"font-medium text-gray-500\",\"children\":\"Retention Approach\"}],[\"$\",\"dd\",null,{\"className\":\"text-gray-700\",\"children\":\"Retained while your account is active and deleted as described in Section 9 after account deletion, subject to lawful exceptions\"}]]}]]}]]}],[\"$\",\"div\",\"1\",{\"className\":\"rounded-2xl border border-gray-200 bg-white p-5 shadow-sm\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-bold text-gray-900 mb-3\",\"children\":\"Subscription information\"}],[\"$\",\"dl\",null,{\"className\":\"space-y-3 text-sm\",\"children\":[[\"$\",\"div\",\"0\",{\"children\":[[\"$\",\"dt\",null,{\"className\":\"font-medium text-gray-500\",\"children\":\"Examples\"}],[\"$\",\"dd\",null,{\"className\":\"text-gray-700\",\"children\":\"Plan selection, subscription status, renewal date, billing events, receipts, and transaction status\"}]]}],[\"$\",\"div\",\"1\",{\"children\":[[\"$\",\"dt\",null,{\"className\":\"font-medium text-gray-500\",\"children\":\"Why We Use It\"}],[\"$\",\"dd\",null,{\"className\":\"text-gray-700\",\"children\":\"Provide paid features, administer trials and subscriptions, respond to billing requests, and prevent fraud\"}]]}],[\"$\",\"div\",\"2\",{\"children\":[[\"$\",\"dt\",null,{\"className\":\"font-medium text-gray-500\",\"children\":\"Retention Approach\"}],[\"$\",\"dd\",null,{\"className\":\"text-gray-700\",\"children\":\"Account-linked records are deleted as described in Section 9, except for aggregate numerical records and any records we must retain by law\"}]]}]]}]]}],[\"$\",\"div\",\"2\",{\"className\":\"rounded-2xl border border-gray-200 bg-white p-5 shadow-sm\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-bold text-gray-900