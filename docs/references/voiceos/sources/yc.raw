quot;,&quot;name&quot;:&quot;VoiceOS&quot;,&quot;batch&quot;:&quot;P25&quot;,&quot;batch_name&quot;:&quot;Spring 2025&quot;,&quot;small_logo_url&quot;:&quot;https://bookface-images.s3.amazonaws.com/small_logos/1b1aed7099a4bf552ddb400d14fc642d3157809c.png&quot;,&quot;one_liner&quot;:&quot;Say it and it&#x27;s done. Voice is the new OS&quot;,&quot;website&quot;:&quot;https://voiceos.com&quot;,&quot;long_description&quot;:&quot;VoiceOS turns voice into a seamless, universal interface to 10x productivity — a true voice operating system for the next era of computing.\r\n\r\nIt works across any app, letting users speak naturally to dictate, edit, and write text instantly. Whether writing an email, revising a document, or grasping complex information, VoiceOS transforms voice into the most powerful productivity tool, bridging the gap between thought and expression.&quot;,&quot;tags&quot;:[],&quot;ycdc_status&quot;:&quot;Active&quot;,&quot;logo_url&quot;:&quot;https://bookface-images.s3.us-west-2.amazonaws.com/logos/accf6012a695ca19158b47ee03a88ff3e18d3408.png?X-Amz-Algorithm=REDACTED&amp;X-Amz-Credential=REDACTED&amp;X-Amz-Date=REDACTED&amp;X-Amz-Expires=REDACTED&amp;X-Amz-Security-Token=REDACTED&amp;X-Amz-SignedHeaders=REDACTED&amp;X-Amz-Signature=REDACTED&quot;,&quot;year_founded&quot;:2023,&quot;team_size&quot;:2,&quot;location&quot;:&quot;San Francisco&quot;,&quot;city&quot;:&quot;San Francisco&quot;,&quot;city_tag&quot;:&quot;san-francisco-bay-area&quot;,&quot;country&quot;:&quot;US&quot;,&quot;linkedin_url&quot;:&quot;https://www.linkedin.com/company/wako-ai&quot;,&quot;twitter_url&quot;:&quot;https://x.com/VoiceOSApp&quot;,&quot;fb_url&quot;:&quot;&quot;,&quot;cb_url&quot;:&quot;&quot;,&quot;github_url&quot;:&quot;&quot;,&quot;free_response_question_answers&quot;:[],&quot;dday_video_url&quot;:null,&quot;app_video_url&quot;:null,&quot;app_answers&quot;:[],&quot;ycdc_url&quot;:&quot;https://www.ycombinator.com/companies/voiceos&quot;,&quot;company_photos&quot;:[],&quot;primary_group_partner&quot;:{&quot;id&quot;:11216,&quot;full_name&quot;:&quot;David Lieb&quot;,&quot;avatar_thumb_url&quot;:&quot;https://bookface-images.s3.us-west-2.amazonaws.com/avatars/6e415a060218fc99589322800cec5173b48ce926.jpg?X-Amz-Algorithm=REDACTED&amp;X-Amz-Credential=REDACTED&amp;X-Amz-Date=REDACTED&amp;X-Amz-Expires=REDACTED&amp;X-Amz-Security-Token=REDACTED&amp;X-Amz-SignedHeaders=REDACTED&amp;X-Amz-Signature=REDACTED&quot;,&quot;url&quot;:&quot;https://www.ycombinator.com/people/david-lieb&quot;},&quot;founders&quot;:[{&quot;user_id&quot;:1521900,&quot;is_active&quot;:true,&quot;founder_bio&quot;:&quot;Spent the last 7 years building voice AI products. Now building a voice operating system designed for a world where AGI isn’t science fiction but a roadmap.&quot;,&quot;full_name&quot;:&quot;Jonah Daian&quot;,&quot;title&quot;:&quot;Founder/CEO&quot;,&quot;avatar_thumb_url&quot;:&quot;https://bookface-images.s3.us-west-2.amazonaws.com/avatars/90727c28d0b9a90a83ccf08a174fe5b25270d371.jpg?X-Amz-Algorithm=REDACTED&amp;X-Amz-Credential=REDACTED&amp;X-Amz-Date=REDACTED&amp;X-Amz-Expires=REDACTED&amp;X-Amz-Security-Token=REDACTED&amp;X-Amz-SignedHeaders=REDACTED&amp;X-Amz-Signature=REDACTED&quot;,&quot;twitter_url&quot;:&quot;https://x.com/jonah_daian&quot;,&quot;linkedin_url&quot;:&quot;https://www.linkedin.com/in/jonah-daian&quot;,&quot;has_email&quot;:true,&quot;latest_yc_company&quot;:{&quot;name&quot;:&quot;VoiceOS&quot;,&quot;href&quot;:&quot;https://www.ycombinator.com/companies/voiceos&quot;}},{&quot;user_id&quot;:1532285,&quot;is_active&quot;:true,&quot;founder_bio&quot;:&quot;Born in Tokyo moved to the U.S. at 15 to dive into the tech scene. Building cool stuff in the voice AI space.&quot;,&quot;full_name&quot;:&quot;Kai Brokering&quot;,&quot;title&quot;:&quot;Founder&quot;,&quot;avatar_thumb_url&quot;:&quot;https://bookface-images.s3.us-west-2.amazonaws.com/avatars/6d29997e5dca07682a88b7572c8bb04f300144ae.jpg?X-Amz-Algorithm=REDACTED&amp;X-Amz-Credential=REDACTED&amp;X-Amz-Date=REDACTED&amp;X-Amz-Expires=REDACTED&amp;X-Amz-Security-Token=REDACTED&amp;X-Amz-SignedHeaders=REDACTED&amp;X-Amz-Signature=REDACTED&quot;,&quot;twitter_url&quot;:&quot;https://x.com/kai_brokering&quot;,&quot;linkedin_url&quot;:&quot;https://linkedin.com/in/francis-brokering&quot;,&quot;has_email&quot;:true,&quot;latest_yc_company&quot;:{&quot;name&quot;:&quot;VoiceOS&quot;,&quot;href&quot;:&quot;https://www.ycombinator.com/companies/voiceos&quot;}}]},&quot;jobPostings&quot;:[{&quot;id&quot;:98609,&quot;title&quot;:&quot;Part-Time Videographer &amp; Video Editor&quot;,&quot;url&quot;:&quot;/companies/voiceos/jobs/AGmOz5S-part-time-videographer-video-editor&quot;,&quot;applyUrl&quot;:&quot;https://account.ycombinator.com/authenticate?continue=https%3A%2F%2Fwww.workatastartup.com%2Fapplication%3Fsignup_job_id%3D98609&amp;defaults%5BsignUpActive%5D=true&amp;defaults%5Bwaas_company%5D=30460&quot;,&quot;location&quot;:&quot;San Francisco, CA, US&quot;,&quot;askUs&quot;:true,&quot;type&quot;:&quot;Contract&quot;,&quot;role&quot;:&quot;marketing&quot;,&quot;roleSpecificType&quot;:null,&quot;prettyRole&quot;:&quot;Marketing&quot;,&quot;salaryRange&quot;:&quot;$35 - $40 / hourly&quot;,&quot;equityRange&quot;:&quot;&quot;,&quot;minExperience&quot;:&quot;Any (new grads ok)&quot;,&quot;minSchoolYear&quot;:null,&quot;visa&quot;:&quot;US citizen/visa only&quot;,&quot;skills&quot;:[],&quot;isIncomplete&quot;:false,&quot;companyUrl&quot;:&quot;/companies/voiceos&quot;,&quot;companyLogoUrl&quot;:&quot;https://bookface-images.s3.amazonaws.com/small_logos/1b1aed7099a4bf552ddb400d14fc642d3157809c.png&quot;,&quot;companyName&quot;:&quot;VoiceOS&quot;,&quot;companyBatchName&quot;:&quot;P25&quot;,&quot;companyOneLiner&quot;:&quot;Say it and it&#x27;s done. Voice is the new OS&quot;,&quot;hiringManager&quot;:null,&quot;createdAt&quot;:&quot;3 months&quot;,&quot;lastActive&quot;:&quot;about 1 month&quot;}],&quot;jobsUrl&quot;:&quot;https://bookface.ycombinator.com/workatastartup&quot;,&quot;newsItems&quot;:[],&quot;newsUrl&quot;:&quot;https://bookface.ycombinator.com/company/30460/company_news&quot;,&quot;videos&quot;:[],&quot;launches&quot;:[{&quot;id&quot;:97653,&quot;title&quot;:&quot;VoiceOS: The Siri for Productivity&quot;,&quot;body&quot;:&quot;Launch video: &lt;https://youtu.be/QaVzPkH8JA0&gt;\n\n## **The problem:** Typing sucks\n\nMost people use their keyboard **hundreds of times a day** and the costs adds up:\n\n* **Mental overhead** turning thoughts into words\n* Spending time **correcting** **your** **typos**\n* **Lost momentum** when context-switching\n\n![uploaded image](/media/?type=post&amp;id=97653&amp;key=user_uploads/1521900/9d0e1af6-686c-4738-959b-17b2155c6d88)\n\n## **The solution:** Voice as the new **OS**\n\nVoiceOS is a universal voice interface that converts **thoughts → polished output** instantly.\n\n* **Reply instantly:** _“Ask to reschedule for tomorrow”_ → replied instantly\n* **Better prompting:** Turn thoughts into perfect prompts effortlessly\n* **Works everywhere:** Works with any app with zero setup required\n\n![uploaded image](/media/?type=post&amp;id=97653&amp;key=user_uploads/1521900/f3639813-a12c-4f6f-9c88-c61b7429ae76)\n\n## **The team: Voice AI Pioneers**\n\nKai, on the left, with Jonah on the right. Over the **past 7 years** they’ve built voice AI solutions, from consumer products to Fortune 500 deployments. They are now building a **voice operating system** built for a **world where** **AGI** is no longer science fiction but an emerging roadmap.\n\n![uploaded image](/media/?type=post&amp;id=97653&amp;key=user_uploads/1521900/98299fdf-31e1-4bc5-b7ce-f9a6633ab874)\n\n## **Our ask**\n\nTry it out for free! &lt;https://voiceos.com&gt;\n\nUse discount code **YCLAUNCH**\n\n— Kai &amp; Jonah&quot;,&quot;state&quot;:&quot;public&quot;,&quot;tagline&quot;:&quot;VoiceOS is on a mission to turn your voice into 10X productivity across every app&quot;,&quot;created_at&quot;:&quot;2026-02-09T15:41:58.199Z&quot;,&quot;company&quot;:{&quot;id&quot;:30460,&quot;name&quot;:&quot;VoiceOS&quot;,&quot;logo&quot;:&quot;https://bookface-images.s3.amazonaws.com/small_logos/1b1aed7099a4bf552ddb400d14fc642d3157809c.png&quot;,&quot;batch&quot;:&quot;p2025&quot;,&quot;tags&quot;:[],&quot;url&quot;:&quot;https://voiceos.com&quot;,&quot;slug&quot;:&quot;voiceos&quot;,&quot;description&quot;:&quot;Say it and it&#x27;s done. Voice is the new OS&quot;},&quot;user&quot;:{&quot;name&quot;:&quot;Jonah Daian&quot;,&quot;avatar&quot;:&quot;https://bookface-images.s3.amazonaws.com/avatars/90727c28d0b9a90a83ccf08a174fe5b25270d371.jpg&quot;},&quot;total_vote_count&quot;:80,&quot;slug&quot;:&quot;PP3-voiceos-the-siri-for-productivity&quot;,&quot;launch_embed_url&quot;:&quot;https://www.ycombinator.com/launches/PP3-voiceos-the-siri-for-productivity/upvote_embed.svg&quot;,&quot;twitter_share_url&quot;:&quot;https://twitter.com/intent/tweet?text=VoiceOS+just+launched+on+%40ycombinator%27s+Launch+YC%21%0A%0AVoiceOS%3A+The+Siri+for+Productivity.+Check+them+out%3A&amp;url=https%3A%2F%2Fwww.ycombinator.com%2Flaunches%2FPP3-voiceos-the-siri-for-productivity&quot;,&quot;sanitized_title&quot;:&quot;VoiceOS: The Siri for Productivity&quot;,&quot;ycdc_launch_url&quot;:&quot;https://www.ycombinator.com/launches/PP3-voiceos-the-siri-for-productivity&quot;,&quot;url&quot;:&quot;https://www.ycombinator.com/launches/PP3-voiceos-the-siri-for-productivity&quot;,&quot;share_config&quot;:{},&quot;share_image&quot;:null,&quot;approved_at&quot;:null,&quot;approved_by&quot;:null,&quot;requested_publish_at&quot;:&quot;2026-02-10T16:00:00Z&quot;}],&quot;editUrl&quot;:&quot;https://bookface.ycombinator.com/company/30460/edit&quot;,&quot;editUserUrl&quot;:&quot;https://bookface.ycombinator.com/edit_user_profile&quot;,&quot;createProfileUrl&quot;:&quot;https://account.ycombinator.com/authenticate?continue=https%3A%2F%2Fwww.workatastartup.com%2Fapplication&amp;defaults%5BsignUpActive%5D=true&quot;,&quot;sign