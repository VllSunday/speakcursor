import { AboutSlint, Button, CheckBox, ComboBox, LineEdit, ListView, TextEdit } from "std-widgets.slint";

export component AssistantPanel inherits Window {
    width: 440px;
    height: 252px;
    background: transparent;
    no-frame: true;
    always-on-top: true;
    title: "SpeakCursor — ответ";

    in-out property <string> answer-text: "";
    in-out property <string> panel-title: "SpeakCursor";
    in-out property <string> panel-footer: "";
    in-out property <int> error-page: -1;
    in-out property <int> generation: 0;
    callback close-requested();
    callback open-error-settings();

    Rectangle {
        x: 14px;
        y: 14px;
        width: 412px;
        height: 224px;
        background: #202227;
        border-radius: 20px;
        drop-shadow-blur: 18px;
        drop-shadow-offset-y: 5px;
        drop-shadow-color: #00000055;

        Rectangle {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: 38px;
            background: #34363b;
            border-radius: 20px;
        }
        Rectangle {
            x: 0px;
            y: 20px;
            width: parent.width;
            height: 18px;
            background: #34363b;
        }
        Rectangle {
            x: 16px;
            y: 15px;
            width: 8px;
            height: 8px;
            border-radius: 4px;
            background: #78b8ff;
        }
        Text {
            x: 32px;
            y: 10px;
            width: 318px;
            height: 20px;
            text: "SpeakCursor · ассистент";
            font-size: 13px;
            font-weight: 600;
            color: #f1f3f7;
        }
        Text {
            x: 370px;
            y: 9px;
            width: 24px;
            height: 20px;
            text: "×";
            font-size: 19px;
            horizontal-alignment: center;
            color: #c0c4cc;
        }
        TouchArea {
            x: 364px;
            y: 4px;
            width: 40px;
            height: 30px;
            clicked => { root.close-requested(); }
        }
        Text {
            x: 18px;
            y: 54px;
            width: 376px;
            height: 20px;
            text: root.panel-title;
            font-size: 13px;
            font-weight: 600;
            color: #d6d9e0;
        }
        Text {
            x: 18px;
            y: 82px;
            width: 374px;
            height: 83px;
            text: root.answer-text;
            wrap: word-wrap;
            font-size: 15px;
            color: #f5f6f8;
        }
        Rectangle {
            x: 18px;
            y: 180px;
            width: 376px;
            height: 1px;
            background: #45474d;
        }
        Text {
            x: 18px;
            y: 190px;
            width: 376px;
            height: 20px;
            text: root.panel-footer;
            font-size: 11px;
            color: #a3a9b4;
        }
        if root.error-page >= 0: TouchArea {
            x: 0px; y: 38px; width: parent.width; height: parent.height - 38px;
            clicked => { root.open-error-settings(); }
        }
    }
}

export component RecordingPill inherits Window {
    width: 264px;
    height: 80px;
    background: transparent;
    no-frame: true;
    always-on-top: true;
    title: "SpeakCursor — запись";

    in-out property <int> activity: 0;
    in-out property <int> generation: 0;
    in-out property <bool> recording: false;
    in-out property <string> status-text: "Готово";

    Rectangle {
        x: 12px;
        y: 12px;
        width: 240px;
        height: 56px;
        background: #17191e;
        border-radius: 28px;
        drop-shadow-blur: 14px;
        drop-shadow-offset-y: 4px;
        drop-shadow-color: #00000055;

        Rectangle {
            x: 16px;
            y: 17px;
            width: 22px;
            height: 22px;
            border-radius: 11px;
            background: #357fee;
        }
        Text {
            x: 17px;
            y: 17px;
            width: 20px;
            height: 22px;
            text: root.recording ? "●" : "○";
            font-size: 10px;
            horizontal-alignment: center;
            vertical-alignment: center;
            color: white;
        }
        Text {
            x: 48px;
            y: 16px;
            width: 98px;
            height: 24px;
            text: root.status-text;
            font-size: 14px;
            font-weight: 600;
            color: #f5f6f8;
        }
        Rectangle {
            x: 147px;
            y: 23px - root.activity * 1px;
            width: 4px;
            height: 10px + root.activity * 2px;
            border-radius: 2px;
            background: root.recording ? #78b8ff : #59606b;
        }
        Rectangle {
            x: 156px;
            y: 19px + root.activity * 1px;
            width: 4px;
            height: 18px - root.activity * 2px;
            border-radius: 2px;
            background: root.recording ? #78b8ff : #59606b;
        }
        Rectangle {
            x: 165px;
            y: 21px - root.activity * 1px;
            width: 4px;
            height: 14px + root.activity * 2px;
            border-radius: 2px;
            background: root.recording ? #78b8ff : #59606b;
        }
        Text {
            x: 189px;
            y: 16px;
            width: 42px;
            height: 24px;
            text: root.recording ? "Esc" : "";
            font-size: 12px;
            horizontal-alignment: center;
            color: #a3a9b4;
        }
    }
}

export component SettingsPanel inherits Window {
    width: 640px;
    height: 610px;
    title: "SpeakCursor — настройки";
    background: #202227;

    in-out property <int> page: 0;
    in-out property <bool> use-cloud: false;
    in-out property <string> compute-choice: "CPU";
    in-out property <bool> launch-at-login: true;
    in-out property <string> local-model-path: "";
    in-out property <string> api-key-input: "";
    in-out property <string> language-code: "auto";
    in-out property <string> asr-model: "";
    in-out property <string> processing-model: "";
    in-out property <string> prompt-model: "";
    in-out property <string> default-style-name: "Без обработки";
    in-out property <string> custom-prompt: "";
    in-out property <string> dictionary-rules: "";
    in-out property <string> general-shortcut: "Ctrl+Alt+F8";
    in-out property <string> raw-shortcut: "";
    in-out property <string> proofread-shortcut: "";
    in-out property <string> structure-shortcut: "";
    in-out property <string> custom-shortcut: "";
    in-out property <string> prompt-shortcut: "Ctrl+Alt+F9";
    in-out property <string> unload-minutes: "";
    in-out property <bool> keep-history-forever: false;
    in-out property <string> feedback-text: "";
    callback save-requested();
    callback delete-key-requested();
    callback open-history();
    callback choose-model-folder();

    Text {
        x: 24px; y: 16px; width: 590px; height: 30px;
        text: "Настройки диктовки";
        color: white; font-size: 23px; font-weight: 700;
    }
    Button { x: 24px; y: 55px; width: 140px; text: "Распознавание"; clicked => { root.page = 0; } }
    Button { x: 168px; y: 55px; width: 120px; text: "Стили"; clicked => { root.page = 1; } }
    Button { x: 292px; y: 55px; width: 140px; text: "Сочетания"; clicked => { root.page = 2; } }
    Button { x: 436px; y: 55px; width: 160px; text: "Приложение"; clicked => { root.page = 3; } }

    if root.page == 0: Rectangle {
        x: 24px; y: 105px; width: 590px; height: 400px;
        background: transparent;
        CheckBox { x: 0px; y: 0px; text: "Распознавание через OpenAI вместо локальной модели"; checked <=> root.use-cloud; }
        ComboBox { x: 400px; y: 34px; width: 180px; model: ["CPU", "NVIDIA GPU"]; current-value <=> root.compute-choice; }
        Text { x: 0px; y: 42px; text: "Каталог локальной модели CTranslate2"; color: white; }
        LineEdit { x: 0px; y: 65px; width: 465px; text <=> root.local-model-path; }
        Button { x: 470px; y: 65px; width: 110px; text: "Выбрать"; clicked => { root.choose-model-folder(); } }
        Text { x: 0px; y: 105px; text: "Ключ OpenAI (после сохранения скрыт)"; color: white; }
        LineEdit { x: 0px; y: 128px; width: 450px; text <=> root.api-key-input; input-type: password; }
        Button { x: 460px; y: 128px; width: 120px; text: "Удалить ключ"; clicked => { root.delete-key-requested(); } }
        Text { x: 0px; y: 170px; text: "Язык: auto или код языка"; color: white; }
        LineEdit { x: 0px; y: 192px; width: 160px; text <=> root.language-code; }
        Text { x: 0px; y: 235px; text: "Модель распознавания OpenAI"; color: white; }
        LineEdit { x: 310px; y: 230px; width: 270px; text <=> root.asr-model; }
        Text { x: 0px; y: 278px; text: "Модель обработки текста"; color: white; }
        LineEdit { x: 310px; y: 273px; width: 270px; text <=> root.processing-model; }
        Text { x: 0px; y: 321px; text: "Модель промпт-инженера"; color: white; }
        LineEdit { x: 310px; y: 316px; width: 270px; text <=> root.prompt-model; }
        Text { x: 0px; y: 365px; width: 580px; height: 32px; text: "При сохранении выполняются короткие API-запросы для проверки выбранных моделей."; color: #c4c8d0; wrap: word-wrap; }
    }

    if root.page == 1: Rectangle {
        x: 24px; y: 105px; width: 590px; height: 400px;
        background: transparent;
        Text { x: 0px; y: 0px; text: "Стиль для основного сочетания"; color: white; }
        ComboBox {
            x: 0px; y: 28px; width: 340px;
            model: ["Без обработки", "Пунктуация и ошибки", "ТЗ / README", "Свой стиль"];
            current-value <=> root.default-style-name;
        }
        Text { x: 0px; y: 83px; text: "Промпт своего стиля"; color: white; }
        LineEdit { x: 0px; y: 111px; width: 580px; text <=> root.custom-prompt; }
        Text {
            x: 0px; y: 165px; width: 580px;
            text: "Без обработки работает без LLM. Другие стили используют выбранную модель обработки.";
            color: #c4c8d0; wrap: word-wrap;
        }
        Text { x: 0px; y: 220px; text: "Словарь замен — по одной паре на строку: как услышано = как написать"; color: white; }
        TextEdit { x: 0px; y: 246px; width: 580px; height: 138px; text <=> root.dictionary-rules; }
    }

    if root.page == 2: Rectangle {
        x: 24px; y: 105px; width: 590px; height: 400px;
        background: transparent;
        Text { x: 0px; y: 0px; text: "Основная диктовка"; color: white; }
        LineEdit { x: 310px; y: 0px; width: 270px; text <=> root.general-shortcut; }
        Text { x: 0px; y: 45px; text: "Без обработки"; color: white; }
        LineEdit { x: 310px; y: 45px; width: 270px; text <=> root.raw-shortcut; }
        Text { x: 0px; y: 90px; text: "Пунктуация и ошибки"; color: white; }
        LineEdit { x: 310px; y: 90px; width: 270px; text <=> root.proofread-shortcut; }
        Text { x: 0px; y: 135px; text: "ТЗ / README"; color: white; }
        LineEdit { x: 310px; y: 135px; width: 270px; text <=> root.structure-shortcut; }
        Text { x: 0px; y: 180px; text: "Свой стиль"; color: white; }
        LineEdit { x: 310px; y: 180px; width: 270px; text <=> root.custom-shortcut; }
        Text { x: 0px; y: 225px; text: "Промпт-инженер"; color: white; }
        LineEdit { x: 310px; y: 225px; width: 270px; text <=> root.prompt-shortcut; }
        Text {
            x: 0px; y: 290px; width: 580px;
            text: "Повтор того же сочетания завершает запись. Esc отменяет.";
            color: #c4c8d0;
        }
    }

    if root.page == 3: Rectangle {
        x: 24px; y: 105px; width: 590px; height: 400px;
        background: transparent;
        CheckBox { x: 0px; y: 0px; text: "Запускать при входе в Windows"; checked <=> root.launch-at-login; }
        CheckBox { x: 0px; y: 35px; text: "Не удалять историю автоматически"; checked <=> root.keep-history-forever; }
        Text { x: 0px; y: 80px; text: "Выгружать локальную модель после простоя (минуты)"; color: white; }
        LineEdit { x: 0px; y: 108px; width: 160px; text <=> root.unload-minutes; }
        Text {
            x: 0px; y: 163px; width: 580px;
            text: "Пустое поле оставляет модель загруженной. Настройки сохраняются локально.";
            color: #c4c8d0; wrap: word-wrap;
        }
        Button { x: 0px; y: 230px; width: 190px; text: "Открыть историю"; clicked => { root.open-history(); } }
    }

    Text { x: 24px; y: 517px; width: 430px; height: 42px; text: root.feedback-text; color: #ffcf73; wrap: word-wrap; }
    Button { x: 464px; y: 522px; width: 150px; text: "Сохранить"; clicked => { root.save-requested(); } }
}

export component AboutPanel inherits Window {
    width: 360px;
    height: 220px;
    title: "SpeakCursor — о программе";
    background: white;
    Text { x: 24px; y: 20px; text: "SpeakCursor"; color: #202227; font-size: 24px; font-weight: 700; }
    Text { x: 24px; y: 58px; text: "Голосовая диктовка для Windows"; color: #494f59; }
    AboutSlint { x: 24px; y: 95px; width: 310px; height: 115px; }
}

export struct HistoryRow {
    id: int,
    original: string,
    processed: string,
    failed: bool,
}

export component HistoryPanel inherits Window {
    width: 740px;
    height: 580px;
    title: "SpeakCursor — история";
    background: #202227;
    in-out property <string> search-query: "";
    in-out property <[HistoryRow]> rows: [];
    in-out property <string> feedback-text: "";
    in-out property <bool> clear-armed: false;
    callback search-changed(string);
    callback copy-original(int);
    callback copy-processed(int);
    callback retry(int);
    callback clear-all();

    Text { x: 24px; y: 16px; text: "История диктовки"; font-size: 23px; font-weight: 700; color: white; }
    LineEdit { x: 24px; y: 58px; width: 520px; text <=> root.search-query; edited(text) => { root.search-changed(text); } }
    Button { x: 554px; y: 58px; width: 160px; text: root.clear-armed ? "Подтвердить" : "Очистить всё"; clicked => { root.clear-all(); } }
    Text { x: 24px; y: 108px; text: "Исходная расшифровка"; color: white; font-weight: 600; }
    Text { x: 372px; y: 108px; text: "После обработки"; color: white; font-weight: 600; }
    ListView {
        x: 24px; y: 135px; width: 690px; height: 380px;
        for row in root.rows: Rectangle {
            height: 105px;
            width: parent.width;
            background: #2b2e35;
            border-radius: 10px;
            Text { x: 10px; y: 8px; width: 245px; height: 76px; text: row.original; color: white; wrap: word-wrap; }
            Button { x: 265px; y: 8px; width: 65px; text: "Копия"; clicked => { root.copy-original(row.id); } }
            Text { x: 350px; y: 8px; width: 245px; height: 76px; text: row.processed; color: white; wrap: word-wrap; }
            Button { x: 605px; y: 8px; width: 65px; text: "Копия"; clicked => { root.copy-processed(row.id); } }
            if row.failed: Button { x: 350px; y: 75px; width: 130px; text: "Повторить"; clicked => { root.retry(row.id); } }
        }
    }
    Text { x: 24px; y: 525px; width: 690px; text: root.feedback-text; color: #ffcf73; }
}
