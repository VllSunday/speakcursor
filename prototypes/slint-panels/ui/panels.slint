import { AboutSlint, Button, CheckBox, ComboBox, LineEdit, ListView, ScrollView, TextEdit } from "std-widgets.slint";

export component AssistantPanel inherits Window {
    width: 440px;
    height: 220px;
    background: transparent;
    no-frame: true;
    always-on-top: true;
    title: "SpeakCursor — ответ";

    in-out property <string> answer-text: "";
    in-out property <string> panel-title: "SpeakCursor";
    in-out property <string> panel-footer: "";
    in-out property <int> error-page: -1;
    in-out property <bool> processing-failure: false;
    in-out property <int> generation: 0;
    callback close-requested();
    callback open-error-settings();
    callback retry-processing();
    callback insert-original();

    Rectangle {
        x: 14px;
        y: 14px;
        width: 412px;
        height: 192px;
        background: #202938;
        border-radius: 18px;
        drop-shadow-blur: 18px;
        drop-shadow-offset-y: 5px;
        drop-shadow-color: #00000055;

        Rectangle {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: 38px;
            background: #293a59;
            border-radius: 18px;
        }
        Rectangle {
            x: 0px;
            y: 20px;
            width: parent.width;
            height: 18px;
            background: #293a59;
        }
        Rectangle {
            x: 16px;
            y: 15px;
            width: 8px;
            height: 8px;
            border-radius: 4px;
            background: #78b8ff;
        }
        Text {
            x: 32px;
            y: 10px;
            width: 318px;
            height: 20px;
            text: "SpeakCursor";
            font-size: 13px;
            font-weight: 600;
            color: #f1f3f7;
        }
        Text {
            x: 370px;
            y: 9px;
            width: 24px;
            height: 20px;
            text: "×";
            font-size: 19px;
            horizontal-alignment: center;
            color: #c0c4cc;
        }
        TouchArea {
            x: 364px;
            y: 4px;
            width: 40px;
            height: 30px;
            clicked => { root.close-requested(); }
        }
        Text {
            x: 18px;
            y: 54px;
            width: 376px;
            height: 20px;
            text: root.panel-title;
            font-size: 13px;
            font-weight: 600;
            color: #d6d9e0;
        }
        Text {
            x: 18px;
            y: 78px;
            width: 374px;
            height: 76px;
            text: root.answer-text;
            wrap: word-wrap;
            font-size: 15px;
            color: #f5f6f8;
        }
        Rectangle {
            x: 18px;
            y: 158px;
            width: 376px;
            height: 1px;
            background: #3a4961;
        }
        if !root.processing-failure: Text {
            x: 18px;
            y: 168px;
            width: 376px;
            height: 20px;
            text: root.panel-footer;
            font-size: 11px;
            color: #a3a9b4;
        }
        if root.processing-failure: Button {
            x: 18px; y: 162px; width: 120px; height: 28px;
            text: "Повторить";
            clicked => { root.retry-processing(); }
        }
        if root.processing-failure: Button {
            x: 146px; y: 162px; width: 142px; height: 28px;
            text: "Вставить исходный";
            clicked => { root.insert-original(); }
        }
        if root.processing-failure: Button {
            x: 296px; y: 162px; width: 98px; height: 28px;
            text: "Настройки";
            clicked => { root.open-error-settings(); }
        }
        if root.error-page >= 0 && !root.processing-failure: TouchArea {
            x: 0px; y: 38px; width: parent.width; height: parent.height - 38px;
            clicked => { root.open-error-settings(); }
        }
    }
}

export component RecordingPill inherits Window {
    width: 320px;
    height: 80px;
    background: transparent;
    no-frame: true;
    always-on-top: true;
    title: "SpeakCursor — запись";

    in-out property <int> activity: 0;
    in-out property <int> generation: 0;
    in-out property <bool> recording: false;
    in-out property <bool> screen-mode: false;
    in-out property <string> status-text: "Готово";

    Rectangle {
        x: 12px;
        y: 12px;
        width: 296px;
        height: 56px;
        background: #17191e;
        border-radius: 28px;
        drop-shadow-blur: 14px;
        drop-shadow-offset-y: 4px;
        drop-shadow-color: #00000055;

        Rectangle {
            x: 16px;
            y: 17px;
            width: 22px;
            height: 22px;
            border-radius: 11px;
            background: #357fee;
        }
        Text {
            x: 17px;
            y: 17px;
            width: 20px;
            height: 22px;
            text: root.recording ? "●" : "○";
            font-size: 10px;
            horizontal-alignment: center;
            vertical-alignment: center;
            color: white;
        }
        Text {
            x: 48px;
            y: 16px;
            width: 128px;
            height: 24px;
            text: root.status-text;
            font-size: 14px;
            font-weight: 600;
            color: #f5f6f8;
        }
        if root.screen-mode: Text {
            x: 178px; y: 16px; width: 24px; height: 24px;
            text: "▣"; color: #78b8ff; font-size: 18px;
        }
        Rectangle {
            x: 208px;
            y: 23px - root.activity * 1px;
            width: 4px;
            height: 10px + root.activity * 2px;
            border-radius: 2px;
            background: root.recording ? #78b8ff : #59606b;
        }
        Rectangle {
            x: 218px;
            y: 19px + root.activity * 1px;
            width: 4px;
            height: 18px - root.activity * 2px;
            border-radius: 2px;
            background: root.recording ? #78b8ff : #59606b;
        }
        Rectangle {
            x: 228px;
            y: 21px - root.activity * 1px;
            width: 4px;
            height: 14px + root.activity * 2px;
            border-radius: 2px;
            background: root.recording ? #78b8ff : #59606b;
        }
        Text {
            x: 253px;
            y: 16px;
            width: 42px;
            height: 24px;
            text: root.recording ? "Esc" : "";
            font-size: 12px;
            horizontal-alignment: center;
            color: #a3a9b4;
        }
    }
}

export component ScreenPanel inherits Window {
    width: 580px;
    height: 510px;
    background: transparent;
    no-frame: true;
    always-on-top: true;
    title: "SpeakCursor — экранный запрос";
    in-out property <string> answer-text: "";
    in-out property <string> status-text: "Ответ";
    in-out property <bool> retry-available: false;
    in-out property <int> generation: 0;
    in-out property <[string]> result-links: [];
    callback close-requested();
    callback copy-answer();
    callback retry-request();
    callback open-link(string);
    Rectangle {
        x: 12px; y: 12px; width: 556px; height: 486px;
        background: #202938; border-radius: 18px;
        drop-shadow-blur: 18px; drop-shadow-offset-y: 5px; drop-shadow-color: #00000055;
        Rectangle { x: 0px; y: 0px; width: parent.width; height: 42px; background: #293a59; border-radius: 18px; }
        Rectangle { x: 0px; y: 24px; width: parent.width; height: 18px; background: #293a59; }
        Text { x: 20px; y: 10px; width: 455px; height: 24px; text: "SpeakCursor · " + root.status-text; color: white; font-size: 15px; font-weight: 600; }
        Text { x: 512px; y: 8px; width: 24px; height: 24px; text: "×"; color: white; font-size: 21px; }
        TouchArea { x: 500px; y: 0px; width: 55px; height: 42px; clicked => { root.close-requested(); } }
        Rectangle {
            x: 20px; y: 60px; width: 516px; height: 282px;
            background: #141e2d; border-radius: 11px;
            scroll := ScrollView {
                x: 12px; y: 10px; width: 492px; height: 262px;
                content-width: self.visible-width;
                content-height: max(self.visible-height, answer-content.preferred-height + 8px);
                answer-content := Text {
                    x: 0px; y: 0px; width: scroll.visible-width - 14px;
                    height: self.preferred-height;
                    text: root.answer-text;
                    color: #f1f5fb; font-size: 14px; wrap: word-wrap;
                }
            }
        }
        for link[index] in root.result-links: Rectangle {
            x: 20px; y: 355px + index * 23px;
            width: 516px; height: 22px;
            Text { width: parent.width; height: parent.height; text: link; color: #78b8ff; font-size: 12px; overflow: elide; }
            TouchArea { width: parent.width; height: parent.height; clicked => { root.open-link(link); } }
        }
        Rectangle {
            x: 20px; y: 435px; width: 126px; height: 32px; border-radius: 9px; background: #367ae3;
            Text { width: parent.width; height: parent.height; text: "Копировать"; color: white; font-size: 13px; horizontal-alignment: center; vertical-alignment: center; }
            TouchArea { width: parent.width; height: parent.height; clicked => { root.copy-answer(); } }
        }
        if root.retry-available: Rectangle {
            x: 156px; y: 435px; width: 126px; height: 32px; border-radius: 9px; background: #344966;
            Text { width: parent.width; height: parent.height; text: "Повторить"; color: white; font-size: 13px; horizontal-alignment: center; vertical-alignment: center; }
            TouchArea { width: parent.width; height: parent.height; clicked => { root.retry-request(); } }
        }
    }
}

export component ScreenTrace inherits Window {
    in-out property <length> overlay-width: 100px;
    in-out property <length> overlay-height: 100px;
    in-out property <image> trace-image;
    width: root.overlay-width;
    height: root.overlay-height;
    background: transparent;
    no-frame: true;
    always-on-top: true;
    title: "SpeakCursor — указание";
    Image { width: parent.width; height: parent.height; source: root.trace-image; }
}

export component SettingsPanel inherits Window {
    width: 800px;
    height: 650px;
    title: "SpeakCursor — настройки";
    background: #f3f6fb;

    in-out property <int> page: 0;
    in-out property <bool> use-cloud: false;
    in-out property <string> compute-choice: "CPU";
    in-out property <bool> launch-at-login: true;
    in-out property <string> local-model-path: "";
    in-out property <string> model-status: "Локальная модель не выбрана";
    in-out property <string> api-key-input: "";
    in-out property <bool> show-api-key: false;
    in-out property <string> language-code: "auto";
    in-out property <string> asr-model: "";
    in-out property <string> processing-model: "";
    in-out property <string> prompt-model: "";
    in-out property <string> screen-model: "";
    in-out property <[string]> transcription-model-options: [];
    in-out property <[string]> text-model-options: [];
    in-out property <string> default-style-name: "Без обработки";
    in-out property <string> custom-prompt: "";
    in-out property <string> dictionary-rules: "";
    in-out property <string> general-shortcut: "Ctrl+Alt+F8";
    in-out property <string> raw-shortcut: "";
    in-out property <string> proofread-shortcut: "";
    in-out property <string> structure-shortcut: "";
    in-out property <string> custom-shortcut: "";
    in-out property <string> prompt-shortcut: "Ctrl+Alt+F9";
    in-out property <string> screen-shortcut: "Ctrl+Alt+F10";
    in-out property <string> unload-minutes: "";
    in-out property <bool> keep-history-forever: false;
    in-out property <string> feedback-text: "";
    callback save-requested();
    callback delete-key-requested();
    callback show-key-requested();
    callback refresh-models();
    callback open-history();
    callback choose-model-folder();

    Rectangle { x: 0px; y: 0px; width: parent.width; height: 88px; background: #1e315b; }
    Rectangle { x: 28px; y: 24px; width: 38px; height: 38px; border-radius: 12px; background: #689cff;
        Text { x: 0px; y: 0px; width: parent.width; height: parent.height; text: "S"; color: white; font-size: 23px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
    }
    Text { x: 78px; y: 20px; width: 510px; height: 30px; text: "SpeakCursor"; color: white; font-size: 24px; font-weight: 700; }
    Text { x: 79px; y: 53px; width: 530px; height: 19px; text: "Диктовка и обработка речи · Windows"; color: #c8d8fa; font-size: 13px; }
    Rectangle { x: 24px; y: 105px; width: 750px; height: 42px; border-radius: 12px; background: #e6ecf5; }
    Rectangle { x: 29px; y: 109px; width: 147px; height: 34px; border-radius: 9px; background: root.page == 0 ? white : transparent;
        Text { width: parent.width; height: parent.height; text: "Распознавание"; color: #223453; font-weight: root.page == 0 ? 700 : 500; horizontal-alignment: center; vertical-alignment: center; }
        TouchArea { width: parent.width; height: parent.height; clicked => { root.page = 0; } }
    }
    Rectangle { x: 181px; y: 109px; width: 116px; height: 34px; border-radius: 9px; background: root.page == 4 ? white : transparent;
        Text { width: parent.width; height: parent.height; text: "Модели API"; color: #223453; font-weight: root.page == 4 ? 700 : 500; horizontal-alignment: center; vertical-alignment: center; }
        TouchArea { width: parent.width; height: parent.height; clicked => { root.page = 4; root.refresh-models(); } }
    }
    Rectangle { x: 302px; y: 109px; width: 102px; height: 34px; border-radius: 9px; background: root.page == 1 ? white : transparent;
        Text { width: parent.width; height: parent.height; text: "Стили"; color: #223453; font-weight: root.page == 1 ? 700 : 500; horizontal-alignment: center; vertical-alignment: center; }
        TouchArea { width: parent.width; height: parent.height; clicked => { root.page = 1; } }
    }
    Rectangle { x: 409px; y: 109px; width: 134px; height: 34px; border-radius: 9px; background: root.page == 2 ? white : transparent;
        Text { width: parent.width; height: parent.height; text: "Сочетания"; color: #223453; font-weight: root.page == 2 ? 700 : 500; horizontal-alignment: center; vertical-alignment: center; }
        TouchArea { width: parent.width; height: parent.height; clicked => { root.page = 2; } }
    }
    Rectangle { x: 548px; y: 109px; width: 142px; height: 34px; border-radius: 9px; background: root.page == 3 ? white : transparent;
        Text { width: parent.width; height: parent.height; text: "Приложение"; color: #223453; font-weight: root.page == 3 ? 700 : 500; horizontal-alignment: center; vertical-alignment: center; }
        TouchArea { width: parent.width; height: parent.height; clicked => { root.page = 3; } }
    }

    Rectangle { x: 24px; y: 158px; width: 750px; height: 422px; border-radius: 16px; background: white; border-width: 1px; border-color: #dfe7f1; }

    if root.page == 0: Rectangle {
        x: 48px; y: 180px; width: 704px; height: 380px;
        background: transparent;
        Text { x: 0px; y: 0px; text: "Источник речи"; color: #172846; font-size: 19px; font-weight: 700; }
        Text { x: 0px; y: 29px; text: "Выбери, где распознавать речь. Обработка стилями настраивается отдельно."; color: #627188; font-size: 13px; }
        CheckBox { x: 0px; y: 59px; text: "Распознавать через OpenAI"; checked <=> root.use-cloud; }
        Text { x: 0px; y: 105px; text: "Локальная модель CTranslate2"; color: #172846; font-weight: 600; }
        ComboBox { x: 518px; y: 99px; width: 170px; model: ["CPU", "NVIDIA GPU"]; current-value <=> root.compute-choice; }
        LineEdit { x: 0px; y: 131px; width: 570px; text <=> root.local-model-path; edited(text) => { root.model-status = "Путь изменён · сохрани настройки для выбора модели"; } }
        Button { x: 580px; y: 131px; width: 108px; text: "Выбрать…"; clicked => { root.choose-model-folder(); } }
        Text { x: 0px; y: 173px; width: 680px; height: 48px; text: root.model-status; color: #2865ad; font-size: 13px; wrap: word-wrap; }
        Rectangle { x: 0px; y: 223px; width: 688px; height: 1px; background: #e4eaf3; }
        Text { x: 0px; y: 237px; text: "Ключ OpenAI"; color: #172846; font-weight: 600; }
        LineEdit { x: 0px; y: 263px; width: 420px; text <=> root.api-key-input; input-type: root.show-api-key ? text : password; }
        Button { x: 426px; y: 263px; width: 116px; text: root.show-api-key ? "Скрыть" : "Показать"; clicked => { root.show-key-requested(); } }
        Button { x: 548px; y: 263px; width: 140px; text: "Удалить ключ"; clicked => { root.delete-key-requested(); } }
        Text { x: 0px; y: 318px; text: "Язык речи"; color: #172846; }
        LineEdit { x: 130px; y: 312px; width: 130px; text <=> root.language-code; }
        Text { x: 280px; y: 319px; text: "auto — определить автоматически"; color: #627188; font-size: 12px; }
    }

    if root.page == 4: Rectangle {
        x: 48px; y: 182px; width: 704px; height: 380px;
        background: transparent;
        Button { x: 0px; y: 0px; width: 190px; text: "Обновить список"; clicked => { root.refresh-models(); } }
        Text { x: 205px; y: 4px; width: 375px; text: "После выбора модель проверяется при сохранении"; color: #627188; }
        Text { x: 0px; y: 55px; text: "Распознавание речи"; color: #172846; }
        LineEdit { x: 0px; y: 80px; width: 335px; text <=> root.asr-model; }
        ComboBox { x: 345px; y: 80px; width: 235px; model: root.transcription-model-options; selected(value) => { root.asr-model = value; } }
        Text { x: 0px; y: 145px; text: "Обработка текста и стили"; color: #172846; }
        LineEdit { x: 0px; y: 170px; width: 335px; text <=> root.processing-model; }
        ComboBox { x: 345px; y: 170px; width: 235px; model: root.text-model-options; selected(value) => { root.processing-model = value; } }
        Text { x: 0px; y: 227px; text: "Промпт-инженер"; color: #172846; }
        LineEdit { x: 0px; y: 250px; width: 335px; text <=> root.prompt-model; }
        ComboBox { x: 345px; y: 250px; width: 235px; model: root.text-model-options; selected(value) => { root.prompt-model = value; } }
        Text { x: 0px; y: 303px; text: "Экран и изображения"; color: #172846; }
        LineEdit { x: 0px; y: 326px; width: 335px; text <=> root.screen-model; }
        ComboBox { x: 345px; y: 326px; width: 235px; model: root.text-model-options; selected(value) => { root.screen-model = value; } }
    }

    if root.page == 1: Rectangle {
        x: 48px; y: 182px; width: 704px; height: 380px;
        background: transparent;
        Text { x: 0px; y: 0px; text: "Стиль для основного сочетания"; color: #172846; }
        ComboBox {
            x: 0px; y: 28px; width: 340px;
            model: ["Без обработки", "Пунктуация и ошибки", "ТЗ / README", "Свой стиль"];
            current-value <=> root.default-style-name;
        }
        Text { x: 0px; y: 83px; text: "Промпт своего стиля"; color: #172846; }
        TextEdit { x: 0px; y: 111px; width: 580px; height: 76px; text <=> root.custom-prompt; }
        Text {
            x: 0px; y: 197px; width: 580px;
            text: "Без обработки работает без LLM. Другие стили используют выбранную модель обработки.";
            color: #627188; wrap: word-wrap;
        }
        Text { x: 0px; y: 252px; text: "Словарь замен — по одной паре на строку: как услышано = как написать"; color: #172846; }
        TextEdit { x: 0px; y: 278px; width: 580px; height: 106px; text <=> root.dictionary-rules; }
    }

    if root.page == 2: Rectangle {
        x: 48px; y: 182px; width: 704px; height: 380px;
        background: transparent;
        Text { x: 0px; y: 0px; text: "Основная диктовка"; color: #172846; }
        LineEdit { x: 310px; y: 0px; width: 270px; text <=> root.general-shortcut; }
        Text { x: 0px; y: 45px; text: "Без обработки"; color: #172846; }
        LineEdit { x: 310px; y: 45px; width: 270px; text <=> root.raw-shortcut; }
        Text { x: 0px; y: 90px; text: "Пунктуация и ошибки"; color: #172846; }
        LineEdit { x: 310px; y: 90px; width: 270px; text <=> root.proofread-shortcut; }
        Text { x: 0px; y: 135px; text: "ТЗ / README"; color: #172846; }
        LineEdit { x: 310px; y: 135px; width: 270px; text <=> root.structure-shortcut; }
        Text { x: 0px; y: 180px; text: "Свой стиль"; color: #172846; }
        LineEdit { x: 310px; y: 180px; width: 270px; text <=> root.custom-shortcut; }
        Text { x: 0px; y: 225px; text: "Промпт-инженер"; color: #172846; }
        LineEdit { x: 310px; y: 225px; width: 270px; text <=> root.prompt-shortcut; }
        Text { x: 0px; y: 270px; text: "Экран и мышь"; color: #172846; }
        LineEdit { x: 310px; y: 270px; width: 270px; text <=> root.screen-shortcut; }
        Text {
            x: 0px; y: 329px; width: 580px;
            text: "Повтор того же сочетания завершает запись. Esc отменяет.";
            color: #627188;
        }
    }

    if root.page == 3: Rectangle {
        x: 48px; y: 182px; width: 704px; height: 380px;
        background: transparent;
        CheckBox { x: 0px; y: 0px; text: "Запускать при входе в Windows"; checked <=> root.launch-at-login; }
        CheckBox { x: 0px; y: 35px; text: "Не удалять историю автоматически"; checked <=> root.keep-history-forever; }
        Text { x: 0px; y: 80px; text: "Выгружать локальную модель после простоя (минуты)"; color: #172846; }
        LineEdit { x: 0px; y: 108px; width: 160px; text <=> root.unload-minutes; }
        Text {
            x: 0px; y: 163px; width: 580px;
            text: "Пустое поле оставляет модель загруженной. Настройки сохраняются локально.";
            color: #627188; wrap: word-wrap;
        }
        Button { x: 0px; y: 230px; width: 190px; text: "Открыть историю"; clicked => { root.open-history(); } }
    }

    Text { x: 28px; y: 596px; width: 540px; height: 38px; text: root.feedback-text; color: #295f9d; wrap: word-wrap; }
    Rectangle { x: 620px; y: 592px; width: 154px; height: 40px; border-radius: 10px; background: #2866d8; Text { width: parent.width; height: parent.height; text: "Сохранить"; color: white; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; } TouchArea { width: parent.width; height: parent.height; clicked => { root.save-requested(); } } }
}

export component AboutPanel inherits Window {
    width: 360px;
    height: 220px;
    title: "SpeakCursor — о программе";
    background: white;
    Text { x: 24px; y: 20px; text: "SpeakCursor"; color: #202227; font-size: 24px; font-weight: 700; }
    Text { x: 24px; y: 58px; text: "Голосовая диктовка для Windows"; color: #494f59; }
    AboutSlint { x: 24px; y: 95px; width: 310px; height: 115px; }
}

export struct HistoryRow {
    id: int,
    original: string,
    processed: string,
    failed: bool,
}

export component HistoryPanel inherits Window {
    width: 740px;
    height: 580px;
    title: "SpeakCursor — история";
    background: #f3f6fb;
    in-out property <string> search-query: "";
    in-out property <[HistoryRow]> rows: [];
    in-out property <string> feedback-text: "";
    in-out property <bool> clear-armed: false;
    callback search-changed(string);
    callback copy-original(int);
    callback copy-processed(int);
    callback retry(int);
    callback clear-all();

    Rectangle { x: 0px; y: 0px; width: parent.width; height: 82px; background: #1e315b; }
    Text { x: 24px; y: 18px; text: "История диктовки"; font-size: 23px; font-weight: 700; color: white; }
    Text { x: 24px; y: 51px; text: "Найди запись и скопируй нужный вариант текста"; font-size: 13px; color: #c8d8fa; }
    LineEdit { x: 24px; y: 104px; width: 520px; text <=> root.search-query; edited(text) => { root.search-changed(text); } }
    Button { x: 554px; y: 104px; width: 160px; text: root.clear-armed ? "Подтвердить" : "Очистить всё"; clicked => { root.clear-all(); } }
    Text { x: 24px; y: 154px; text: "Исходная расшифровка"; color: #172846; font-weight: 600; }
    Text { x: 372px; y: 154px; text: "После обработки"; color: #172846; font-weight: 600; }
    ListView {
        x: 24px; y: 181px; width: 690px; height: 328px;
        for row in root.rows: Rectangle {
            height: 108px;
            width: parent.width;
            background: white;
            border-radius: 10px;
            border-width: 1px; border-color: #e1e8f2;
            Text { x: 10px; y: 8px; width: 245px; height: 76px; text: row.original; color: #172846; wrap: word-wrap; }
            Button { x: 265px; y: 8px; width: 65px; text: "⧉"; accessible-label: "Скопировать исходный текст"; clicked => { root.copy-original(row.id); } }
            Text { x: 350px; y: 8px; width: 245px; height: 76px; text: row.processed; color: #172846; wrap: word-wrap; }
            Button { x: 605px; y: 8px; width: 65px; text: "⧉"; accessible-label: "Скопировать обработанный текст"; clicked => { root.copy-processed(row.id); } }
            if row.failed: Button { x: 350px; y: 75px; width: 130px; text: "Повторить"; clicked => { root.retry(row.id); } }
        }
    }
    Text { x: 24px; y: 528px; width: 690px; text: root.feedback-text; color: #295f9d; }
}
